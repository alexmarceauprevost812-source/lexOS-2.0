#include <winuser.h>
1 ICON "play.ico"
1 RT_MANIFEST "play.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "TI-LEX-AL"
      VALUE "FileDescription", "LexOS Play"
      VALUE "ProductName", "LexOS"
      VALUE "FileVersion", "1.0"
      VALUE "ProductVersion", "1.0"
      VALUE "LegalCopyright", "Alex Marceau Prevost - MIT"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END

#!/bin/sh
# =============================================================================
#  LexOS — auto/config
#  Appelé par `lb config`. Traduit lexos.conf en options live-build.
# =============================================================================
set -e

#  ── Pourquoi on ne se contente pas de sourcer lexos.conf ────────────────
#  build.sh exporte LEXOS_FLAVOUR, LEXOS_DEBIAN_SUITE et LEXOS_ARCH d'après
#  ses options de ligne de commande. « . ./lexos.conf » les écrasait par les
#  valeurs du fichier : « --flavour pro » produisait une ISO contenant bien
#  les paquets de la saveur pro — build.sh assemble les listes lui-même —
#  mais NOMMÉE « standard ». Un fichier qui ment sur son contenu est pire
#  qu'une erreur bruyante : on télécharge 6 Gio en croyant s'être trompé.
#  On garde donc ce qui vient de l'environnement quand il y en a.
_ENV_FLAVOUR="${LEXOS_FLAVOUR:-}"
_ENV_SUITE="${LEXOS_DEBIAN_SUITE:-}"
_ENV_ARCH="${LEXOS_ARCH:-}"

. ./lexos.conf

[ -n "$_ENV_FLAVOUR" ] && LEXOS_FLAVOUR="$_ENV_FLAVOUR"
[ -n "$_ENV_SUITE" ]   && LEXOS_DEBIAN_SUITE="$_ENV_SUITE"
[ -n "$_ENV_ARCH" ]    && LEXOS_ARCH="$_ENV_ARCH"

BACKPORTS="false"
[ "${LEXOS_KERNEL_CHANNEL:-stock}" = "backports" ] && BACKPORTS="true"

#  ── Le socle commun aux deux modes ──────────────────────────────────────
#  Tout ce qui décrit la SESSION (compte, nom de machine, langue, clavier,
#  fuseau) doit valoir aussi bien en mode normal qu'en mode secours : un
#  filet de sécurité qui démarre en clavier américain et en anglais est un
#  filet dans lequel on ne sait plus taper son mot de passe.
BOOTAPPEND_BASE="boot=live components"
BOOTAPPEND_BASE="${BOOTAPPEND_BASE} username=${LEXOS_LIVE_USER}"
BOOTAPPEND_BASE="${BOOTAPPEND_BASE} user-fullname=${LEXOS_NAME}\\ Live"
BOOTAPPEND_BASE="${BOOTAPPEND_BASE} hostname=${LEXOS_HOSTNAME}"
BOOTAPPEND_BASE="${BOOTAPPEND_BASE} locales=${LEXOS_LOCALE}"
BOOTAPPEND_BASE="${BOOTAPPEND_BASE} keyboard-layouts=${LEXOS_KEYBOARD_LAYOUT}"
BOOTAPPEND_BASE="${BOOTAPPEND_BASE} keyboard-variants=${LEXOS_KEYBOARD_VARIANT}"
BOOTAPPEND_BASE="${BOOTAPPEND_BASE} timezone=${LEXOS_TIMEZONE}"

BOOTAPPEND="${BOOTAPPEND_BASE} quiet splash"

#  ── NVIDIA (RTX 50 / Blackwell) : garder la console visible ─────────────
#  Constaté sur une Alienware Aurora, RTX 5060, pilote 610.43.02 (dépôt
#  officiel NVIDIA) : la TV (HDMI) perd le signal pile quand nvidia.ko
#  initialise le firmware GSP, AVANT même que Xorg ne démarre — un bug de
#  régression documenté par NVIDIA elle-même pour cette version exacte
#  (« TV shows No Signal », open-gpu-kernel-modules#1238, apparu pile à
#  610.43.02, encore présent en 610.43.03). Deux filets de sécurité, sans
#  effet sur une machine sans carte NVIDIA (options ignorées) :
#    · modeset=1 fbdev=1 : ré-enregistrent une console framebuffer côté
#      nvidia_drm dès qu'il se charge, au lieu de laisser le framebuffer
#      UEFI mort sans rien pour le remplacer.
#    · hdmi_deepcolor=0 : force une sortie HDMI 8 bits — correctif connu
#      (ArchWiki NVIDIA/Troubleshooting) pour les « no signal » sur TV,
#      dont les puces HDMI sont souvent plus strictes qu'un vrai moniteur.
#
#  CE QUE L'ESSAI SUR VRAIE MACHINE A APPRIS ENSUITE : ces deux filets n'ont
#  pas suffi — la 610 coupait le signal malgré eux. Le vrai correctif n'est
#  pas ici mais dans lexos.conf, LEXOS_NVIDIA_BRANCH : on installe désormais
#  la branche 595, celle qu'Ubuntu 26.04 fait tourner sur ce même matériel
#  sans aucun réglage particulier. Les options ci-dessous restent, en
#  ceinture et bretelles : elles sont déjà les défauts des pilotes récents,
#  et forcer le HDMI en 8 bits ne peut pas faire perdre un signal — au pire
#  ça retire des nuances de couleur que la plupart des TV n'affichent pas.
BOOTAPPEND="${BOOTAPPEND} nvidia-drm.modeset=1 nvidia-drm.fbdev=1 nvidia-modeset.hdmi_deepcolor=0"

#  ── Mode fail-safe : un VRAI filet, garanti sans NVIDIA ─────────────────
#  module_blacklist= agit au niveau du noyau : il bloque TOUT chargement, y
#  compris un modprobe explicite par un service — contrairement à
#  modprobe.blacklist= qui ne bloque que le chargement automatique par alias.
#  C'est la seule façon de garantir qu'aucun composant NVIDIA ne touche
#  l'écran dans ce mode.
#
#  DEUX CORRECTIFS, après le premier essai réel de ce mode (Alienware Aurora
#  ACT1250, RTX 5060, TV Hisense en HDMI, construction 19) : le mode NORMAL
#  affichait le bureau, et c'est le mode secours — celui censé ne jamais
#  échouer — qui restait noir. Deux causes, toutes deux dans la chaîne qu'on
#  avait reprise du défaut live-build :
#
#  1. « nouveau » n'était pas bloqué. Bloquer la pile NVIDIA propriétaire ne
#     laisse pas l'écran tranquille : le pilote libre nouveau, lui, est dans
#     le noyau, et rien ne l'empêchait alors de se lier à la carte. Sur une
#     Blackwell (RTX 50) il échoue — mais il a déjà évincé le framebuffer
#     UEFI en essayant, et il ne reste plus rien pour afficher quoi que ce
#     soit. D'où « nomodeset », qui interdit à TOUT pilote DRM réel de
#     prendre la main et laisse en place le framebuffer que l'UEFI a déjà
#     configuré — exactement celui qui affiche GRUB, donc un affichage dont
#     on a la preuve qu'il fonctionne sur cet écran. nouveau est aussi nommé
#     dans la liste noire, pour que ce soit vrai même sans nomodeset.
#
#  2. Les vieilles options de dépannage du défaut live-build — noapic,
#     nosmp, nodma, nomce, vga=788 — datent des années 2000. Sur une machine
#     récente elles ne réparent rien et cassent : noapic désorganise les
#     interruptions, nosmp réduit un processeur moderne à un seul cœur, et
#     vga=788 (un mode VESA) n'a aucun sens en démarrage UEFI, où il est
#     purement ignoré. Un mode secours doit changer le MINIMUM de choses.
#
#  Et on garde les messages visibles (ni quiet ni splash) : quand ce mode
#  sert, c'est qu'on cherche déjà pourquoi quelque chose ne marche pas.
#  Le marqueur lexos.failsafe=1 ne fait rien par lui-même — il permet de
#  reconnaître le mode dans /proc/cmdline au moment d'un diagnostic.
BOOTAPPEND_FAILSAFE="${BOOTAPPEND_BASE} nosplash nomodeset"
BOOTAPPEND_FAILSAFE="${BOOTAPPEND_FAILSAFE} module_blacklist=nvidia,nvidia_drm,nvidia_modeset,nvidia_uvm,nouveau"
BOOTAPPEND_FAILSAFE="${BOOTAPPEND_FAILSAFE} lexos.failsafe=1"

#  ── Le mode secours s'arrête AVANT le bureau ────────────────────────────
#  CE QUE L'ESSAI SUR LA TV HISENSE A MONTRÉ (construction 34) : en mode
#  secours, les messages de démarrage S'AFFICHAIENT — donc le téléviseur, le
#  câble, la clé USB et l'ISO sont tous bons, et le noyau parle bien à
#  l'écran. Le signal se perdait ensuite, au moment où le bureau graphique
#  démarrait. Un mode de secours qui va jusqu'à mourir à l'écran ne sert plus
#  à rien : c'est précisément là qu'on a besoin de LIRE quelque chose.
#
#  Il s'arrête donc en console, sur du texte, et il y reste. C'est le seul
#  état dont on ait la PREUVE qu'il tient sur ce téléviseur. On peut alors y
#  taper « lexos tv », qui lit l'EDID et le mode réclamé sans serveur
#  graphique ni pilote, et photographier le résultat.
#
#  Compromis assumé : quelqu'un dont le problème n'est PAS l'affichage perd
#  le bureau dans ce mode. C'est le bon échange — un mode de secours doit
#  d'abord être sûr d'afficher, et le mode normal reste juste au-dessus dans
#  le menu. « systemd.unit= » est la façon propre de le demander ; le « 3 »
#  qui suit est le vieux niveau d'exécution, compris aussi par les noyaux et
#  les init qui ignoreraient le premier.
BOOTAPPEND_FAILSAFE="${BOOTAPPEND_FAILSAFE} systemd.unit=multi-user.target 3"

#  CE QUE L'ESSAI DU BUILD 50 A MONTRÉ (Alienware, TV Hisense, vidéo à
#  l'appui) : même dans CE mode — nomodeset, toute la pile NVIDIA et nouveau
#  en liste noire, aucun bureau — le signal se perdait encore à ~20 secondes.
#  Aucun pilote d'affichage ne peut être coupable : aucun n'a le droit de
#  toucher l'écran ici. Le seul acteur restant qui agit sur le matériel à ce
#  moment-là est TLP, l'économiseur d'énergie (paquet pensé pour les
#  portables) : il démarre justement autour de la vingtième seconde et met
#  en veille les périphériques PCI « inutilisés ». Or dans ce mode, AUCUN
#  pilote ne tient la carte graphique — TLP peut donc l'endormir pendant
#  qu'elle envoie l'image du framebuffer UEFI. Sur une tour branchée au mur,
#  TLP peut de plus se croire sur batterie (pas de /sys/class/power_supply/AC)
#  et appliquer son profil le plus agressif. On l'interdit ici, et le
#  service lui-même est conditionné à la présence d'une batterie (voir le
#  drop-in tlp.service.d/lexos-batterie.conf).
BOOTAPPEND_FAILSAFE="${BOOTAPPEND_FAILSAFE} systemd.mask=tlp.service"

#  ── Réponses préremplies de l'installateur ──────────────────────────────
#  config/includes.installer/preseed.cfg est recopié à la racine du support
#  par live-build ; l'installateur le trouve sous /cdrom. Il ne contient que
#  des questions sans conséquence (domaine réseau, horloge en UTC) — RIEN
#  qui touche au disque, qui reste entièrement manuel.
BOOTAPPEND_INSTALL="${BOOTAPPEND} file=/cdrom/preseed.cfg"

lb config noauto \
	--mode debian \
	--distribution "${LEXOS_DEBIAN_SUITE}" \
	--architectures "${LEXOS_ARCH}" \
	--linux-flavours "${LEXOS_ARCH}" \
	--archive-areas "main contrib non-free non-free-firmware" \
	--parent-archive-areas "main contrib non-free non-free-firmware" \
	--mirror-bootstrap "${LEXOS_MIRROR}" \
	--mirror-chroot "${LEXOS_MIRROR}" \
	--mirror-chroot-security "${LEXOS_MIRROR_SECURITY}" \
	--mirror-binary "${LEXOS_MIRROR}" \
	--mirror-binary-security "${LEXOS_MIRROR_SECURITY}" \
	--security true \
	--updates true \
	--backports "${BACKPORTS}" \
	--apt-recommends true \
	--apt-indices false \
	--firmware-chroot true \
	--firmware-binary true \
	--binary-images iso-hybrid \
	--bootloaders "syslinux,grub-efi" \
	--uefi-secure-boot enable \
	--memtest none \
	--debian-installer live \
	--debian-installer-gui true \
	--debian-installer-distribution "${LEXOS_DEBIAN_SUITE}" \
	--win32-loader false \
	--iso-application "${LEXOS_NAME}" \
	--iso-publisher "${LEXOS_PUBLISHER}" \
	--iso-preparer "${LEXOS_NAME} build system; ${LEXOS_HOME_URL}" \
	--iso-volume "${LEXOS_NAME} ${LEXOS_VERSION}" \
	`#  live-build ajoute lui-même « -<arch>.hybrid.iso » : répéter
	 #  l'architecture ici donnait lexos-1.0-standard-amd64-amd64.hybrid.iso.` \
	--image-name "${LEXOS_ID}-${LEXOS_VERSION}-${LEXOS_FLAVOUR}" \
	--bootappend-live "${BOOTAPPEND}" \
	--bootappend-live-failsafe "${BOOTAPPEND_FAILSAFE}" \
	--bootappend-install "${BOOTAPPEND_INSTALL}" \
	--compression xz \
	--zsync false \
	--checksums sha256 \
	"${@}"

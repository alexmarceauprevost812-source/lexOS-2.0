# =============================================================================
#  LexOS — entrées « démo » du menu de démarrage BIOS
# =============================================================================
#  REMPLACE le modèle de live-build, qui écrit « Live (amd64) » en anglais.
#
#  RÈGLE DURE, PAYÉE TROIS FOIS : ON N'ÉCRIT QUE DES JETONS PROUVÉS, ET ON
#  N'ÉCRIT JAMAIS UN JETON DANS UN COMMENTAIRE.
#
#  · Build 66 : « KERNEL entre arobases » a été inventé — ce jeton n'existe
#    pas chez live-build. Le menu s'affichait, choisir une entrée ne
#    démarrait rien : la ligne kernel pointait vers un fichier au nom du
#    jeton. D'où les chemins RÉELS ci-dessous : /live/vmlinuz et
#    /live/initrd.img, la disposition standard d'une image live Debian,
#    vérifiée par le hook 0905 à chaque construction.
#
#  · Build 68 : « LB_BOOTAPPEND_LIVE entre arobases » était inventé AUSSI —
#    la ligne append est partie sur l'ISO avec le jeton en toutes lettres,
#    donc SANS boot=live : le noyau chargeait puis tombait dans l'initramfs.
#    La preuve est dans le journal du 68, par élimination : FLAVOUR et
#    INITRD, écrits dans ces commentaires, ont été substitués par live-build
#    (ce sont de vrais jetons) ; les LB_* sont restés. Les vrais noms pour
#    la ligne append sont APPEND_LIVE et APPEND_FAILSAFE — ceux du modèle
#    isolinux de live-build lui-même (usr/share/live/build/bootloaders).
#
#  · Et pourquoi pas de jeton dans les commentaires : le filet du hook 0905
#    liste tout jeton survivant, et un jeton cité dans un commentaire rend
#    cette liste illisible — au 68, la moitié des « survivants » étaient des
#    mots de commentaire. Écrire « NOM entre arobases » suffit.
#
#  Le hook 0905 fait la ceinture ET les bretelles : si un jeton d'append
#  survit malgré tout, il reconstruit la ligne à partir du grub.cfg de la
#  même image — celui que live-build génère lui-même, toujours juste.
# =============================================================================

label live-@FLAVOUR@
	menu label Session de démonstration
	menu default
	kernel /live/vmlinuz
	append initrd=/live/initrd.img @APPEND_LIVE@

label live-@FLAVOUR@-failsafe
	menu label Mode de secours (affichage garanti)
	kernel /live/vmlinuz
	append initrd=/live/initrd.img @APPEND_FAILSAFE@

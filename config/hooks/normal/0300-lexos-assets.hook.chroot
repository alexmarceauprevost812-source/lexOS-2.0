#!/bin/sh
# =============================================================================
#  LexOS — rendu des visuels : logo TI-LEX-AL, mascotte, fonds d'écran, Plymouth
# =============================================================================
set -e

echo "[lexos] hook 0300 : visuels"

BRAND="/usr/share/lexos/branding"
BG="/usr/share/backgrounds/lexos"
mkdir -p "$BG" "$BRAND" /usr/share/pixmaps

have() { command -v "$1" >/dev/null 2>&1; }

# --- WebP -> PNG -------------------------------------------------------------
# Les mascottes sont livrées en .webp : peu d'outils GTK savent les lire.
for W in "$BRAND"/*.webp; do
	[ -e "$W" ] || continue
	OUT="${W%.webp}.png"
	if have dwebp; then
		dwebp -quiet "$W" -o "$OUT" && echo "[lexos]   webp -> $OUT"
	elif have convert; then
		convert "$W" "$OUT" && echo "[lexos]   webp -> $OUT"
	else
		echo "[lexos]   !! ni dwebp ni convert : $W non converti"
	fi
done

# --- Rendu SVG ---------------------------------------------------------------
render() { # render <src.svg> <w> <h> <dest.png>
	if [ ! -r "$1" ]; then
		echo "[lexos]   !! source absente : $1"
		return 0
	fi
	if have rsvg-convert; then
		rsvg-convert -w "$2" -h "$3" -o "$4" "$1" \
			&& echo "[lexos]   -> $4" || echo "[lexos]   !! échec : $1"
	elif have convert; then
		convert -background none -resize "${2}x${3}" "$1" "$4" \
			&& echo "[lexos]   -> $4" || echo "[lexos]   !! échec : $1"
	fi
}

# --- Fonds d'écran -----------------------------------------------------------
render "$BRAND/wallpaper.svg"     1920 1080 "$BG/wallpaper.png"
render "$BRAND/wallpaper.svg"     3840 2160 "$BG/wallpaper-4k.png"
render "$BRAND/wallpaper.svg"     1366  768 "$BG/wallpaper-hd.png"
render "$BRAND/wallpaper-crt.svg" 1920 1080 "$BG/wallpaper-crt.png"
render "$BRAND/wallpaper-secu.svg" 1920 1080 "$BG/wallpaper-secu.png"
render "$BRAND/wallpaper-secu.svg" 3840 2160 "$BG/wallpaper-secu-4k.png"

#  ═══ LE FOND « NOMAD » — LE BUREAU DE LA DÉMO ═══
#  ALEX, capture de la démo à l'appui : « ajouter ce fond d'écran officiel
#  comme fond d'écran », puis « mettre ces images dans l'ISO 96, dans le
#  fichier images, si je veux les avoir comme fond d'écran ». C'est le
#  bureau de web-demo/index.html — logo ASCII orange, filet, TI·LEX·AL,
#  2.0.0 NOMAD — repris valeur par valeur (voir l'en-tête du SVG).
#
#  Trois tailles, comme le fond par défaut : sans la 4K, un écran 3840 de
#  large étirerait la 1920 et le filet passerait de 2 px à 4 px flous.
render "$BRAND/wallpaper-nomad.svg" 1920 1080 "$BG/wallpaper-nomad.png"
render "$BRAND/wallpaper-nomad.svg" 3840 2160 "$BG/wallpaper-nomad-4k.png"
render "$BRAND/wallpaper-nomad.svg" 1366  768 "$BG/wallpaper-nomad-hd.png"

# Fond d'écran « LexOS 1.0 » : le logo TI-LEX-AL, posé sur fond noir — même
# composition que le sélecteur de la démo web (Paramètres → Bureau LexOS).
if [ -r "$BRAND/logo-ti-lex-al-icon.png" ] && have convert; then
	convert -size 1920x1080 xc:black \
		"$BRAND/logo-ti-lex-al-icon.png" -resize 620x620 -gravity north -geometry +0+90 -composite \
		"$BG/wallpaper-demon.png" \
		&& echo "[lexos]   -> $BG/wallpaper-demon.png" \
		|| echo "[lexos]   !! échec : wallpaper-demon.png"

	#  LE DÉMON DEVIENT LE FOND D'ÉCRAN OFFICIEL. Alex : « pour la prochaine
	#  ios sa va etre le fond ecren officiel — mais toute noir — avec le
	#  demon ». wallpaper.png (rendu plus haut depuis wallpaper.svg) est LE
	#  fichier que lexos-firstrun applique au premier lancement et que le
	#  repli XFCE ci-dessous copie — le remplacer ICI, une fois le démon
	#  composé, suffit à changer l'officiel PARTOUT sans toucher trois
	#  fichiers séparément.
	#
	#  UN LIEN SYMBOLIQUE, PAS UNE COPIE : les deux noms (« defaut » et
	#  « demon » dans settings.py, FONDS) doivent rester LA MÊME image pour
	#  toujours — une copie se dédouble en silence si un correctif futur ne
	#  touche que l'un des deux fichiers. « ln -sf » écrase sans se plaindre
	#  ce que « render » venait de poser deux blocs plus haut.
	if [ -r "$BG/wallpaper-demon.png" ]; then
		ln -sf wallpaper-demon.png "$BG/wallpaper.png" \
			&& echo "[lexos]   -> wallpaper.png pointe maintenant sur le démon (fond officiel)" \
			|| echo "[lexos]   !! échec : wallpaper.png n'a pas pu pointer sur le démon"
	fi
fi

# --- Le fond de l'ÉCRAN DE CONNEXION ---------------------------------------
#  Alex, photo de l'ISO 76 : « aimerais [...] avec la 2e image comme fond
#  d'écran ». La 2e image, c'est le logo TI·LEX·AL — le démon en flammes.
#
#  POURQUOI UNE IMAGE À PART, ET PAS wallpaper-demon.png QUI EXISTE DÉJÀ
#  Celle-là est composée pour un BUREAU : le logo occupe le haut, le dock et
#  les icônes vivent en dessous. L'écran de connexion, lui, pose une boîte au
#  milieu-bas. Avec le logo à 620 px, la boîte lui tomberait en plein visage.
#
#  680 px de haut à 40 px du bord, ce n'est donc pas un chiffre choisi au
#  hasard. La boîte de connexion est ancrée par son BAS à 88 % de la hauteur
#  (hook 0400) et mesure ~330 px : sur un écran de 1080, son haut tombe vers
#  620 px, juste sous la pointe des flammes — le démon ET la banderole
#  TI·LEX·AL restent entiers. Composé et REGARDÉ, pas calculé de tête.
#
#  Sur un écran de 768 px de haut, la boîte garde ses 330 px pendant que
#  l'image, elle, rétrécit : elle mordra sur le bas de la banderole. C'est le
#  compromis assumé — une image assez grande pour qu'on la voie sur les
#  écrans d'aujourd'hui, plutôt qu'un timbre-poste sûr partout. Le visage,
#  lui, reste dégagé dans tous les cas.
if [ -r "$BRAND/logo-ti-lex-al-icon.png" ] && have convert; then
	convert -size 1920x1080 xc:black \
		\( "$BRAND/logo-ti-lex-al-icon.png" -resize x680 \) \
		-gravity north -geometry +0+40 -composite \
		"$BG/lexos-connexion.png" \
		&& echo "[lexos]   -> $BG/lexos-connexion.png" \
		|| echo "[lexos]   !! échec : lexos-connexion.png"
else
	echo "[lexos]   !! pas de logo ou pas d'ImageMagick — l'écran de connexion restera noir uni"
fi

# Fond d'écran « Explorateur » : la photo-affiche lexos-1.0-keyart.png, posée
# sur fond noir — même composition que le sélecteur de la démo web (Paramètres → Bureau LexOS).
if [ -r "$BRAND/lexos-1.0-keyart.png" ] && have convert; then
	convert -size 1920x1080 xc:black \
		"$BRAND/lexos-1.0-keyart.png" -resize 480x480 -gravity north -geometry +0+70 -composite \
		"$BG/wallpaper-keyart.png" \
		&& echo "[lexos]   -> $BG/wallpaper-keyart.png" \
		|| echo "[lexos]   !! échec : wallpaper-keyart.png"
fi

# --- Les fonds d'écran d'Alex : deux JPEG, deux recettes différentes -------
# >>> banc: fonds-alex
#  ═══ AUCUN DES DEUX N'EST EN 16:9, ET C'EST TOUT LE TRAVAIL ═══
#  Alex a envoyé des images qu'il aime ; l'écran, lui, fait 1920 × 1080.
#  Laissé à xfdesktop, le cadrage « étirer » déforme la mascotte et « rogner »
#  coupe la bannière — au hasard, selon le style enregistré. On prépare donc
#  les images ICI, une fois, au format exact de l'écran.
#
#  ET LA RECETTE N'EST PAS LA MÊME POUR LES DEUX, parce que les images ne se
#  ressemblent pas :
#
#    · fond-mascotte.jpg (1392 × 1680, PORTRAIT) a un FOND NOIR PUR. Posée au
#      centre d'un cadre noir, la jointure est invisible : c'est le même noir.
#      On la met à la hauteur et on centre. ON NE ROGNE RIEN — la main qui
#      fait les cornes est tout en haut à droite, un rognage la couperait.
#
#    · fond-tilexal-banniere.jpg (1920 × 1280, 3:2) va JUSQU'AUX BORDS, pluie
#      Matrix comprise. Des bandes noires lui donneraient l'air d'une vidéo
#      mal cadrée. Il faut donc lui retirer 200 px de hauteur, et le tout en
#      HAUT — mesuré : le contenu descend jusqu'à la ligne 1278 sur 1280
#      (le buste et le mot « Explore » du chandail touchent le bord bas),
#      alors qu'en haut les flammes ne commencent qu'à la ligne 41. Essayé
#      170/30 et regardé : « Explore » se fait couper. À 200/0 le buste reste
#      entier et le démon déborde du cadre par le haut — ça se tient.
#
#  ON GARDE LE JPEG. Les autres fonds sont des SVG rendus en PNG ; ceux-ci
#  sont des photos-affiches, et un PNG de photo pèse cinq fois plus pour rien
#  sur une ISO. lexos-fond-ecran accepte déjà .jpg (sa liste d'extensions).
#
#  ET SI convert MANQUE, RIEN N'EST PRODUIT ET ÇA SE DIT. Pas d'image
#  déformée livrée en silence : imagemagick ne vit que dans des listes
#  facultatives que le hook 0250 pose en tolérant l'échec.
FONDS_ALEX_OK=0
if have convert; then
	FONDS_ALEX_OK=1
	if [ -r "$BRAND/fond-mascotte.jpg" ]; then
		#  -resize x1080 : à la hauteur, sans déformer. -gravity center
		#  -extent 1920x1080 : le cadre noir autour, sans rien rogner.
		convert "$BRAND/fond-mascotte.jpg" -resize x1080 \
			-background black -gravity center -extent 1920x1080 \
			-quality 88 "$BG/wallpaper-mascotte.jpg" \
			&& echo "[lexos]   -> $BG/wallpaper-mascotte.jpg (portrait centré, fond noir)" \
			|| { FONDS_ALEX_OK=0; rm -f "$BG/wallpaper-mascotte.jpg"
			     echo "[lexos]   !! échec : wallpaper-mascotte.jpg"; }
	else
		echo "[lexos]   pas de fond mascotte : branding/fond-mascotte.jpg absent"
	fi
	if [ -r "$BRAND/fond-tilexal-banniere.jpg" ]; then
		#  -crop 1920x1080+0+200 : les 200 px pris EN HAUT, +repage pour que
		#  l'image ne garde pas la mémoire de son ancien cadre.
		convert "$BRAND/fond-tilexal-banniere.jpg" \
			-crop 1920x1080+0+200 +repage \
			-quality 88 "$BG/wallpaper-tilexal.jpg" \
			&& echo "[lexos]   -> $BG/wallpaper-tilexal.jpg (200 px rognés en haut)" \
			|| { FONDS_ALEX_OK=0; rm -f "$BG/wallpaper-tilexal.jpg"
			     echo "[lexos]   !! échec : wallpaper-tilexal.jpg"; }
	else
		echo "[lexos]   pas de fond bannière : branding/fond-tilexal-banniere.jpg absent"
	fi
else
	FONDS_ALEX_OK=0
	echo "[lexos]   !! convert absent : les fonds d'écran d'Alex ne sont PAS mis au"
	echo "[lexos]   !! format. Aucun n'est posé — mieux vaut leur absence qu'une"
	echo "[lexos]   !! image étirée ou rognée au hasard par xfdesktop."
fi

#  ═══ LES SOURCES NE PARTENT PAS DANS L'ISO ═══
#  Deux raisons, et la seconde est la vraie. La place, d'abord. Mais surtout :
#  lexos-fond-ecran ratisse /usr/share/lexos/branding (sa liste DOSSIERS).
#  Laissées là, les sources apparaîtraient dans le choix des fonds d'écran À
#  CÔTÉ des versions mises au format — mêmes images, mauvais cadrage, et
#  aucun moyen pour Alex de savoir laquelle est laquelle.
#  ON N'EFFACE QU'AU CHEMIN DE PRODUCTION, comme pour les vidéos : le banc
#  joue ce fragment avec le vrai dossier branding/ du dépôt, et sans cette
#  garde, éprouver les fonds d'écran SUPPRIMERAIT les sources du dépôt.
if [ "$FONDS_ALEX_OK" = 1 ] && [ "$BRAND" = "/usr/share/lexos/branding" ]; then
	rm -f "$BRAND/fond-mascotte.jpg" "$BRAND/fond-tilexal-banniere.jpg"
fi
# <<< banc: fonds-alex

# --- Le fond par DÉFAUT de XFCE devient celui de LexOS ---------------------
#  POURQUOI CE BLOC EXISTE (constaté sur le portable 2016, build 35)
#  Le bon fond d'écran s'affichait à l'ouverture de session… puis laissait
#  la place au fond bleu de XFCE, celui à la souris. Ce n'était donc pas une
#  question de nom de propriété — c'était une COURSE, et on la perdait :
#  lexos-firstrun pose l'image, xfdesktop finit de démarrer ensuite et écrit
#  ses propres valeurs par-dessus.
#
#  On peut toujours écrire après lui, il écrira encore après nous. La seule
#  façon de gagner à coup sûr, c'est de ne plus courir : on remplace LE
#  FICHIER que xfdesktop utilise par défaut. Peu importe alors qui écrit en
#  dernier — l'image affichée est celle de LexOS.
#
#  On remplace chaque fichier en gardant son nom ET son format : xfdesktop
#  choisit par nom, et un JPEG déguisé en .svg n'est pas lisible par tous
#  les chargeurs. Les originaux de Debian ne servent plus à rien ici.
XFCE_BG="/usr/share/backgrounds/xfce"
if [ -d "$XFCE_BG" ] && [ -r "$BG/wallpaper.png" ]; then
	REMPLACES=0
	for D in "$XFCE_BG"/*; do
		[ -f "$D" ] || continue
		case "$D" in
			*.svg)
				[ -r "$BRAND/wallpaper.svg" ] \
					&& cp "$BRAND/wallpaper.svg" "$D" && REMPLACES=$((REMPLACES + 1))
				;;
			*.png)
				cp "$BG/wallpaper.png" "$D" && REMPLACES=$((REMPLACES + 1))
				;;
			*.jpg|*.jpeg)
				#  Sans convert, on recopie quand même le PNG sous le nom
				#  .jpg : les chargeurs d'images reconnaissent le format au
				#  contenu, pas à l'extension. Un PNG mal nommé s'affiche ;
				#  le fond bleu de Debian laissé en place, lui, se voit.
				if have convert; then
					convert "$BG/wallpaper.png" -quality 92 "$D" \
						&& REMPLACES=$((REMPLACES + 1))
				else
					cp "$BG/wallpaper.png" "$D" && REMPLACES=$((REMPLACES + 1))
				fi
				;;
		esac
	done
	echo "[lexos]   fond par défaut de XFCE remplacé (${REMPLACES} fichier(s))"
	if [ "$REMPLACES" -eq 0 ]; then
		echo "[lexos]   !! aucun fond XFCE remplacé — le bureau live risque de repasser au fond bleu"
	fi
else
	echo "[lexos]   !! ${XFCE_BG} absent ou wallpaper.png manquant — fond par défaut non remplacé"
fi

# Les mascottes servent aussi de fonds d'écran alternatifs.
for M in "$BRAND"/mascot*.png; do
	[ -e "$M" ] || continue
	cp "$M" "$BG/$(basename "$M")"
done

# --- Autocollants du bureau --------------------------------------------------
#  Les TROIS personnages que la fenêtre « Fonds d'écran — autocollants » de
#  la démo pose sur le fond (Lex bebeilles, Lex salut, badge PREVOST). Ce
#  sont les MÊMES images, extraites de la démo — pas des à-peu-près. PNG à
#  fond transparent, posés par « lexos fond-ecran autocollant ».
mkdir -p /usr/share/lexos/autocollants
for A in "$BRAND"/sticker-*.png; do
	[ -e "$A" ] || continue
	cp "$A" "/usr/share/lexos/autocollants/$(basename "$A")"
	echo "[lexos]   autocollant : $(basename "$A")"
done

# --- Logo TI-LEX-AL : icône officielle du système ---------------------------
#  La version détourée (fond transparent) est privilégiée pour l'icône : elle
#  se fond dans le panneau, le dock et le menu Applications quel que soit le
#  thème, contrairement à la version sur fond noir (posters, Plymouth).
LOGO_SRC=""
if [ -r "$BRAND/logo-ti-lex-al-icon.png" ]; then
	LOGO_SRC="$BRAND/logo-ti-lex-al-icon.png"
#  ET LE REPLI S'APPELLE .jpg, PARCE QUE C'EST UN JPEG. Le fichier
#  portait l'extension .png et « file » dit : « JPEG image data,
#  1024x1024 ». Personne ne l'avait vu — ce repli ne se déclenche que
#  si logo-ti-lex-al-icon.png manque, ce qui n'arrive jamais. Le
#  convertir en vrai PNG coûtait 6,3 fois sa taille (134 ko -> 843 ko) ;
#  on l'a donc renommé pour ce qu'il est.
elif [ -r "$BRAND/logo-ti-lex-al.jpg" ]; then
	LOGO_SRC="$BRAND/logo-ti-lex-al.jpg"
elif [ -r "$BRAND/logo.svg" ]; then
	LOGO_SRC="$BRAND/logo.svg"
fi

for SIZE in 16 22 24 32 48 64 128 256 512; do
	DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
	mkdir -p "$DIR"
	case "$LOGO_SRC" in
		*.svg) render "$LOGO_SRC" "$SIZE" "$SIZE" "$DIR/lexos.png" ;;
		*.png)
			if have convert; then
				convert "$LOGO_SRC" -resize "${SIZE}x${SIZE}" "$DIR/lexos.png" \
					&& echo "[lexos]   -> $DIR/lexos.png"
			fi
			;;
	esac
done

mkdir -p /usr/share/icons/hicolor/scalable/apps

# --- AUCUNE VERSION VECTORIELLE POUR LES ICÔNES LexOS. C'EST VOULU. --------
#  Le dock AGRANDIT l'icône survolée : la taille demandée varie alors en
#  continu, et pour toute taille sans PNG exact, GTK préfère le SVG
#  « scalable ». L'affichage saute donc du PNG au SVG et retour — l'icône
#  CHANGE de dessin sous la souris.
#
#  On a d'abord cru à un simple trou de tailles. On les a complétées, trois
#  fois : Chrome (build 38), Claude et Musique (build 41). Le clignotement
#  est resté. La cause n'était pas le NOMBRE de tailles, c'était l'existence
#  de DEUX rendus possibles du même nom d'icône.
#
#  Il n'en reste donc qu'un : les PNG. GTK met à l'échelle le plus proche, et
#  plus rien ne peut changer sous la souris. Au-delà de 256 px l'icône sera
#  un peu moins nette — aucune interface de LexOS ne demande cette taille.
rm -f /usr/share/icons/hicolor/scalable/apps/lexos.svg

# --- Icônes teintables (lexos-files, lexos-zip) — orange par défaut --------
#  À l'exécution, lexos-theme-gen en produit une version à la couleur
#  d'accent dans ~/.local/share/icons, qui a priorité sur celle-ci.
#  wifi-ok / wifi-warn / wifi-off portent une couleur FIXE (vert, orange,
#  rouge) : elle dit l'état du réseau, elle ne doit donc pas suivre l'accent.
#  Elles ne contiennent pas le jeton #E8590C, la substitution les ignore.
#  couleurs (gestion des couleurs) est dans le même cas : ses six teintes
#  d'arc-en-ciel sont fixes, pas de jeton non plus.
for NAME in files zip share wifi wifi-ok wifi-warn wifi-off bluetooth \
             perf-petit perf-medium perf-performant perf-max \
             folder-ferme folder-ouvert musique usb secure terminal camera \
             capture-zone capture-video arret \
             reglages volet-bas navigateur note couleurs maj disque mac; do
	SRC="$BRAND/icon-${NAME}.svg"
	[ -r "$SRC" ] || continue
	for SIZE in 16 22 24 32 48 64 128 256; do
		DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
		mkdir -p "$DIR"
		render "$SRC" "$SIZE" "$SIZE" "$DIR/lexos-${NAME}.png"
	done
	rm -f "/usr/share/icons/hicolor/scalable/apps/lexos-${NAME}.svg"
done

#  LA MASCOTTE, EN BOUTON « TOUTES LES APPLICATIONS ».
#  Demande d'Alex, photos d'Ubuntu à l'appui : le bouton qui ouvre la page des
#  applications se met dans le COIN EN BAS, et il porte la mascotte — comme le
#  logo Ubuntu au bout du dock sur sa capture. Le dock de LexOS est vertical à
#  droite : son dernier élément EST le coin en bas à droite.
#  Source déjà en PNG (c'est un dessin, pas un pictogramme) : on la
#  redimensionne comme icon-github.png, sans passer par render() qui suppose
#  un SVG. Elle n'est PAS teintée à l'accent : c'est un portrait, pas un
#  symbole.
if [ -r "$BRAND/icon-applications.png" ] && have convert; then
	for SIZE in 16 22 24 32 48 64 128 256; do
		DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
		mkdir -p "$DIR"
		#  « -background none » et le centrage : le dessin n'est pas carré
		#  (599x720). Sans ça, convert l'écraserait pour le rendre carré et
		#  la mascotte serait aplatie.
		convert "$BRAND/icon-applications.png" -background none \
			-resize "${SIZE}x${SIZE}" -gravity center \
			-extent "${SIZE}x${SIZE}" "$DIR/lexos-applications.png" \
			&& echo "[lexos]   -> $DIR/lexos-applications.png"
	done
fi

#  Icône GitHub — source déjà en PNG (pas de version vectorielle), redimensionnée
#  directement plutôt que passée par render() qui suppose un SVG en entrée.
if [ -r "$BRAND/icon-github.png" ] && have convert; then
	for SIZE in 16 22 24 32 48 64 128 256; do
		DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
		mkdir -p "$DIR"
		convert "$BRAND/icon-github.png" -resize "${SIZE}x${SIZE}" "$DIR/lexos-github.png" \
			&& echo "[lexos]   -> $DIR/lexos-github.png"
	done
fi

#  Studio+ LexOS porte le logo de marque TI-LEX-AL, pas une icône à part :
#  c'est l'atelier maison, il s'annonce sous l'enseigne. On recopie donc
#  lexos.png déjà rendu plus haut, à chaque taille, sous le nom attendu par
#  lexos-studio.desktop.
for SIZE in 16 22 24 32 48 64 128 256; do
	DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
	[ -r "$DIR/lexos.png" ] && cp "$DIR/lexos.png" "$DIR/lexos-studio.png"
done

if [ -n "$LOGO_SRC" ]; then
	case "$LOGO_SRC" in
		*.png) cp "$LOGO_SRC" /usr/share/pixmaps/lexos.png ;;
		*.svg) render "$LOGO_SRC" 256 256 /usr/share/pixmaps/lexos.png ;;
	esac
fi

have gtk-update-icon-cache && \
	gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true

# --- Avatar de session (mascotte) -------------------------------------------
FACE=""
for CAND in "$BRAND/mascot.png" "$BRAND/mascot-portrait.png" "$BRAND/mascot-rock.png"; do
	[ -r "$CAND" ] && { FACE="$CAND"; break; }
done

if [ -n "$FACE" ]; then
	mkdir -p /usr/share/lexos/faces /var/lib/AccountsService/icons /etc/skel
	cp "$FACE" /usr/share/lexos/faces/lexos.png
	cp "$FACE" /etc/skel/.face
	cp "$FACE" /var/lib/AccountsService/icons/lex
	echo "[lexos]   avatar : $FACE"
fi

# --- Thème Plymouth ----------------------------------------------------------
#  ═══ CE QUE CET ÉCRAN MONTRE, ET POURQUOI IL A CHANGÉ ═══
#  Jusqu'à l'ISO 110 : la mascotte s'agitait en 16 images de 240×240, et une
#  barre orange dessous. Deux problèmes, tous deux visibles à l'écran :
#
#    · 240×240 sur un 1920×1080, c'est un timbre-poste, et l'agrandissement
#      des 16 images les rendait floues. On ne distinguait ni le masque, ni
#      les lunettes, ni le geste de la main.
#    · DEUX ANIMATIONS EN MÊME TEMPS, L'ŒIL NE SAIT PLUS OÙ REGARDER. Le
#      mouvement de cet écran, c'est maintenant le logo qui s'écrit ; la
#      mascotte est ce qu'on regarde pendant ce temps-là. Elle ne bouge donc
#      plus, et elle passe à 449×540.
#
#  LES 16 IMAGES RESTENT DANS branding/ — ON NE LES EFFACE PAS. Elles servent
#  ailleurs : mascot-anim-web.gif et mascot-anim.gif sont montés à partir
#  d'elles pour le site. Elles ne sont simplement plus copiées dans le thème
#  Plymouth. Écrit ici pour que personne ne les recâble dans six mois en
#  croyant réparer un oubli.
#  ═══ LES TROIS CHEMINS SONT SURCHARGEABLES, ET C'EST POUR LE BANC ═══
#  Pas pour qu'on les change en production : pour que cette section soit
#  ÉPROUVABLE ailleurs que dans une vraie construction. Le banc découpe le
#  fragment entre les deux marqueurs ci-dessous et le fait tourner sur un
#  faux thème « spinner », un faux dossier de marque et un faux ImageMagick.
#  Sans ça, la seule façon de savoir si l'écran de démarrage se génère serait
#  de graver une clé et de redémarrer — le pire cycle de retour du dépôt.
# >>> banc: plymouth
PLY_SRC="${LEXOS_PLYMOUTH_SRC:-/usr/share/plymouth/themes/spinner}"
PLY_DST="${LEXOS_PLYMOUTH_DST:-/usr/share/plymouth/themes/lexos}"
PLY_MASCOTTE="$BRAND/mascotte-splash.png"

#  ═══ LA PLUIE MATRIX ═══
#  Une couche RGBA 1920×1080 : des colonnes de katakana et de chiffres en
#  vert #1F9E3D, très peu opaques (42 sur 255 pour la traînée, 88 pour le
#  caractère de tête), avec un trou en fondu derrière la mascotte et derrière
#  le logo pour que rien ne devienne illisible.
#
#  ELLE NE BOUGE PAS, ET C'EST UN CHOIX. Animer une pluie de 1920×1080 dans
#  Plymouth demanderait des dizaines d'images pleine résolution DANS
#  L'INITRAMFS — on ralentirait le démarrage pour un effet que personne ne
#  regarde plus de deux secondes. C'est un instantané figé.
#
#  ET ELLE EST FACULTATIVE. Une décoration ne doit jamais pouvoir casser
#  l'écran de démarrage : si l'image manque, le thème se construit SANS elle
#  et le journal le dit. Le banc l'éprouve en la retirant pour de vrai.
#
#  tools/faire-pluie.py sait la refabriquer à une autre résolution ou avec un
#  autre dosage. On ne l'appelle PAS d'ici : Python et Pillow n'ont pas à
#  devenir des dépendances de construction pour une décoration. L'image est
#  dans le dépôt, ça suffit.
PLY_PLUIE="$BRAND/pluie-demarrage.png"

#  ═══ L'ENTRÉE EN MATIÈRE — LA VIDÉO, EN IMAGES ═══
#  ALEX : voir sa vidéo « tout de suite après Lenovo ». GRUB ne sait animer
#  qu'une image fixe (voir hook 0100), et Plymouth (le module "script")
#  n'anime que des suites d'images — pas de vidéo. ouvrir-ordinateur.mp4 est
#  donc découpé, À LA CONSTRUCTION, en une suite de PNG fixes, embarqués
#  dans le thème comme la mascotte ou les lettres.
#
#  LE FORMAT EST UN BUDGET, PAS UN GOÛT. L'initramfs est décompressé en
#  MÉMOIRE À CHAQUE DÉMARRAGE : chaque image ajoutée est payée à chaque
#  démarrage, pas une fois pour toutes — exactement ce que ce dépôt vient de
#  corriger en coupant 106 secondes. Mesuré sur ce fichier (10,5 s,
#  1920×1080), pour une coupe de 3,5 s à 15 im/s (53 images) : 33 Mo en
#  1280×720 ; 20 Mo en 960×540, 6,5 Mo à 128 couleurs ; 9,8 Mo en 640×360,
#  3,5 à 4,3 Mo à 128 couleurs — SANS différence visible sur un splash qui
#  ne dure que 3,5 s. On reste sur 640×360 : au-delà de 960×540/128
#  couleurs, on rallonge le démarrage, et on paierait l'animation deux fois
#  — une fois à la regarder, une fois à la charger.
PLY_INTRO_SRC="$BRAND/ouvrir-ordinateur.mp4"
PLY_INTRO_DUREE=5       # secondes de vidéo montrées
PLY_INTRO_FPS=15
#  ═══ PLEIN ÉCRAN — ALEX : « qu'on voie l'animation en tout son écran » ═══
#  C'était 640×360, dessiné AU CENTRE d'un écran de 1920×1080 : un timbre-
#  poste au milieu du noir. Le commentaire d'alors l'assumait — « l'image
#  n'est PAS étirée » — pour ne pas payer ~50 ms d'étirement par image à
#  l'exécution. Cette raison-là tient toujours : on n'étire pas. On DÉCOUPE
#  DIRECTEMENT À LA TAILLE DE L'ÉCRAN, à la construction, une fois pour
#  toutes.
#
#  CE QUE ÇA COÛTE, MESURÉ ICI (mêmes filtres, compression zstd de
#  l'initramfs, décompression chronométrée trois fois) :
#      640×360,  3,5 s          →  3,4 Mo,  7 ms
#      960×540,  5 s            →  7,4 Mo, 11 ms
#      1920×1080, 5 s, 128 c    → 20,3 Mo, 20 ms
#  TREIZE MILLISECONDES de plus au démarrage. La crainte inscrite ici —
#  « au-delà de 960×540 on rallonge le démarrage » — était une estimation ;
#  la mesure la chiffre, et elle est négligeable. Ce qui se paie vraiment,
#  c'est 17 Mo d'ISO et de mémoire pendant l'amorçage. Sur la seule image
#  que LexOS construit — « pro » —, c'est un prix qu'on accepte pour que le
#  logo d'Alex remplisse l'écran au lieu d'en occuper un neuvième.
PLY_INTRO_LARGEUR=1920
PLY_INTRO_HAUTEUR=1080
#  ═══ ET LA DURÉE : 3,5 s COUPAIT JUSTE AVANT LA CHUTE ═══
#  Relevé image par image sur la vidéo : à 0,5 s une lueur, à 1,5 s le
#  blason, et « LEXOS » ne commence à apparaître qu'à 3,5 s — exactement là
#  où l'ancienne coupe s'arrêtait. On voyait donc le logo se former sans
#  jamais voir le mot. Cinq secondes le montrent en entier.
PLY_INTRO_N=0           # DÉRIVÉ de ce que ffmpeg produit — voir plus bas

#  Les cinq lettres du logo, déjà détourées et déjà agrandies ×2 en PLUS
#  PROCHE VOISIN par Alex. ON NE LES RÉÉCHANTILLONNE PAS : le logo est du
#  pixel carré, et n'importe quel agrandissement lissé lui ferait perdre son
#  air d'écran cathodique. Elles sont copiées telles quelles, jamais passées
#  dans convert.
#  ON RELÈVE LES MANQUES NOMMÉMENT, PAS SEULEMENT « IL EN MANQUE UN ».
#  Le repli d'origine disait « lettres ou mascotte absentes, ou convert
#  manquant » — trois causes possibles, aucune désignée, noyées dans mille
#  lignes de journal de construction. Alex a gravé une ISO, redémarré, et
#  découvert le problème À L'ÉCRAN. Une demi-journée pour une information que
#  la construction avait sous la main.
PLY_LETTRES_OK=1
PLY_MANQUANTS=""
for I in 0 1 2 3 4; do
	if [ ! -r "$BRAND/lexos-lettre-$I.png" ]; then
		PLY_LETTRES_OK=0
		PLY_MANQUANTS="$PLY_MANQUANTS lexos-lettre-$I.png"
	fi
done
if [ ! -r "$PLY_MASCOTTE" ]; then
	PLY_LETTRES_OK=0
	PLY_MANQUANTS="$PLY_MANQUANTS mascotte-splash.png"
fi

if [ -d "$PLY_SRC" ]; then
	rm -rf "$PLY_DST"
	cp -a "$PLY_SRC" "$PLY_DST"
	rm -f "$PLY_DST/spinner.plymouth"

	#  Le filigrane sert AU REPLI STATIQUE, où il est la seule image affichée.
	#  S'il manque, cet écran de secours est entièrement vide — ça se dit.
	if [ -n "$LOGO_SRC" ] && have convert; then
		convert "$LOGO_SRC" -resize 200x200 "$PLY_DST/watermark.png" 2>/dev/null \
			|| echo "[lexos]   !! filigrane non fabriqué — le repli statique serait vide"
	elif [ -n "$LOGO_SRC" ]; then
		echo "[lexos]   !! convert absent : pas de filigrane — le repli statique serait vide"
	fi

	#  ═══ LES LETTRES NE DÉPENDENT PAS D'IMAGEMAGICK, ET C'ÉTAIT LE BOGUE ═══
	#  Cette condition était « [ "$PLY_LETTRES_OK" = 1 ] && have convert ».
	#  Or les lettres et la mascotte sont posées par cp : elles n'ont AUCUN
	#  besoin de convert. Seules les deux images d'un pixel de la barre en ont
	#  un. Et imagemagick n'est pas au socle — il ne vit que dans trois listes
	#  facultatives (00-core, 45-capture, 46-studio), que le hook 0250 pose en
	#  tolérant l'échec, à dessein. Un miroir qui hoquète ce jour-là, et TOUT
	#  l'écran animé retombait sur la version statique : ni mascotte, ni LEXOS.
	#  Les deux conditions sont donc séparées, et la barre — la seule qui a
	#  vraiment besoin de convert — devient facultative comme la pluie.
	if [ "$PLY_LETTRES_OK" = 1 ]; then
		# --- Mascotte fixe + logo qui s'écrit lettre par lettre -------------
		cp "$PLY_MASCOTTE" "$PLY_DST/mascotte-splash.png"
		for I in 0 1 2 3 4; do
			cp "$BRAND/lexos-lettre-$I.png" "$PLY_DST/lexos-lettre-$I.png"
		done

		#  ═══ LA BARRE EST VERTE, ET ELLE LE RESTE ═══
		#  #1F9E3D, le vert choisi par Alex. Le fond gris #1A1A1C ne change
		#  pas.
		#
		#  ET ELLE NE SUIT PAS L'ACCENT — VÉRIFIÉ, PAS SUPPOSÉ. #E8590C est
		#  l'accent orange de LexOS, et il est remplacé par sed à trois
		#  endroits : le squelette du panneau (gtk-panneau.css) et les icônes
		#  SVG dans lexos-theme-gen, la feuille de l'écran de connexion dans
		#  le hook 0600. AUCUN de ces trois chemins ne touche
		#  /usr/share/plymouth/themes/ — lexos-theme-gen ne nomme même pas
		#  Plymouth. La barre de démarrage est donc hors du périmètre de la
		#  substitution par construction, et « lexos accent bleu » la laisse
		#  verte. Le banc tests/test_lexos_plymouth.sh le MESURE en lançant
		#  le générateur avec un accent non-orange.
		#
		#  ELLE EST FACULTATIVE, comme la pluie. Deux images d'un pixel ne
		#  valent pas de faire retomber tout l'écran de démarrage.
		if have convert; then
			convert -size 1x1 xc:'#1A1A1C' "$PLY_DST/progress-bg.png" || true
			convert -size 1x1 xc:'#1F9E3D' "$PLY_DST/progress-fg.png" || true
		fi
		if [ ! -r "$PLY_DST/progress-bg.png" ] || [ ! -r "$PLY_DST/progress-fg.png" ]; then
			rm -f "$PLY_DST/progress-bg.png" "$PLY_DST/progress-fg.png"
			echo "[lexos]   !! ═══════════════════════════════════════════════════════════"
			echo "[lexos]   !! ImageMagick (convert) absent — écran de démarrage SANS barre"
			echo "[lexos]   !! de progression. La mascotte et le logo LEXOS s'affichent."
			echo "[lexos]   !! Pour la retrouver : imagemagick doit être installé au moment"
			echo "[lexos]   !! du hook 0300 (il est dans 00-core.list, posé par le hook 0250"
			echo "[lexos]   !! qui TOLÈRE un paquet absent)."
			echo "[lexos]   !! ═══════════════════════════════════════════════════════════"
		fi

		#  ═══ L'EXTINCTION — LES DEUX IMAGES DE LA VIEILLE TÉLÉ ═══
		#  ALEX : à l'arrêt, l'écran s'écrase en une ligne blanche comme un
		#  vieux téléviseur, puis noir, puis LEXOS. Deux images pour ça :
		#    · blanc.png — UN pixel blanc, étiré par Image.Scale à la taille
		#      voulue à chaque rafraîchissement (le procédé de la barre) ;
		#    · bye-bye.png — les cinq lettres COMPOSÉES en une seule image,
		#      aux décalages mesurés du logo (0/102/202/304/418), pour un seul
		#      Sprite à faire apparaître. -page/-layers merge calcule la toile
		#      d'après les lettres : rien n'est écrit en dur, et si une lettre
		#      change de taille, l'image suit. Vérifié pixel par pixel contre
		#      une composition Pillow dans tests/test_lexos_plymouth.sh.
		#  FACULTATIVES, comme la barre : sans convert, l'extinction est un
		#  écran noir — et ça se dit en « !! ». Le script produit ne cite
		#  jamais une image qui n'existe pas.
		#  LE CODE DE RETOUR DE CONVERT N'EST PAS JETÉ. Revue adversariale,
		#  reproduit : une lettre CORROMPUE dans branding fait échouer convert
		#  (rc 1) qui écrit QUAND MÊME une bye-bye.png — complète en taille,
		#  sans le O. Avec « 2>/dev/null || true » et un simple « -s », cette
		#  image fausse partait dans l'ISO sans un mot. On garde stderr (la
		#  seule piste utile), et un échec RETIRE le fichier en nommant la
		#  cause.
		if have convert; then
			convert -size 1x1 xc:'#FFFFFF' "PNG32:$PLY_DST/blanc.png" \
				|| { rm -f "$PLY_DST/blanc.png"; echo "[lexos]   !! blanc.png : convert a échoué (message ci-dessus)"; }
			convert -background none \
				-page +0+0   "$PLY_DST/lexos-lettre-0.png" \
				-page +102+0 "$PLY_DST/lexos-lettre-1.png" \
				-page +202+0 "$PLY_DST/lexos-lettre-2.png" \
				-page +304+0 "$PLY_DST/lexos-lettre-3.png" \
				-page +418+0 "$PLY_DST/lexos-lettre-4.png" \
				-layers merge +repage "PNG32:$PLY_DST/bye-bye.png" \
				|| { rm -f "$PLY_DST/bye-bye.png"; echo "[lexos]   !! bye-bye.png : convert a échoué (message ci-dessus)"; }
		else
			echo "[lexos]   !! convert absent : pas d'animation « vieille télé » à l'arrêt."
		fi
		if [ ! -s "$PLY_DST/blanc.png" ] || [ ! -s "$PLY_DST/bye-bye.png" ]; then
			for F in blanc.png bye-bye.png; do
				[ -s "$PLY_DST/$F" ] || echo "[lexos]   !! $F non fabriquée : extinction SANS animation « vieille télé »"
			done
			rm -f "$PLY_DST/blanc.png" "$PLY_DST/bye-bye.png"
			echo "[lexos]   !! (écran noir jusqu'à l'arrêt ; le démarrage n'est pas touché)."
			echo "[lexos]   !! Pour la retrouver : imagemagick au moment du hook 0300 (00-core.list,"
			echo "[lexos]   !! posé par le hook 0250 qui tolère un paquet absent)."
		fi

		#  ═══ L'ENTRÉE EN MATIÈRE EST FACULTATIVE, ELLE AUSSI ═══
		#  Sans ffmpeg ou sans le fichier, le splash retombe SANS RIEN DE
		#  PERDU : la mascotte, les lettres et la pluie s'affichent comme
		#  avant, immédiatement. Ce n'est pas une dégradation qui casse
		#  l'écran de démarrage — c'est l'écran de démarrage TEL QU'IL ÉTAIT
		#  avant cette consigne.
		PLY_INTRO_OK=0
		if [ -r "$PLY_INTRO_SRC" ] && have ffmpeg; then
			rm -f "$PLY_DST"/intro-*.png
			#  ═══ LE FILTRE, EXPLIQUÉ ═══
			#  fps=15,scale=640:360 (lanczos) : le format retenu ci-dessus.
			#  split + palettegen/paletteuse à 128 couleurs : la RÉDUCTION DE
			#  PALETTE qui fait tenir 53 images dans quelques mégaoctets — le
			#  principe d'un GIF bien fait, pas une perte à la JPEG.
			#  « dither=none » : sur un splash de 3,5 s, le grain d'un tramage
			#  se verrait plus que la nuance qu'il est censé cacher.
			#  -pix_fmt pal8 : force le PNG à écrire UN OCTET PAR PIXEL (la
			#  palette à part) plutôt que trois — sans lui, palettegen ne
			#  ferait que CHOISIR les couleurs, le PNG resterait encodé en
			#  24 bits et ne pèserait pas moins lourd pour autant.
			PLY_INTRO_ERR="$(ffmpeg -y -loglevel error -i "$PLY_INTRO_SRC" \
				-t "$PLY_INTRO_DUREE" -vf "fps=${PLY_INTRO_FPS},scale=${PLY_INTRO_LARGEUR}:${PLY_INTRO_HAUTEUR}:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=128:stats_mode=full[p];[s1][p]paletteuse=dither=none" \
				-start_number 0 -pred mixed \
				"$PLY_DST/intro-%04d.png" </dev/null 2>&1 >/dev/null)"
			#  ═══ ON COMPTE CE QUI EST VRAIMENT SORTI, PAS CE QU'ON A DEMANDÉ ═══
			#  « -frames:v » est un plafond, pas une garantie : ffmpeg peut
			#  rendre 0 tout en écrivant MOINS d'images (filtre refusé sur
			#  cette version, source trop courte). Le script Plymouth compte
			#  sur EXACTEMENT $PLY_INTRO_N images, numérotées sans trou : un
			#  compte différent, et l'entrée en matière n'entre pas dans le
			#  script — jamais une séquence à moitié écrite.
			#  ═══ ON PREND LE COMPTE QUE FFMPEG A RENDU, ON NE L'EXIGE PLUS ═══
			#  CE QUE ÇA FAISAIT AVANT : le hook réclamait EXACTEMENT 53
			#  images ; à 52, il effaçait tout et l'ISO partait sans animation,
			#  avec pour seule trace une ligne dans une heure de journal.
			#  Or ce compte dépend de la vidéo SOURCE : la même commande rend
			#  53 images sur l'ancienne et 52 sur celle qu'Alex vient
			#  d'envoyer — l'horodatage de la première image ne tombe pas au
			#  même endroit. Autrement dit : déposer une nouvelle vidéo
			#  supprimait l'animation, en silence.
			#  On compte donc ce qui est SORTI, et le script Plymouth reçoit
			#  ce nombre-là. Un plancher reste : sous une seconde d'images,
			#  ce n'est pas une entrée en matière, c'est un accident.
			PLY_INTRO_VUES="$(ls "$PLY_DST"/intro-*.png 2>/dev/null | wc -l)"
			PLY_INTRO_MIN="$PLY_INTRO_FPS"
			PLY_INTRO_N="$PLY_INTRO_VUES"
			if [ "$PLY_INTRO_VUES" -ge "$PLY_INTRO_MIN" ]; then
				PLY_INTRO_OK=1
				echo "[lexos]   entrée en matière : ouvrir-ordinateur.mp4 découpée en ${PLY_INTRO_N} images (${PLY_INTRO_LARGEUR}x${PLY_INTRO_HAUTEUR}, 128 couleurs, ${PLY_INTRO_DUREE} s) — PLEIN ÉCRAN"
				#  LA VIDÉO NE RESTE PAS DANS L'ISO. C'est une source de
				#  construction : une fois découpée, elle ne sert plus à
				#  rien sur la machine, et 7 Mo dans l'image, c'est 7 Mo
				#  sur chaque clé USB et chaque disque installé.
				#
				#  ═══ ET ON NE L'EFFACE QUE LÀ OÙ ELLE EST UNE COPIE ═══
				#  Le banc joue ce fragment AVEC LE VRAI DOSSIER branding/
				#  DU DÉPÔT dans plusieurs passages (section 5 bis, section
				#  10) : sans cette garde, éprouver l'écran de démarrage
				#  SUPPRIMERAIT la vidéo source du dépôt. On ne retire donc
				#  que l'exemplaire du chroot, à son chemin de production.
				if [ "$PLY_INTRO_SRC" = "/usr/share/lexos/branding/ouvrir-ordinateur.mp4" ]; then
					rm -f "$PLY_INTRO_SRC"
				fi
			else
				rm -f "$PLY_DST"/intro-*.png
				echo "[lexos]   !! entrée en matière : ffmpeg n'a produit que ${PLY_INTRO_VUES} image(s), moins d'une seconde — écran de"
				echo "[lexos]   !! démarrage SANS la vidéo d'ouverture (mascotte + LEXOS + pluie"
				echo "[lexos]   !! s'affichent comme avant). Message de ffmpeg : ${PLY_INTRO_ERR}"
			fi
		elif [ -r "$PLY_INTRO_SRC" ]; then
			echo "[lexos]   !! ffmpeg absent : pas d'entrée en matière — écran de démarrage SANS"
			echo "[lexos]   !! ouvrir-ordinateur.mp4. mascotte + LEXOS + pluie s'affichent comme"
			echo "[lexos]   !! avant, immédiatement."
		else
			echo "[lexos]   pas d'entrée en matière : branding/ouvrir-ordinateur.mp4 absent — Alex"
			echo "[lexos]   ne l'a pas encore déposé dans le dépôt."
		fi

		if [ -r "$PLY_PLUIE" ]; then
			cp "$PLY_PLUIE" "$PLY_DST/pluie-demarrage.png"
			echo "[lexos]   pluie Matrix : posée en fond de l'écran de démarrage"
		else
			echo "[lexos]   !! pluie-demarrage.png absente de $BRAND — écran de"
			echo "[lexos]   !! démarrage SANS la pluie de fond. Décoration : le reste"
			echo "[lexos]   !! s'affiche. tools/faire-pluie.py sait la refabriquer."
		fi

		{
		cat <<'SCRIPT_TETE'
// LexOS — thème Plymouth : mascotte fixe, logo qui s'écrit lettre par lettre.
// Généré par config/hooks/normal/0300-lexos-assets.hook.chroot — ne pas éditer à la main.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

// ═══ LES RÉGLAGES, TOUS ICI ═══
// SI L'ANIMATION SE FAIT COUPER — sur un SSD rapide, Plymouth peut
// disparaître avant que le S soit arrivé : l'entrée complète dure
// glisse + 4 × retard, soit environ 1.06 s. Descendre à 0.30 et 0.10
// ramène le total à 0.70 s. Ce sont les deux seules valeurs à toucher.
glisse_duree = 0.42;    // temps de trajet d'UNE lettre
lettre_retard = 0.16;   // décalage de départ entre deux lettres

// ═══ D'OÙ VIENT LE TEMPS — ET POURQUOI PAS D'UNE HORLOGE ═══
// LE MODULE « script » DE PLYMOUTH N'A AUCUNE FONCTION DE TEMPS. Aucune.
// La table complète des fonctions exposées par script.so tient en dix
// noms — GetBitsPerPixel, GetCapslockState, GetHeight, GetImage,
// GetMode, GetOpacity, GetWidth, GetX, GetY, GetZ — et « GetTime » ne
// figure dans AUCUN binaire de Plymouth.
//
// Ce fichier appelait « Plymouth.GetTime() ». L'interpréteur ne bronche
// pas sur une fonction inconnue : il rend une valeur nulle. Le temps
// écoulé restait donc nul, les cinq lettres gardaient l'opacité 0 hors
// écran, et l'écran de démarrage montrait la mascotte — fixe, elle — SANS
// le logo. C'est exactement ce qu'on voyait sur l'ISO 112.
//
// La seule horloge disponible est la CADENCE DE RAFRAÎCHISSEMENT, qu'on
// impose ici au lieu de la deviner. Si Plymouth servait malgré tout une
// autre cadence, l'animation irait plus ou moins vite — mais elle irait :
// « t » est borné à 1, donc les lettres finissent en place dans tous les
// cas. C'est le point : plus aucun chemin ne laisse l'écran sans logo.
cadence = 50;           // rafraîchissements par seconde, imposés ci-dessous
barre_largeur_ratio = 0.26;
barre_hauteur = 6;
barre_y_ratio = 0.88;
mascotte_centre_y = 0.36;   // le CENTRE de la mascotte, en fraction de hauteur
logo_haut_y = 0.69;         // le HAUT du logo, en fraction de hauteur

// Décalages horizontaux des lettres, mesurés sur le logo d'origine.
// La dernière commence à 418 et fait 100 de large : 518 en tout.
lettre_dx[0] = 0;
lettre_dx[1] = 102;
lettre_dx[2] = 202;
lettre_dx[3] = 304;
lettre_dx[4] = 418;
logo_largeur = 518;

// ═══ L'EXTINCTION — LA VIEILLE TÉLÉ, RÉGLAGES ═══
// À l'arrêt et au redémarrage, Plymouth est relancé par systemd
// (plymouth-poweroff.service / plymouth-reboot.service, conditionnés par
// « splash » sur la ligne noyau) et ce même script tourne, avec
// Plymouth.GetMode() qui répond « shutdown » ou « reboot ». Quatre temps,
// 2,0 s en tout — l'arrêt d'un SSD peut être plus court, et l'animation
// est alors coupée : c'est admis, elle ne retarde rien.
tele_ecrasement_duree = 0.35;   // l'écran blanc s'écrase en une ligne
tele_point_duree      = 0.20;   // la ligne se resserre en un point
tele_noir_duree       = 1.00;   // noir complet
tele_adieu_duree      = 0.45;   // LEXOS apparaît (bye-bye.png), et reste
tele_ligne_hauteur    = 4;      // épaisseur de la ligne, en pixels

// « || », « && », « else if » et « return » EXISTENT dans le module script —
// lus dans la table des symboles de script.so et sondés dans l'interpréteur
// (revue adversariale). Deux « if » restent ici par lisibilité, pas par
// prudence : chaque ligne se lit seule.
extinction = 0;
mode = Plymouth.GetMode();
if (mode == "shutdown") {
    extinction = 1;
}
if (mode == "reboot") {
    extinction = 1;
}

// ═══ L'ENTRÉE EN MATIÈRE — RÉGLAGES ═══
// CES QUATRE NOMBRES NE SONT PLUS ÉCRITS À LA MAIN. Ils étaient recopiés
// ici ET dans le hook, et un banc comparait les deux copies pour qu'elles ne
// divergent pas. Une copie qu'un banc surveille reste une copie : le hook
// les ÉCRIT maintenant, depuis ses propres variables, au moment où il
// fabrique les images. Il ne peut donc plus y avoir de désaccord — et
// intro_n vaut exactement le nombre d'images que ffmpeg a rendues, pas
// celui qu'on espérait.
SCRIPT_TETE
		printf 'intro_n = %d;             // images (%s s a %s im/s)\n' \
			"$PLY_INTRO_N" "$PLY_INTRO_DUREE" "$PLY_INTRO_FPS"
		printf 'intro_fps = %d;\n'      "$PLY_INTRO_FPS"
		printf 'intro_largeur = %d;\n'  "$PLY_INTRO_LARGEUR"
		printf 'intro_hauteur = %d;\n'  "$PLY_INTRO_HAUTEUR"
		cat <<'SCRIPT_TETE_SUITE'
// LES DEUX VALEURS PAR DÉFAUT DISENT « PAS D'ENTRÉE EN MATIÈRE ». Sans les
// images, rien plus bas ne les change, et refresh_callback saute droit au
// logo — l'écran de démarrage TEL QU'IL ÉTAIT avant cette consigne.
intro_ok = 0;
intro_termine = 1;
// L'horloge du logo repart de zéro à la fin de l'entrée en matière : sans
// ce décalage, les lettres arriveraient déjà à mi-course.
intro_decalage = 0;

SCRIPT_TETE_SUITE

		#  La pluie n'entre dans le script QUE si son image a été posée.
		#  Écrire « Image("pluie-demarrage.png") » sans le fichier laisserait
		#  Plymouth avec une image nulle et un Sprite qui n'affiche rien — au
		#  mieux. On ne parie pas : on n'écrit la ligne que si elle a un sens.
		if [ -r "$PLY_DST/pluie-demarrage.png" ]; then
			cat <<'SCRIPT_PLUIE'
// --- La pluie Matrix, tout au fond ------------------------------------------
// SetZ(1) : sous la mascotte (10), sous les lettres (15), sous la barre (20).
// Étirée à la fenêtre — c'est un fond, une légère déformation ne se voit pas,
// contrairement aux lettres, qui gardent leur taille native.
pluie_image = Image("pluie-demarrage.png");
pluie_sprite = Sprite();
pluie_sprite.SetImage(pluie_image.Scale(Window.GetWidth(), Window.GetHeight()));
pluie_sprite.SetX(0);
pluie_sprite.SetY(0);
pluie_sprite.SetZ(1);
pluie_sprite.SetOpacity(1);
if (extinction == 1) {
    pluie_sprite.SetOpacity(0);
}
SCRIPT_PLUIE
		else
			printf '// pluie-demarrage.png absente a la construction : pas de couche de pluie.\n'
		fi

		cat <<'SCRIPT_CORPS'
// --- La mascotte, fixe ------------------------------------------------------
mascotte_image = Image("mascotte-splash.png");
mascotte_sprite = Sprite();
mascotte_sprite.SetImage(mascotte_image);
mascotte_sprite.SetX(Window.GetWidth() / 2 - mascotte_image.GetWidth() / 2);
mascotte_sprite.SetY(Window.GetHeight() * mascotte_centre_y - mascotte_image.GetHeight() / 2);
mascotte_sprite.SetZ(10);
mascotte_sprite.SetOpacity(1);
if (extinction == 1) {
    mascotte_sprite.SetOpacity(0);
}

// --- Les cinq lettres -------------------------------------------------------
// Chacune est son propre Sprite : elles n'arrivent pas en même temps.
logo_x = Window.GetWidth() / 2 - logo_largeur / 2;
logo_y = Window.GetHeight() * logo_haut_y;
depart_x = Window.GetWidth() + 80;   // hors écran, à droite

lettre_image[0] = Image("lexos-lettre-0.png");
lettre_image[1] = Image("lexos-lettre-1.png");
lettre_image[2] = Image("lexos-lettre-2.png");
lettre_image[3] = Image("lexos-lettre-3.png");
lettre_image[4] = Image("lexos-lettre-4.png");

lettre_sprite[0] = Sprite();
lettre_sprite[1] = Sprite();
lettre_sprite[2] = Sprite();
lettre_sprite[3] = Sprite();
lettre_sprite[4] = Sprite();

fun preparer_lettre(i) {
    lettre_sprite[i].SetImage(lettre_image[i]);
    lettre_sprite[i].SetX(depart_x);
    lettre_sprite[i].SetY(logo_y);
    lettre_sprite[i].SetZ(15);
    lettre_sprite[i].SetOpacity(0);
}

preparer_lettre(0);
preparer_lettre(1);
preparer_lettre(2);
preparer_lettre(3);
preparer_lettre(4);

Plymouth.SetRefreshRate(cadence);
rafraichissements = 0;

// Place UNE lettre selon le temps écoulé.
//
// LA COURBE EST CUBIQUE, ET C'EST TOUT L'EFFET : p = 1 - (1-t)^3. La lettre
// part vite et se pose en douceur. Une interpolation linéaire (p = t)
// donnerait un mouvement de robot avec un arrêt net à l'arrivée — c'est
// exactement ce qu'Alex ne voulait pas.
//
// L'OPACITÉ MONTE PENDANT LE PREMIER TIERS DU TRAJET. Sans ça, la lettre
// surgit d'un coup au bord de l'écran : ça se voit, et ça fait sale.
fun placer_lettre(i, ecoule) {
    t = (ecoule - i * lettre_retard) / glisse_duree;
    if (t < 0) {
        t = 0;
    }
    if (t > 1) {
        t = 1;
    }

    reste = 1 - t;
    p = 1 - reste * reste * reste;

    cible = logo_x + lettre_dx[i];
    lettre_sprite[i].SetX(depart_x + (cible - depart_x) * p);

    opacite = p * 2.2;
    if (opacite > 1) {
        opacite = 1;
    }
    lettre_sprite[i].SetOpacity(opacite);
}
SCRIPT_CORPS

		#  ═══ L'ENTRÉE EN MATIÈRE N'ENTRE QUE SI SES IMAGES EXISTENT ═══
		#  Même règle que la pluie, la barre et l'extinction : jamais
		#  « Image("intro-0000.png") » sans le fichier. Ce bloc vient APRÈS
		#  celui de la mascotte : il la cache, et on ne cache que ce qui a
		#  déjà été créé.
		if [ "$PLY_INTRO_OK" = 1 ]; then
			cat <<'SCRIPT_INTRO_TETE'
// --- L'entrée en matière : la vidéo d'ouverture, en images ------------------
// ALEX : « je veux voir ma vidéo tout de suite après Lenovo ». Plymouth ne
// lit pas de vidéo ; ouvrir-ordinateur.mp4 est découpée à la construction
// (ffmpeg, hook 0300) en images fixes, chargées ICI, UNE SEULE FOIS.
// refresh_callback ne fera qu'échanger le Sprite vers une image DÉJÀ
// chargée : mesuré dans ce même script, redessiner une image pleine
// fenêtre coûte ~50 ms, soit deux rafraîchissements et demi perdus.
intro_ok = 1;
SCRIPT_INTRO_TETE
			#  Les 53 lignes sont ÉCRITES, pas bouclées dans le script : le
			#  module « script » a bien des tableaux, mais pas de boucle
			#  « for » — et une ligne par image se relit sans effort.
			I=0
			while [ "$I" -lt "$PLY_INTRO_N" ]; do
				printf 'intro_image[%d] = Image("intro-%04d.png");\n' "$I" "$I"
				I=$((I + 1))
			done
			cat <<'SCRIPT_INTRO_CORPS'
intro_sprite = Sprite();
intro_sprite.SetImage(intro_image[0]);
intro_sprite.SetX(Window.GetWidth() / 2 - intro_largeur / 2);
intro_sprite.SetY(Window.GetHeight() / 2 - intro_hauteur / 2);
// Au-dessus de la barre (20/21), des lettres (15), de la mascotte (10) et
// de la pluie (1). L'image n'est PAS étirée : 640×360 au centre d'un écran
// de 1920×1080, comme la mascotte garde sa taille native — étirer coûterait
// ~50 ms par image, et l'entrée en matière en a 53.
intro_sprite.SetZ(25);
intro_sprite.SetOpacity(0);

// ═══ RIEN DE TOUT ÇA À L'EXTINCTION ═══
// Sondé dans le vrai interpréteur : sans cette garde, le Sprite restait
// armé à l'opacité 1 pendant l'ARRÊT — refresh_callback n'appelle jamais
// placer_intro quand extinction vaut 1, donc la première image de la vidéo
// serait restée figée à l'écran, sous l'écrasement de la vieille télé.
// Une entrée en matière n'a de sens qu'au démarrage.
if (extinction == 0) {
    intro_sprite.SetOpacity(1);
    intro_termine = 0;

    // Le splash existant transparaîtrait AUTOUR de l'image, plus petite que
    // l'écran : on le cache le temps de l'entrée en matière.
    mascotte_sprite.SetOpacity(0);
    pluie_sprite.SetOpacity(0);
}

// L'INDICE VIENT DU TEMPS ÉCOULÉ, PAS D'UN COMPTE D'IMAGES. cadence (50)
// divisée par intro_fps (15) ne tombe pas juste : avancer d'une image tous
// les « 50/15 » rafraîchissements dériverait. Math.Int existe dans le
// module (table des symboles de script.so, sondé dans l'interpréteur) et
// tronque vers zéro — un floor() pour un temps toujours positif.
fun placer_intro(ecoule) {
    indice = Math.Int(ecoule * intro_fps);
    if (indice >= intro_n) {
        // LA MAIN PASSE AU SPLASH EXISTANT, PAS AU NOIR. La vidéo est une
        // entrée en matière : mascotte, LEXOS et pluie reprennent ensuite,
        // avec leur horloge remise à zéro (intro_decalage).
        intro_termine = 1;
        intro_decalage = ecoule;
        intro_sprite.SetOpacity(0);
        mascotte_sprite.SetOpacity(1);
        pluie_sprite.SetOpacity(1);
    } else {
        intro_sprite.SetImage(intro_image[indice]);
    }
}
SCRIPT_INTRO_CORPS
		else
			#  Le stub vide, même raison que placer_extinction plus bas :
			#  refresh_callback doit toujours avoir quelqu'un à appeler. Il
			#  n'est jamais appelé (intro_termine vaut 1 d'office), mais une
			#  fonction inconnue rend une valeur nulle SANS UN MOT — on ne
			#  laisse pas ce silence-là dans le chemin de secours.
			printf '// pas d entree en matiere : ouvrir-ordinateur.mp4 ou ffmpeg absents a la construction.\n'
			printf 'fun placer_intro(ecoule) {\n    ecoule = ecoule;\n}\n'
		fi

		#  ═══ L'EXTINCTION N'ENTRE DANS LE SCRIPT QUE SI SES IMAGES EXISTENT ═══
		#  Même règle que la pluie et la barre : jamais « Image("blanc.png") »
		#  sans le fichier. Sans les images, placer_extinction existe quand
		#  même — vide — pour que refresh_callback ait toujours quelqu'un à
		#  appeler : une fonction inconnue rend une valeur nulle sans un mot.
		if [ -r "$PLY_DST/blanc.png" ] && [ -r "$PLY_DST/bye-bye.png" ]; then
			cat <<'SCRIPT_TELE'

// --- L'extinction : la vieille télé ------------------------------------------
// Quatre temps, mesurés sur le compteur de rafraîchissements comme le reste :
//   1. ÉCRASEMENT — un rectangle blanc plein écran perd sa hauteur jusqu'à
//      n'être qu'une ligne, en courbe cubique (vite, puis doucement) ;
//   2. POINT — la ligne perd sa largeur jusqu'à un point ;
//   3. NOIR — plus rien ;
//   4. ADIEU — LEXOS (bye-bye.png) monte en opacité au centre, et reste.
// Un seul pixel blanc, étiré par Image.Scale (le procédé de la barre) — une
// fois —, puis découpé par Image.Crop à chaque passage.
tele_image = Image("blanc.png");
tele_sprite = Sprite();
tele_sprite.SetZ(30);
tele_sprite.SetOpacity(0);
// ÉTIRER UNE FOIS, DÉCOUPER ENSUITE. Mesuré dans le vrai interpréteur (revue
// adversariale) : Image.Scale d'un pixel vers 1920×1080 coûte ~50 ms par
// image, à 50 images par seconde — l'horloge, qui compte des images, se
// serait étirée pendant l'écrasement. Un plein écran blanc est étiré UNE
// fois (sous garde, pour ne rien payer au démarrage) et chaque image n'en
// prend qu'une découpe : ~5 ms. Image.Crop existe dans ce module.
if (extinction == 1) {
    tele_plein = tele_image.Scale(Window.GetWidth(), Window.GetHeight());
}

adieu_image = Image("bye-bye.png");
adieu_sprite = Sprite();
adieu_sprite.SetImage(adieu_image);
adieu_sprite.SetX(Window.GetWidth() / 2 - adieu_image.GetWidth() / 2);
adieu_sprite.SetY(Window.GetHeight() / 2 - adieu_image.GetHeight() / 2);
adieu_sprite.SetZ(40);
adieu_sprite.SetOpacity(0);

tele_fin_ecrasement = tele_ecrasement_duree;
tele_fin_point      = tele_fin_ecrasement + tele_point_duree;
tele_fin_noir       = tele_fin_point + tele_noir_duree;

// La phase se décide par des « if » successifs, du dernier temps au premier,
// sans « else if » ni « && » : rien n'est supposé du langage.
fun placer_extinction(ecoule) {
    largeur = Window.GetWidth();
    hauteur = Window.GetHeight();

    phase = 4;
    if (ecoule < tele_fin_noir) {
        phase = 3;
    }
    if (ecoule < tele_fin_point) {
        phase = 2;
    }
    if (ecoule < tele_fin_ecrasement) {
        phase = 1;
    }

    if (phase == 1) {
        t = ecoule / tele_ecrasement_duree;
        reste = 1 - t;
        h = tele_ligne_hauteur + (hauteur - tele_ligne_hauteur) * reste * reste * reste;
        tele_sprite.SetImage(tele_plein.Crop(0, 0, largeur, h));
        tele_sprite.SetX(0);
        tele_sprite.SetY(hauteur / 2 - h / 2);
        tele_sprite.SetOpacity(1);
    }
    if (phase == 2) {
        t = (ecoule - tele_fin_ecrasement) / tele_point_duree;
        reste = 1 - t;
        l = 2 + (largeur - 2) * reste * reste;
        tele_sprite.SetImage(tele_plein.Crop(0, 0, l, tele_ligne_hauteur));
        tele_sprite.SetX(largeur / 2 - l / 2);
        tele_sprite.SetY(hauteur / 2 - tele_ligne_hauteur / 2);
        tele_sprite.SetOpacity(1);
    }
    if (phase == 3) {
        tele_sprite.SetOpacity(0);
    }
    if (phase == 4) {
        tele_sprite.SetOpacity(0);
        t = (ecoule - tele_fin_noir) / tele_adieu_duree;
        if (t > 1) {
            t = 1;
        }
        adieu_sprite.SetOpacity(t);
    }
}
SCRIPT_TELE
		else
			cat <<'SCRIPT_TELE_SANS'

// --- L'extinction : blanc.png ou bye-bye.png absentes a la construction ------
// Pas d'animation « vieille tele » : ecran noir jusqu'a l'arret. La fonction
// existe quand meme, vide, pour que refresh_callback ne l'appelle pas dans le
// vide.
fun placer_extinction(ecoule) {
    ecoule = ecoule;
}
SCRIPT_TELE_SANS
		fi

		cat <<'SCRIPT_CORPS_FIN'

fun refresh_callback() {
    rafraichissements = rafraichissements + 1;
    ecoule = rafraichissements / cadence;

    if (extinction == 1) {
        placer_extinction(ecoule);
    } else {
        // intro_termine vaut 1 d'office quand il n'y a pas d'entrée en
        // matière : on tombe alors directement dans le second « if », avec
        // un décalage nul — exactement le comportement d'avant.
        if (intro_termine == 0) {
            placer_intro(ecoule);
        }
        if (intro_termine == 1) {
            logo_ecoule = ecoule - intro_decalage;
            placer_lettre(0, logo_ecoule);
            placer_lettre(1, logo_ecoule);
            placer_lettre(2, logo_ecoule);
            placer_lettre(3, logo_ecoule);
            placer_lettre(4, logo_ecoule);
        }
    }
}

// --- Les messages de systemd ne s'affichent JAMAIS -------------------------
// ALEX : « on ne voie pas les outils ouvrir quand il fait l'animation ».
// Ce script ne definissait AUCUNE SetMessageFunction. C'etait correct, mais
// c'etait un SILENCE, pas une decision : rien n'empeche une version de
// Plymouth de peindre elle-meme les messages que systemd lui envoie — dont
// le fameux « A start job is running for ... (1min 30s / no limit) » quand
// un service traine. Les fonctions existent donc, et elles ne dessinent
// rien : c'est la seule facon de garantir qu'aucune version ne les peindra.
//
// LES NOMS ONT ETE RELEVES DANS script.so, PAS RECOPIES. « SetMessage-
// Function » n'est PAS une fonction native du module : c'est un alias que le
// prelude declare (« Plymouth.SetMessageFunction = Plymouth.SetDisplay-
// MessageFunction; »). Les deux natives sont SetDisplayMessageFunction (on
// affiche) et SetHideMessageFunction (on efface) — et il faut LES DEUX, car
// le theme qui n'en pose qu'une laisse l'autre au comportement par defaut.
// C'est exactement le piege de « Plymouth.GetTime() », qui n'existait pas et
// qui a coute l'ISO 112 : l'interprete ne se plaint JAMAIS d'un nom inconnu.
//
// ON NE TOUCHE PAS A LA FONCTION DE MOT DE PASSE, et c'est important : si
// LexOS est installe chiffre (enableLuksAutomatedPartitioning dans
// partition.conf), c'est par elle qu'Alex tape sa phrase de passe au
// demarrage. Une seule chose est mise en sourdine ici : les MESSAGES.
fun message_callback(texte) {
    texte = texte;
}
Plymouth.SetDisplayMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(message_callback);

Plymouth.SetRefreshFunction(refresh_callback);
SCRIPT_CORPS_FIN

		#  ═══ LA BARRE N'ENTRE DANS LE SCRIPT QUE SI SES IMAGES EXISTENT ═══
		#  Même raisonnement que pour la pluie, quinze lignes plus haut :
		#  écrire « Image("progress-bg.png") » sans le fichier laisserait
		#  Plymouth avec une image nulle, et un Sprite qui n'affiche rien — au
		#  mieux. On n'écrit la ligne que si elle a un sens.
		if [ -r "$PLY_DST/progress-bg.png" ] && [ -r "$PLY_DST/progress-fg.png" ]; then
			cat <<'SCRIPT_BARRE'

// --- La barre de progression -------------------------------------------------
// Fond gris, remplissage VERT, redessinés par mise à l'échelle d'un pixel de
// couleur unie — le module "script" ne fournit pas de barre native comme
// "two-step". Ce n'est pas un contournement à simplifier : c'est le procédé.
//
// ELLE SUIT LE VRAI DÉMARRAGE. progress vient de Plymouth, pas d'une
// minuterie : une barre qui fait semblant d'avancer est un mensonge poli, et
// elle ment surtout le jour où le démarrage bloque.
progress_bg_image = Image("progress-bg.png");
progress_fg_image = Image("progress-fg.png");
progress_bg_sprite = Sprite();
progress_fg_sprite = Sprite();
progress_bg_sprite.SetImage(progress_bg_image);
progress_fg_sprite.SetImage(progress_fg_image);
progress_bg_sprite.SetZ(20);
progress_fg_sprite.SetZ(21);
// Un Sprite naît OPAQUE, en (0,0) — sondé dans le vrai interpréteur. À
// l'extinction, progress_callback ne le déplace jamais : sans ces deux
// lignes, un pixel vert sur un pixel gris resterait dessiné en haut à
// gauche pendant le noir et l'adieu.
if (extinction == 1) {
    progress_bg_sprite.SetOpacity(0);
    progress_fg_sprite.SetOpacity(0);
}

// À L'EXTINCTION, PAS DE BARRE : le corps entier est sous « if » (« return »
// existe aussi, mesuré ; le bloc évite un retour anticipé dans un rappel).
fun progress_callback(duration, progress) {
  if (extinction == 0) {
    bar_width = Window.GetWidth() * barre_largeur_ratio;
    bar_height = barre_hauteur;
    bar_x = Window.GetWidth() / 2 - bar_width / 2;
    bar_y = Window.GetHeight() * barre_y_ratio;

    progress_bg_sprite.SetImage(progress_bg_image.Scale(bar_width, bar_height));
    progress_bg_sprite.SetX(bar_x);
    progress_bg_sprite.SetY(bar_y);

    fg_width = bar_width * progress;
    if (fg_width < 1) {
        fg_width = 1;
    }

    progress_fg_sprite.SetImage(progress_fg_image.Scale(fg_width, bar_height));
    progress_fg_sprite.SetX(bar_x);
    progress_fg_sprite.SetY(bar_y);
  }
}

Plymouth.SetBootProgressFunction(progress_callback);
SCRIPT_BARRE
		else
			printf '// progress-bg/fg absentes a la construction : pas de barre de progression.\n'
		fi
		} > "$PLY_DST/lexos.script"

		cat > "$PLY_DST/lexos.plymouth" <<'EOF'
[Plymouth Theme]
Name=LexOS
Description=Ecran de demarrage LexOS (logo qui s'ecrit)
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/lexos
ScriptFile=/usr/share/plymouth/themes/lexos/lexos.script
EOF
	else
		#  LE REPLI EXISTE, ET IL SE DIT. Une lettre manquante, la mascotte
		#  absente ou convert introuvable, et on retombe sur le thème
		#  "two-step" avec le watermark — pas sur un thème VIDE. Le message
		#  part dans le journal de construction : sans lui, on livrerait un
		#  écran de démarrage nu sans que rien ne l'ait dit, et on ne s'en
		#  apercevrait qu'au redémarrage suivant.
		#  SA BARRE RESTE ORANGE (ProgressBarForegroundColor plus bas) : c'est
		#  un autre thème, dessiné par Plymouth lui-même, et le vert d'Alex
		#  vise l'écran qu'on livre vraiment. Choix conscient, pas un oubli.
		#  ═══ UN REPLI DE CONSTRUCTION DOIT CRIER, PAS CHUCHOTER ═══
		#  Un repli silencieux est BON à l'exécution : mieux vaut un écran de
		#  démarrage laid qu'une machine qui ne démarre pas. Il est MAUVAIS à
		#  la construction. Ici, c'est une image qu'on grave, qu'on démarre, et
		#  dont on découvre le défaut à l'écran — sans aucune piste. Le journal
		#  de construction savait tout, et n'a rien dit d'utilisable.
		#  Il nomme donc les fichiers, dit ce qu'on perd, et dit quoi faire.
		echo "[lexos]   !! ═══════════════════════════════════════════════════════════"
		echo "[lexos]   !! ÉCRAN DE DÉMARRAGE SANS LOGO ANIMÉ — repli sur le thème"
		echo "[lexos]   !! statique « two-step » : PAS de mascotte, PAS de LEXOS qui"
		echo "[lexos]   !! s'écrit, PAS de pluie. Seul le filigrane reste."
		echo "[lexos]   !!"
		echo "[lexos]   !! Fichiers introuvables dans $BRAND :"
		for F in $PLY_MANQUANTS; do
			echo "[lexos]   !!     · $F"
		done
		echo "[lexos]   !!"
		echo "[lexos]   !! À FAIRE : remettre ces fichiers dans branding/ du dépôt,"
		echo "[lexos]   !! aux dimensions attendues (lettres 98..112 × 138,"
		echo "[lexos]   !! mascotte-splash 449 × 540), puis reconstruire."
		echo "[lexos]   !! Le banc tests/test_lexos_plymouth.sh les mesure."
		echo "[lexos]   !! ═══════════════════════════════════════════════════════════"
		cat > "$PLY_DST/lexos.plymouth" <<'EOF'
[Plymouth Theme]
Name=LexOS
Description=Ecran de demarrage LexOS
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Bold 14
ImageDir=/usr/share/plymouth/themes/lexos
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.72
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.38
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarBackgroundColor=0x1A1A1C
ProgressBarForegroundColor=0xE8590C
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false
EOF
	fi

	#  ═══ PAS D'« update-initramfs » ICI, ET CE N'EST PAS UN OUBLI ═══
	#  C'est la cause classique de « le thème est sur le disque mais Plymouth
	#  en affiche un autre » : Plymouth démarre DEPUIS L'INITRAMFS, et un
	#  thème écrit après sa fabrication n'y est pas.
	#
	#  Vérifié dans live-build lui-même, pas supposé. /usr/lib/live/build/lb_chroot
	#  appelle ses étapes dans l'ordre, et deux lignes se suivent :
	#      ligne 78 : lb chroot_hooks    <- ce hook-ci
	#      ligne 79 : lb chroot_hacks
	#  et lb_chroot_hacks fait, ligne 191 :
	#      Chroot chroot "… update-initramfs -k all -t -u"
	#  L'initramfs est donc TOUJOURS refait après nous, pour tous les noyaux.
	#  L'appeler ici le referait deux fois — plusieurs minutes de construction
	#  pour rien. Si un jour ces deux lignes changeaient d'ordre dans
	#  live-build, ce commentaire est le premier endroit où regarder.
	#  ÉCRIRE LE THÈME NE SUFFIT PAS : il faut encore le DÉSIGNER par défaut.
	#  Le « || true » d'origine avalait les deux échecs possibles sans un mot —
	#  et un thème écrit mais jamais choisi ne s'affiche jamais.
	if ! have plymouth-set-default-theme; then
		echo "[lexos]   !! plymouth-set-default-theme absent — le thème lexos est"
		echo "[lexos]   !! écrit mais N'EST PAS choisi par défaut : il ne s'affichera"
		echo "[lexos]   !! pas. Le paquet plymouth n'est pas installé."
	elif plymouth-set-default-theme lexos >/dev/null 2>&1; then
		echo "[lexos]   thème Plymouth : lexos"
	else
		echo "[lexos]   !! plymouth-set-default-theme a REFUSÉ le thème lexos — il est"
		echo "[lexos]   !! écrit dans $PLY_DST mais ne sera pas affiché au démarrage."
	fi
else
	echo "[lexos]   !! ═══════════════════════════════════════════════════════════"
	echo "[lexos]   !! AUCUN ÉCRAN DE DÉMARRAGE LexOS. Le thème 'spinner' de Debian"
	echo "[lexos]   !! est introuvable ($PLY_SRC) : LexOS s'en sert de squelette,"
	echo "[lexos]   !! donc rien n'a été écrit. La machine démarrera sur l'écran de"
	echo "[lexos]   !! Debian, ou sur rien du tout."
	echo "[lexos]   !!"
	echo "[lexos]   !! CAUSE LA PLUS PROBABLE : les paquets plymouth et"
	echo "[lexos]   !! plymouth-themes ne sont PAS au socle — ils ne vivent que dans"
	echo "[lexos]   !! 00-core.list, que le hook 0250 pose en tolérant l'échec."
	echo "[lexos]   !! ═══════════════════════════════════════════════════════════"
fi
# <<< banc: plymouth

# --- La vidéo d'après-connexion : le carré et son halo -----------------------
# >>> banc: apres-connexion
#  ═══ LA VIDÉO D'APRÈS-CONNEXION — LE CARRÉ ET SON HALO ═══
#  ALEX a changé de fichier : celui-ci est CARRÉ (720 × 720), et rempli de
#  flammes vives jusqu'aux quatre bords. Le conseil de la consigne
#  précédente — « pose au centre avec des bandes noires » — ne tient plus :
#  il valait pour un fichier à fond sombre, où le noir se fondait. Un carré
#  lumineux au milieu de 420 pixels de noir de chaque côté, ça ne ressemble
#  pas à une intro, ça ressemble à une panne d'affichage.
#
#  ON FABRIQUE DONC UN 1920 × 1080 : la même image agrandie pour remplir
#  l'écran et FORTEMENT FLOUTÉE en fond, la vidéo carrée nette par-dessus,
#  centrée. Les côtés deviennent un halo de flammes floues qui PROLONGE
#  l'image au lieu de la couper. On ne rogne pas : la bannière TI-LEX-AL
#  touche presque le bord du carré, la rogner la couperait.
#
#  ET C'EST FAIT ICI, À LA CONSTRUCTION, UNE FOIS. Flouter en direct à
#  l'ouverture de session coûterait du processeur exactement là où on
#  essaie d'en économiser — c'est le moment où le bureau se charge.
APRES_SRC="$BRAND/apres-connexion.mp4"
APRES_LARGEUR=1920
APRES_HAUTEUR=1080
APRES_COURTE_S=3.5      # la coupe courte, celle du réglage par défaut

#  ═══ LE HALO, FABRIQUÉ COMME LE RESTE — ET FACULTATIF COMME LUI ═══
#  Sans ffmpeg ou sans le fichier, aucune des deux versions n'est
#  écrite : lexos-intro ne trouve rien et laisse la session partir
#  sans vidéo, en le disant dans son journal. Le bureau n'attend
#  jamais après une décoration.
if [ -r "$APRES_SRC" ] && have ffmpeg; then
	#  Le filtre, en trois temps :
	#    · le fond : la vidéo agrandie pour COUVRIR 1920×1080
	#      (force_original_aspect_ratio=increase puis crop), puis
	#      gblur — c'est lui qui fait le halo ;
	#    · le devant : le carré mis à la hauteur de l'écran, net ;
	#    · overlay centré. format=yuv420p pour que n'importe quel
	#      lecteur sache l'afficher.
	APRES_FILTRE="[0:v]scale=${APRES_LARGEUR}:${APRES_HAUTEUR}:force_original_aspect_ratio=increase,crop=${APRES_LARGEUR}:${APRES_HAUTEUR},gblur=sigma=40[bg];[0:v]scale=${APRES_HAUTEUR}:${APRES_HAUTEUR}:flags=lanczos[fg];[bg][fg]overlay=(W-w)/2:(H-h)/2,format=yuv420p[v]"
	#  ═══ LE JOURNAL DES DEUX PASSES A BESOIN D'UN DOSSIER À LUI ═══
	#  Sans -passlogfile, ffmpeg écrit « ffmpeg2pass-0.log » DANS LE DOSSIER
	#  COURANT. Un hook live-build tourne à la racine du chroot : ce fichier
	#  partirait tel quel dans l'ISO. mktemp le met ailleurs, et le piège
	#  l'efface même si ffmpeg meurt en route.
	APRES_TMP="$(mktemp -d)" || APRES_TMP=""
	if [ -z "$APRES_TMP" ]; then
		echo "[lexos]   !! mktemp a échoué : pas de vidéo après le mot de passe"
		APRES_OK=0
	else
	APRES_OK=1
	for DUREE in complete courte; do
		CIBLE="$BRAND/apres-connexion-16-9.mp4"
		COUPE=""
		if [ "$DUREE" = courte ]; then
			CIBLE="$BRAND/apres-connexion-16-9-courte.mp4"
			COUPE="-t $APRES_COURTE_S"
		fi
		#  ═══ « -t » EST UNE OPTION DE SORTIE ICI, ET C'EST UN CORRECTIF ═══
		#  Premier jet : « -t 3.5 » AVANT le -i, donc en option d'ENTRÉE.
		#  Reproduit sur une coupe de 2,08 s de ce même fichier : ffmpeg ne
		#  rend JAMAIS la main. Le filtre sépare [0:v] en deux branches (le
		#  fond flouté, le carré net) et overlay attend éternellement une
		#  branche que la fin d'entrée a déjà close. Sur les 10,2 s d'Alex ça
		#  ne se voit pas — mais le jour où il envoie un fichier plus court
		#  que la coupe, la CONSTRUCTION NE SE TERMINE PLUS. Bien pire qu'un
		#  échec : personne ne saurait où regarder.
		#  Après le -i, la coupe s'applique au MUXEUR : les filtres voient le
		#  flux entier, et une source plus courte s'arrête simplement plus
		#  tôt. Mesuré : 1,5 s par passe au lieu de l'attente sans fin.
		#  « timeout » reste par-dessus — le filet pour ce qu'on n'a pas
		#  prévu, jamais l'explication de ce qu'on a compris.
		#
		#  DEUX PASSES : à débit imposé, c'est la seule façon de tenir une
		#  taille prévisible. La 1re ne mesure QUE l'image (-an).
		# shellcheck disable=SC2086
		if timeout 600 ffmpeg -y -loglevel error -i "$APRES_SRC" \
			-filter_complex "$APRES_FILTRE" -map '[v]' -an $COUPE \
			-c:v libx264 -preset medium -b:v 1600k -passlogfile "$APRES_TMP/passe" \
			-pass 1 -f null /dev/null </dev/null 2>/dev/null \
		&& timeout 600 ffmpeg -y -loglevel error -i "$APRES_SRC" \
			-filter_complex "$APRES_FILTRE" -map '[v]' -map '0:a?' $COUPE \
			-c:v libx264 -preset medium -b:v 1600k -passlogfile "$APRES_TMP/passe" \
			-pass 2 -c:a aac -b:a 96k -movflags +faststart \
			"$CIBLE" </dev/null 2>/dev/null; then
			:
		else
			APRES_OK=0
			rm -f "$CIBLE"
			echo "[lexos]   !! apres-connexion ($DUREE) : ffmpeg a échoué — pas de vidéo après le mot de passe"
		fi
	done
	rm -rf "$APRES_TMP"
	fi
	if [ "$APRES_OK" = 1 ]; then
		echo "[lexos]   vidéo d'après-connexion : carré 720x720 -> ${APRES_LARGEUR}x${APRES_HAUTEUR} avec halo flouté (complète + courte)"
		#  LE CARRÉ NE PART PAS DANS L'ISO : c'est une source de
		#  construction, comme ouvrir-ordinateur.mp4. Seules les deux
		#  versions 16:9 sont lues à l'ouverture de session. Et on ne
		#  retire QUE l'exemplaire du chroot — le banc joue ce
		#  fragment avec le vrai dossier branding/ du dépôt.
		if [ "$APRES_SRC" = "/usr/share/lexos/branding/apres-connexion.mp4" ]; then
			rm -f "$APRES_SRC"
		fi
	fi
elif [ -r "$APRES_SRC" ]; then
	echo "[lexos]   !! ffmpeg absent : pas de vidéo après le mot de passe (le bureau s'ouvre directement)"
else
	echo "[lexos]   pas de vidéo d'après-connexion : branding/apres-connexion.mp4 absent"
fi

# <<< banc: apres-connexion

# --- Le cache des polices ----------------------------------------------------
#  POURQUOI C'EST NÉCESSAIRE, ET CE QUI SE PASSAIT SANS.
#  LexOS embarque UNE police à lui : Patrick Hand (licence OFL), celle du
#  réglage « Manuscrite ». Elle arrive par includes.chroot — donc en dehors
#  de dpkg, donc SANS déclencher le mécanisme qui reconstruit d'ordinaire le
#  cache de fontconfig quand un paquet de polices s'installe.
#
#  Le cache système livré par Debian ne la contient donc pas. À l'usage,
#  fontconfig s'en sort quand même : il voit le dossier plus récent que son
#  cache et rebalaye tout seul. Mais ce rattrapage a un prix qu'on paie au
#  pire moment — la PREMIÈRE application qui demande une police, sur un
#  portable de 2016 — et il suppose de pouvoir écrire un cache par
#  utilisateur, ce qui n'est pas garanti en session démo.
#
#  Une seconde de construction ici enlève ce doute pour de bon : la police
#  est dans le cache système, tout de suite, pour tout le monde.
if command -v fc-cache >/dev/null 2>&1; then
	fc-cache -f >/dev/null 2>&1 \
		&& echo "[lexos]   cache des polices reconstruit" \
		|| echo "[lexos]   !! fc-cache a échoué — « Manuscrite » sera plus lente au 1er usage"
	#  Vérifier, plutôt que d'espérer : une police annoncée dans les
	#  Paramètres et introuvable par le système est exactement le genre
	#  d'écart qu'on passe la journée à fermer.
	if command -v fc-list >/dev/null 2>&1; then
		if fc-list 2>/dev/null | grep -qi "Patrick Hand"; then
			echo "[lexos]   police « Manuscrite » (Patrick Hand) : vue par fontconfig"
		else
			echo "[lexos]   !! Patrick Hand INTROUVABLE — le réglage « Manuscrite » n'aura rien à afficher"
		fi
	fi
else
	echo "[lexos]   !! fc-cache absent — cache des polices non reconstruit"
fi

echo "[lexos] hook 0300 : ok"

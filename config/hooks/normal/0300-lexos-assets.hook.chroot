#!/bin/sh
# =============================================================================
#  LexOS — rendu des visuels : logo TI-LEX-AL, mascotte, fonds d'écran, Plymouth
# =============================================================================
set -e

echo "[lexos] hook 0300 : visuels"

BRAND="/usr/share/lexos/branding"
BG="/usr/share/backgrounds/lexos"
mkdir -p "$BG" "$BRAND" /usr/share/pixmaps

have() { command -v "$1" >/dev/null 2>&1; }

# --- WebP -> PNG -------------------------------------------------------------
# Les mascottes sont livrées en .webp : peu d'outils GTK savent les lire.
for W in "$BRAND"/*.webp; do
	[ -e "$W" ] || continue
	OUT="${W%.webp}.png"
	if have dwebp; then
		dwebp -quiet "$W" -o "$OUT" && echo "[lexos]   webp -> $OUT"
	elif have convert; then
		convert "$W" "$OUT" && echo "[lexos]   webp -> $OUT"
	else
		echo "[lexos]   !! ni dwebp ni convert : $W non converti"
	fi
done

# --- Rendu SVG ---------------------------------------------------------------
render() { # render <src.svg> <w> <h> <dest.png>
	if [ ! -r "$1" ]; then
		echo "[lexos]   !! source absente : $1"
		return 0
	fi
	if have rsvg-convert; then
		rsvg-convert -w "$2" -h "$3" -o "$4" "$1" \
			&& echo "[lexos]   -> $4" || echo "[lexos]   !! échec : $1"
	elif have convert; then
		convert -background none -resize "${2}x${3}" "$1" "$4" \
			&& echo "[lexos]   -> $4" || echo "[lexos]   !! échec : $1"
	fi
}

# --- Fonds d'écran -----------------------------------------------------------
render "$BRAND/wallpaper.svg"     1920 1080 "$BG/wallpaper.png"
render "$BRAND/wallpaper.svg"     3840 2160 "$BG/wallpaper-4k.png"
render "$BRAND/wallpaper.svg"     1366  768 "$BG/wallpaper-hd.png"
render "$BRAND/wallpaper-crt.svg" 1920 1080 "$BG/wallpaper-crt.png"
render "$BRAND/wallpaper-secu.svg" 1920 1080 "$BG/wallpaper-secu.png"
render "$BRAND/wallpaper-secu.svg" 3840 2160 "$BG/wallpaper-secu-4k.png"

# Fond d'écran « LexOS 1.0 » : le logo TI-LEX-AL, posé sur fond noir — même
# composition que le sélecteur de la démo web (Paramètres → Bureau LexOS).
if [ -r "$BRAND/logo-ti-lex-al-icon.png" ] && have convert; then
	convert -size 1920x1080 xc:black \
		"$BRAND/logo-ti-lex-al-icon.png" -resize 620x620 -gravity north -geometry +0+90 -composite \
		"$BG/wallpaper-demon.png" \
		&& echo "[lexos]   -> $BG/wallpaper-demon.png" \
		|| echo "[lexos]   !! échec : wallpaper-demon.png"
fi

# Fond d'écran « Explorateur » : la photo-affiche lexos-1.0-keyart.png, posée
# sur fond noir — même composition que le sélecteur de la démo web (Paramètres → Bureau LexOS).
if [ -r "$BRAND/lexos-1.0-keyart.png" ] && have convert; then
	convert -size 1920x1080 xc:black \
		"$BRAND/lexos-1.0-keyart.png" -resize 480x480 -gravity north -geometry +0+70 -composite \
		"$BG/wallpaper-keyart.png" \
		&& echo "[lexos]   -> $BG/wallpaper-keyart.png" \
		|| echo "[lexos]   !! échec : wallpaper-keyart.png"
fi

# --- Le fond par DÉFAUT de XFCE devient celui de LexOS ---------------------
#  POURQUOI CE BLOC EXISTE (constaté sur le portable 2016, build 35)
#  Le bon fond d'écran s'affichait à l'ouverture de session… puis laissait
#  la place au fond bleu de XFCE, celui à la souris. Ce n'était donc pas une
#  question de nom de propriété — c'était une COURSE, et on la perdait :
#  lexos-firstrun pose l'image, xfdesktop finit de démarrer ensuite et écrit
#  ses propres valeurs par-dessus.
#
#  On peut toujours écrire après lui, il écrira encore après nous. La seule
#  façon de gagner à coup sûr, c'est de ne plus courir : on remplace LE
#  FICHIER que xfdesktop utilise par défaut. Peu importe alors qui écrit en
#  dernier — l'image affichée est celle de LexOS.
#
#  On remplace chaque fichier en gardant son nom ET son format : xfdesktop
#  choisit par nom, et un JPEG déguisé en .svg n'est pas lisible par tous
#  les chargeurs. Les originaux de Debian ne servent plus à rien ici.
XFCE_BG="/usr/share/backgrounds/xfce"
if [ -d "$XFCE_BG" ] && [ -r "$BG/wallpaper.png" ]; then
	REMPLACES=0
	for D in "$XFCE_BG"/*; do
		[ -f "$D" ] || continue
		case "$D" in
			*.svg)
				[ -r "$BRAND/wallpaper.svg" ] \
					&& cp "$BRAND/wallpaper.svg" "$D" && REMPLACES=$((REMPLACES + 1))
				;;
			*.png)
				cp "$BG/wallpaper.png" "$D" && REMPLACES=$((REMPLACES + 1))
				;;
			*.jpg|*.jpeg)
				#  Sans convert, on recopie quand même le PNG sous le nom
				#  .jpg : les chargeurs d'images reconnaissent le format au
				#  contenu, pas à l'extension. Un PNG mal nommé s'affiche ;
				#  le fond bleu de Debian laissé en place, lui, se voit.
				if have convert; then
					convert "$BG/wallpaper.png" -quality 92 "$D" \
						&& REMPLACES=$((REMPLACES + 1))
				else
					cp "$BG/wallpaper.png" "$D" && REMPLACES=$((REMPLACES + 1))
				fi
				;;
		esac
	done
	echo "[lexos]   fond par défaut de XFCE remplacé (${REMPLACES} fichier(s))"
	if [ "$REMPLACES" -eq 0 ]; then
		echo "[lexos]   !! aucun fond XFCE remplacé — le bureau live risque de repasser au fond bleu"
	fi
else
	echo "[lexos]   !! ${XFCE_BG} absent ou wallpaper.png manquant — fond par défaut non remplacé"
fi

# Les mascottes servent aussi de fonds d'écran alternatifs.
for M in "$BRAND"/mascot*.png; do
	[ -e "$M" ] || continue
	cp "$M" "$BG/$(basename "$M")"
done

# --- Logo TI-LEX-AL : icône officielle du système ---------------------------
#  La version détourée (fond transparent) est privilégiée pour l'icône : elle
#  se fond dans le panneau, le dock et le menu Applications quel que soit le
#  thème, contrairement à la version sur fond noir (posters, Plymouth).
LOGO_SRC=""
if [ -r "$BRAND/logo-ti-lex-al-icon.png" ]; then
	LOGO_SRC="$BRAND/logo-ti-lex-al-icon.png"
elif [ -r "$BRAND/logo-ti-lex-al.png" ]; then
	LOGO_SRC="$BRAND/logo-ti-lex-al.png"
elif [ -r "$BRAND/logo.svg" ]; then
	LOGO_SRC="$BRAND/logo.svg"
fi

for SIZE in 16 22 24 32 48 64 128 256 512; do
	DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
	mkdir -p "$DIR"
	case "$LOGO_SRC" in
		*.svg) render "$LOGO_SRC" "$SIZE" "$SIZE" "$DIR/lexos.png" ;;
		*.png)
			if have convert; then
				convert "$LOGO_SRC" -resize "${SIZE}x${SIZE}" "$DIR/lexos.png" \
					&& echo "[lexos]   -> $DIR/lexos.png"
			fi
			;;
	esac
done

mkdir -p /usr/share/icons/hicolor/scalable/apps

# --- AUCUNE VERSION VECTORIELLE POUR LES ICÔNES LexOS. C'EST VOULU. --------
#  Le dock AGRANDIT l'icône survolée : la taille demandée varie alors en
#  continu, et pour toute taille sans PNG exact, GTK préfère le SVG
#  « scalable ». L'affichage saute donc du PNG au SVG et retour — l'icône
#  CHANGE de dessin sous la souris.
#
#  On a d'abord cru à un simple trou de tailles. On les a complétées, trois
#  fois : Chrome (build 38), Claude et Musique (build 41). Le clignotement
#  est resté. La cause n'était pas le NOMBRE de tailles, c'était l'existence
#  de DEUX rendus possibles du même nom d'icône.
#
#  Il n'en reste donc qu'un : les PNG. GTK met à l'échelle le plus proche, et
#  plus rien ne peut changer sous la souris. Au-delà de 256 px l'icône sera
#  un peu moins nette — aucune interface de LexOS ne demande cette taille.
rm -f /usr/share/icons/hicolor/scalable/apps/lexos.svg

# --- Icônes teintables (lexos-files, lexos-zip) — orange par défaut --------
#  À l'exécution, lexos-theme-gen en produit une version à la couleur
#  d'accent dans ~/.local/share/icons, qui a priorité sur celle-ci.
#  wifi-ok / wifi-warn / wifi-off portent une couleur FIXE (vert, orange,
#  rouge) : elle dit l'état du réseau, elle ne doit donc pas suivre l'accent.
#  Elles ne contiennent pas le jeton #E8590C, la substitution les ignore.
#  couleurs (gestion des couleurs) est dans le même cas : ses six teintes
#  d'arc-en-ciel sont fixes, pas de jeton non plus.
for NAME in files zip share wifi wifi-ok wifi-warn wifi-off bluetooth \
             perf-petit perf-medium perf-performant perf-max \
             folder-ferme folder-ouvert musique usb secure terminal camera \
             reglages navigateur note couleurs maj disque mac; do
	SRC="$BRAND/icon-${NAME}.svg"
	[ -r "$SRC" ] || continue
	for SIZE in 16 22 24 32 48 64 128 256; do
		DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
		mkdir -p "$DIR"
		render "$SRC" "$SIZE" "$SIZE" "$DIR/lexos-${NAME}.png"
	done
	rm -f "/usr/share/icons/hicolor/scalable/apps/lexos-${NAME}.svg"
done

#  Icône GitHub — source déjà en PNG (pas de version vectorielle), redimensionnée
#  directement plutôt que passée par render() qui suppose un SVG en entrée.
if [ -r "$BRAND/icon-github.png" ] && have convert; then
	for SIZE in 16 22 24 32 48 64 128 256; do
		DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
		mkdir -p "$DIR"
		convert "$BRAND/icon-github.png" -resize "${SIZE}x${SIZE}" "$DIR/lexos-github.png" \
			&& echo "[lexos]   -> $DIR/lexos-github.png"
	done
fi

#  Studio+ LexOS porte le logo de marque TI-LEX-AL, pas une icône à part :
#  c'est l'atelier maison, il s'annonce sous l'enseigne. On recopie donc
#  lexos.png déjà rendu plus haut, à chaque taille, sous le nom attendu par
#  lexos-studio.desktop.
for SIZE in 16 22 24 32 48 64 128 256; do
	DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
	[ -r "$DIR/lexos.png" ] && cp "$DIR/lexos.png" "$DIR/lexos-studio.png"
done

if [ -n "$LOGO_SRC" ]; then
	case "$LOGO_SRC" in
		*.png) cp "$LOGO_SRC" /usr/share/pixmaps/lexos.png ;;
		*.svg) render "$LOGO_SRC" 256 256 /usr/share/pixmaps/lexos.png ;;
	esac
fi

have gtk-update-icon-cache && \
	gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true

# --- Avatar de session (mascotte) -------------------------------------------
FACE=""
for CAND in "$BRAND/mascot.png" "$BRAND/mascot-portrait.png" "$BRAND/mascot-rock.png"; do
	[ -r "$CAND" ] && { FACE="$CAND"; break; }
done

if [ -n "$FACE" ]; then
	mkdir -p /usr/share/lexos/faces /var/lib/AccountsService/icons /etc/skel
	cp "$FACE" /usr/share/lexos/faces/lexos.png
	cp "$FACE" /etc/skel/.face
	cp "$FACE" /var/lib/AccountsService/icons/lex
	echo "[lexos]   avatar : $FACE"
fi

# --- Thème Plymouth ----------------------------------------------------------
PLY_SRC="/usr/share/plymouth/themes/spinner"
PLY_DST="/usr/share/plymouth/themes/lexos"
FRAME_DIR="$BRAND/mascot-anim-frames"
FRAME_FIRST="$FRAME_DIR/mascot-anim-00.png"

if [ -d "$PLY_SRC" ]; then
	rm -rf "$PLY_DST"
	cp -a "$PLY_SRC" "$PLY_DST"
	rm -f "$PLY_DST/spinner.plymouth"

	if [ -n "$LOGO_SRC" ] && have convert; then
		convert "$LOGO_SRC" -resize 200x200 "$PLY_DST/watermark.png" || true
	fi

	if [ -r "$FRAME_FIRST" ] && have convert; then
		# --- Mascotte animée (16 images, ~90ms/frame) : thème "script" ------
		for F in "$FRAME_DIR"/mascot-anim-*.png; do
			[ -e "$F" ] || continue
			cp "$F" "$PLY_DST/$(basename "$F")"
		done

		convert -size 1x1 xc:'#1A1A1C' "$PLY_DST/progress-bg.png" || true
		convert -size 1x1 xc:'#E8590C' "$PLY_DST/progress-fg.png" || true

		cat > "$PLY_DST/lexos.script" <<'SCRIPT_EOF'
// LexOS — thème Plymouth animé (mascotte, 16 images)
// Généré par config/hooks/normal/0300-lexos-assets.hook.chroot — ne pas éditer à la main.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

frame_count = 16;
frame_delay = 0.09;
frame_index = 0;
frame_start_time = -1;

frame_image[0]  = Image("mascot-anim-00.png");
frame_image[1]  = Image("mascot-anim-01.png");
frame_image[2]  = Image("mascot-anim-02.png");
frame_image[3]  = Image("mascot-anim-03.png");
frame_image[4]  = Image("mascot-anim-04.png");
frame_image[5]  = Image("mascot-anim-05.png");
frame_image[6]  = Image("mascot-anim-06.png");
frame_image[7]  = Image("mascot-anim-07.png");
frame_image[8]  = Image("mascot-anim-08.png");
frame_image[9]  = Image("mascot-anim-09.png");
frame_image[10] = Image("mascot-anim-10.png");
frame_image[11] = Image("mascot-anim-11.png");
frame_image[12] = Image("mascot-anim-12.png");
frame_image[13] = Image("mascot-anim-13.png");
frame_image[14] = Image("mascot-anim-14.png");
frame_image[15] = Image("mascot-anim-15.png");

mascot_sprite = Sprite();
mascot_sprite.SetImage(frame_image[0]);
mascot_sprite.SetX(Window.GetWidth() / 2 - frame_image[0].GetWidth() / 2);
mascot_sprite.SetY(Window.GetHeight() * 0.38 - frame_image[0].GetHeight() / 2);
mascot_sprite.SetZ(10);
mascot_sprite.SetOpacity(1);

fun refresh_callback() {
    now = Plymouth.GetTime();

    if (frame_start_time < 0) {
        frame_start_time = now;
    }

    if (now - frame_start_time >= frame_delay) {
        frame_start_time = now;
        frame_index = frame_index + 1;
        if (frame_index >= frame_count) {
            frame_index = 0;
        }
        mascot_sprite.SetImage(frame_image[frame_index]);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

// Barre de progression (fond gris ProgressBarBackgroundColor=0x1A1A1C,
// remplissage orange ProgressBarForegroundColor=0xE8590C), redessinée par
// mise à l'échelle d'un pixel de couleur unie — le module "script" ne
// fournit pas de barre de progression native comme "two-step".
progress_bg_image = Image("progress-bg.png");
progress_fg_image = Image("progress-fg.png");
progress_bg_sprite = Sprite();
progress_fg_sprite = Sprite();
progress_bg_sprite.SetImage(progress_bg_image);
progress_fg_sprite.SetImage(progress_fg_image);
progress_bg_sprite.SetZ(20);
progress_fg_sprite.SetZ(21);

fun progress_callback(duration, progress) {
    bar_width = Window.GetWidth() * 0.3;
    bar_height = 4;
    bar_x = Window.GetWidth() / 2 - bar_width / 2;
    bar_y = Window.GetHeight() * 0.72;

    progress_bg_sprite.SetImage(progress_bg_image.Scale(bar_width, bar_height));
    progress_bg_sprite.SetX(bar_x);
    progress_bg_sprite.SetY(bar_y);

    fg_width = bar_width * progress;
    if (fg_width < 1) {
        fg_width = 1;
    }

    progress_fg_sprite.SetImage(progress_fg_image.Scale(fg_width, bar_height));
    progress_fg_sprite.SetX(bar_x);
    progress_fg_sprite.SetY(bar_y);
}

Plymouth.SetBootProgressFunction(progress_callback);
SCRIPT_EOF

		cat > "$PLY_DST/lexos.plymouth" <<'EOF'
[Plymouth Theme]
Name=LexOS
Description=Ecran de demarrage LexOS (mascotte animee)
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/lexos
ScriptFile=/usr/share/plymouth/themes/lexos/lexos.script
EOF
	else
		echo "[lexos]   images d'animation absentes ou convert manquant — thème Plymouth statique (watermark)"
		cat > "$PLY_DST/lexos.plymouth" <<'EOF'
[Plymouth Theme]
Name=LexOS
Description=Ecran de demarrage LexOS
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Bold 14
ImageDir=/usr/share/plymouth/themes/lexos
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.72
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.38
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarBackgroundColor=0x1A1A1C
ProgressBarForegroundColor=0xE8590C
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false
EOF
	fi

	have plymouth-set-default-theme && \
		plymouth-set-default-theme lexos >/dev/null 2>&1 \
		&& echo "[lexos]   thème Plymouth : lexos" || true
else
	echo "[lexos]   thème 'spinner' absent — Plymouth non personnalisé"
fi

echo "[lexos] hook 0300 : ok"

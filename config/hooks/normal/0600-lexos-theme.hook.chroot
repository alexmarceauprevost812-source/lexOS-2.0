#!/bin/sh
# =============================================================================
#  LexOS Noir — thème par défaut (noir pur, écriture blanche, boutons accentués)
# =============================================================================
set -e

echo "[lexos] hook 0600 : thème LexOS Noir"

ACCENT_NAME="orange"
GTK_BASE="Yaru-dark"
ICONS="LexOS"
TERM_MODE="suivre"
LEXOS_DOCK_POSITION="right"

if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
	ACCENT_NAME="${LEXOS_ACCENT_NAME:-orange}"
	GTK_BASE="${LEXOS_GTK_BASE_THEME:-Yaru-dark}"
	ICONS="${LEXOS_ICON_THEME:-LexOS}"
	TERM_MODE="${LEXOS_TERMINAL_MODE:-suivre}"
fi

# --- Le thème demandé est-il RÉELLEMENT installé ? --------------------------
#  LE SOCLE N'EST PLUS OPTIONNEL — yaru-theme-gtk est en liste STRICTE
#  (lexos-core), justement parce que ce bloc existait. Le raisonnement qui
#  suit reste vrai pour les icônes et pour tout socle de repli, et il dit
#  pourquoi le socle a changé de liste.
#  papirus-icon-theme, lui, voyage toujours dans les paquets OPTIONNELS : il
#  est posé en « best effort » par le hook 0250, et son absence n'arrête pas
#  la construction. Mais si on continue quand même à écrire « Yaru-dark »
#  partout, XFCE ne trouve rien et retombe sur son thème CLAIR par défaut :
#  on livre alors une ISO qui ne ressemble pas du tout à LexOS, sans qu'aucune
#  ligne du journal ne l'ait signalé. On vérifie donc sur le disque, et on
#  choisit le premier thème sombre réellement présent.
#
#  Dernier recours : « Adwaita », qui est compilé DANS GTK (donc toujours là,
#  même sans dossier dans /usr/share/themes) et dont la variante sombre est
#  obtenue par gtk-application-prefer-dark-theme, déjà posé plus bas. Le
#  bureau reste noir quoi qu'il arrive.
premier_present() {
	RACINE="$1"; shift
	for NOM in "$@"; do
		if [ -d "${RACINE}/${NOM}" ]; then
			printf '%s' "$NOM"
			return 0
		fi
	done
	return 1
}

GTK_DEMANDE="$GTK_BASE"
if [ ! -d "/usr/share/themes/${GTK_BASE}" ]; then
	GTK_BASE="$(premier_present /usr/share/themes \
		Yaru-dark Adwaita-dark Greybird-dark Materia-dark Numix Arc-Dark)" \
		|| GTK_BASE="Adwaita"
	echo "[lexos]   !! thème « ${GTK_DEMANDE} » absent — remplacé par « ${GTK_BASE} »"
fi

ICONS_DEMANDE="$ICONS"
if [ ! -d "/usr/share/icons/${ICONS}" ]; then
	ICONS="$(premier_present /usr/share/icons \
		LexOS Papirus-Dark Papirus ePapirus Adwaita gnome hicolor)" \
		|| ICONS="hicolor"
	echo "[lexos]   !! icônes « ${ICONS_DEMANDE} » absentes — remplacées par « ${ICONS} »"
fi

#  Les bordures de fenêtre sont un thème à part (xfwm4). MESURÉ, pas supposé :
#  yaru-theme-gtk livre bien un /usr/share/themes/Yaru-dark/xfwm4 — on
#  s'attendait au contraire, Yaru visant GNOME. Les bordures suivent donc le
#  socle sans rien faire de plus. Les thèmes de repli, eux, n'en ont pas
#  toujours : « Default » est livré avec xfwm4 et sert de dernier recours.
#  Un socle GTK et un thème de bordures peuvent parfaitement venir de deux
#  paquets différents — ce n'est pas une incohérence, et la ligne ci-dessous
#  s'en accommode d'elle-même.
#  Les bordures de fenêtre restent celles du thème de BASE : LexOS-Noir est
#  une feuille de style, il ne fournit pas de xfwm4. Cette ligne est calculée
#  AVANT que GTK_BASE ne devienne « LexOS-Noir », plus bas — sans quoi on
#  chercherait « /usr/share/themes/LexOS-Noir/xfwm4 », qui n'existe pas, et
#  toutes les fenêtres retomberaient sur les bordures grises de « Default ».
XFWM_THEME="$GTK_BASE"
[ -d "/usr/share/themes/${XFWM_THEME}/xfwm4" ] || XFWM_THEME="Default"

#  ─── LE SOCLE ───────────────────────────────────────────────────────────────
#  Le thème sur lequel LexOS-Noir est CONSTRUIT — pas celui que la session
#  affiche. Comme XFWM_THEME juste au-dessus, il se retient AVANT la bascule.
#
#  POURQUOI IL LUI FAUT UN NOM À LUI. Vingt lignes plus bas, GTK_BASE devient
#  « LexOS-Noir » ; c'est cette valeur-là qui part dans build.conf sous
#  « LEXOS_GTK_BASE_THEME », et c'est correct : ce que lexos-firstrun y lit,
#  c'est le thème à poser dans xfconf. Mais lexos-theme-gen lit un réglage du
#  MÊME NOM pour savoir sur quoi construire. Réinjecter la valeur de
#  build.conf dans le générateur lui demanderait donc de bâtir LexOS-Noir sur
#  LexOS-Noir : mesuré, ça donne une feuille SANS @import et SANS ressource,
#  c'est-à-dire un thème sans socle — des fenêtres nues, et rien dans le
#  journal. Personne ne fait ça aujourd'hui, par chance et non par
#  construction : firstrun lit build.conf dans un sous-shell et n'exporte
#  rien. Une ligne déplacée suffisait.
#
#  C'est exactement la faute « LEXOS_GTK_BASE / LEXOS_GTK_BASE_THEME » du
#  balayage précédent : deux sens sous un nom. Le socle a le sien.
GTK_SOCLE="$GTK_BASE"

echo "[lexos]   thème : ${GTK_BASE} · icônes : ${ICONS} · fenêtres : ${XFWM_THEME}"

# --- Génère le thème dans /etc/skel (hérité par tout nouveau compte) --------
if [ -x /usr/bin/lexos-theme-gen ]; then
	mkdir -p /etc/skel
	#  --terminal décide de la palette du TERMINAL, qui a maintenant son mode
	#  à elle. « suivre » = le terminal suit le thème du bureau, ce qui
	#  reproduit l'ancien comportement en sombre tout en donnant enfin un
	#  VRAI terminal clair au thème de jour — il restait noir jusqu'ici.
	#  LE THÈME DE BASE RETENU LUI EST PASSÉ ICI, ET C'EST NÉCESSAIRE.
	#  Le thème LexOS-Noir pose un lien vers la ressource compilée du thème
	#  de base et importe son adresse : il doit donc savoir LEQUEL a
	#  réellement été retenu quelques lignes plus haut. Sans ça il viserait
	#  Yaru-dark en dur, et sur une machine où le socle manque le lien
	#  pointerait dans le vide — bureau NU, ni en-tête ni sélection, pour un
	#  simple avertissement dans le journal.
	#
	#  On le passe À L'APPEL et non par build.conf : ce fichier n'est écrit
	#  que bien plus bas, après ces deux lignes. Il aurait été lu vide.
	HOME=/etc/skel LEXOS_GTK_BASE_THEME="$GTK_BASE" \
		/usr/bin/lexos-theme-gen "$ACCENT_NAME" \
		--terminal "$TERM_MODE" --target /etc/skel \
		|| echo "[lexos]   !! génération du thème échouée (non bloquant)"
	# Même thème pour root, utile en console de secours.
	HOME=/root LEXOS_GTK_BASE_THEME="$GTK_BASE" \
		/usr/bin/lexos-theme-gen "$ACCENT_NAME" \
		--terminal "$TERM_MODE" --target /root >/dev/null 2>&1 || true
else
	echo "[lexos]   !! lexos-theme-gen absent"
fi

# --- LexOS-Noir : le style devient un VRAI THÈME ---------------------------
#  ALEX : « les thèmes des applications, on peut-tu faire que ça soit pas trop
#  compliqué et que ça reste tout officiel normal, pour pas avoir à changer
#  les couleurs et tout le kit sur chaque appli ».
#
#  Le style de LexOS partait dans ~/.config/gtk-3.0/gtk.css, que GTK charge en
#  priorité UTILISATEUR : il écrasait le thème de base ET chaque application
#  par-dessus. D'où les correctifs sur mesure, application par application.
#  lexos-theme-gen écrit maintenant le MÊME style dans ~/.themes/LexOS-Noir,
#  que GTK charge en priorité THÈME — sous les applications, pas dessus.
#
#  ON NE DÉCLARE LE THÈME QUE S'IL EST RÉELLEMENT LÀ. Même règle que pour
#  le socle vingt lignes plus haut, et pour la même raison : écrire un nom de
#  thème introuvable donne un bureau CLAIR par défaut, sans qu'une seule ligne
#  du journal ne le signale. On vérifie le fichier, pas l'intention.
#
#  DEPUIS L'ÉTAPE 4, LE THÈME EST SEUL : la feuille utilisateur n'est plus
#  écrite du tout. L'égalité entre les deux montages avait d'abord été tenue
#  par la mesure (dix-huit couleurs, zéro différence) AVANT de retirer quoi
#  que ce soit ; le banc du thème garde maintenant la palette elle-même comme
#  référence. Seul le foyer de lightdm (hook 0410) conserve une feuille en
#  priorité utilisateur : le greeter a son propre thème, c'est la seule façon
#  de passer devant, et c'est écrit là-bas.
THEME_LEXOS="LexOS-Noir"
if [ -r "/etc/skel/.themes/${THEME_LEXOS}/gtk-3.0/gtk.css" ]; then
	GTK_BASE="$THEME_LEXOS"
	echo "[lexos]   thème LexOS-Noir posé — GTK le chargera par son nom"
else
	echo "[lexos]   !! ~/.themes/${THEME_LEXOS} absent — on reste sur ${GTK_BASE}"
fi

# --- Les applications Qt suivent, elles aussi -------------------------------
#  ALEX : « pour pas avoir a changer les couleurs et tout le kit sur chaque
#  appli ». LexOS embarque sept applications Qt (audacity, flameshot,
#  kdenlive, keepassxc, krita, scribus, vlc) et rien ne leur disait de suivre
#  le theme : elles s'ouvraient BLANCHES au milieu d'un bureau noir.
#
#  DEUX VARIABLES, DEUX ROLES — mesure sur le vrai flameshot sous Xvfb :
#     rien ............................ fond #FBFBFB (blanc)
#     QT_QPA_PLATFORMTHEME=gtk3 ....... fond #FBFBFB (blanc)
#     QT_STYLE_OVERRIDE=Adwaita-Dark .. fond #303030 (sombre)
#
#  Le greffon gtk3 EST bien charge — verifie avec QT_DEBUG_PLUGINS — mais
#  celui de Qt5 fournit les dialogues, les polices et les icones, PAS la
#  palette. C'est le STYLE qui peint. On garde les deux : la couleur d'un
#  cote, les fenetres « ouvrir un fichier » du systeme de l'autre.
#
#  /etc/environment ET PAS profile.d : profile.d n'est lu que par un shell de
#  CONNEXION. Une application lancee depuis le dock n'en voit rien.
#  /etc/environment est lu par PAM, donc par toute session graphique — c'est
#  le chemin officiel, et le seul qui couvre le cas reel.
#
#  ON AJOUTE, ON NE REECRIT PAS : Debian y met PATH. Et on ne le fait qu'une
#  fois — un hook rejoue ne doit pas empiler dix lignes identiques.
ENVF="${LEXOS_ENVIRONMENT:-/etc/environment}"
touch "$ENVF"
if ! grep -q "^QT_STYLE_OVERRIDE=" "$ENVF" 2>/dev/null; then
	{
		echo "# LexOS : les applications Qt suivent le sombre (voir hook 0600)."
		echo "QT_QPA_PLATFORMTHEME=gtk3"
		echo "QT_STYLE_OVERRIDE=Adwaita-Dark"
	} >> "$ENVF"
	echo "[lexos]   Qt : style sombre + dialogues GTK posés dans $ENVF"
else
	echo "[lexos]   Qt : $ENVF porte déjà le réglage"
fi
#  CE QUE ÇA NE FAIT PAS : suivre le thème de JOUR. /etc/environment est
#  ecrit par root a la construction ; lexos-theme-gen n'ecrit que dans le
#  dossier de l'utilisateur et ne peut pas y toucher. Les applications Qt
#  restent donc sombres meme en theme de jour — meme limite que la politique
#  de couleur du navigateur, et pour la meme raison. C'est assume.

# --- Réglages GTK système ----------------------------------------------------
#  DEUX ENDROITS POUR UN SEUL RÉGLAGE, ET LES DEUX SONT NÉCESSAIRES.
#  « gtk-icon-sizes » ci-dessous double la propriété Gtk/IconSizes de
#  /etc/skel/…/xsettings.xml, et ce n'est pas un oubli de ménage : sous XFCE,
#  xfsettingsd exporte ses propres réglages vers GTK et ÉCRASE settings.ini
#  pour les clés qu'il gère, une fois la session ouverte. Mais settings.ini
#  sert AVANT lui — dans l'installateur Calamares, notamment, qui tourne sans
#  session XFCE complète. N'écrire qu'à un seul endroit donne donc une taille
#  d'icônes dans l'installateur et une autre dans la session, sans qu'aucune
#  erreur ne se lève nulle part.
#  LES DEUX VALEURS DOIVENT RESTER IDENTIQUES ; tests/test_lexos_taille_icones_fichiers.sh
#  les compare, précisément parce que rien d'autre ne le ferait.
mkdir -p /etc/gtk-3.0
cat > /etc/gtk-3.0/settings.ini <<EOF
[Settings]
gtk-theme-name=${GTK_BASE}
gtk-icon-theme-name=${ICONS}
gtk-font-name=Noto Sans 10
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=24
gtk-application-prefer-dark-theme=true
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
gtk-menu-images=1
gtk-icon-sizes=gtk-menu=24,24
gtk-button-images=1
EOF

# --- Propager les noms RETENUS partout où ils étaient écrits en dur --------
#  Les fichiers ci-dessous ont été écrits par des hooks antérieurs avec le nom
#  DEMANDÉ (« Yaru-dark » aujourd'hui, « Arc-Dark » jusqu'à l'ISO 108). Si on
#  vient d'en choisir un autre parce que celui-là manquait, il faut les
#  corriger, sinon la vérification ci-dessus n'aura servi à rien : XFCE lirait
#  toujours l'ancien nom dans son XML.
SKEL_XFCONF="/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"

if [ -f "$SKEL_XFCONF/xsettings.xml" ]; then
	sed -i \
		-e "s|\(name=\"ThemeName\"[^>]*value=\"\)[^\"]*\"|\1${GTK_BASE}\"|" \
		-e "s|\(name=\"IconThemeName\"[^>]*value=\"\)[^\"]*\"|\1${ICONS}\"|" \
		"$SKEL_XFCONF/xsettings.xml"
fi

if [ -f "$SKEL_XFCONF/xfwm4.xml" ]; then
	sed -i \
		-e "s|\(name=\"theme\"[^>]*value=\"\)[^\"]*\"|\1${XFWM_THEME}\"|" \
		"$SKEL_XFCONF/xfwm4.xml"
fi

# --- L'écran de connexion : les noms retenus, et l'accent retenu -----------
#  CE BLOC RÉÉCRIVAIT « theme-name » AVEC LE THÈME DE BASE. Depuis que le hook
#  0410 fabrique « LexOS-Connexion » (le noir et l'orange demandés par Alex),
#  l'écraser ici ANNULERAIT tout le travail — et rien dans le journal ne
#  l'aurait dit. Exactement le piège du paquet terminal au build 76, qui
#  aurait remis « Papirus-Dark » sans qu'on s'en aperçoive.
#
#  Le bloc va de la balise « banc: connexion » à sa fermeture. Ce ne sont pas
#  des décorations : tests/test_lexos_connexion.sh découpe entre les deux et
#  exécute CE fragment. Les déplacer sans les emporter casse le banc, ce qui
#  est le comportement voulu — un banc qui suit tout seul ne prouve rien.
# >>> banc: connexion
CONNEXION_LIGHTDM_DIR="${LEXOS_LIGHTDM_DIR:-/etc/lightdm}"
CONNEXION_LIGHTDM_HOME="${LEXOS_LIGHTDM_HOME:-/var/lib/lightdm}"
CONNEXION_THEMES="${LEXOS_THEMES:-/usr/share/themes}"
CONNEXION_SKEL="${LEXOS_SKEL:-/etc/skel}"
CONNEXION_CONF="$CONNEXION_LIGHTDM_DIR/lightdm-gtk-greeter.conf"

if [ -f "$CONNEXION_CONF" ]; then
	sed -i -e "s|^icon-theme-name=.*|icon-theme-name=${ICONS}|" "$CONNEXION_CONF"
	#  On ne touche à « theme-name » que s'il ne porte PAS notre thème ; dans
	#  ce cas-là c'est bien le nom de base retenu qu'il lui faut.
	if ! grep -q '^theme-name=LexOS-Connexion$' "$CONNEXION_CONF"; then
		sed -i -e "s|^theme-name=.*|theme-name=${GTK_BASE}|" "$CONNEXION_CONF"
	fi
fi

#  L'import du thème de connexion pointe vers le thème de base DEMANDÉ par le
#  hook 0410. Si la vérification plus haut en a retenu un autre (le socle
#  absent), l'import montrerait un dossier qui n'existe pas et l'écran de
#  connexion perdrait sa mise en forme de base. On le réécrit d'après le nom
#  RÉELLEMENT retenu — même raison que pour xsettings.xml juste au-dessus.
CONNEXION_CSS="$CONNEXION_THEMES/LexOS-Connexion/gtk-3.0/gtk.css"
if [ -f "$CONNEXION_CSS" ]; then
	CONNEXION_BASE="$CONNEXION_THEMES/${GTK_BASE}/gtk-3.0/gtk.css"
	if [ -r "$CONNEXION_BASE" ]; then
		sed -i "1s|^@import url(\"file://.*\");$|@import url(\"file://${CONNEXION_BASE}\");|" \
			"$CONNEXION_CSS"
	fi
fi

#  L'ACCENT. connexion.css est écrit en orange (#E8590C), l'accent par défaut.
#  Une ISO montée en bleu ou en néon aurait sinon un bureau d'une couleur et un
#  écran de connexion d'une autre — deux vérités pour un seul réglage. On lit
#  l'accent réellement produit par lexos-theme-gen (il l'écrit dans theme.conf)
#  et on le substitue, exactement comme lexos-theme-gen le fait pour les icônes.
CONNEXION_ACCENT=""
CONNEXION_ACCENT_HI=""
CONNEXION_ACCENT_LO=""
if [ -r "$CONNEXION_SKEL/.config/lexos/theme.conf" ]; then
	CONNEXION_ACCENT="$(sed -n 's/^LEXOS_ACCENT=//p' "$CONNEXION_SKEL/.config/lexos/theme.conf" | head -1)"
	CONNEXION_ACCENT_HI="$(sed -n 's/^LEXOS_ACCENT_HI=//p' "$CONNEXION_SKEL/.config/lexos/theme.conf" | head -1)"
	CONNEXION_ACCENT_LO="$(sed -n 's/^LEXOS_ACCENT_LO=//p' "$CONNEXION_SKEL/.config/lexos/theme.conf" | head -1)"
fi
if [ -n "$CONNEXION_ACCENT" ] && [ "$CONNEXION_ACCENT" != "#E8590C" ]; then
	for F in "$CONNEXION_CSS" "$CONNEXION_LIGHTDM_HOME/.config/gtk-3.0/gtk.css"; do
		[ -f "$F" ] || continue
		sed -i -e "s/#E8590C/${CONNEXION_ACCENT}/gI" \
			-e "s/#FF7A33/${CONNEXION_ACCENT_HI}/gI" \
			-e "s/#A84007/${CONNEXION_ACCENT_LO}/gI" "$F"
	done
	echo "[lexos]   connexion : accent ${CONNEXION_ACCENT}"
fi
# <<< banc: connexion

#  Et dans build.conf, pour que lexos-firstrun applique les MÊMES noms à
#  l'ouverture de session — c'est lui qui a le dernier mot sur l'écran.
mkdir -p /etc/lexos
touch /etc/lexos/build.conf
#  DEUX CLÉS, DEUX SENS, ET IL FAUT LES LIRE COMME TELLES :
#    · LEXOS_GTK_BASE_THEME = le thème que la SESSION affiche (LexOS-Noir).
#      C'est ce que firstrun pose dans xfconf. Ne pas le donner au générateur.
#    · LEXOS_GTK_SOCLE      = le thème sur lequel LexOS-Noir est CONSTRUIT.
#      C'est celui-là que firstrun passe à lexos-theme-gen, pour que la
#      première session refabrique le MÊME thème que la construction — y
#      compris sur une machine où le socle demandé n'a pas été posé, où celui
#      retenu ici n'est pas celui par défaut.
#    · LEXOS_XFWM_THEME     = le thème de BORDURES DE FENÊTRE. Il était écrit
#      par le seul hook 0610, qui dérive « LexOS-Arc-… ». Or 0610 s'arrête
#      AVANT d'écrire quoi que ce soit quand il n'a rien pu dériver (pas
#      d'arc-theme, pas d'ImageMagick) — la clé restait alors ABSENTE, et
#      lexos-firstrun retombait sur LEXOS_GTK_BASE_THEME, c'est-à-dire
#      « LexOS-Noir »… qui n'a pas de dossier xfwm4, étant une feuille de
#      style dans le foyer. Résultat : xfwm4 retombait sur « Default », des
#      bordures GRISES au milieu d'un bureau noir, sans un mot dans le
#      journal. On publie donc ICI la valeur déjà calculée plus haut ; 0610
#      la remplace par la sienne quand il réussit, puisqu'il passe après.
for PAIRE in "LEXOS_GTK_BASE_THEME=${GTK_BASE}" "LEXOS_GTK_SOCLE=${GTK_SOCLE}" \
             "LEXOS_ICON_THEME=${ICONS}" "LEXOS_XFWM_THEME=${XFWM_THEME}" \
             "LEXOS_TERMINAL_MODE=${TERM_MODE}"; do
	CLE="${PAIRE%%=*}"
	if grep -q "^${CLE}=" /etc/lexos/build.conf; then
		sed -i "s|^${CLE}=.*|${CLE}=\"${PAIRE#*=}\"|" /etc/lexos/build.conf
	else
		echo "${CLE}=\"${PAIRE#*=}\"" >> /etc/lexos/build.conf
	fi
done

# --- Terminal : la palette est écrite par lexos-theme-gen -------------------
#  CE BLOC NE FAISAIT QU'UN « mkdir », sous un titre qui annonçait « noir +
#  vert dark » : le dossier était créé et RIEN n'était écrit dedans. Le
#  terminalrc vient maintenant de lexos-theme-gen, appelé plus haut. On garde
#  le mkdir pour le cas où lexos-theme-gen manque : xfce4-terminal veut un
#  dossier existant pour y écrire ses propres réglages.
#  Et on VÉRIFIE, au lieu d'espérer : un terminalrc absent se voit ici, pas
#  sur une photo trois jours plus tard.
if [ -r /etc/skel/.config/xfce4/terminal/terminalrc ]; then
	echo "[lexos]   terminal : palette « ${TERM_MODE} » écrite dans /etc/skel"
else
	echo "[lexos]   !! aucun terminalrc dans /etc/skel — le terminal gardera les couleurs de Debian"
fi

# --- Terminal : aussi pour les autres émulateurs ---------------------------
mkdir -p /etc/skel/.config/xfce4/terminal

# --- Position du dock demandée dans lexos.conf ------------------------------
DOCK_DB="/etc/dconf/db/local.d/00-lexos-dock"
if [ -f "$DOCK_DB" ] && [ -n "${LEXOS_DOCK_POSITION:-}" ]; then
	case "$LEXOS_DOCK_POSITION" in
		right|left|bottom|top)
			sed -i "s/^position=.*/position='${LEXOS_DOCK_POSITION}'/" "$DOCK_DB"
			echo "[lexos]   dock : ${LEXOS_DOCK_POSITION}"
			;;
		*) echo "[lexos]   !! position de dock invalide : ${LEXOS_DOCK_POSITION}" ;;
	esac
fi

# --- Schémas GSettings : compiler NOS surcharges ----------------------------
#  ALEX, PHOTOS DE LA LOGITHÈQUE : « on voit pas les écritures ». Les cartes
#  des applications étaient BLANCHES, le nom écrit en blanc dessus.
#
#  La cause tient en une phrase, et c'est libadwaita qui la dit — relevée mot
#  pour mot dans son binaire : « Using GtkSettings:gtk-application-prefer-dark-
#  theme with libadwaita is unsupported. » Notre mode sombre est annoncé par
#  CE réglage-là (juste au-dessus, dans /etc/gtk-3.0/settings.ini), donc la
#  Logithèque — GTK 4 + libadwaita — l'ignorait et rendait en CLAIR.
#  90-lexos-sombre.gschema.override lui parle enfin sa langue :
#  « org.gnome.desktop.interface color-scheme=prefer-dark ».
#
#  ═══ ET SANS CETTE LIGNE-CI, CE FICHIER NE SERVIRAIT À RIEN ═══
#  Une surcharge n'agit qu'une fois COMPILÉE dans gschemas.compiled. Les
#  paquets le font par un déclencheur dpkg — mais eux s'installent AVANT que
#  includes.chroot ne dépose notre fichier. Le correctif serait donc arrivé
#  après le seul moment où quelqu'un compilait : présent dans l'ISO, et sans
#  aucun effet. Exactement le piège des icônes non déclarées.
#
#  Non bloquant, et sûr : glib-compile-schemas IGNORE une surcharge qui vise
#  un schéma absent (vérifié — code de retour 0, gschemas.compiled quand même
#  écrit), donc une Logithèque non installée ne peut pas casser la construction.
SCHEMAS_DIR="/usr/share/glib-2.0/schemas"
if command -v glib-compile-schemas >/dev/null 2>&1; then
	if glib-compile-schemas "$SCHEMAS_DIR" >/dev/null 2>&1; then
		echo "[lexos]   schémas GSettings recompilés"
	else
		echo "[lexos]   !! glib-compile-schemas a échoué (non bloquant)"
	fi
	#  ON VÉRIFIE, AU LIEU D'ESPÉRER. Une surcharge silencieusement écartée
	#  (schéma absent, faute de frappe dans le nom de la clé) ne se verrait
	#  autrement que sur une photo de la Logithèque, trois jours plus tard.
	if command -v gsettings >/dev/null 2>&1; then
		VU_SCHEME="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)"
		case "$VU_SCHEME" in
			*prefer-dark*) echo "[lexos]   color-scheme : ${VU_SCHEME} — la Logithèque sera sombre" ;;
			"")            echo "[lexos]   !! org.gnome.desktop.interface absent — surcharge sans effet (Logithèque non installée ?)" ;;
			*)             echo "[lexos]   !! color-scheme vaut ${VU_SCHEME} : la Logithèque resterait en clair" ;;
		esac
	fi
else
	echo "[lexos]   !! glib-compile-schemas absent — la Logithèque resterait en clair"
fi

# --- Base de données dconf (dock Plank + effets Compiz) ---------------------
if command -v dconf >/dev/null 2>&1; then
	dconf update >/dev/null 2>&1 \
		&& echo "[lexos]   base dconf mise à jour" \
		|| echo "[lexos]   !! dconf update a échoué (non bloquant)"
else
	echo "[lexos]   dconf absent — réglages du dock non compilés"
fi

echo "[lexos] hook 0600 : ok"

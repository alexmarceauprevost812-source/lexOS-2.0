#!/bin/sh
# =============================================================================
#  LexOS — brancher le terminal sur les réglages LexOS
# =============================================================================
#  L'invite, les alias et la touche Tab vivent dans
#  /usr/share/lexos/shell/interactive.sh. Ce hook les branche aux trois
#  endroits que bash lit, parce qu'AUCUN ne suffit seul :
#
#    /etc/profile.d/lexos.sh  déjà livré — mais lu par les seuls shells de
#                             CONNEXION. Le terminal du bureau n'y passe pas.
#    /etc/bash.bashrc         lu par tout shell interactif, root compris.
#    /etc/skel/.bashrc        lu APRÈS /etc/bash.bashrc, et il repose SA propre
#                             invite. Sans un rappel à la fin, l'invite LexOS
#                             serait écrasée par celle de Debian dans le
#                             terminal du bureau.
#
#  Idempotent : on repère notre ligne avant d'écrire, donc relancer le hook
#  (ou reconstruire) n'empile pas les doublons.
#
#  Ce hook pose aussi le MODE de terminal livré d'usine — « suivre », c'est-
#  à-dire : le terminal suit « lexos theme sombre|clair ». Les deux autres
#  choix (« jour », « nuit », « auto ») se prennent après coup avec
#  « lexos terminal ». On écrit le fichier plutôt que de laisser le défaut
#  implicite pour que la commande « lexos terminal » ait quelque chose à
#  montrer dès le premier démarrage, au lieu d'un état deviné.
# =============================================================================
set -e

echo "[lexos] hook 0120 : terminal (invite, alias, touche Tab, jour/nuit)"

CIBLE="/usr/share/lexos/shell/interactive.sh"
MARQUE="# >>> LexOS — invite, alias et touche Tab >>>"

if [ ! -r "$CIBLE" ]; then
	echo "[lexos]   !! $CIBLE absent — le terminal resterait celui de Debian"
	exit 1
fi

# Vérifie que le fichier est du shell valable AVANT de le brancher partout :
# une faute de frappe ici casserait l'ouverture de tous les terminaux.
if ! sh -n "$CIBLE"; then
	echo "[lexos]   !! $CIBLE contient une erreur de syntaxe"
	exit 1
fi

brancher() {
	fichier="$1"
	[ -e "$fichier" ] || touch "$fichier"
	if grep -qF "$MARQUE" "$fichier" 2>/dev/null; then
		echo "[lexos]   déjà branché : $fichier"
		return 0
	fi
	cat >> "$fichier" <<EOF

$MARQUE
#  Ajouté par LexOS (hook 0120). Enlève ce bloc pour retrouver le terminal
#  Debian d'origine : rien d'autre n'en dépend.
if [ -r $CIBLE ]; then
	. $CIBLE
fi
# <<< LexOS <<<
EOF
	echo "[lexos]   branché : $fichier"
}

brancher /etc/bash.bashrc
brancher /etc/skel/.bashrc

# Le compte root est créé avant /etc/skel dans certaines images : on lui pose
# le même rappel, sinon « sudo -i » retombe sur l'invite Debian nue.
[ -d /root ] && brancher /root/.bashrc

# --- La commande jour / nuit -------------------------------------------------
if [ -x /usr/bin/lexos-terminal ]; then
	#  Même précaution que pour interactive.sh : un script cassé ici et
	#  « lexos terminal » ne répondrait plus, sans que rien ne le signale
	#  avant le premier démarrage de l'ISO.
	if bash -n /usr/bin/lexos-terminal; then
		echo "[lexos]   lexos-terminal : ok"
	else
		echo "[lexos]   !! /usr/bin/lexos-terminal contient une erreur de syntaxe"
		exit 1
	fi
else
	echo "[lexos]   !! /usr/bin/lexos-terminal absent — pas de bascule jour/nuit"
fi

# Mode livré d'usine, pour /etc/skel et pour root.
for RACINE in /etc/skel /root; do
	[ -d "$RACINE" ] || continue
	mkdir -p "$RACINE/.config/lexos"
	[ -e "$RACINE/.config/lexos/terminal-mode" ] \
		|| printf 'suivre\n' > "$RACINE/.config/lexos/terminal-mode"
	[ -e "$RACINE/.config/lexos/terminal-horaire" ] || cat > "$RACINE/.config/lexos/terminal-horaire" <<'EOF'
# LexOS — les heures du terminal de jour (mode « auto »).
LEXOS_JOUR_DEBUT=07:00
LEXOS_JOUR_FIN=19:00
EOF
done

#  La minuterie n'est PAS activée à la construction : elle ne sert qu'au mode
#  « auto », et c'est « lexos terminal auto » qui l'allume pour l'utilisateur
#  qui la demande. L'activer d'office ferait tourner un service toutes les
#  quinze minutes chez tout le monde, pour un réglage que personne n'a choisi.
if [ -r /usr/lib/systemd/user/lexos-terminal-auto.timer ]; then
	echo "[lexos]   minuterie jour/nuit livrée (inactive tant que « lexos terminal auto » n'est pas tapé)"
else
	echo "[lexos]   !! lexos-terminal-auto.timer absent — le mode auto ne basculera pas tout seul"
fi

echo "[lexos]   ok — l'invite, les alias et Tab suivent dans tous les terminaux"

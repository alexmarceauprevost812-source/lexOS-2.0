#!/bin/sh
# =============================================================================
#  LexOS — habillage de l'installateur Calamares
# =============================================================================
set -e

echo "[lexos] hook 0500 : installateur"

#  La saveur est lue tôt : le test « Calamares obligatoire » plus bas tolère
#  la saveur minimal (sans bureau, donc sans installateur graphique).
LEXOS_FLAVOUR="standard"
if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
fi

# =============================================================================
#  DOUBLE DÉMARRAGE — la vérification qui ne doit jamais sauter
# =============================================================================
#  Une ISO a été livrée sans de quoi voir Windows au démarrage : os-prober
#  n'était dans aucune liste, et GRUB_DISABLE_OS_PROBER restait au défaut
#  de Debian (true, depuis GRUB 2.06). Installer LexOS à côté de Windows
#  donnait alors un menu qui n'affichait que LexOS. Rien n'était perdu, mais
#  ça ne se découvrait qu'APRÈS l'installation — le pire moment.
#  Les deux pièces sont vérifiées ici, et leur absence ARRÊTE la
#  construction : mieux vaut pas d'ISO qu'une ISO au double démarrage muet.
#  IMPORTANT : ce bloc est AVANT le test de présence de Calamares. os-prober
#  et le drop-in GRUB servent aussi au chemin d-i (installateur Debian), donc
#  la garantie double démarrage ne doit pas dépendre de Calamares — sinon un
#  Calamares manquant ferait sauter la vérification en silence.
if ! command -v os-prober >/dev/null 2>&1; then
	echo "[lexos]   !! os-prober absent : le menu de démarrage ne verrait pas Windows"
	exit 1
fi
if ! grep -rqs '^GRUB_DISABLE_OS_PROBER=false' /etc/default/grub /etc/default/grub.d; then
	echo "[lexos]   !! GRUB_DISABLE_OS_PROBER=false introuvable dans /etc/default/grub.d"
	echo "[lexos]      (posé par le hook 0100 — a-t-il tourné ?)"
	exit 1
fi
echo "[lexos]   double démarrage : os-prober présent, recherche des autres systèmes active"

#  Calamares est maintenant dans la liste OBLIGATOIRE (lexos-core.list.chroot) :
#  son absence est donc anormale et doit ARRÊTER la construction, pas être
#  ignorée en silence comme avant. Les saveurs sans bureau (minimal) n'ont pas
#  d'installateur graphique et sont tolérées ici.
if [ ! -x /usr/bin/calamares ]; then
	if [ "${LEXOS_FLAVOUR:-standard}" = "minimal" ]; then
		echo "[lexos] hook 0500 : saveur minimal sans Calamares, ignoré"
		exit 0
	fi
	echo "[lexos]   !! Calamares absent alors qu'il est en liste obligatoire"
	exit 1
fi

LEXOS_NAME="LexOS"
LEXOS_VERSION="1.0"
LEXOS_CODENAME="Nomad"
LEXOS_HOME_URL="https://github.com/alexmarceauprevost812-source/logiciel-ti-lex-"
LEXOS_BUG_URL="${LEXOS_HOME_URL}/issues"

#  build.conf a déjà été lu plus haut (pour la saveur) ; on le relit ici au
#  cas où, sans effet de bord (mêmes affectations).
if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
fi

BRANDING_DIR="/usr/share/calamares/branding/lexos"
mkdir -p "$BRANDING_DIR"

# --- Visuels de l'installateur ----------------------------------------------
SRC="/usr/share/lexos/branding"
#  Même logo que le dock et le menu : l'emblème TI-LEX-AL, pas logo.svg.
if [ -r "$SRC/logo-ti-lex-al-icon.png" ] && command -v convert >/dev/null 2>&1; then
	convert "$SRC/logo-ti-lex-al-icon.png" -resize 160x160 "$BRANDING_DIR/logo.png" || true
elif [ -r "$SRC/logo.svg" ] && command -v rsvg-convert >/dev/null 2>&1; then
	rsvg-convert -w 160 -h 160 -o "$BRANDING_DIR/logo.png" "$SRC/logo.svg" || true
fi
if [ -r "$SRC/wallpaper.svg" ] && command -v rsvg-convert >/dev/null 2>&1; then
	rsvg-convert -w 1280 -h 720 -o "$BRANDING_DIR/welcome.png" "$SRC/wallpaper.svg" || true
fi

cat > "$BRANDING_DIR/branding.desc" <<EOF
---
componentName: lexos

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

navigation: widget
sidebar: widget

strings:
    productName:         "${LEXOS_NAME} ${LEXOS_VERSION}"
    shortProductName:    "${LEXOS_NAME}"
    version:             "${LEXOS_VERSION} ${LEXOS_CODENAME}"
    shortVersion:        "${LEXOS_VERSION}"
    versionedName:       "${LEXOS_NAME} ${LEXOS_VERSION} ${LEXOS_CODENAME}"
    shortVersionedName:  "${LEXOS_NAME} ${LEXOS_VERSION}"
    bootloaderEntryName: "${LEXOS_NAME}"
    productUrl:          "${LEXOS_HOME_URL}"
    supportUrl:          "${LEXOS_HOME_URL}"
    knownIssuesUrl:      "${LEXOS_BUG_URL}"
    releaseNotesUrl:     "${LEXOS_HOME_URL}/releases"

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            2

style:
    sidebarBackground:    "#141110"
    sidebarText:          "#F4EFEA"
    sidebarTextSelect:    "#E8590C"
    sidebarTextCurrent:   "#FFB067"
EOF

# --- Diaporama pendant l'installation ---------------------------------------
cat > "$BRANDING_DIR/show.qml" <<EOF
import QtQuick 2.0
import calamares.slideshow 1.0

Presentation {
    id: presentation

    Timer {
        interval: 12000
        running: true
        repeat: true
        onTriggered: presentation.goToNextSlide()
    }

    Slide {
        Rectangle {
            anchors.fill: parent
            color: "#141110"
            Column {
                anchors.centerIn: parent
                spacing: 18
                Text {
                    text: "${LEXOS_NAME} ${LEXOS_VERSION}"
                    color: "#E8590C"
                    font.pixelSize: 34
                    font.bold: true
                    anchors.horizontalCenter: parent.horizontalCenter
                }
                Text {
                    text: "Installation en cours — ça ne prend que quelques minutes."
                    color: "#F4EFEA"
                    font.pixelSize: 16
                    anchors.horizontalCenter: parent.horizontalCenter
                }
            }
        }
    }

    Slide {
        Rectangle {
            anchors.fill: parent
            color: "#141110"
            Column {
                anchors.centerIn: parent
                spacing: 14
                Text {
                    text: "Tout est à toi"
                    color: "#E8590C"
                    font.pixelSize: 30
                    font.bold: true
                    anchors.horizontalCenter: parent.horizontalCenter
                }
                Text {
                    text: "Pas de télémétrie, pas de compte obligatoire, pas de pub."
                    color: "#F4EFEA"
                    font.pixelSize: 16
                    anchors.horizontalCenter: parent.horizontalCenter
                }
            }
        }
    }

    Slide {
        Rectangle {
            anchors.fill: parent
            color: "#141110"
            Column {
                anchors.centerIn: parent
                spacing: 14
                Text {
                    text: "Après l'installation"
                    color: "#E8590C"
                    font.pixelSize: 30
                    font.bold: true
                    anchors.horizontalCenter: parent.horizontalCenter
                }
                Text {
                    text: "Ouvre un terminal et tape « lexos help »."
                    color: "#F4EFEA"
                    font.pixelSize: 16
                    anchors.horizontalCenter: parent.horizontalCenter
                }
            }
        }
    }

    function onActivate()  { presentation.currentSlide = 0 }
    function onLeave()     { }
}
EOF

# --- Activer notre branding --------------------------------------------------
if [ -f /etc/calamares/settings.conf ]; then
	sed -i 's/^branding:.*/branding: lexos/' /etc/calamares/settings.conf
fi

# --- Chiffrement du disque : « mot de passe sur le disque dur » --------------
#  Coché, l'installateur demande une phrase secrète et chiffre TOUT le disque
#  (LUKS2). Sans elle, le contenu est illisible même en sortant le disque de
#  la machine. C'est la vraie protection contre le vol de l'ordinateur.
if [ -f /etc/calamares/modules/partition.conf ]; then
	CONF="/etc/calamares/modules/partition.conf"

	set_opt() { # set_opt <clé> <valeur>
		if grep -qE "^[#[:space:]]*$1:" "$CONF"; then
			sed -i "s|^[#[:space:]]*$1:.*|$1: $2|" "$CONF"
		else
			printf '%s: %s\n' "$1" "$2" >> "$CONF"
		fi
	}

	set_opt enableLuksAutomatedPartitioning true
	set_opt luksGeneration luks2
	echo "[lexos]   chiffrement du disque proposé à l'installation (LUKS2)"
else
	echo "[lexos]   !! partition.conf absent — chiffrement non préconfiguré"
fi

# Le déverrouillage au démarrage exige les outils dans l'initramfs.
if [ -d /etc/initramfs-tools ]; then
	mkdir -p /etc/initramfs-tools/conf.d
	printf 'CRYPTSETUP=y\n' > /etc/initramfs-tools/conf.d/lexos-crypt.conf
fi

# --- Raccourci « Installer LexOS » ------------------------------------------
#  Exec pointe sur lexos-install, PAS directement sur calamares : ce wrapper
#  vérifie qu'on est bien en session démo et exige une confirmation avant
#  toute opération susceptible d'effacer le disque dur.
mkdir -p /usr/share/applications /etc/skel/Bureau /etc/skel/Desktop
cat > /usr/share/applications/lexos-install.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Installer ${LEXOS_NAME} sur le disque
Name[en]=Install ${LEXOS_NAME} to disk
Comment=Essaie d'abord la démo depuis la clé USB — l'installation peut effacer le disque dur
Exec=lexos-install
Icon=lexos
Terminal=false
Categories=System;
Keywords=install;installer;calamares;disque;
EOF

cat > /usr/share/applications/lexos-demo.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Essayer ${LEXOS_NAME} (démo)
Name[en]=Try ${LEXOS_NAME} (demo)
Comment=Session live : rien n'est écrit sur ton disque dur
Exec=lexos-welcome
Icon=lexos
Terminal=false
Categories=System;
Keywords=demo;live;essai;
EOF

for D in /etc/skel/Bureau /etc/skel/Desktop; do
	cp /usr/share/applications/lexos-demo.desktop    "$D/"
	cp /usr/share/applications/lexos-install.desktop "$D/"
	chmod +x "$D"/*.desktop
done

echo "[lexos] hook 0500 : ok"

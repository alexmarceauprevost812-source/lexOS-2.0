#!/bin/sh
# =============================================================================
#  LexOS — habillage de l'installateur Calamares
# =============================================================================
set -e

echo "[lexos] hook 0500 : installateur"

#  La saveur est lue tôt : le test « Calamares obligatoire » plus bas tolère
#  la saveur minimal (sans bureau, donc sans installateur graphique).
LEXOS_FLAVOUR="standard"
if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
fi

# =============================================================================
#  DOUBLE DÉMARRAGE — la vérification qui ne doit jamais sauter
# =============================================================================
#  Une ISO a été livrée sans de quoi voir Windows au démarrage : os-prober
#  n'était dans aucune liste, et GRUB_DISABLE_OS_PROBER restait au défaut
#  de Debian (true, depuis GRUB 2.06). Installer LexOS à côté de Windows
#  donnait alors un menu qui n'affichait que LexOS. Rien n'était perdu, mais
#  ça ne se découvrait qu'APRÈS l'installation — le pire moment.
#  Les deux pièces sont vérifiées ici, et leur absence ARRÊTE la
#  construction : mieux vaut pas d'ISO qu'une ISO au double démarrage muet.
#  IMPORTANT : ce bloc est AVANT le test de présence de Calamares. os-prober
#  et le drop-in GRUB servent aussi au chemin d-i (installateur Debian), donc
#  la garantie double démarrage ne doit pas dépendre de Calamares — sinon un
#  Calamares manquant ferait sauter la vérification en silence.
if ! command -v os-prober >/dev/null 2>&1; then
	echo "[lexos]   !! os-prober absent : le menu de démarrage ne verrait pas Windows"
	exit 1
fi
if ! grep -rqs '^GRUB_DISABLE_OS_PROBER=false' /etc/default/grub /etc/default/grub.d; then
	echo "[lexos]   !! GRUB_DISABLE_OS_PROBER=false introuvable dans /etc/default/grub.d"
	echo "[lexos]      (posé par le hook 0100 — a-t-il tourné ?)"
	exit 1
fi
echo "[lexos]   double démarrage : os-prober présent, recherche des autres systèmes active"

#  Même logique que pour os-prober juste au-dessus : Calamares appellera
#  grub-install sur le disque cible à la TOUTE DERNIÈRE étape de
#  l'installation, une fois la partition voisine déjà redimensionnée. Si le
#  paquet manque à ce moment-là (pas de réseau, le cas normal), l'échec
#  arrive après coup — le pire moment possible. On l'arrête ici plutôt que
#  de livrer une ISO qui échouerait tard.
if [ ! -x /usr/sbin/grub-install ] && [ ! -x /usr/bin/grub-install ]; then
	echo "[lexos]   !! grub-install absent : l'installation échouerait à l'étape du démarrage"
	exit 1
fi
echo "[lexos]   programme de démarrage : grub-install présent"

# --- Windows par défaut au démarrage, quand Windows est là -------------------
#  Demande d'Alex : Windows sert à jouer, LexOS à travailler ; au démarrage le
#  menu propose les deux et part sur Windows si personne ne touche à rien.
#  Le hook 0100 a posé GRUB_DEFAULT=saved, GRUB_TIMEOUT=8 et
#  GRUB_TIMEOUT_STYLE=menu ; ce service écrit l'entrée Windows dans grubenv au
#  premier démarrage du système installé, quand os-prober a enfin vu le vrai
#  disque. En session démo il sort immédiatement.
chmod 0755 /usr/lib/lexos/grub-defaut-windows 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
	systemctl enable lexos-grub-defaut.service >/dev/null 2>&1 \
		&& echo "[lexos]   démarrage par défaut : Windows s'il est présent (menu 8 s)" \
		|| echo "[lexos]   !! service lexos-grub-defaut non activé"
fi

# --- L'heure juste dans les DEUX systèmes ------------------------------------
#  preseed.cfg met l'horloge matérielle en UTC — le bon choix pour Linux seul,
#  et exactement ce qui décale l'heure de 4 ou 5 h à chaque bascule quand
#  Windows partage la machine (lui la lit en heure locale). Ce service regarde
#  si Windows est dans le menu au premier démarrage du système installé et
#  aligne LexOS sur lui le cas échéant. Sans Windows, rien n'est modifié.
chmod 0755 /usr/lib/lexos/heure-dualboot 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
	systemctl enable lexos-heure-dualboot.service >/dev/null 2>&1 \
		&& echo "[lexos]   horloge accordée avec Windows s'il est présent" \
		|| echo "[lexos]   !! service lexos-heure-dualboot non activé"
fi

# --- La même ISO sur n'importe quelle machine --------------------------------
#  L'ISO « pro » embarque le pilote NVIDIA et pose deux fichiers dans
#  /etc/modprobe.d/ — dont l'interdiction de nouveau, sans laquelle la RTX 5060
#  de l'Alienware n'affiche rien. Mais ces fichiers sont écrits à la
#  CONSTRUCTION, sans savoir où l'ISO démarrera.
#
#  Sur une machine sans carte NVIDIA (le ThinkPad 2016 et ses graphiques
#  Intel), ça ne coûte rien. Sur une machine à VIEILLE carte NVIDIA que le
#  pilote 595 ne gère plus, ce serait l'écran noir : nouveau interdit, le
#  propriétaire incapable de prendre la carte. Exactement la panne qu'on vient
#  de mettre des semaines à comprendre, mais à l'envers.
#
#  Ce service regarde la carte réellement présente au démarrage et range ou
#  remet ces réglages en conséquence. Réversible : déplacer le disque dans une
#  autre machine les remet tout seuls. Rien n'est jamais supprimé.
chmod 0755 /usr/lib/lexos/gpu-garde 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
	systemctl enable lexos-gpu-garde.service >/dev/null 2>&1 \
		&& echo "[lexos]   réglages NVIDIA adaptés à la carte présente au démarrage" \
		|| echo "[lexos]   !! service lexos-gpu-garde non activé"
fi

#  Contrôle de construction : les trois réglages dont ce service dépend
#  doivent être dans /etc/default/grub.d/lexos.cfg. Si quelqu'un les retire un
#  jour, le service écrirait dans grubenv un défaut que GRUB n'irait jamais
#  lire — une panne parfaitement silencieuse. On le dit maintenant.
for REGLAGE in "GRUB_DEFAULT=saved" "GRUB_TIMEOUT=8" "GRUB_TIMEOUT_STYLE=menu"; do
	if ! grep -rqs "^${REGLAGE}" /etc/default/grub.d/ /etc/default/grub; then
		echo "[lexos]   !! ${REGLAGE} absent — le défaut Windows ne serait pas lu"
	fi
done

#  Calamares est maintenant dans la liste OBLIGATOIRE (lexos-core.list.chroot) :
#  son absence est donc anormale et doit ARRÊTER la construction, pas être
#  ignorée en silence comme avant. Les saveurs sans bureau (minimal) n'ont pas
#  d'installateur graphique et sont tolérées ici.
if [ ! -x /usr/bin/calamares ]; then
	if [ "${LEXOS_FLAVOUR:-standard}" = "minimal" ]; then
		echo "[lexos] hook 0500 : saveur minimal sans Calamares, ignoré"
		exit 0
	fi
	echo "[lexos]   !! Calamares absent alors qu'il est en liste obligatoire"
	exit 1
fi

LEXOS_NAME="LexOS"
LEXOS_VERSION="1.0"
LEXOS_CODENAME="Nomad"
LEXOS_HOME_URL="https://github.com/alexmarceauprevost812-source/lexOS-2.0"
LEXOS_BUG_URL="${LEXOS_HOME_URL}/issues"

#  build.conf a déjà été lu plus haut (pour la saveur) ; on le relit ici au
#  cas où, sans effet de bord (mêmes affectations).
if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
fi

BRANDING_DIR="/usr/share/calamares/branding/lexos"
mkdir -p "$BRANDING_DIR"

# --- Visuels de l'installateur ----------------------------------------------
SRC="/usr/share/lexos/branding"
#  Même logo que le dock et le menu : l'emblème TI-LEX-AL, pas logo.svg.
if [ -r "$SRC/logo-ti-lex-al-icon.png" ] && command -v convert >/dev/null 2>&1; then
	convert "$SRC/logo-ti-lex-al-icon.png" -resize 160x160 "$BRANDING_DIR/logo.png" || true
elif [ -r "$SRC/logo.svg" ] && command -v rsvg-convert >/dev/null 2>&1; then
	rsvg-convert -w 160 -h 160 -o "$BRANDING_DIR/logo.png" "$SRC/logo.svg" || true
fi
if [ -r "$SRC/wallpaper.svg" ] && command -v rsvg-convert >/dev/null 2>&1; then
	rsvg-convert -w 1280 -h 720 -o "$BRANDING_DIR/welcome.png" "$SRC/wallpaper.svg" || true
fi

cat > "$BRANDING_DIR/branding.desc" <<EOF
---
componentName: lexos

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

navigation: widget
sidebar: widget

strings:
    productName:         "${LEXOS_NAME} ${LEXOS_VERSION}"
    shortProductName:    "${LEXOS_NAME}"
    version:             "${LEXOS_VERSION} ${LEXOS_CODENAME}"
    shortVersion:        "${LEXOS_VERSION}"
    versionedName:       "${LEXOS_NAME} ${LEXOS_VERSION} ${LEXOS_CODENAME}"
    shortVersionedName:  "${LEXOS_NAME} ${LEXOS_VERSION}"
    bootloaderEntryName: "${LEXOS_NAME}"
    productUrl:          "${LEXOS_HOME_URL}"
    supportUrl:          "${LEXOS_HOME_URL}"
    knownIssuesUrl:      "${LEXOS_BUG_URL}"
    releaseNotesUrl:     "${LEXOS_HOME_URL}/releases"

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            2

#  ═══ LA CASSE DE CES QUATRE CLÉS N'EST PAS UN DÉTAIL DE STYLE ═══
#  ALEX, PHOTO DE L'INSTALLATEUR : le bandeau de gauche était ILLISIBLE —
#  seule l'étape courante se distinguait, les autres n'apparaissaient pas du
#  tout. Ce n'était pas un manque de contraste : c'était du NOIR SUR NOIR.
#
#  Les quatre clés étaient écrites en minuscule initiale
#  (« sidebarBackground »…). Calamares 3.3 les compare aux noms de son enum
#  C++ Branding::StyleEntry, résolus par QMetaEnum::valueToKey — donc avec
#  une MAJUSCULE initiale. Vérifié deux fois : les seules chaînes présentes
#  dans le libcalamaresui.so livré sont « SidebarBackground »,
#  « SidebarBackgroundCurrent », « SidebarText » et « SidebarTextCurrent »,
#  et l'exemple officiel amont (src/branding/default/branding.desc) les
#  écrit bien ainsi.
#
#  CONSÉQUENCE, ET ELLE EST SILENCIEUSE : une clé inconnue n'arrête rien.
#  Calamares écrit « Unknown branding *style* entry » dans un journal que
#  personne ne lit, puis styleString() rend une chaîne VIDE pour chacune des
#  quatre vraies entrées. QColor("") est invalide, et une couleur invalide
#  se peint en NOIR. Le bandeau avait donc son texte noir sur son fond noir,
#  sans le moindre message d'erreur.
#
#  « sidebarTextSelect » n'existe dans AUCUNE casse : c'est une clé de
#  Calamares 3.2, disparue en 3.3. La bonne quatrième clé est
#  SidebarBackgroundCurrent — le fond de l'étape courante. Sans elle, ce
#  fond retombait sur palette().window() du style Qt.
#
#  Le couple courant suit le motif de l'exemple amont : texte SOMBRE sur le
#  surlignage d'accent, et non l'inverse.
style:
    SidebarBackground:        "#141110"
    SidebarText:              "#F4EFEA"
    SidebarTextCurrent:       "#141110"
    SidebarBackgroundCurrent: "#E8590C"
EOF

# --- Diaporama pendant l'installation ---------------------------------------
cat > "$BRANDING_DIR/show.qml" <<EOF
import QtQuick 2.0
import calamares.slideshow 1.0

Presentation {
    id: presentation

    Timer {
        interval: 12000
        running: true
        repeat: true
        onTriggered: presentation.goToNextSlide()
    }

    Slide {
        Rectangle {
            anchors.fill: parent
            color: "#141110"
            Column {
                anchors.centerIn: parent
                spacing: 18
                Text {
                    text: "${LEXOS_NAME} ${LEXOS_VERSION}"
                    color: "#E8590C"
                    font.pixelSize: 34
                    font.bold: true
                    anchors.horizontalCenter: parent.horizontalCenter
                }
                Text {
                    text: "Installation en cours — ça ne prend que quelques minutes."
                    color: "#F4EFEA"
                    font.pixelSize: 16
                    anchors.horizontalCenter: parent.horizontalCenter
                }
            }
        }
    }

    Slide {
        Rectangle {
            anchors.fill: parent
            color: "#141110"
            Column {
                anchors.centerIn: parent
                spacing: 14
                Text {
                    text: "Tout est à toi"
                    color: "#E8590C"
                    font.pixelSize: 30
                    font.bold: true
                    anchors.horizontalCenter: parent.horizontalCenter
                }
                Text {
                    text: "Pas de télémétrie, pas de compte obligatoire, pas de pub."
                    color: "#F4EFEA"
                    font.pixelSize: 16
                    anchors.horizontalCenter: parent.horizontalCenter
                }
            }
        }
    }

    Slide {
        Rectangle {
            anchors.fill: parent
            color: "#141110"
            Column {
                anchors.centerIn: parent
                spacing: 14
                Text {
                    text: "Après l'installation"
                    color: "#E8590C"
                    font.pixelSize: 30
                    font.bold: true
                    anchors.horizontalCenter: parent.horizontalCenter
                }
                Text {
                    text: "Ouvre un terminal et tape « lexos help »."
                    color: "#F4EFEA"
                    font.pixelSize: 16
                    anchors.horizontalCenter: parent.horizontalCenter
                }
            }
        }
    }

    function onActivate()  { presentation.currentSlide = 0 }
    function onLeave()     { }
}
EOF

# --- Activer notre branding --------------------------------------------------
if [ -f /etc/calamares/settings.conf ]; then
	sed -i 's/^branding:.*/branding: lexos/' /etc/calamares/settings.conf
fi

# --- Chiffrement du disque : « mot de passe sur le disque dur » --------------
#  Coché, l'installateur demande une phrase secrète et chiffre TOUT le disque
#  (LUKS2). Sans elle, le contenu est illisible même en sortant le disque de
#  la machine. C'est la vraie protection contre le vol de l'ordinateur.
if [ -f /etc/calamares/modules/partition.conf ]; then
	CONF="/etc/calamares/modules/partition.conf"

	set_opt() { # set_opt <clé> <valeur>
		if grep -qE "^[#[:space:]]*$1:" "$CONF"; then
			sed -i "s|^[#[:space:]]*$1:.*|$1: $2|" "$CONF"
		else
			printf '%s: %s\n' "$1" "$2" >> "$CONF"
		fi
	}

	set_opt enableLuksAutomatedPartitioning true
	set_opt luksGeneration luks2
	echo "[lexos]   chiffrement du disque proposé à l'installation (LUKS2)"

	#  DOUBLE DÉMARRAGE : ces trois réglages viennent du partition.conf que
	#  LexOS livre (config/includes.chroot/etc/calamares/modules/). On les
	#  vérifie ici plutôt que de les supposer — c'est ce qui décide si Alex
	#  voit l'écran « Installer à côté de Windows », et si la partition EFI
	#  de Windows est réutilisée au lieu d'être reformatée.
	for CLE in initialPartitioningChoice efiSystemPartition requiredStorage; do
		if grep -qE "^${CLE}:" "$CONF"; then
			echo "[lexos]   partition : ${CLE} = $(sed -n "s/^${CLE}:[[:space:]]*//p" "$CONF" | head -1)"
		else
			echo "[lexos]   !! partition : ${CLE} absent — double démarrage non garanti"
		fi
	done
else
	#  Debian ne livre AUCUN partition.conf dans calamares-settings-debian :
	#  c'est LexOS qui l'apporte, via includes.chroot. S'il manque ici, c'est
	#  que ce fichier n'a pas été embarqué — et alors ni le chiffrement, ni
	#  l'écran « à côté de Windows », ni la réutilisation de la partition EFI
	#  ne sont configurés. Ce n'est pas un détail : on le dit fort.
	echo "[lexos]   !! partition.conf ABSENT — ni chiffrement, ni double démarrage configurés"
	echo "[lexos]   !! attendu : /etc/calamares/modules/partition.conf (livré par LexOS)"
fi

# Le déverrouillage au démarrage exige les outils dans l'initramfs.
if [ -d /etc/initramfs-tools ]; then
	mkdir -p /etc/initramfs-tools/conf.d
	printf 'CRYPTSETUP=y\n' > /etc/initramfs-tools/conf.d/lexos-crypt.conf
fi

# --- Le ménage de fin d'installation ne doit pas FAIRE ÉCHOUER l'installation
#  ═══ ALEX, PHOTO : « L'installation a échoué — Erreur du gestionnaire de
#      paquets … a renvoyé le code d'erreur 100. » ═══
#
#  À la toute dernière étape, Calamares retire du système installé les paquets
#  qui n'ont de sens que sur la clé USB. La liste vient de
#  calamares-settings-debian, et elle est écrite pour une image Debian
#  officielle. Elle nomme neuf paquets ; LexOS n'en installe QUE TROIS :
#  live-boot, live-config et calamares-settings-debian. Les six autres
#  (live-boot-doc, live-config-doc, live-config-systemd, live-tools,
#  live-task-localisation, live-task-recommended) ne sont dans aucune de nos
#  listes.
#
#  ET C'EST FATAL, à cause de la forme de l'opération. Lu dans le module
#  livré (/usr/lib/*/calamares/modules/packages/main.py) :
#    · « remove: »     -> operation_remove() fait UN SEUL « apt-get remove »
#      avec TOUTE la liste. Un seul nom qu'apt ne peut pas localiser — et
#      dans le système fraîchement déballé, apt ne connaît que ce qui est
#      INSTALLÉ — fait échouer l'appel entier, donc l'installation.
#    · « try_remove: » -> operation_try_remove() les retire UN PAR UN et se
#      contente d'un avertissement en cas d'échec (« no package-installation
#      exceptions should be raised », dit sa propre documentation).
#
#  On réécrit donc la liste en « try_remove ». On la garde COMPLÈTE plutôt que
#  de la réduire aux trois paquets d'aujourd'hui : si LexOS embarque un jour
#  live-tools, il sera retiré comme il faut, et s'il ne l'embarque pas, son
#  absence ne coûte qu'une ligne de journal. Le ménage reste fait ; il ne peut
#  simplement plus emporter l'installation avec lui.
PKGCONF="/etc/calamares/modules/packages.conf"
if [ -f "$PKGCONF" ]; then
	echo "[lexos]   ménage de fin d'installation : liste Debian remplacée par une liste tolérante"
	cat > "$PKGCONF" <<'PKGEOF'
# Écrit par le hook 0500 de LexOS — voir ce hook pour le pourquoi.
#
# « try_remove » et NON « remove » : Calamares retire alors les paquets un par
# un et n'échoue pas sur un nom absent. Avec « remove », un seul paquet non
# installé faisait échouer TOUTE l'installation, à sa dernière étape, après
# la copie du système — code d'erreur 100.
backend: apt

operations:
  - try_remove:
      - 'live-boot'
      - 'live-boot-doc'
      - 'live-config'
      - 'live-config-doc'
      - 'live-config-systemd'
      - 'live-tools'
      - 'live-task-localisation'
      - 'live-task-recommended'
      - 'calamares-settings-debian'
PKGEOF
else
	#  Le fichier vient de calamares-settings-debian, qui est en liste
	#  OBLIGATOIRE. Son absence est donc anormale et vaut d'être dite : sans
	#  lui, on ne sait pas quelle liste Calamares appliquera.
	echo "[lexos]   !! $PKGCONF absent — le ménage de fin d'installation n'est pas maîtrisé"
fi

# --- Raccourci « Installer LexOS » ------------------------------------------
#  Exec pointe sur lexos-install, PAS directement sur calamares : ce wrapper
#  vérifie qu'on est bien en session démo et exige une confirmation avant
#  toute opération susceptible d'effacer le disque dur.
mkdir -p /usr/share/applications /etc/skel/Bureau /etc/skel/Desktop
cat > /usr/share/applications/lexos-install.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Installer ${LEXOS_NAME} sur le disque
Name[en]=Install ${LEXOS_NAME} to disk
Comment=Essaie d'abord la démo depuis la clé USB — l'installation peut effacer le disque dur
Exec=lexos-install
Icon=lexos
Terminal=false
Categories=System;
Keywords=install;installer;calamares;disque;
EOF

cat > /usr/share/applications/lexos-demo.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Essayer ${LEXOS_NAME} (démo)
Name[en]=Try ${LEXOS_NAME} (demo)
Comment=Session live : rien n'est écrit sur ton disque dur
Exec=lexos-welcome
Icon=lexos
Terminal=false
Categories=System;
Keywords=demo;live;essai;
EOF

for D in /etc/skel/Bureau /etc/skel/Desktop; do
	cp /usr/share/applications/lexos-demo.desktop    "$D/"
	cp /usr/share/applications/lexos-install.desktop "$D/"
	chmod +x "$D"/*.desktop
done

# --- Ce que Debian décide à notre place au sujet des comptes ----------------
#  LexOS ne livre AUCUN users.conf ni removeuser.conf : tout ce qui touche à
#  la création du compte de l'utilisateur vient de calamares-settings-debian.
#  On a DÉJÀ été mordus par cette supposition une fois — voir plus haut, à
#  propos du partitionnement : « Debian ne livre AUCUN partition.conf dans
#  calamares-settings-debian ». On avait supposé que le paquet fournissait
#  quelque chose, il ne le fournissait pas, et il a fallu le livrer nous-mêmes.
#
#  Ici on NE CHANGE RIEN — écrire un users.conf inventé serait pire que de ne
#  rien poser, puisqu'on écraserait une configuration qui marche peut-être
#  très bien. On met simplement le contenu RÉEL sous les yeux, dans le journal
#  de construction.
#
#  ── CE QU'ON Y A TROUVÉ (calamares-settings-debian 13.0.5-1, lu pour de
#     vrai en dépaquetant le .deb, pas supposé) ────────────────────────────
#    · users.conf EST livré, et « defaultGroups » contient « sudo » : le
#      compte créé à l'installation est bien ADMINISTRATEUR de sa machine.
#      Rien à faire — et surtout rien à écraser.
#      Il porte aussi « setRootPassword: false » : root reste sans mot de
#      passe utilisable, l'administration passe par sudo. C'est la
#      convention Debian, et c'est pour ça que le garde-fou ne verrouille
#      « lex » QUE s'il existe un autre membre du groupe sudo.
#    · removeuser.conf N'EST PAS livré — et surtout, le module « removeuser »
#      N'APPARAÎT NULLE PART dans la séquence de settings.conf. Calamares ne
#      supprime donc JAMAIS le compte de démo : « lex » part sur le disque et
#      y reste, à chaque installation, sans exception.
#      C'est exactement ce qui rend le verrouillage du garde-fou nécessaire
#      plutôt que prudent. On ne livre PAS de removeuser.conf pour autant :
#      supprimer le compte détruirait la porte de secours qu'on garde
#      volontairement (si la création du compte a raté, c'est la seule façon
#      d'entrer). Fermée à clé vaut mieux que murée.
#
#  Le bloc reste en place : il coûte trois lignes de journal et il dira si
#  Debian change d'avis dans une version future.
for M in users removeuser; do
	F="/etc/calamares/modules/${M}.conf"
	if [ -r "$F" ]; then
		echo "[lexos]   --- ${M}.conf livré par Debian ---"
		grep -vE '^\s*(#|$)' "$F" | sed 's/^/[lexos]     /'
	else
		echo "[lexos]   !! ${F} absent — Calamares utilisera ses valeurs internes"
	fi
done
#  Le nom du compte de démo, pour comparaison avec ce que removeuser vise.
echo "[lexos]   compte de démo LexOS : ${LEXOS_LIVE_USER:-lex}"

echo "[lexos] hook 0500 : ok"

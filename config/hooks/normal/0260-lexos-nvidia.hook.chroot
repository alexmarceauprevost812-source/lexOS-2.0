#!/bin/sh
# =============================================================================
#  LexOS — pilote NVIDIA : la version RÉCENTE, depuis le dépôt officiel NVIDIA
# =============================================================================
#  Constaté sur une Alienware Aurora ACT1250 avec GeForce RTX 5060 : GRUB et
#  le splash s'affichent, puis l'écran perd le signal PILE au lancement du
#  bureau. La carte est de la génération 2025 (Blackwell) : il lui faut un
#  pilote 570 ou plus récent. Or (construction 29, journal lu ligne à ligne) :
#    · Debian stable (trixie) fournit du 535 — trop vieux ;
#    · trixie-backports fournit du 550 — trop vieux AUSSI, et son module
#      « ouvert » ne compile même pas contre le noyau 6.12.100 de l'ISO
#      (Error! Bad return status for module build) ;
#    · le pilote libre « nouveau » ne sait pas piloter l'affichage Blackwell.
#  La seule source d'un pilote qui connaît les RTX 50 est LE DÉPÔT OFFICIEL
#  DE NVIDIA — la même politique que LexOS applique à Chrome avec le dépôt
#  officiel de Google. Sa clé est vérifiée (cuda-keyring), rien n'est
#  installé sans signature.
#
#  La cascade, du meilleur au minimum — la première réussite gagne :
#    1. dépôt NVIDIA, « nvidia-open »   (module ouvert, RTX 20 → RTX 50)
#    2. dépôt NVIDIA, « cuda-drivers »  (si le nom du méta-paquet change)
#    3. Debian stable, « nvidia-driver » (comme l'ISO 21 — RTX 40 et avant)
#    4. rien — l'ISO reste exactement comme avant ce hook
#
#  LA LEÇON DE LA CONSTRUCTION 29 : une tentative qui échoue à mi-chemin
#  laisse des paquets à moitié configurés, et ces débris ont fait échouer
#  TOUTE la construction bien plus loin (le hook interne de live-build
#  5040-update-nvidia-alternative est tombé sur une alternative à moitié
#  enregistrée). D'où la règle absolue ici : ON NETTOIE À FOND entre chaque
#  tentative, et après la dernière si tout a échoué. Et une tentative n'est
#  déclarée réussie que si le module noyau est RÉELLEMENT compilé — pas
#  seulement si apt a dit oui.
# =============================================================================
set -e

echo "[lexos] hook 0260 : pilote NVIDIA (dépôt officiel)"

FLAVOUR="standard"
SUITE=""
if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
	FLAVOUR="${LEXOS_FLAVOUR:-standard}"
	SUITE="${LEXOS_DEBIAN_SUITE:-}"
fi

case "$FLAVOUR" in
	pro) ;;
	*)
		echo "[lexos]   saveur ${FLAVOUR} : pas de pilote NVIDIA embarqué — rien à faire"
		exit 0
		;;
esac

ARCH="$(dpkg --print-architecture 2>/dev/null || echo inconnue)"
if [ "$ARCH" != "amd64" ]; then
	echo "[lexos]   architecture ${ARCH} : NVIDIA ne publie pas pour elle — rien à faire"
	exit 0
fi

#  PAS /etc/os-release : le hook 0100-lexos-identity y écrit le nom de code
#  de LexOS (« nomad »), pas celui de Debian. LEXOS_DEBIAN_SUITE est la même
#  variable que lit auto/config pour --distribution.
CODENAME="${SUITE:-trixie}"
case "$CODENAME" in
	trixie)   NV_DIST="debian13" ;;
	bookworm) NV_DIST="debian12" ;;
	*)        NV_DIST="" ;;
esac

export DEBIAN_FRONTEND=noninteractive
mkdir -p /etc/lexos
REPORT=/etc/lexos/nvidia-report
NV_LISTE=/etc/apt/sources.list.d/lexos-nvidia.list
NV_URL="https://developer.download.nvidia.com/compute/cuda/repos/${NV_DIST}/x86_64"

# --- Nettoyage : effacer TOUTE trace d'une tentative ratée ------------------
#  dpkg d'abord (finir ce qui peut l'être), puis purge de tout paquet dont le
#  nom contient « nvidia » (pilote, bibliothèques, micrologiciel GSP,
#  xserver-xorg-video-nvidia…) et de la clé NVIDIA, puis les alternatives et
#  le dossier /usr/lib/nvidia que le hook 5040 de live-build inspecte.
nettoie() {
	dpkg --configure -a >/dev/null 2>&1 || true
	apt-get install -y -f >/dev/null 2>&1 || true
	RESTES="$(dpkg-query -W -f '${db:Status-Abbrev} ${Package}\n' 2>/dev/null \
		| awk '$1 !~ /^un/ && ($2 ~ /nvidia/ || $2 == "cuda-keyring") {print $2}')"
	if [ -n "$RESTES" ]; then
		# shellcheck disable=SC2086
		apt-get purge -y $RESTES >/dev/null 2>&1 || {
			# shellcheck disable=SC2086
			dpkg --purge --force-remove-reinstreq --force-depends $RESTES >/dev/null 2>&1 || true
		}
	fi
	apt-get autoremove -y --purge >/dev/null 2>&1 || true
	dpkg --configure -a >/dev/null 2>&1 || true
	update-alternatives --remove-all nvidia >/dev/null 2>&1 || true
	rm -rf /usr/lib/nvidia
	rm -f "$NV_LISTE"
}

#  LE GARDE-FOU QUI A MANQUÉ À LA CONSTRUCTION 29.
#  live-build fournit son propre hook, 5040-update-nvidia-alternative, qui
#  s'exécute APRÈS le nôtre et fait, en gros :
#      [ -e /usr/lib/nvidia/current ] && update-alternatives --set nvidia …
#  avec « set -e ». Si le dossier existe mais que l'alternative n'est PAS
#  enregistrée — exactement l'état que laisse une installation ratée à
#  mi-chemin — update-alternatives sort en erreur et TOUTE la construction
#  s'arrête, six minutes de compilation et une heure de travail plus loin.
#  On rend donc cette situation impossible : soit l'alternative existe pour
#  de bon, soit le dossier n'existe pas. Appelé sur TOUS les chemins.
protege_alternative() {
	[ -e /usr/lib/nvidia/current ] || return 0
	if update-alternatives --query nvidia >/dev/null 2>&1; then
		echo "[lexos]   alternative « nvidia » enregistrée — hook 5040 passera"
		return 0
	fi
	echo "[lexos]   /usr/lib/nvidia/current orphelin (alternative absente) — retiré"
	rm -rf /usr/lib/nvidia
}

#  Une réussite d'apt ne suffit pas : la construction 29 a montré un module
#  qui ne compile pas. On exige le .ko sur le disque (ou DKMS « installed »).
verifie_module() {
	find /lib/modules -name 'nvidia*.ko*' 2>/dev/null | grep -q . && return 0
	dkms status 2>/dev/null | grep -qi 'nvidia.*installed' && return 0
	return 1
}

# --- Les en-têtes du noyau : sans eux, DKMS ne compile rien -----------------
apt-get update -qq || echo "[lexos]   !! apt-get update a échoué, on tente quand même"
apt-get install -y linux-headers-amd64 \
	|| echo "[lexos]   !! linux-headers-amd64 refusé — la compilation DKMS échouera"

# --- Le dépôt officiel NVIDIA -----------------------------------------------
#  cuda-keyring installe la clé de signature dans /usr/share/keyrings ; la
#  ligne de dépôt exige cette clé (signed-by) : rien n'entre sans signature.
depot_nvidia() {
	[ -n "$NV_DIST" ] || return 1
	command -v wget >/dev/null 2>&1 || apt-get install -y wget ca-certificates >/dev/null 2>&1 \
		|| return 1
	KEYDEB="$(wget -qO- "${NV_URL}/" 2>/dev/null \
		| grep -o 'cuda-keyring_[0-9.]*-[0-9]*_all\.deb' | sort -V | tail -1)"
	KEYDEB="${KEYDEB:-cuda-keyring_1.1-1_all.deb}"
	wget -q -O /tmp/cuda-keyring.deb "${NV_URL}/${KEYDEB}" || return 1
	dpkg -i /tmp/cuda-keyring.deb >/dev/null 2>&1 || return 1
	rm -f /tmp/cuda-keyring.deb
	#  cuda-keyring pose parfois sa propre ligne de dépôt ; la nôtre suffit,
	#  on retire la sienne pour n'avoir qu'une source à raisonner.
	rm -f /etc/apt/sources.list.d/cuda-${NV_DIST}-x86_64.list 2>/dev/null || true
	printf 'deb [signed-by=/usr/share/keyrings/cuda-archive-keyring.gpg] %s/ /\n' \
		"$NV_URL" > "$NV_LISTE"
	apt-get update -qq || return 1
	return 0
}

# --- La cascade -------------------------------------------------------------
REUSSITE=""

if depot_nvidia; then
	echo "[lexos]   dépôt NVIDIA ajouté (${NV_DIST})"
	if apt-get install -y nvidia-open && verifie_module; then
		REUSSITE="dépôt officiel NVIDIA (nvidia-open) — module ouvert, RTX 20 à RTX 50"
	else
		echo "[lexos]   nvidia-open : échec — nettoyage puis cuda-drivers"
		nettoie; depot_nvidia >/dev/null 2>&1 || true
		if [ -r "$NV_LISTE" ] && apt-get install -y cuda-drivers && verifie_module; then
			REUSSITE="dépôt officiel NVIDIA (cuda-drivers)"
		else
			echo "[lexos]   cuda-drivers : échec — nettoyage puis pilote Debian stable"
			nettoie
		fi
	fi
else
	echo "[lexos]   dépôt NVIDIA injoignable — pilote Debian stable directement"
	nettoie
fi

if [ -z "$REUSSITE" ]; then
	apt-get update -qq || true
	if apt-get install -y nvidia-driver nvidia-settings && verifie_module; then
		REUSSITE="Debian stable — RTX 40 et antérieures (les RTX 50 resteront sans affichage)"
	else
		echo "[lexos]   !! aucun pilote NVIDIA installable — grand nettoyage, l'ISO reste sur « nouveau »"
		nettoie
		protege_alternative
		apt-get update -qq || true
		{
			echo "# Pilote NVIDIA — échec de l'installation à la construction"
			echo "# Toutes les tentatives ont échoué (dépôt NVIDIA, Debian stable)."
			echo "# Sur une carte NVIDIA récente : démarrer en fail-safe, puis suivre"
			echo "# https://developer.nvidia.com — ou réessayer une ISO plus récente."
		} > "$REPORT"
		echo "[lexos] hook 0260 : terminé (sans pilote, système propre)"
		exit 0
	fi
fi

#  nvidia-detect (contrib Debian) : « quelle carte, quel pilote ? » en une
#  commande. Précieux au premier dépannage ; jamais bloquant.
apt-get install -y nvidia-detect >/dev/null 2>&1 \
	&& echo "[lexos]   nvidia-detect installé" \
	|| echo "[lexos]   nvidia-detect indisponible (sans gravité)"

# --- LE RÉGLAGE QUI MANQUAIT : le kernel modesetting + le bug HDMI 610 ------
#  Constaté sur l'Alienware Aurora, RTX 5060, pilote 610 installé avec succès
#  (module compilé, alternative enregistrée) : le splash LexOS s'affiche, la
#  roue tourne, puis l'écran (une TV, en HDMI) perd le signal — au moment
#  précis où nvidia.ko initialise le firmware GSP, avant même que Xorg ne
#  démarre. Deux causes cumulées, trouvées après investigation :
#
#  1. Le kernel modesetting (KMS) : par défaut sur les versions anciennes du
#     module nvidia-drm, il ne pilote pas l'affichage tant que « modeset=1 »
#     ne le lui dit pas explicitement. Le splash de démarrage (Plymouth)
#     passe par le framebuffer que l'UEFI a déjà configuré (simpledrm/efifb),
#     ce qui explique qu'il s'affiche très bien ; mais dès que quelque chose
#     tente de prendre la main sur le VRAI pilote NVIDIA sans KMS, il ne
#     trouve aucune sortie utilisable — et sur une machine où la carte NVIDIA
#     EST la seule sortie vidéo, ça donne exactement « no signal ».
#     (Sur le pilote 610 spécifiquement, modeset=1 et fbdev=1 sont déjà les
#     défauts — mais on les force quand même, au cas où la cascade plus haut
#     retombe sur un pilote plus ancien où ce n'est pas encore le cas.)
#
#  2. Une régression connue de NVIDIA elle-même : sur les pilotes 610.43.02
#     et 610.43.03, plusieurs utilisateurs rapportent un « No Signal » sur TV
#     HDMI apparu pile à cette version (issue officielle
#     NVIDIA/open-gpu-kernel-modules#1238) — indépendant du modesetting.
#     Le correctif documenté (ArchWiki NVIDIA/Troubleshooting) : forcer une
#     sortie HDMI en 8 bits avec hdmi_deepcolor=0, les puces HDMI des TV
#     étant souvent plus strictes qu'un vrai moniteur sur le deep color.
#
#  Un fichier modprobe.d, pas un paramètre GRUB : le paramètre de démarrage
#  ne vivrait que dans CETTE session live — l'installateur Debian ne le
#  recopie pas dans le GRUB du système installé. Un fichier dans
#  /etc/modprobe.d/, lui, est un fichier normal : il est copié sur le disque
#  à l'installation, comme n'importe quel autre réglage.
#  $REUSSITE n'est renseigné que si un pilote a RÉELLEMENT été installé (le
#  module vérifié présent) : /proc/driver/nvidia n'existerait pas ici de
#  toute façon, on est dans le chroot de construction, sans GPU réel ni
#  module chargé.
if [ -n "$REUSSITE" ]; then
	mkdir -p /etc/modprobe.d
	cat > /etc/modprobe.d/lexos-nvidia-drm.conf <<'EOF'
# LexOS — active le kernel modesetting de nvidia-drm, et corrige un « No
# Signal » HDMI connu des pilotes 610.43.02/610.43.03 (open-gpu-kernel-
# modules#1238).
#
# Sans modeset=1/fbdev=1, une carte NVIDIA qui est la SEULE sortie vidéo de
# la machine (aucune puce graphique Intel/AMD en secours, le cas de la
# plupart des tours de bureau) affiche le splash de démarrage — servi par
# l'UEFI, pas par NVIDIA — puis perd le signal au lancement de la session
# graphique : le pilote NVIDIA n'a alors aucun moyen de piloter l'écran.
# hdmi_deepcolor=0 force une sortie 8 bits : la régression 610.x fait perdre
# le signal sur certaines TV même avec le modesetting actif.
# Constaté et corrigé sur une GeForce RTX 5060 (Alienware Aurora ACT1250)
# branchée en HDMI sur une TV Hisense.
options nvidia-drm modeset=1 fbdev=1
options nvidia-modeset hdmi_deepcolor=0
EOF
	#  Répercuter tout de suite sur l'initramfs : les kernels déjà présents
	#  dans l'ISO doivent embarquer ce réglage, pas seulement le prochain à
	#  être construit.
	update-initramfs -u -k all >/dev/null 2>&1 \
		&& echo "[lexos]   nvidia-drm.modeset=1 fbdev=1, hdmi_deepcolor=0, initramfs mis à jour" \
		|| echo "[lexos]   !! réglages écrits, mais update-initramfs a échoué"
fi

VERSION="$(dpkg-query -W -f='${Version}' nvidia-open 2>/dev/null \
	|| dpkg-query -W -f='${Version}' cuda-drivers 2>/dev/null \
	|| dpkg-query -W -f='${Version}' nvidia-driver 2>/dev/null \
	|| echo '?')"
{
	echo "# Pilote NVIDIA embarqué dans cette ISO"
	echo "# Version : ${VERSION}"
	echo "# Source  : ${REUSSITE}"
	if [ -r "$NV_LISTE" ]; then
		echo "# Mises à jour : via le dépôt officiel NVIDIA (déjà configuré),"
		echo "# avec « lexos upgrade »."
	fi
} > "$REPORT"

protege_alternative

echo "[lexos]   pilote installé : ${VERSION} — ${REUSSITE}"
echo "[lexos] hook 0260 : ok"

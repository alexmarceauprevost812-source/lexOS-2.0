#!/bin/sh
# =============================================================================
#  LexOS — pilote NVIDIA : la version RÉCENTE, depuis le dépôt officiel NVIDIA
# =============================================================================
#  Constaté sur une Alienware Aurora ACT1250 avec GeForce RTX 5060 : GRUB et
#  le splash s'affichent, puis l'écran perd le signal PILE au lancement du
#  bureau. La carte est de la génération 2025 (Blackwell) : il lui faut un
#  pilote 570 ou plus récent. Or (construction 29, journal lu ligne à ligne) :
#    · Debian stable (trixie) fournit du 535 — trop vieux ;
#    · trixie-backports fournit du 550 — trop vieux AUSSI, et son module
#      « ouvert » ne compile même pas contre le noyau 6.12.100 de l'ISO
#      (Error! Bad return status for module build) ;
#    · le pilote libre « nouveau » ne sait pas piloter l'affichage Blackwell.
#  La seule source d'un pilote qui connaît les RTX 50 est LE DÉPÔT OFFICIEL
#  DE NVIDIA — la même politique que LexOS applique à Chrome avec le dépôt
#  officiel de Google. Sa clé est vérifiée (cuda-keyring), rien n'est
#  installé sans signature.
#
#  La cascade, du meilleur au minimum — la première réussite gagne :
#    1. dépôt NVIDIA, « nvidia-open »   (module ouvert, RTX 20 → RTX 50)
#    2. dépôt NVIDIA, « cuda-drivers »  (si le nom du méta-paquet change)
#    3. Debian stable, « nvidia-driver » (comme l'ISO 21 — RTX 40 et avant)
#    4. rien — l'ISO reste exactement comme avant ce hook
#
#  LA LEÇON DE LA CONSTRUCTION 29 : une tentative qui échoue à mi-chemin
#  laisse des paquets à moitié configurés, et ces débris ont fait échouer
#  TOUTE la construction bien plus loin (le hook interne de live-build
#  5040-update-nvidia-alternative est tombé sur une alternative à moitié
#  enregistrée). D'où la règle absolue ici : ON NETTOIE À FOND entre chaque
#  tentative, et après la dernière si tout a échoué. Et une tentative n'est
#  déclarée réussie que si le module noyau est RÉELLEMENT compilé — pas
#  seulement si apt a dit oui.
# =============================================================================
set -e

echo "[lexos] hook 0260 : pilote NVIDIA (dépôt officiel)"

FLAVOUR="standard"
SUITE=""
BRANCHE=""
if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
	FLAVOUR="${LEXOS_FLAVOUR:-standard}"
	SUITE="${LEXOS_DEBIAN_SUITE:-}"
	BRANCHE="${LEXOS_NVIDIA_BRANCH:-}"
fi

case "$FLAVOUR" in
	pro) ;;
	*)
		echo "[lexos]   saveur ${FLAVOUR} : pas de pilote NVIDIA embarqué — rien à faire"
		exit 0
		;;
esac

ARCH="$(dpkg --print-architecture 2>/dev/null || echo inconnue)"
if [ "$ARCH" != "amd64" ]; then
	echo "[lexos]   architecture ${ARCH} : NVIDIA ne publie pas pour elle — rien à faire"
	exit 0
fi

#  PAS /etc/os-release : le hook 0100-lexos-identity y écrit le nom de code
#  de LexOS (« nomad »), pas celui de Debian. LEXOS_DEBIAN_SUITE est la même
#  variable que lit auto/config pour --distribution.
CODENAME="${SUITE:-trixie}"
case "$CODENAME" in
	trixie)   NV_DIST="debian13" ;;
	bookworm) NV_DIST="debian12" ;;
	*)        NV_DIST="" ;;
esac

export DEBIAN_FRONTEND=noninteractive
mkdir -p /etc/lexos
REPORT=/etc/lexos/nvidia-report
NV_LISTE=/etc/apt/sources.list.d/lexos-nvidia.list
NV_PIN=/etc/apt/preferences.d/lexos-nvidia-pin
NV_URL="https://developer.download.nvidia.com/compute/cuda/repos/${NV_DIST}/x86_64"

# --- Nettoyage : effacer TOUTE trace d'une tentative ratée ------------------
#  dpkg d'abord (finir ce qui peut l'être), puis purge de tout paquet dont le
#  nom contient « nvidia » (pilote, bibliothèques, micrologiciel GSP,
#  xserver-xorg-video-nvidia…) et de la clé NVIDIA, puis les alternatives et
#  le dossier /usr/lib/nvidia que le hook 5040 de live-build inspecte.
nettoie() {
	dpkg --configure -a >/dev/null 2>&1 || true
	apt-get install -y -f >/dev/null 2>&1 || true
	RESTES="$(dpkg-query -W -f '${db:Status-Abbrev} ${Package}\n' 2>/dev/null \
		| awk '$1 !~ /^un/ && ($2 ~ /nvidia/ || $2 == "cuda-keyring") {print $2}')"
	if [ -n "$RESTES" ]; then
		# shellcheck disable=SC2086
		apt-get purge -y $RESTES >/dev/null 2>&1 || {
			# shellcheck disable=SC2086
			dpkg --purge --force-remove-reinstreq --force-depends $RESTES >/dev/null 2>&1 || true
		}
	fi
	apt-get autoremove -y --purge >/dev/null 2>&1 || true
	dpkg --configure -a >/dev/null 2>&1 || true
	update-alternatives --remove-all nvidia >/dev/null 2>&1 || true
	rm -rf /usr/lib/nvidia
	rm -f "$NV_LISTE"
	rm -f "$NV_PIN"
}

#  L'ÉPINGLE — la leçon de la construction qui a suivi l'inventaire.
#  On avait demandé « nvidia-open=595.71.05-1 » et apt a dit oui. Sauf que
#  nvidia-open est un méta-paquet de 2,5 ko : seule L'ÉTIQUETTE était en 595,
#  pendant que le pilote réel — nvidia-driver-cuda, libcuda1, libnvidia-*,
#  le module noyau — s'installait en 610.43.02, la version buggée. Épingler
#  un méta-paquet n'épingle rien du tout.
#  On épingle donc TOUTE la pile NVIDIA sur la branche voulue, par les
#  préférences apt, AVANT d'installer. À priorité 1001, apt refuse la 610 :
#  soit il installe la branche demandée en entier, soit il échoue franchement
#  — et un échec franc, on le voit, contrairement à un repli silencieux.
pin_branche() {
	#  $1 = numéro de branche (595, 580…)
	mkdir -p /etc/apt/preferences.d
	cat > "$NV_PIN" <<EOF
# LexOS — toute la pile NVIDIA sur la branche $1.
# La branche 610 (610.43.02/610.43.03) coupe le signal HDMI sur téléviseur :
# NVIDIA/open-gpu-kernel-modules#1238. Priorité 1001 = apt préfère cette
# branche même s'il faut refuser une version plus récente.
# Pour repasser au plus récent : supprimer ce fichier, puis « lexos upgrade ».
Package: nvidia-* libnvidia-* cuda-* libcuda* libcudadebugger* libnvcuvid* libnvoptix* libnvfatbin* libnvjitlink* xserver-xorg-video-nvidia*
Pin: version $1.*
Pin-Priority: 1001
EOF
	echo "[lexos]   pile NVIDIA épinglée sur la branche $1 (préférences apt)"
}

#  Ce qui est VRAIMENT installé — sur un paquet qui est le pilote, pas son
#  étiquette. C'est cette vérification qui manquait : sans elle, « nvidia-open
#  595 » et « pilote 610 » se ressemblent dans un journal.
version_pilote_reel() {
	#  ATTENTION : sans \n dans le format, un paquet installé en amd64 ET en
	#  i386 rend « 610.43.02-1610.43.02-1 » d'un seul tenant — c'est ce qui
	#  s'est affiché au build précédent. D'où le \n et le head -1.
	for p in nvidia-driver-cuda libnvidia-ml1 nvidia-kernel-common nvidia-open; do
		v="$(dpkg-query -W -f='${Version}\n' "$p" 2>/dev/null | head -1)" || continue
		[ -n "$v" ] && { echo "$v"; return 0; }
	done
	return 1
}

#  LE GARDE-FOU QUI A MANQUÉ À LA CONSTRUCTION 29.
#  live-build fournit son propre hook, 5040-update-nvidia-alternative, qui
#  s'exécute APRÈS le nôtre et fait, en gros :
#      [ -e /usr/lib/nvidia/current ] && update-alternatives --set nvidia …
#  avec « set -e ». Si le dossier existe mais que l'alternative n'est PAS
#  enregistrée — exactement l'état que laisse une installation ratée à
#  mi-chemin — update-alternatives sort en erreur et TOUTE la construction
#  s'arrête, six minutes de compilation et une heure de travail plus loin.
#  On rend donc cette situation impossible : soit l'alternative existe pour
#  de bon, soit le dossier n'existe pas. Appelé sur TOUS les chemins.
protege_alternative() {
	[ -e /usr/lib/nvidia/current ] || return 0
	if update-alternatives --query nvidia >/dev/null 2>&1; then
		echo "[lexos]   alternative « nvidia » enregistrée — hook 5040 passera"
		return 0
	fi
	echo "[lexos]   /usr/lib/nvidia/current orphelin (alternative absente) — retiré"
	rm -rf /usr/lib/nvidia
}

#  Une réussite d'apt ne suffit pas : la construction 29 a montré un module
#  qui ne compile pas. On exige le .ko sur le disque (ou DKMS « installed »).
verifie_module() {
	find /lib/modules -name 'nvidia*.ko*' 2>/dev/null | grep -q . && return 0
	dkms status 2>/dev/null | grep -qi 'nvidia.*installed' && return 0
	return 1
}

# --- Les en-têtes du noyau : sans eux, DKMS ne compile rien -----------------
apt-get update -qq || echo "[lexos]   !! apt-get update a échoué, on tente quand même"
apt-get install -y linux-headers-amd64 \
	|| echo "[lexos]   !! linux-headers-amd64 refusé — la compilation DKMS échouera"

# --- Le dépôt officiel NVIDIA -----------------------------------------------
#  cuda-keyring installe la clé de signature dans /usr/share/keyrings ; la
#  ligne de dépôt exige cette clé (signed-by) : rien n'entre sans signature.
depot_nvidia() {
	[ -n "$NV_DIST" ] || return 1
	NV_URL="https://developer.download.nvidia.com/compute/cuda/repos/${NV_DIST}/x86_64"
	command -v wget >/dev/null 2>&1 || apt-get install -y wget ca-certificates >/dev/null 2>&1 \
		|| return 1
	KEYDEB="$(wget -qO- "${NV_URL}/" 2>/dev/null \
		| grep -o 'cuda-keyring_[0-9.]*-[0-9]*_all\.deb' | sort -V | tail -1)"
	KEYDEB="${KEYDEB:-cuda-keyring_1.1-1_all.deb}"
	wget -q -O /tmp/cuda-keyring.deb "${NV_URL}/${KEYDEB}" || return 1
	dpkg -i /tmp/cuda-keyring.deb >/dev/null 2>&1 || return 1
	rm -f /tmp/cuda-keyring.deb
	#  cuda-keyring pose parfois sa propre ligne de dépôt ; la nôtre suffit,
	#  on retire la sienne pour n'avoir qu'une source à raisonner.
	rm -f /etc/apt/sources.list.d/cuda-${NV_DIST}-x86_64.list 2>/dev/null || true
	printf 'deb [signed-by=/usr/share/keyrings/cuda-archive-keyring.gpg] %s/ /\n' \
		"$NV_URL" > "$NV_LISTE"
	apt-get update -qq || return 1
	return 0
}

# --- La cascade -------------------------------------------------------------
#  LA LEÇON DU PREMIER ESSAI SUR VRAIE MACHINE : « le plus récent » n'est pas
#  « le meilleur ». Le dépôt NVIDIA sert par défaut la branche 610, et c'est
#  précisément elle qui coupe le signal HDMI sur la TV d'essai. La preuve est
#  venue de la machine elle-même : sur cette Alienware, cette RTX 5060 et
#  cette TV, Ubuntu 26.04 affiche son bureau sans le moindre réglage
#  particulier — et « modinfo nvidia » y répond nvidia-595-open. Une branche
#  plus ancienne, donc, mais celle qui MARCHE sur ce matériel.
#
#  LA LEÇON DES DEUX CONSTRUCTIONS SUIVANTES : on a épinglé « nvidia-open-595 »,
#  puis « nvidia-open-580 » — deux noms de paquets DEVINÉS d'après ce qui
#  existe chez Ubuntu. Aucun des deux n'existe dans le dépôt debian13 : les
#  deux fois, la cascade est retombée sans bruit sur le défaut, donc sur la
#  610 buggée, et deux ISO de trois heures ont été livrées identiques à celle
#  qu'elles devaient corriger. Le journal ne disait « pilote installé : 610 »
#  qu'à la toute fin, sans jamais nommer ce que le dépôt proposait vraiment.
#  ON NE DEVINE PLUS. On demande au dépôt son inventaire, on l'écrit dans le
#  journal ET dans le rapport embarqué, et on choisit DEDANS : la version la
#  plus récente d'avant la branche 610. Une tentative n'est déclarée réussie
#  que si le module noyau est réellement compilé.
REUSSITE=""
VERSIONS_DISPO=""
VERSIONS_PILOTE=""
PAQUET_PILOTE=""

#  LA TRACE. Les messages du hook partent sur la sortie standard, au milieu
#  d'un journal de 450 000 caractères dont l'API ne rend que la fin : trois
#  diagnostics de suite ont buté là-dessus, et le dernier a montré une 595
#  DISPONIBLE sans qu'on puisse voir pourquoi elle n'avait pas été prise.
#  Chaque tentative s'inscrit donc aussi ici, et la trace part dans le
#  rapport — qui, lui, est imprimé à la toute fin et toujours lisible.
TRACE=""
trace() { TRACE="${TRACE}#   $1
"; }

essaie() {
	#  $1 = paquet (éventuellement « paquet=version »), $2 = description
	[ -r "$NV_LISTE" ] || { trace "$1 : pas de dépôt configuré"; return 1; }
	echo "[lexos]   tentative : $1"
	if apt-get install -y "$1" >/tmp/lexos-apt.log 2>&1; then
		if verifie_module; then
			REUSSITE="$2"
			trace "$1 : INSTALLÉ, module compilé"
			return 0
		fi
		trace "$1 : apt a réussi mais AUCUN module noyau — refusé"
	else
		#  La vraie raison, en clair : « held broken packages », un conflit de
		#  versions, un paquet absent… Sans ces lignes on en est réduit aux
		#  suppositions, et on l'a été trop longtemps.
		trace "$1 : apt a ÉCHOUÉ —"
		while IFS= read -r l; do
			case "$l" in ""|" "*) continue ;; esac
			trace "    $l"
		done <<EOT
$(grep -E "^(E:|Err|The following packages have unmet|  )" /tmp/lexos-apt.log 2>/dev/null | head -8)
EOT
	fi
	echo "[lexos]   $1 : échec — nettoyage"
	nettoie
	depot_nvidia >/dev/null 2>&1 || true
	return 1
}

#  L'inventaire du dépôt, écrit en toutes lettres dans le journal. C'est CE
#  bloc qui manquait : sans lui, un nom de paquet inexistant est indiscernable
#  d'un pilote qui refuse de compiler.
versions_de() {
	apt-cache madison "$1" 2>/dev/null \
		| awk -F'|' '{gsub(/[ \t]/,"",$2); if ($2 != "") print $2}' \
		| sort -Vr | uniq
}

inventaire() {
	[ -r "$NV_LISTE" ] || return 0
	#  Le méta-paquet, pour mémoire — c'est lui qui nous a menés en bateau.
	VERSIONS_DISPO="$(versions_de nvidia-open)"
	if [ -n "$VERSIONS_DISPO" ]; then
		echo "[lexos]   versions du méta-paquet nvidia-open :"
		echo "$VERSIONS_DISPO" | sed 's/^/[lexos]     · /'
	else
		echo "[lexos]   !! le dépôt ne liste aucune version de nvidia-open"
	fi
	#  ET LE VRAI PILOTE. C'est sur CETTE liste qu'on choisit : le méta-paquet
	#  peut proposer une 595 dont le pilote correspondant n'existe pas, et
	#  c'est exactement le piège dans lequel la construction précédente est
	#  tombée (étiquette 595, pilote 610).
	for p in nvidia-driver-cuda libnvidia-ml1 nvidia-kernel-common; do
		VERSIONS_PILOTE="$(versions_de "$p")"
		if [ -n "$VERSIONS_PILOTE" ]; then
			PAQUET_PILOTE="$p"
			echo "[lexos]   versions du pilote réel (${p}) :"
			echo "$VERSIONS_PILOTE" | sed 's/^/[lexos]     · /'
			break
		fi
	done
	[ -n "$VERSIONS_PILOTE" ] \
		|| echo "[lexos]   !! aucun paquet de pilote listé — choix sur le méta-paquet seul"
	METAS="$(apt-cache --names-only search '^nvidia-open' 2>/dev/null \
		| awk '{print $1}' | sort -V | tr '\n' ' ')"
	[ -n "$METAS" ] && echo "[lexos]   méta-paquets nvidia-open* : ${METAS}"
	METAS_CUDA="$(apt-cache --names-only search '^cuda-drivers' 2>/dev/null \
		| awk '{print $1}' | sort -V | tr '\n' ' ')"
	[ -n "$METAS_CUDA" ] && echo "[lexos]   méta-paquets cuda-drivers* : ${METAS_CUDA}"
	return 0
}

#  La version la plus récente STRICTEMENT antérieure à la branche 610 — celle
#  qui porte la régression HDMI. On ne vise plus un numéro précis (595, 580) :
#  on prend ce que le dépôt a de plus proche en dessous de 610, choisi sur la
#  liste du VRAI pilote quand elle existe.
version_avant_610() {
	LISTE="${VERSIONS_PILOTE:-$VERSIONS_DISPO}"
	[ -n "$LISTE" ] || return 0
	echo "$LISTE" | while read -r v; do
		[ -n "$v" ] || continue
		maj="${v%%.*}"
		case "$maj" in
			''|*[!0-9]*) continue ;;
		esac
		if [ "$maj" -lt 610 ]; then
			echo "$v"
			break
		fi
	done
}

if depot_nvidia; then
	echo "[lexos]   dépôt NVIDIA ajouté (${NV_DIST})"
	inventaire
	#  1. Un méta-paquet de branche, SI l'utilisateur en a épinglé un et qu'il
	#     existe vraiment. Vide par défaut : c'est le choix par version, plus
	#     bas, qui fait le travail.
	if [ -n "$BRANCHE" ]; then
		essaie "nvidia-open-${BRANCHE}" \
			"dépôt officiel NVIDIA, branche ${BRANCHE} épinglée (nvidia-open-${BRANCHE})" \
			|| essaie "cuda-drivers-${BRANCHE}" \
				"dépôt officiel NVIDIA, branche ${BRANCHE} épinglée (cuda-drivers-${BRANCHE})" \
			|| echo "[lexos]   !! aucun méta-paquet de branche ${BRANCHE} dans ce dépôt"
	fi
	#  2. SI debian13 n'a rien avant la 610, on va voir chez debian12.
	#     Constaté à la construction du 3 août : le dépôt debian13 ne publie
	#     la 595 que pour le méta-paquet nvidia-open (2,5 ko) — aucun paquet
	#     de PILOTE en 595. Le dépôt debian12, plus ancien, garde en général
	#     davantage de branches. Les bibliothèques NVIDIA sont autonomes et
	#     ne dépendent que d'une glibc plus vieille que celle de trixie :
	#     l'installation reste cohérente. Si ça ne passe pas, apt refusera
	#     franchement et on repartira sur le défaut, comme avant.
	if [ -z "$REUSSITE" ] && [ -z "$(version_avant_610)" ] && [ "$NV_DIST" = "debian13" ]; then
		echo "[lexos]   debian13 n'a aucun pilote avant la 610 — on regarde debian12"
		NV_DIST_SECOURS="debian12"
		NV_DIST_INITIAL="$NV_DIST"
		NV_DIST="$NV_DIST_SECOURS"
		if depot_nvidia; then
			echo "[lexos]   dépôt NVIDIA de secours ajouté (${NV_DIST})"
			inventaire
			if [ -z "$(version_avant_610)" ]; then
				echo "[lexos]   !! debian12 non plus ne propose rien avant la 610 — retour à ${NV_DIST_INITIAL}"
				NV_DIST="$NV_DIST_INITIAL"
				depot_nvidia >/dev/null 2>&1 || true
				inventaire >/dev/null 2>&1 || true
			fi
		else
			echo "[lexos]   !! dépôt debian12 injoignable — retour à ${NV_DIST_INITIAL}"
			NV_DIST="$NV_DIST_INITIAL"
			depot_nvidia >/dev/null 2>&1 || true
			inventaire >/dev/null 2>&1 || true
		fi
	fi
	#  3. La branche la plus récente d'avant la 610, choisie dans l'inventaire
	#     et imposée à TOUTE la pile par les préférences apt — pas seulement
	#     au méta-paquet, qui ne décide de rien.
	if [ -z "$REUSSITE" ]; then
		V610="$(version_avant_610)"
		if [ -n "$V610" ]; then
			BR610="${V610%%.*}"
			trace "branche retenue : ${BR610} (version ${V610})"
			pin_branche "$BR610"
			#  ON NOMME LE PILOTE, PAS SON ÉTIQUETTE. Le méta-paquet nvidia-open
			#  s'installe volontiers en 595 en tirant un pilote 610 derrière lui
			#  — c'est arrivé. En demandant nvidia-driver-cuda à la version
			#  exacte, apt doit résoudre TOUTE la pile sur cette branche, ou
			#  échouer franchement. Le méta-paquet ne vient qu'ensuite, une fois
			#  le pilote posé, pour compléter la panoplie.
			if essaie "${PAQUET_PILOTE:-nvidia-driver-cuda}=${V610}" \
				"dépôt officiel NVIDIA, pilote ${V610} nommé explicitement — branche ${BR610}, la plus récente d'avant la 610 et sa régression HDMI sur téléviseur" \
			   || essaie nvidia-open \
				"dépôt officiel NVIDIA, branche ${BR610} imposée à toute la pile (version ${V610}) — la plus récente d'avant la 610 et sa régression HDMI sur téléviseur"
			then
				#  Et on VÉRIFIE. Deux ISO ont été livrées sur la foi d'un
				#  « apt a dit oui » qui cachait un pilote 610.
				REEL="$(version_pilote_reel || echo '?')"
				if [ "${REEL%%.*}" = "$BR610" ]; then
					echo "[lexos]   vérifié : le pilote réel est bien en ${REEL}"
				else
					echo "[lexos]   !! l'épingle n'a pas tenu — pilote réel ${REEL}, attendu ${BR610}.x"
					trace "épingle NON TENUE : pilote réel ${REEL}, attendu ${BR610}.x"
					REUSSITE=""
					nettoie
					depot_nvidia >/dev/null 2>&1 || true
				fi
			else
				echo "[lexos]   !! branche ${BR610} refusée par apt — épingle retirée"
				rm -f "$NV_PIN"
				apt-get update -qq || true
			fi
		else
			echo "[lexos]   !! le dépôt ne propose rien avant la branche 610"
			trace "aucune version avant la branche 610 dans l'inventaire"
		fi
	fi
	#  4. Le défaut du dépôt — la 610, avec les contournements modprobe plus bas.
	if [ -z "$REUSSITE" ]; then
		essaie nvidia-open \
			"dépôt officiel NVIDIA, version par défaut (nvidia-open) — module ouvert, RTX 20 à RTX 50" \
			|| essaie cuda-drivers \
				"dépôt officiel NVIDIA, version par défaut (cuda-drivers)" \
			|| echo "[lexos]   dépôt NVIDIA épuisé — pilote Debian stable"
	fi
	[ -n "$REUSSITE" ] || nettoie
else
	echo "[lexos]   dépôt NVIDIA injoignable — pilote Debian stable directement"
	nettoie
fi

if [ -z "$REUSSITE" ]; then
	apt-get update -qq || true
	if apt-get install -y nvidia-driver nvidia-settings && verifie_module; then
		REUSSITE="Debian stable — RTX 40 et antérieures (les RTX 50 resteront sans affichage)"
	else
		echo "[lexos]   !! aucun pilote NVIDIA installable — grand nettoyage, l'ISO reste sur « nouveau »"
		nettoie
		protege_alternative
		apt-get update -qq || true
		{
			echo "# Pilote NVIDIA — échec de l'installation à la construction"
			echo "# Toutes les tentatives ont échoué (dépôt NVIDIA, Debian stable)."
			echo "# Sur une carte NVIDIA récente : démarrer en fail-safe, puis suivre"
			echo "# https://developer.nvidia.com — ou réessayer une ISO plus récente."
		} > "$REPORT"
		echo "[lexos] hook 0260 : terminé (sans pilote, système propre)"
		exit 0
	fi
fi

#  nvidia-detect (contrib Debian) : « quelle carte, quel pilote ? » en une
#  commande. Précieux au premier dépannage ; jamais bloquant.
apt-get install -y nvidia-detect >/dev/null 2>&1 \
	&& echo "[lexos]   nvidia-detect installé" \
	|| echo "[lexos]   nvidia-detect indisponible (sans gravité)"

# --- LE RÉGLAGE QUI MANQUAIT : le kernel modesetting + le bug HDMI 610 ------
#  Constaté sur l'Alienware Aurora, RTX 5060, pilote 610 installé avec succès
#  (module compilé, alternative enregistrée) : le splash LexOS s'affiche, la
#  roue tourne, puis l'écran (une TV, en HDMI) perd le signal — au moment
#  précis où nvidia.ko initialise le firmware GSP, avant même que Xorg ne
#  démarre. Deux causes cumulées, trouvées après investigation :
#
#  1. Le kernel modesetting (KMS) : par défaut sur les versions anciennes du
#     module nvidia-drm, il ne pilote pas l'affichage tant que « modeset=1 »
#     ne le lui dit pas explicitement. Le splash de démarrage (Plymouth)
#     passe par le framebuffer que l'UEFI a déjà configuré (simpledrm/efifb),
#     ce qui explique qu'il s'affiche très bien ; mais dès que quelque chose
#     tente de prendre la main sur le VRAI pilote NVIDIA sans KMS, il ne
#     trouve aucune sortie utilisable — et sur une machine où la carte NVIDIA
#     EST la seule sortie vidéo, ça donne exactement « no signal ».
#     (Sur le pilote 610 spécifiquement, modeset=1 et fbdev=1 sont déjà les
#     défauts — mais on les force quand même, au cas où la cascade plus haut
#     retombe sur un pilote plus ancien où ce n'est pas encore le cas.)
#
#  2. Une régression connue de NVIDIA elle-même : sur les pilotes 610.43.02
#     et 610.43.03, plusieurs utilisateurs rapportent un « No Signal » sur TV
#     HDMI apparu pile à cette version (issue officielle
#     NVIDIA/open-gpu-kernel-modules#1238) — indépendant du modesetting.
#     Le correctif documenté (ArchWiki NVIDIA/Troubleshooting) : forcer une
#     sortie HDMI en 8 bits avec hdmi_deepcolor=0, les puces HDMI des TV
#     étant souvent plus strictes qu'un vrai moniteur sur le deep color.
#
#  Un fichier modprobe.d, pas un paramètre GRUB : le paramètre de démarrage
#  ne vivrait que dans CETTE session live — l'installateur Debian ne le
#  recopie pas dans le GRUB du système installé. Un fichier dans
#  /etc/modprobe.d/, lui, est un fichier normal : il est copié sur le disque
#  à l'installation, comme n'importe quel autre réglage.
#  $REUSSITE n'est renseigné que si un pilote a RÉELLEMENT été installé (le
#  module vérifié présent) : /proc/driver/nvidia n'existerait pas ici de
#  toute façon, on est dans le chroot de construction, sans GPU réel ni
#  module chargé.
if [ -n "$REUSSITE" ]; then
	mkdir -p /etc/modprobe.d
	cat > /etc/modprobe.d/lexos-nvidia-drm.conf <<'EOF'
# LexOS — active le kernel modesetting de nvidia-drm, et corrige un « No
# Signal » HDMI connu des pilotes 610.43.02/610.43.03 (open-gpu-kernel-
# modules#1238).
#
# Sans modeset=1/fbdev=1, une carte NVIDIA qui est la SEULE sortie vidéo de
# la machine (aucune puce graphique Intel/AMD en secours, le cas de la
# plupart des tours de bureau) affiche le splash de démarrage — servi par
# l'UEFI, pas par NVIDIA — puis perd le signal au lancement de la session
# graphique : le pilote NVIDIA n'a alors aucun moyen de piloter l'écran.
# hdmi_deepcolor=0 force une sortie 8 bits : la régression 610.x fait perdre
# le signal sur certaines TV même avec le modesetting actif.
# Constaté et corrigé sur une GeForce RTX 5060 (Alienware Aurora ACT1250)
# branchée en HDMI sur une TV Hisense.
options nvidia-drm modeset=1 fbdev=1
options nvidia-modeset hdmi_deepcolor=0
EOF
	#  Répercuter tout de suite sur l'initramfs : les kernels déjà présents
	#  dans l'ISO doivent embarquer ce réglage, pas seulement le prochain à
	#  être construit.
	update-initramfs -u -k all >/dev/null 2>&1 \
		&& echo "[lexos]   nvidia-drm.modeset=1 fbdev=1, hdmi_deepcolor=0, initramfs mis à jour" \
		|| echo "[lexos]   !! réglages écrits, mais update-initramfs a échoué"
fi

#  LA VERSION QUI COMPTE est celle du pilote, pas celle du méta-paquet : ils
#  ont divergé (nvidia-open 595.71.05 par-dessus un pilote 610.43.02) et c'est
#  ce qui a fait passer une ISO buggée pour corrigée.
VERSION="$(version_pilote_reel || echo '?')"
META="$(dpkg-query -W -f='${Version}' nvidia-open 2>/dev/null || echo '')"
{
	echo "# Pilote NVIDIA embarqué dans cette ISO"
	echo "# Version : ${VERSION}   (relevée sur le pilote lui-même)"
	if [ -n "$META" ] && [ "$META" != "$VERSION" ]; then
		echo "# Méta-paquet nvidia-open : ${META} — étiquette seule, ne dit PAS"
		echo "# quelle version du pilote est réellement installée."
	fi
	echo "# Source  : ${REUSSITE}"
	if [ -r "$NV_PIN" ]; then
		echo "# Épingle : toute la pile NVIDIA est tenue sur cette branche par"
		echo "#   ${NV_PIN}"
		echo "#   C'est volontaire : la branche 610 coupe le signal HDMI sur"
		echo "#   certains téléviseurs (open-gpu-kernel-modules#1238). Supprimer"
		echo "#   ce fichier pour repasser au plus récent."
	fi
	if [ -r "$NV_LISTE" ]; then
		echo "# Mises à jour : via le dépôt officiel NVIDIA (déjà configuré),"
		echo "# avec « lexos upgrade »."
	fi
	#  L'inventaire du dépôt au moment de la construction. Il répond d'un coup
	#  d'oeil à « pourquoi cette version-là ? » — et, si un jour il faut
	#  épingler autre chose, il donne les noms exacts sans reconstruire.
	if [ -n "$TRACE" ]; then
		echo "# Ce qui a été tenté, dans l'ordre :"
		printf '%s' "$TRACE"
	fi
	if [ -n "$VERSIONS_PILOTE" ]; then
		echo "# Versions du pilote (${PAQUET_PILOTE}) proposées par le dépôt :"
		echo "$VERSIONS_PILOTE" | sed 's/^/#   · /'
	fi
	if [ -n "$VERSIONS_DISPO" ]; then
		echo "# Versions du méta-paquet nvidia-open proposées par le dépôt :"
		echo "$VERSIONS_DISPO" | sed 's/^/#   · /'
	fi
} > "$REPORT"

protege_alternative

echo "[lexos]   pilote installé : ${VERSION} — ${REUSSITE}"
echo "[lexos] hook 0260 : ok"

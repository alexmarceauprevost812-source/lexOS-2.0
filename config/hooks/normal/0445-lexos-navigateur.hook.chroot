#!/bin/sh
set -e
# =============================================================================
#  hook 0445 — le haut du navigateur, et qui est le navigateur officiel
# =============================================================================
#  ALEX, CAPTURE DU NAVIGATEUR : « en haut du navigateur il est trop noir,
#  changer pour qu'il soit un peu gris ». Et, sur la photo du fichier
#  « Navigateur Web Chromium » : « garder lui officiel comme navigateur ».
#
#  ═══ D'OU VENAIT LE NOIR, MESURE ET NON SUPPOSE ═══
#  Chromium a ete lance pour de vrai (Chromium 141, sous Xvfb), sa fenetre
#  photographiee, et les pixels de la bande du haut releves. Trois etats,
#  trois resultats :
#
#     theme du systeme (GTK), notre gtk.css ... cadre #0A0A0B  barre #000000
#     theme interne de Chromium ............... cadre #1F2020  barre #3C3C3C
#     theme interne + BrowserThemeColor ....... cadre #26262B  barre #46464E
#
#  La premiere ligne est exactement ce qu'Alex voit : Chromium suit le theme
#  GTK de LexOS, dont l'entete vaut #0A0A0B et le fond #000000. Du noir, donc,
#  parce que c'est NOTRE noir — pas un defaut de Chromium.
#
#  ═══ CE HOOK A MAIGRI — DEMANDE D'ALEX ═══
#  « Pour pas avoir a changer les couleurs et tout le kit sur chaque appli. »
#  Il posait DEUX choses : la politique de couleur, ET un fichier de
#  preferences qui forcait Chromium a employer son theme INTERNE plutot que
#  celui du systeme. Ce second fichier a disparu.
#
#  POURQUOI IL EXISTAIT : tant que le haut des fenetres de LexOS valait
#  #0A0A0B, la politique ne repeignait que la barre d'outils et la bande
#  d'onglets restait noire. Il fallait donc sortir Chromium du theme systeme.
#
#  POURQUOI IL NE SERT PLUS : le gris est maintenant dans le THEME (voir
#  HEADER dans lexos-theme-gen). Chromium lit les couleurs GTK comme
#  n'importe quelle application, et prend la bande d'onglets tout seul.
#  Mesure des trois montages, vrai Chromium sous Xvfb :
#
#     GTK, en-tete noir ....................... onglets #0A0A0B  barre #000000
#     GTK, en-tete GRIS, sans politique ....... onglets #26262B  barre #000000
#     GTK, en-tete GRIS, avec politique ....... onglets #26262B  barre #46464E
#     theme interne + politique (l'ISO 101) ... onglets #26262B  barre #46464E
#
#  Les deux dernieres lignes sont IDENTIQUES : on peut donc rendre Chromium
#  au theme du systeme sans que rien ne bouge a l'ecran. Un fichier de moins,
#  et un navigateur qui suit desormais le theme comme les autres.
#
#  ═══ POURQUOI LA POLITIQUE, ELLE, RESTE ═══
#  Parce qu'elle n'est PAS un bricolage : « BrowserThemeColor » est le
#  mecanisme officiel de Chromium, releve dans son binaire. Et parce que la
#  retirer coute la barre d'outils : ligne 2 du tableau, elle redevient
#  #000000 — plus noire qu'aujourd'hui, exactement ce dont Alex se plaignait.
#  Chromium n'est pas une application GTK : il LIT les couleurs GTK mais se
#  peint lui-meme, et sa barre d'outils suit le fond de fenetre, qui est le
#  noir de LexOS. On ne va pas eclaircir tout le bureau pour un navigateur.
#
#  ═══ LE GRIS ═══
#  #26262B, choisi par Alex sur trois propositions rendues cote a cote
#  (« 3er aime bien gris »).
#
#  ═══ CE QUE CE HOOK NE FAIT PAS ═══
#  La politique ne suit PAS le theme de jour : elle vit dans /etc, ecrite par
#  root a la construction, tandis que lexos-theme-gen n'ecrit que dans le
#  dossier de l'utilisateur. La barre d'outils du navigateur reste donc
#  derivee de ce gris meme en theme de jour. C'est assume, et c'est ecrit ici
#  pour que personne ne le redecouvre en le prenant pour un bogue.
# =============================================================================
echo "[lexos] hook 0445 : le haut du navigateur, et le navigateur officiel"

#  Surchargeables pour que ce hook soit eprouvable sur un banc, comme
#  LEXOS_THEMES du hook 0610. Les valeurs par defaut sont les vraies.
POL_CHROMIUM="${LEXOS_POL_CHROMIUM:-/etc/chromium/policies/managed}"
POL_CHROME="${LEXOS_POL_CHROME:-/etc/opt/chrome/policies/managed}"
SKEL="${LEXOS_SKEL:-/etc/skel}"
GRIS="${LEXOS_NAVIGATEUR_GRIS:-#26262B}"

# --- 1. La couleur, par la politique ----------------------------------------
#  Le meme fichier pour les deux navigateurs : Chromium lit
#  /etc/chromium/policies/managed, Google Chrome /etc/opt/chrome/policies/
#  managed. Les deux chemins sont dans les binaires respectifs, on ne les
#  invente pas.
for D in "$POL_CHROMIUM" "$POL_CHROME"; do
	mkdir -p "$D"
	cat > "$D/lexos-couleurs.json" <<EOF
{
  "BrowserThemeColor": "${GRIS}"
}
EOF
	echo "[lexos]   politique de couleur posee : $D/lexos-couleurs.json"
done

# --- 2. Chromium suit le theme du systeme, comme les autres -----------------
#  On lui posait ici un fichier de preferences (« system_theme: 0 ») pour le
#  sortir du theme GTK. Il ne sert plus : le gris est dans le theme, Chromium
#  le lit tout seul. Voir l'explication et les mesures en tete de fichier.
#
#  ET ON EFFACE CELUI QU'ON A DEJA POSE. Une ISO installee garde /etc/skel de
#  sa construction ; sans ce menage, une machine passee par l'ISO 101 garderait
#  un profil qui ignore le theme, et le jour ou Alex changerait d'accent son
#  navigateur serait le seul a ne pas suivre. On ne touche qu'au fichier qu'on
#  a ecrit nous-memes, et seulement s'il dit exactement ce qu'on y avait mis.
for P in chromium google-chrome; do
	F="$SKEL/.config/$P/Default/Preferences"
	if [ -f "$F" ] && grep -q '"system_theme":0' "$F" 2>/dev/null; then
		rm -f "$F"
		rmdir "$SKEL/.config/$P/Default" "$SKEL/.config/$P" 2>/dev/null || true
		echo "[lexos]   $P : ancien forcage de theme retire — il suit le systeme"
	fi
done

# --- 3. Chromium officiel : c'est le hook 0400 qui l'ecrit ------------------
#  ALEX : « garder lui officiel comme navigateur ». Le reglage vit dans
#  /etc/xdg/mimeapps.list, et ce fichier a DEJA un auteur : le hook 0400. On
#  l'y a corrige plutot que de le reecrire ici. Deux hooks qui ecrivent le
#  meme fichier, c'est la faute qui a donne trois palettes de panneaux
#  differentes dans ce depot ; on ne la refait pas pour un navigateur.
echo "[lexos]   navigateur officiel : ecrit par le hook 0400 (mimeapps.list)"

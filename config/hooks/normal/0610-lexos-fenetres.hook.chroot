#!/bin/sh
# =============================================================================
#  LexOS — des boutons de fenêtre qu'on puisse viser
# =============================================================================
#  LE PARI PERDU DU BUILD 70, ET CE QU'IL A APPRIS.
#
#  Alex : « les boutons en haut des fenêtres sont trop petits ». On a d'abord
#  fait passer title_font de 10 à 13, en supposant qu'xfwm4 met les images du
#  thème à l'échelle du texte. Résultat sur l'ISO 70, constaté à l'écran : la
#  barre de titre a bien grandi, LES BOUTONS SONT RESTÉS À LEUR TAILLE.
#
#  La raison, mesurée dans l'image : le thème xfwm4 d'Arc-Dark est fait
#  d'IMAGES PNG DE TAILLE FIXE. close-active.png fait 28×28 pixels, et il
#  fera 28×28 quelle que soit la police. xfwm4 n'a aucun réglage de taille de
#  bouton : la taille du bouton EST celle de son image.
#
#  On ne peut donc pas régler ça — il faut fabriquer les images.
#
#  CE QUE FAIT CE HOOK. Il dérive un thème « LexOS-<nom> » de chaque thème Arc
#  présent, en agrandissant uniquement ce qui compose la rangée du titre.
#
#  POURQUOI « UNIQUEMENT ». Les 45 images du thème se répartissent en trois
#  hauteurs, et elles ne jouent pas le même rôle :
#
#      32 images de 28 px  →  la rangée du titre : boutons, tuiles, coins
#       7 images de 16 px  →  les bords gauche et droit
#       6 images de  4 px  →  le bord du bas
#
#  Tout agrandir épaissirait les BORDURES des fenêtres — un cadre gras autour
#  de chaque fenêtre, que personne n'a demandé. On ne touche donc qu'aux 28.
#
#  POURQUOI LES DEUX MODES. « lexos theme clair » bascule le thème de fenêtre
#  sur « Arc ». Ne dériver qu'Arc-Dark aurait donné des boutons visables en
#  sombre et des boutons minuscules en clair — le correctif aurait eu l'air
#  de se défaire tout seul, et on aurait cherché la panne ailleurs. On dérive
#  donc les deux, quand les deux sont là.
#
#  ═══ LA LEÇON DES ICÔNES, APPLIQUÉE ICI AVANT DE LA REVIVRE ═══
#
#  Au build 70, les dossiers étaient BLEUS sur la photo d'Alex alors que le
#  thème LexOS était bien dans l'ISO : trois programmes écrivaient le nom du
#  thème d'icônes, et deux d'entre eux le remplaçaient après coup. Le thème
#  était là, personne ne le voyait.
#
#  Le thème de fenêtre a EXACTEMENT les mêmes trois écrivains :
#      · ce hook, à la construction ;
#      · lexos-firstrun, à la première ouverture de session ;
#      · « lexos theme », à chaque changement de mode.
#
#  Poser LexOS-Arc-Dark ici sans prévenir les deux autres, c'était livrer des
#  boutons qui redeviennent petits À LA PREMIÈRE SESSION, avant même qu'Alex
#  ait pu les voir. On publie donc le nom retenu dans /etc/lexos/build.conf,
#  d'où les deux autres le lisent — une seule vérité, comme pour les icônes.
#
#  CE HOOK N'ÉCHOUE JAMAIS. Sans Arc ni Arc-Dark, ou sans ImageMagick, il le
#  dit et s'arrête : le thème d'origine reste en place, les boutons restent
#  petits, et rien n'est cassé.
# =============================================================================
set -e

HAUTEUR_SRC=28
HAUTEUR_DST=40          # 40/28 ≈ 1,43 — visible sans devenir grotesque

#  ═══ LES COINS ARRONDIS, ET POURQUOI IL FAUT LES DESSINER SOI-MÊME ═══
#  Alex, photos de l'ISO 73 à côté de la démo : « arrondir les coins si vous
#  plaît », et « faire la page des fichiers pareille comme la 2e image » — où
#  la fenêtre Fichiers a des coins franchement ronds.
#
#  On a supposé qu'Arc-Dark en avait déjà et qu'on les avait abîmés. C'EST
#  FAUX, et c'est mesuré : dans assets.svg d'arc-theme, top-left-active est
#  le tracé « m 6,174 v 1 H 5 v 27 l 4,-1e-5 v -28 z ». Quatre pixels de
#  large, vingt-huit de haut, et pour tout arrondi UN décrochement d'un
#  pixel. Arc-Dark a des coins carrés. La photo d'Alex ne montrait pas une
#  régression : elle montrait le thème tel qu'il est.
#
#  xfwm4 n'a AUCUN réglage de rayon — la forme du coin EST l'alpha de son
#  image, exactement comme la taille du bouton EST celle de la sienne. On
#  redessine donc les quatre images de coin : la colonne de couleur vient de
#  title-3, donc elle suit le thème (sombre/clair, active/inactive) sans
#  qu'on écrive une seule couleur en dur, et un quart de disque en découpe
#  le coin extérieur.
#
#  LE BAS RESTE CARRÉ, ET C'EST VOULU. La barre de titre appartient à xfwm4 :
#  l'arrondir arrondit ce qu'on voit. Le bas d'une fenêtre, non — xfwm4 n'y
#  possède que les 4 px de bordure, le contenu de l'application occupe le
#  reste et xfwm4 ne peut pas le rogner. Arrondir la bordure du bas
#  laisserait apparaître le coin CARRÉ du contenu juste à l'intérieur de la
#  courbe : un défaut plus visible que celui qu'on corrige. La démo y arrive
#  parce qu'elle a « overflow:hidden » ; ici on n'a pas cet outil, et on ne
#  fait pas semblant de l'avoir.
RAYON=12                # ≈ 30 % de la hauteur du titre, comme la démo

#  ═══ POURQUOI LES BOUTONS SONT TRAITÉS À PART ═══
#  Photo d'Alex, fenêtre « Paramètres LexOS » : « le rouge est correct mais
#  les 2 autres, les grossir aussi ». Fermer est gros, le menu et agrandir
#  sont minuscules à côté. Deux causes, mesurées dans arc-theme :
#
#    · menu-active n'est PAS carré. Dans assets.svg c'est un rect de 26x16.
#      Le filtre « hauteur == 28 » ne le voyait donc pas : pendant que tout le
#      reste passait à 40 px, le bouton menu restait à 16. Il ne s'agissait
#      pas d'un bouton « un peu petit », il s'agissait d'un bouton JAMAIS
#      TOUCHÉ par le correctif censé le grossir.
#
#    · même à taille de toile égale, le DESSIN à l'intérieur n'a pas la même
#      taille : Arc dessine « fermer » en disque plein qui remplit sa toile,
#      et « agrandir » en trait fin qui en occupe la moitié. Agrandir la toile
#      ne change rien à ce rapport-là.
#
#  D'où deux règles au lieu d'une : on reconnaît les boutons PAR LEUR NOM (et
#  non par leur hauteur, qui vient justement de mentir), et on ramène chacun à
#  la même toile ET au même rapport d'encre que le plus généreux d'entre eux —
#  « fermer » sur Arc, celui qu'Alex dit correct. La mesure vient du thème :
#  aucune taille n'est écrite en dur ici, donc ça reste vrai si Arc change.
BOUTONS="close hide maximize menu shade stick"

#  Les trois chemins sont surchargeables — non pas pour qu'on les change en
#  production, mais pour que ce hook soit ÉPROUVABLE. Le hook 0905 a mis trois
#  ISO à trouver sa panne parce qu'on ne pouvait le lancer que dans une vraie
#  construction ; celui-ci tourne sur un banc, avec un faux thème aux trois
#  hauteurs et un faux ImageMagick. Vide de sens hors du banc : les valeurs
#  par défaut sont les vraies.
THEMES="${LEXOS_THEMES:-/usr/share/themes}"
CONF="${LEXOS_BUILD_CONF:-/etc/lexos/build.conf}"
SKELS="${LEXOS_XFWM_XML:-/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml}"

echo "[lexos] hook 0610 : boutons de fenêtre"

IM=""
for c in magick convert; do
	command -v "$c" >/dev/null 2>&1 && { IM="$c"; break; }
done
if [ -z "$IM" ]; then
	echo "[lexos]   !! ni magick ni convert — impossible de fabriquer les images."
	echo "[lexos]   !! « imagemagick » est dans optional-packages/00-core.list ;"
	echo "[lexos]   !! s'il manque ici, c'est que le hook 0250 ne l'a pas posé."
	exit 0
fi

#  La hauteur d'un PNG se lit dans son en-tête : octets 20 à 23, en gros
#  boutiste. Pas besoin d'ImageMagick pour MESURER — on le garde pour
#  redimensionner, et on évite un appel par fichier juste pour une taille.
hauteur_png() {
	od -An -tu1 -j20 -N4 "$1" 2>/dev/null \
		| awk '{ print $1*16777216 + $2*65536 + $3*256 + $4 }'
}

#  Ce fichier est-il un bouton de la rangée du titre ?
est_bouton() {
	_eb="${1%.png}"
	for _ebf in $BOUTONS; do
		case "$_eb" in "$_ebf"-*) return 0 ;; esac
	done
	return 1
}

#  Hauteur de l'ENCRE — la partie non transparente. Vide si l'image est
#  entièrement transparente : « -trim » échoue alors, et c'est très bien, un
#  gabarit vide n'a pas de dessin à agrandir.
encre_hauteur() {
	"$IM" "$1" -trim -format '%h' info: 2>/dev/null
}

#  ─── LES BOUTONS, TOUS À LA MÊME TAILLE ─────────────────────────────────────
#  Rend le nombre de boutons refaits sur sa sortie standard.
egaliser_boutons() {
	_dst="$1"
	_h="$2"

	#  1) Le plus généreux donne la mesure. On compare les rapports
	#     encre/toile en ENTIERS (produits croisés) : le shell POSIX n'a pas
	#     de virgule, et une division tronquée aurait mis tous les rapports
	#     à 0 — le genre de bug qui rend un correctif inerte sans rien dire.
	_num=0
	_den=1
	for _f in "$_dst"/*.png; do
		[ -f "$_f" ] || continue
		est_bouton "$(basename "$_f")" || continue
		_hc="$(hauteur_png "$_f")"
		case "$_hc" in ''|*[!0-9]*) continue ;; esac
		[ "$_hc" -gt 0 ] || continue
		_he="$(encre_hauteur "$_f")"
		case "$_he" in ''|*[!0-9]*) continue ;; esac
		[ "$_he" -gt 0 ] || continue
		if [ $((_he * _den)) -gt $((_num * _hc)) ]; then
			_num="$_he"
			_den="$_hc"
		fi
	done

	if [ "$_num" -eq 0 ]; then
		echo "[lexos]   !! aucun bouton avec du dessin — rien à égaliser" >&2
		echo 0
		return
	fi

	#  Hauteur d'encre visée, arrondie au plus proche.
	_t=$(( (_h * _num * 2 / _den + 1) / 2 ))
	[ "$_t" -gt 0 ] || _t=1

	#  2) Chacun est retaillé : on isole le dessin, on le met à la taille
	#     visée SANS déborder de la toile (« _h x _t » borne aussi la
	#     largeur — sinon un dessin large comme celui du menu, 26x16, se
	#     ferait rogner les côtés par « -extent »), puis on le recentre sur
	#     une toile carrée de la hauteur de la rangée.
	_faits=0
	for _f in "$_dst"/*.png; do
		[ -f "$_f" ] || continue
		est_bouton "$(basename "$_f")" || continue
		_he="$(encre_hauteur "$_f")"
		case "$_he" in ''|*[!0-9]*) continue ;; esac
		[ "$_he" -gt 0 ] || continue
		if "$IM" "$_f" -trim +repage -resize "${_h}x${_t}" \
			-background none -gravity center -extent "${_h}x${_h}" \
			-depth 8 "$_f" 2>/dev/null
		then
			_faits=$((_faits + 1))
		else
			echo "[lexos]   !! échec sur $(basename "$_f") — laissé tel quel" >&2
		fi
	done
	echo "[lexos]   boutons égalisés : ${_faits}, dessin à ${_t} px dans une toile de ${_h} px" >&2
	echo "$_faits"
}

#  ─── LES COINS DU HAUT, REDESSINÉS ──────────────────────────────────────────
#  Rend 0 si au moins un coin a été refait. Ne casse jamais rien : sur une
#  image manquante ou un ImageMagick qui refuse, on laisse le coin d'origine
#  et on le DIT — un coin carré est moins grave qu'un coin absent.
arrondir_coins() {
	_dst="$1"
	_h="$2"
	_r="$3"
	_faits=0
	_rates=0
	for _etat in active inactive; do
		#  title-3 est la pièce de remplissage unie de la barre. title-1 en
		#  est le repli : sur certains thèmes c'est elle qui porte le fond.
		_titre="$_dst/title-3-$_etat.png"
		[ -r "$_titre" ] || _titre="$_dst/title-1-$_etat.png"
		[ -r "$_titre" ] || continue
		for _coin in left right; do
			_cible="$_dst/top-$_coin-$_etat.png"
			[ -f "$_cible" ] || continue
			#  Le masque est tracé en NIVEAUX DE GRIS, pas en alpha : noir =
			#  transparent, blanc = opaque. « CopyOpacity » lit alors son
			#  intensité, ce qui marche pareil sur toutes les versions
			#  d'ImageMagick — là où un masque à canal alpha dépend de l'ordre
			#  exact des options « -alpha ».
			#  Le rectangle arrondi déborde volontairement (2R x 2H) : seule
			#  sa courbe du haut tombe dans la toile, donc seul le coin du
			#  haut est entamé. Le bas reste plein.
			if [ "$_coin" = "right" ]; then _flop="-flop"; else _flop=""; fi
			# shellcheck disable=SC2086
			if "$IM" "$_titre" -resize "${_r}x${_h}!" \
				\( -size "${_r}x${_h}" xc:black -fill white \
				   -draw "roundrectangle 0,0 $((_r * 2)),$((_h * 2)) ${_r},${_r}" \
				   $_flop -alpha off -colorspace Gray \) \
				-compose CopyOpacity -composite -depth 8 "$_cible" 2>/dev/null
			then
				_faits=$((_faits + 1))
			else
				_rates=$((_rates + 1))
			fi
		done
	done
	if [ "$_rates" -gt 0 ]; then
		echo "[lexos]   !! ${_rates} coin(s) non redessiné(s) — ils restent carrés"
	fi
	echo "[lexos]   coins arrondis : ${_faits}/4 (rayon ${_r} px sur ${_h} px de titre)"
	[ "$_faits" -gt 0 ]
}

#  Écrire une clé dans build.conf sans jamais la doubler — même forme que
#  celle du hook 0600, pour que les deux fichiers se relisent pareil.
pose_conf() {
	mkdir -p "$(dirname "$CONF")"
	touch "$CONF"
	if grep -q "^$1=" "$CONF"; then
		sed -i "s|^$1=.*|$1=\"$2\"|" "$CONF"
	else
		echo "$1=\"$2\"" >> "$CONF"
	fi
}

#  Dériver UN thème. Renvoie 0 s'il y a désormais un thème dérivé utilisable.
# =============================================================================
#  LE BOUTON « RÉDUIRE », EN JAUNE
# =============================================================================
#  ALEX : « ajouter un bouton jaune pour réduire les fenêtres, à droite de
#  l'écran ». Deux choses manquaient, pas une.
#
#  1. LE BOUTON N'ÉTAIT PAS DANS LA BARRE. button_layout valait « |OMC » —
#     menu, agrandir, fermer. Le « H » (hide) n'y figurait pas : aucune
#     fenêtre ne pouvait être réduite à la souris. Corrigé dans xfwm4.xml.
#
#  2. IL N'AURAIT PAS ÉTÉ JAUNE. Arc dessine « fermer » en DISQUE ROUGE et
#     « réduire » en simple tiret gris — mesuré dans les vraies images :
#     close-active.png porte un disque de 14 px (#CC575D) centré en
#     (13,5 · 13,5) dans une toile de 28 ; hide-active.png n'a qu'un trait.
#
#  ON REDESSINE DONC « réduire » DANS LE LANGAGE DU THÈME : le même disque,
#  au même endroit, en jaune, avec un tiret creusé dedans — exactement comme
#  la croix est creusée dans le disque rouge. Rouge pour fermer, jaune pour
#  réduire : la convention que tout le monde connaît déjà.
#
#  LA COULEUR DU TIRET EST LUE DANS LE THÈME, pas écrite en dur. Elle doit
#  être celle de la barre de titre pour que le tiret paraisse CREUSÉ ; or
#  Arc-Dark a une barre sombre et Arc une barre claire. Un ton en dur aurait
#  donné un bouton juste en sombre et faux en clair — le genre de correctif
#  qui a l'air de se défaire tout seul quand on change de thème.
#
#  On dessine à la taille SOURCE et AVANT l'agrandissement : le bouton passe
#  ensuite par egaliser_boutons() comme tous les autres et ressort à leur
#  taille. Le dessiner après aurait demandé de refaire ce calcul à la main.
#  ═══ LES TROIS PASTILLES DE LA BARRE DE TITRE ═══
#  ALEX : « on pourrait garder, en haut à droite : bouton rouge pour fermer
#  la fenêtre, bouton jaune pour réduire la fenêtre, bouton gris pour mettre
#  la page de côté. »
#
#  ARC N'EN DESSINE QU'UNE. Mesuré dans les vraies images : close-active.png
#  porte un DISQUE ROUGE de 14 px (#CC575D) centré en (13,5 · 13,5) dans une
#  toile de 28, avec la croix CREUSÉE dedans — le creux est de la couleur de
#  la barre de titre. hide et maximize, eux, ne sont que des traits gris
#  posés à plat : pas de disque, pas de couleur.
#
#  On redessine donc les deux manquantes DANS LE LANGAGE DU THÈME, en
#  reprenant exactement la géométrie du bouton rouge. Rouge, jaune, gris :
#  la convention que tout le monde reconnaît sans qu'on l'explique.
#
#  LES PROPORTIONS SONT MESURÉES, PAS CHOISIES. Le profil de la ligne
#  centrale du bouton rouge donne « ##RRRRR####RRRRR## » : la croix occupe
#  4 px sur 14, soit 29 % du disque. Une première version traçait un tiret
#  d'un bord à l'autre — vu en RENDANT le bouton, pas en relisant le calcul.
#
#  LA COULEUR DU CREUX EST LUE DANS LE THÈME, jamais écrite en dur : elle
#  doit être celle de la barre de titre pour que le glyphe paraisse creusé,
#  et Arc-Dark a une barre sombre quand Arc l'a claire. Un ton figé aurait
#  donné des boutons justes en sombre et faux en clair — le genre de
#  correctif qui a l'air de se défaire tout seul quand on change de thème.
#
#  On dessine à la taille SOURCE et AVANT l'agrandissement : les pastilles
#  passent ensuite par egaliser_boutons() comme les autres et ressortent à
#  leur taille. Les dessiner après aurait demandé de refaire ce calcul à la
#  main, avec une chance de tomber à côté.
#
#  L'état « inactive » reste GRIS pour tous : Arc grise les boutons d'une
#  fenêtre sans focus, le rouge compris. Des pastilles vives sur une fenêtre
#  d'arrière-plan attireraient l'œil vers la mauvaise.
#  Le cran de réduction des trois pastilles, en pourcentage du diamètre
#  relevé sur le bouton fermer. 100 = la taille d'origine.
PASTILLE_ECHELLE="${LEXOS_PASTILLE_ECHELLE:-78}"
PASTILLE_INACTIVE="#666A74"
#  Jaune — réduire.
JAUNE_ACTIF="#E5B027"; JAUNE_SURVOL="#F0C351"; JAUNE_PRESSE="#C4941A"
#  Gris — mettre de côté. Plus clair que la barre, sinon la pastille
#  disparaîtrait dans le fond au lieu de se voir.
GRIS_ACTIF="#9AA0AC";  GRIS_SURVOL="#B4BAC6";  GRIS_PRESSE="#7C8290"
#  Rouge — fermer. #CC575D est LA couleur d'Arc, relevée dans close-active.png :
#  on ne réinvente pas le bouton qu'Alex trouve déjà bon, on le REDESSINE avec
#  la même géométrie que les deux autres. Voir juste en dessous pourquoi.
ROUGE_ACTIF="#CC575D"; ROUGE_SURVOL="#DC6E73"; ROUGE_PRESSE="#B4454B"

#  ON RELÈVE AU MILIEU DE LA BARRE, PAS À DEUX PIXELS DU HAUT.
#  La première version lisait p{2,2}. Sur l'Arc-Dark d'origine — 28 px de
#  haut — ça tombait dans l'aplat : srgb(47,52,63), la bonne couleur. Mais
#  ces images sont ÉTIRÉES juste avant, parce que la barre de titre de LexOS
#  est plus haute que celle d'Arc (28 → 40 px). Le mince trait clair qu'Arc
#  pose sur sa toute première ligne s'étale alors, et vient couvrir la
#  deuxième : p{2,2} lisait srgb(52,57,70), c'est-à-dire le REFLET du haut
#  et non le fond. Le creux des trois pastilles sortait donc d'un ton trop
#  clair, sur toutes les fenêtres, depuis que la barre a grandi.
#
#  Le milieu de l'image ne peut ni attraper le reflet du haut ni la bordure
#  du bas, quelle que soit la hauteur de la barre — aujourd'hui et la
#  prochaine fois qu'Alex la fera grandir. « -gravity center -crop 1x1+0+0 »
#  découpe ce pixel-là et se lit pareil sur ImageMagick 6 et 7.
fond_barre() { # fond_barre <dossier xfwm4> → la couleur de la barre de titre
	for _t in title-1-active title-3-active title-1-inactive; do
		if [ -r "$1/$_t.png" ]; then
			"$IM" "$1/$_t.png" -gravity center -crop 1x1+0+0 +repage \
				-format '%[pixel:p{0,0}]' info: 2>/dev/null && return 0
		fi
	done
	return 1
}

#  pastille <dossier> <bouton> <glyphe> <actif> <survol> <pressé> <diamètre>
#  <glyphe> vaut « croix » (fermer), « tiret » (réduire) ou « carre »
#  (mettre de côté). <diamètre> est celui du bouton rouge, mesuré par
#  pastilles_couleur() : les trois le partagent, c'est tout le correctif.
pastille() {
	_pd="$1"; _pb="$2"; _pg="$3"
	if [ ! -f "$_pd/$_pb-active.png" ]; then
		echo "[lexos]   !! pas de $_pb-active.png — pastille $_pb non peinte"
		return 1
	fi
	_creux="$(fond_barre "$_pd")"
	if [ -z "$_creux" ]; then
		echo "[lexos]   !! barre de titre illisible — pastille $_pb non peinte"
		return 1
	fi
	#  ═══ LA TAILLE EST IMPOSÉE, PLUS DÉDUITE ═══
	#  ALEX, capture zoomée de la barre de titre : « ils sont pas de la même
	#  grandeur — ce qu'on a ajouté pour réduire les fenêtres, les mettre de
	#  la même grandeur », puis « fais qu'il soit la même grandeur que le
	#  bouton rouge ». Sur sa photo, le rouge est plus gros que le jaune et
	#  le gris.
	#
	#  LE PREMIER MONTAGE DEMANDAIT À DEUX MÉCANIQUES DE TOMBER D'ACCORD.
	#  On peignait les pastilles à la taille d'ORIGINE, puis on laissait
	#  egaliser_boutons() les mettre à l'échelle avec les autres. Cette
	#  fonction normalise le rapport ENCRE/TOILE : elle ne peut égaliser que
	#  ce qu'elle a réussi à mesurer et à retailler, et tout bouton qu'elle
	#  saute (encre illisible, retaille refusée) reste à 28 px pendant que
	#  les autres passent à 40. C'est exactement ce que montre la photo.
	#
	#  Reproduit ici sur un faux thème Arc : tant que tout se passe bien, les
	#  trois sortent identiques — donc l'accord tenait par chance, et rien ne
	#  le garantissait. Sur la machine d'Alex il n'a pas tenu.
	#
	#  On arrête de dépendre de cet accord. Les pastilles sont maintenant
	#  peintes APRÈS l'agrandissement, directement à la taille FINALE, avec
	#  la même géométrie pour les trois. Elles ne peuvent plus différer : ce
	#  sont trois exécutions du même dessin, aux mêmes chiffres.
	#  ═══ ET LE DIAMÈTRE EST CELUI DU ROUGE, MESURÉ ═══
	#  ALEX, en deux temps : « fais en sorte que le bouton rouge reste la
	#  même grandeur que sa photo et mettre les autres [pareils] », puis
	#  « même grandeur que le rouge ». Le rouge est donc la RÉFÉRENCE : il ne
	#  doit pas bouger, les deux autres doivent le rejoindre.
	#
	#  On ne fixe donc pas un diamètre choisi ici — on MESURE celui que le
	#  bouton fermer a déjà, tel qu'il sort d'egaliser_boutons(), et on peint
	#  les trois à cette taille-là. Le rouge garde exactement l'allure de sa
	#  photo, et le jaune et le gris deviennent son jumeau.
	#  Le repli (14 sur 40, le disque d'Arc à l'échelle) ne sert que si la
	#  mesure échoue : mieux vaut trois pastilles d'une taille raisonnable
	#  que trois pastilles d'aucune taille.
	_c="$HAUTEUR_DST"
	_diam="$7"
	case "$_diam" in ''|*[!0-9]*) _diam=0 ;; esac
	[ "$_diam" -gt 3 ] && [ "$_diam" -le "$_c" ] || _diam=$(( _c * 7 / 10 ))
	#  ═══ UN CRAN PLUS PETIT ═══
	#  ALEX, après l'ISO 97 : « on pourrait les mettre un peu plus petits, les
	#  3 boutons à droite de l'écran ». Le diamètre relevé sur le bouton fermer
	#  reste la RÉFÉRENCE — c'est lui qui garantit que les trois se
	#  ressemblent, et il ne faut surtout pas y renoncer — mais on le réduit
	#  d'un cran avant de dessiner. Réduire ici plutôt qu'ailleurs garde la
	#  propriété qui compte : les trois passent par le même chiffre.
	_diam=$(( _diam * PASTILLE_ECHELLE / 100 ))
	[ "$_diam" -gt 3 ] || _diam=4
	_r=$(( _diam / 2 ))         # le rayon du disque
	_m=$(( _c / 2 ))            # le centre
	_d=$(( _r / 2 ))            # demi-largeur du glyphe : 50 % du disque
	[ "$_d" -gt 0 ] || _d=1
	_faits=0
	for _paire in "active:$4" "prelight:$5" "pressed:$6" "inactive:$PASTILLE_INACTIVE"; do
		_etat="${_paire%%:*}"; _teinte="${_paire#*:}"
		[ -f "$_pd/$_pb-$_etat.png" ] || continue
		if [ "$_pg" = "croix" ]; then
			#  La croix de « fermer ». Même demi-largeur que le carré et
			#  le tiret : c'est ce qui fait que les trois se ressemblent.
			set -- -fill none -stroke "$_creux" -strokewidth 2 \
			       -draw "line $(( _m - _d )),$(( _m - _d )) $(( _m + _d )),$(( _m + _d ))" \
			       -draw "line $(( _m + _d )),$(( _m - _d )) $(( _m - _d )),$(( _m + _d ))"
		elif [ "$_pg" = "carre" ]; then
			#  Un carré CREUX : c'est le dessin universel d'« agrandir /
			#  restaurer », et il se distingue du tiret d'un coup d'œil.
			set -- -fill none -stroke "$_creux" -strokewidth 2 			       -draw "rectangle $(( _m - _d )),$(( _m - _d )) $(( _m + _d )),$(( _m + _d ))"
		else
			set -- -fill "$_creux" -stroke none 			       -draw "rectangle $(( _m - _d )),$(( _m - 1 )) $(( _m + _d )),$(( _m + 1 ))"
		fi
		if "$IM" -size "${_c}x${_c}" xc:none 			-fill "$_teinte" -stroke none 			-draw "circle $_m,$_m $_m,$(( _m - _r ))" 			"$@" -depth 8 "$_pd/$_pb-$_etat.png" 2>/dev/null
		then
			_faits=$(( _faits + 1 ))
		else
			echo "[lexos]   !! échec du dessin de $_pb-$_etat — laissé tel quel"
		fi
	done
	echo "[lexos]   pastille « $_pb » peinte : ${_faits}/4 états (disque ${_r} px, creux ${_creux})"
	[ "$_faits" -gt 0 ]
}

pastilles_couleur() { # pastilles_couleur <dossier xfwm4>
	#  ─── LA MESURE, PRISE UNE FOIS ET AVANT DE REPEINDRE QUOI QUE CE SOIT ───
	#  Le bouton rouge est la référence d'Alex. On relève le diamètre qu'il a
	#  DÉJÀ, tel qu'il sort de la chaîne d'agrandissement — après quoi il sera
	#  repeint à ce même diamètre, donc sans changer d'allure, et les deux
	#  autres avec lui. Mesurer après l'avoir repeint mesurerait notre propre
	#  dessin : la référence serait perdue.
	_pcd=0
	if [ -f "$1/close-active.png" ]; then
		_pcd="$(encre_hauteur "$1/close-active.png")"
		case "$_pcd" in ''|*[!0-9]*) _pcd=0 ;; esac
	fi
	echo "[lexos]   pastilles : diamètre du bouton rouge relevé à ${_pcd} px"

	#  LE ROUGE AUSSI EST REPEINT, et c'est le cœur du correctif. Le laisser
	#  tel qu'Arc le livre, c'était garder comme référence une géométrie qu'on
	#  ne contrôle pas. Repeint au diamètre qu'on vient de lui mesurer, il ne
	#  change pas d'allure — mais les trois portent désormais le même disque,
	#  au même centre, dans la même toile. « La même grandeur que le bouton
	#  rouge » devient vrai par construction, et non par un calcul qui doit
	#  tomber juste.
	pastille "$1" close    croix "$ROUGE_ACTIF" "$ROUGE_SURVOL" "$ROUGE_PRESSE" "$_pcd" || true
	pastille "$1" hide     tiret "$JAUNE_ACTIF" "$JAUNE_SURVOL" "$JAUNE_PRESSE" "$_pcd" || true
	pastille "$1" maximize carre "$GRIS_ACTIF"  "$GRIS_SURVOL"  "$GRIS_PRESSE"  "$_pcd" || true
}

derive() {
	SRC="$THEMES/$1/xfwm4"
	NOM_DST="LexOS-$1"
	DST="$THEMES/$NOM_DST/xfwm4"

	[ -d "$SRC" ] || { echo "[lexos]   $1 absent — rien à dériver de ce côté"; return 1; }

	rm -rf "${THEMES:?}/${NOM_DST:?}"
	mkdir -p "$DST"
	cp -a "$SRC"/. "$DST"/
	AGRANDIS=0
	IGNORES=0
	for f in "$DST"/*.png; do
		[ -f "$f" ] || continue
		#  Les boutons ont leur propre règle (egaliser_boutons) : ils ne
		#  passent PAS par le filtre de hauteur, qui laissait le menu de
		#  côté parce qu'il fait 26x16 et non 28x28.
		est_bouton "$(basename "$f")" && continue
		h="$(hauteur_png "$f")"
		if [ "$h" = "$HAUTEUR_SRC" ]; then
			if "$IM" "$f" -resize "x${HAUTEUR_DST}" "$f" 2>/dev/null; then
				AGRANDIS=$((AGRANDIS + 1))
			else
				echo "[lexos]   !! échec sur $(basename "$f") — laissé tel quel"
			fi
		else
			IGNORES=$((IGNORES + 1))
		fi
	done

	BOUTONS_FAITS="$(egaliser_boutons "$DST" "$HAUTEUR_DST")"
	case "$BOUTONS_FAITS" in ''|*[!0-9]*) BOUTONS_FAITS=0 ;; esac

	#  ═══ LES TROIS PASTILLES, EN DERNIER ET À LA TAILLE FINALE ═══
	#  Elles étaient peintes avant l'agrandissement, à charge pour
	#  egaliser_boutons() de les mettre à l'échelle avec les autres. Alex a
	#  photographié le résultat : le rouge plus gros que le jaune et le gris.
	#  Peintes ICI, après tout le reste, elles sortent aux mêmes chiffres
	#  quoi qu'il arrive en amont — voir le long commentaire dans pastille().
	pastilles_couleur "$DST"
	AGRANDIS=$((AGRANDIS + BOUTONS_FAITS))

	echo "[lexos]   $1 : ${AGRANDIS} images de la rangée du titre agrandies (${HAUTEUR_SRC} -> ${HAUTEUR_DST} px, boutons compris), ${IGNORES} bordures intactes"

	#  Un thème dérivé qui n'a rien changé mais porte notre nom, c'est le genre
	#  de mensonge poli qu'on traque ici depuis le build 66. On l'efface.
	if [ "$AGRANDIS" -eq 0 ]; then
		echo "[lexos]   !! aucune image agrandie — on efface $NOM_DST plutôt que"
		echo "[lexos]   !! de livrer une copie de $1 sous un autre nom."
		rm -rf "${THEMES:?}/${NOM_DST:?}"
		return 1
	fi

	arrondir_coins "$DST" "$HAUTEUR_DST" "$RAYON" || true

	#  L'écart autour des boutons suit leur taille, sinon ils se touchent.
	if [ -f "$DST/themerc" ]; then
		sed -i -e 's/^button_offset=.*/button_offset=3/' \
		       -e 's/^button_spacing=.*/button_spacing=3/' "$DST/themerc" 2>/dev/null || true
	fi

	cat > "$THEMES/$NOM_DST/index.theme" <<EOF
[Desktop Entry]
Type=X-GNOME-Metatheme
Name=$NOM_DST
Comment=$1, avec des boutons de fenêtre visables
EOF
	return 0
}

XFWM_SOMBRE=""
XFWM_CLAIR=""
derive Arc-Dark && XFWM_SOMBRE="LexOS-Arc-Dark"
derive Arc      && XFWM_CLAIR="LexOS-Arc"

if [ -z "$XFWM_SOMBRE" ] && [ -z "$XFWM_CLAIR" ]; then
	echo "[lexos]   !! aucun thème dérivé — boutons inchangés, rien n'est cassé."
	exit 0
fi

#  ═══ LA SOURCE UNIQUE ═══
#  Ces deux clés sont ce que lexos-firstrun et « lexos theme » liront. Sans
#  elles, ils écriraient « Arc-Dark » par-dessus notre thème à la première
#  session — la panne des icônes du build 70, refaite à l'identique.
#  Repli explicite sur le thème d'origine quand un mode n'a pas pu être
#  dérivé : mieux vaut des petits boutons qu'un nom de thème qui n'existe pas,
#  qui ferait retomber XFCE sur son habillage clair par défaut.
[ -n "$XFWM_SOMBRE" ] || XFWM_SOMBRE="Arc-Dark"
[ -n "$XFWM_CLAIR" ]  || XFWM_CLAIR="Arc"
pose_conf LEXOS_XFWM_THEME        "$XFWM_SOMBRE"
pose_conf LEXOS_XFWM_THEME_CLAIR  "$XFWM_CLAIR"

#  Et dans le XML du squelette, que XFCE lit à la création du compte. Le hook
#  0600 vient d'y écrire le thème GTK ; on ne remplace QUE la valeur, sans
#  présumer de ce qu'elle contient — un jour où 0600 aurait choisi un repli,
#  une recherche de « Arc-Dark » en toutes lettres n'aurait rien trouvé et le
#  hook aurait échoué en silence.
for x in $SKELS; do
	[ -f "$x" ] || continue
	sed -i "s|\(name=\"theme\"[^>]*value=\"\)[^\"]*\"|\1${XFWM_SOMBRE}\"|" "$x" 2>/dev/null || true
done

echo "[lexos]   thème de fenêtre : ${XFWM_SOMBRE} (sombre) · ${XFWM_CLAIR} (clair)"
echo "[lexos]   publié dans build.conf — firstrun et « lexos theme » le liront"
echo "[lexos] hook 0610 : ok"

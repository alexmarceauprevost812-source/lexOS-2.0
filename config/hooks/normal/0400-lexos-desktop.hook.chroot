SKEL_XFCONF="/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$SKEL_XFCONF"

# --- Horloge du panneau : la marque au centre, comme la démo ----------------
#  La démo affiche « lexOS ⚡ Pro   mer. 12 août 17 h 19 » au centre de la
#  barre. Le panneau, lui, n'affichait que la date et l'heure. La saveur ne
#  peut pas être écrite en dur dans le XML — elle change d'une ISO à l'autre —
#  donc on l'injecte ici.
#
#  Le XML livré contient déjà un format VALABLE (« lexOS  %a %d %b  %H h %M »).
#  Si cette substitution échoue, on garde donc une horloge correcte, juste
#  sans le nom de la saveur. Jamais de jeton non remplacé à l'écran.
#  LA MÊME HORLOGE PARTOUT, ET LA MÊME QUE LA DÉMO.
#
#  L'horloge affichait le nom de la saveur : « lexOS ⚡ Dev » sur le
#  portable, « lexOS ⚡ Pro » sur l'Alienware. C'était la dernière chose
#  visible à l'écran qui n'était pas pareille entre les deux machines — et
#  la démo, elle, montre « lexOS⚡Pro ». Maintenant que les deux ISO
#  installent exactement les mêmes applications, cette distinction ne veut
#  plus rien dire à l'écran : on affiche partout ce que montre la démo.
#
#  La vraie saveur de l'ISO n'est pas perdue pour autant, elle reste lisible
#  à trois endroits : le nom du fichier ISO, la fenêtre de bienvenue, et la
#  commande « lexos infos » dans le terminal.
case "${LEXOS_FLAVOUR:-standard}" in
	minimal) SAVEUR_AFFICHEE="" ;;
	*)       SAVEUR_AFFICHEE="Pro" ;;
esac

#  L'éclair de la démo est un emoji : sans police emoji installée il
#  s'afficherait en carré vide, au beau milieu de la barre. On ne le pose
#  que si la police est réellement là, sinon un point médian fait l'affaire.
if ls /usr/share/fonts/truetype/noto/NotoColorEmoji* >/dev/null 2>&1; then
	SEPARATEUR_MARQUE="⚡"
else
	SEPARATEUR_MARQUE="·"
fi

if [ -n "$SAVEUR_AFFICHEE" ] && [ -f "$SKEL_XFCONF/xfce4-panel.xml" ]; then
	FORMAT_HORLOGE="lexOS ${SEPARATEUR_MARQUE} ${SAVEUR_AFFICHEE}   %a %d %b  %H h %M"
	sed -i "s|value=\"lexOS  %a %d %b  %H h %M\"|value=\"${FORMAT_HORLOGE}\"|g" \
		"$SKEL_XFCONF/xfce4-panel.xml"
	if grep -qF "$FORMAT_HORLOGE" "$SKEL_XFCONF/xfce4-panel.xml"; then
		echo "[lexos]   horloge : ${FORMAT_HORLOGE}"
	else
		echo "[lexos]   !! horloge non personnalisée — format par défaut conservé"
	fi
fi

# --- Aucun greffon déclaré ne doit manquer à l'appel ------------------------
#  LE BOGUE QUE CE BLOC RÉPARE, ET IL A COÛTÉ TROIS ISO.
#
#  Alex : « quand je clique, le menu du haut disparaît. » On a cru à Compiz,
#  on a corrigé Compiz, et la barre disparaissait encore. La photo a donné la
#  réponse : au démarrage, xfce4-panel ouvrait une fenêtre
#
#     « Le greffon "power-manager-plugin" n'a pas pu être chargé,
#       voulez-vous le supprimer de la configuration de xfce4-panel ? »
#          [ Supprimer ]   [ Quitter ]
#
#  et « Quitter » ferme le panneau EN ENTIER. La barre ne disparaissait pas
#  toute seule : elle disparaissait au clic, parce que le clic tombait sur ce
#  bouton-là.
#
#  La cause de fond : la configuration livrée DÉCLARE des greffons
#  (whiskermenu, pulseaudio, power-manager-plugin, genmon) que le hook 0250
#  installait en « best effort ». Un seul manquant, et la fenêtre s'ouvre.
#  Ces quatre paquets sont désormais obligatoires (flavours/standard), mais
#  une liste de paquets peut encore échouer un jour, et un greffon peut
#  changer de nom d'une version de Debian à l'autre. Alors on vérifie ici,
#  pour TOUS les greffons déclarés, et on retire de la configuration ceux qui
#  ne sont pas réellement installés. La fenêtre ne peut plus s'ouvrir.
#
#  Les greffons intégrés à xfce4-panel lui-même (séparateur, lanceur,
#  horloge…) ne sont jamais vérifiés : xfce4-panel est un paquet obligatoire,
#  ils sont là par construction, et une vérification qui se tromperait sur eux
#  viderait la barre au lieu de la réparer.
GREFFONS_INTERNES="separator launcher actions clock systray tasklist pager \
showdesktop windowmenu applicationsmenu directorymenu"

if [ -f "$SKEL_XFCONF/xfce4-panel.xml" ]; then
	A_RETIRER=""
	for DECL in $(sed -n 's|.*<property name="plugin-\([0-9]*\)" type="string" value="\([a-z0-9-]*\)".*|\1:\2|p' \
			"$SKEL_XFCONF/xfce4-panel.xml"); do
		ID="${DECL%%:*}"
		NOM="${DECL#*:}"

		INTERNE=0
		for I in $GREFFONS_INTERNES; do
			[ "$I" = "$NOM" ] && { INTERNE=1; break; }
		done
		[ "$INTERNE" -eq 1 ] && continue

		if [ -e "/usr/share/xfce4/panel/plugins/${NOM}.desktop" ]; then
			echo "[lexos]   greffon ${NOM} : présent"
		else
			echo "[lexos]   !! greffon ${NOM} absent — retiré de la barre (plugin-${ID})"
			A_RETIRER="${A_RETIRER} ${ID}"
		fi
	done

	if [ -n "$A_RETIRER" ]; then
		#  awk plutôt que sed : un bloc plugin-N peut contenir des
		#  </property> imbriqués (plugin-1 a un tableau « favorites »), donc
		#  « supprimer jusqu'à la première balise fermante » emporterait la
		#  moitié du fichier. On compte la profondeur.
		#
		#  Et le numéro du greffon doit être retiré du tableau « plugin-ids »
		#  SANS toucher aux autres entiers du fichier : un value="1" traîne
		#  aussi dans les propriétés du panneau lui-même.
		awk -v retirer="$A_RETIRER" '
			BEGIN { n = split(retirer, t, " "); for (i = 1; i <= n; i++) mauvais[t[i]] = 1 }

			/<property name="plugin-ids" type="array">/ { dans_ids = 1; print; next }
			dans_ids && /<\/property>/                  { dans_ids = 0; print; next }
			dans_ids {
				if (match($0, /value="[0-9]+"/)) {
					v = substr($0, RSTART + 7, RLENGTH - 8)
					if (v in mauvais) next
				}
				print; next
			}

			saut {
				if ($0 ~ /<property/ && $0 !~ /\/>[[:space:]]*$/) profondeur++
				if ($0 ~ /<\/property>/) { profondeur--; if (profondeur <= 0) saut = 0 }
				next
			}

			match($0, /<property name="plugin-[0-9]+" type="string"/) {
				id = $0; sub(/.*name="plugin-/, "", id); sub(/".*/, "", id)
				if (id in mauvais) {
					if ($0 ~ /\/>[[:space:]]*$/) next   # balise auto-fermante
					saut = 1; profondeur = 1; next
				}
			}

			{ print }
		' "$SKEL_XFCONF/xfce4-panel.xml" > "$SKEL_XFCONF/xfce4-panel.xml.tmp" \
			&& mv "$SKEL_XFCONF/xfce4-panel.xml.tmp" "$SKEL_XFCONF/xfce4-panel.xml"
	else
		echo "[lexos]   barre du haut : tous les greffons déclarés sont installés"
	fi
fi

# --- Météo : genmon ne lit PAS xfce4-panel.xml -----------------------------
#  ERREUR DE MA PART, et elle explique pourquoi la barre affichait
#  « (genmon)XXX » au lieu de « ☁ 20° ». J'avais mis la commande de la météo
#  dans xfce4-panel.xml, comme pour les autres greffons. genmon, lui, ne
#  passe pas par xfconf du tout : il ouvre son propre fichier
#  ~/.config/xfce4/panel/genmon-<numéro>.rc (xfce_panel_plugin_lookup_rc_file
#  + xfce_rc_simple_open, vérifié dans le binaire du paquet Debian).
#
#  Les propriétés posées dans le XML n'ont donc jamais été lues, sur aucune
#  ISO : genmon affichait son étiquette par défaut « (genmon) » suivie de sa
#  valeur par défaut « XXX ». Les clés qu'il lit vraiment sont Command,
#  Text, UseLabel, UpdatePeriod et Font — relevées dans libgenmon.so.
#
#  Le numéro du fichier est celui du greffon dans plugin-ids : 13.
if [ -e /usr/share/xfce4/panel/plugins/genmon.desktop ]; then
	mkdir -p /etc/skel/.config/xfce4/panel
	cat > /etc/skel/.config/xfce4/panel/genmon-13.rc <<'EOF'
Text=Météo
Command=lexos-meteo --panneau
UpdatePeriod=900000
UseLabel=0
Font=Noto Sans 10
EOF
	echo "[lexos]   météo : genmon-13.rc écrit (commande lexos-meteo --panneau)"

	#  Même mécanique pour le greffon 16 : les appareils branchés (imprimante,
	#  écran, casque, USB, disque — la rangée d'icônes de la démo). Cinq
	#  secondes entre deux lectures : tout est local, rien ne part au réseau.
	cat > /etc/skel/.config/xfce4/panel/genmon-16.rc <<'EOF'
Text=Appareils
Command=lexos-peripheriques --panneau
UpdatePeriod=5000
UseLabel=0
Font=Noto Sans 10
EOF
	echo "[lexos]   appareils : genmon-16.rc écrit (commande lexos-peripheriques --panneau)"

	#  L'HORLOGE. Elle était le greffon « clock » de XFCE ; elle est devenue
	#  un genmon pour qu'un clic dessus ouvre le volet des notifications et
	#  de l'agenda — le greffon d'origine ouvre SON calendrier et ne sait
	#  rien lancer d'autre. Elle a donc besoin de son .rc comme les deux
	#  autres, sans quoi la barre afficherait « (genmon)XXX » à la place de
	#  l'heure : exactement la panne qu'on vient de décrire pour la météo.
	#
	#  Une seconde entre deux lectures : lexos-heure est un « date » suivi
	#  d'un « printf ». C'est ce qu'il faut pour que l'affichage des secondes,
	#  proposé dans les Paramètres, soit juste plutôt qu'approximatif.
	cat > /etc/skel/.config/xfce4/panel/genmon-3.rc <<'EOF'
Text=Heure
Command=lexos-heure --panneau
UpdatePeriod=1000
UseLabel=0
Font=Noto Sans 10
EOF
	echo "[lexos]   horloge : genmon-3.rc écrit (commande lexos-heure --panneau)"
else
	#  PAS DE GENMON — ET UNE BARRE SANS HEURE SERAIT PIRE QUE TOUT.
	#  Le nettoyage plus haut retire les greffons déclarés mais absents : sans
	#  ce repli, plugin-3 disparaîtrait et il n'y aurait plus d'horloge du
	#  tout. On remet donc le greffon « clock » de XFCE, qui est interne et
	#  toujours là. On perd le clic qui ouvre le volet — il reste accessible
	#  par « lexos volet » — mais on garde l'heure, qui est l'essentiel.
	PANNEAU_XML="/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
	if [ -f "$PANNEAU_XML" ] && grep -q 'value="lexos-heure --panneau"' "$PANNEAU_XML"; then
		python3 - "$PANNEAU_XML" <<'PYEOF'
import re, sys
chemin = sys.argv[1]
s = open(chemin, encoding="utf-8").read()
bloc = re.search(r'    <property name="plugin-3" type="string" value="genmon">.*?</property>\n',
                 s, re.S)
if bloc:
    s = s[:bloc.start()] + (
        '    <property name="plugin-3" type="string" value="clock">\n'
        '      <property name="mode"                type="uint"   value="2"/>\n'
        '      <property name="digital-time-format" type="string" value="lexOS  %a %d %b  %H h %M"/>\n'
        '      <property name="tooltip-format"      type="string" value="%A %d %B %Y"/>\n'
        '    </property>\n') + s[bloc.end():]
    open(chemin, "w", encoding="utf-8").write(s)
    print("remis")
PYEOF
		echo "[lexos]   !! genmon absent — horloge XFCE d'origine remise (pas de volet au clic)"
	fi
fi

# --- Raccourcis clavier ------------------------------------------------------
#  CE HOOK N'ÉCRIT PLUS CE FICHIER, ET C'EST UNE CORRECTION.
#
#  Il faisait « cat > "$SKEL_XFCONF/xfce4-keyboard-shortcuts.xml" », donc il
#  ÉCRASAIT entièrement le fichier livré par includes.chroot. Le jeu qui
#  arrivait dans l'ISO était le sien, et il ne gardait AUCUN raccourci de
#  capture : Maj+Impr écr, Alt+Impr écr, Ctrl+Maj+R et les accords
#  Super+chiffre ne faisaient rien du tout. Pendant ce temps l'aide de
#  « lexos » continuait de les annoncer — le système mentait sur son propre
#  mode d'emploi. Deux fichiers pour un seul réglage, c'est toujours l'un des
#  deux qui gagne en silence.
#
#  Les deux jeux sont désormais FUSIONNÉS dans le fichier livré. Ce hook ne
#  fait plus que VÉRIFIER qu'il est bien arrivé — et le dire fort s'il manque,
#  parce qu'une ISO sans raccourcis se remarque tard et s'explique mal.
RACCOURCIS="$SKEL_XFCONF/xfce4-keyboard-shortcuts.xml"
if [ -r "$RACCOURCIS" ]; then
	MANQUE=""
	for CLE in "lexos capture" "workspace_1_key" "xfce4-terminal"; do
		grep -q "$CLE" "$RACCOURCIS" || MANQUE="${MANQUE} ${CLE}"
	done
	if [ -n "$MANQUE" ]; then
		echo "[lexos]   !! raccourcis incomplets, manquent :${MANQUE}"
	else
		echo "[lexos]   raccourcis clavier : captures, lancements et bureaux en place"
	fi
else
	echo "[lexos]   !! AUCUN fichier de raccourcis — captures et Super+chiffre morts"
fi

echo "[lexos] hook 0400 : ok"

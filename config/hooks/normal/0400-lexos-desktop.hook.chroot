#!/bin/sh
# =============================================================================
#  LexOS — configuration du bureau (LightDM, XFCE, PolicyKit)
#  Ne fait rien si la saveur est « minimal » (pas de serveur X).
# =============================================================================
set -e

if [ ! -x /usr/sbin/lightdm ] && [ ! -x /usr/bin/startxfce4 ]; then
	echo "[lexos] hook 0400 : pas de bureau installé, ignoré"
	exit 0
fi

echo "[lexos] hook 0400 : bureau"

LEXOS_NAME="LexOS"
LEXOS_GTK_BASE_THEME="Arc-Dark"
LEXOS_ICON_THEME="Papirus-Dark"
LEXOS_LIVE_USER="lex"

if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
fi

# --- LightDM : écran de connexion -------------------------------------------
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-lexos.conf <<EOF
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
greeter-hide-users=false
allow-guest=true
EOF

cat > /etc/lightdm/lightdm-gtk-greeter.conf <<EOF
[greeter]
background=/usr/share/backgrounds/lexos/wallpaper.png
theme-name=${LEXOS_GTK_BASE_THEME}
icon-theme-name=${LEXOS_ICON_THEME}
font-name=Noto Sans 11
xft-antialias=true
xft-hintstyle=hintslight
xft-rgba=rgb
indicators=~host;~spacer;~clock;~spacer;~layout;~session;~a11y;~power
clock-format=%A %d %B — %H:%M
position=50%,center 55%,center
default-user-image=/usr/share/lexos/branding/mascot.png
user-background=false
hide-user-image=false
round-user-image=true
EOF

# --- Session live : autologin ------------------------------------------------
# live-config gère déjà l'autologin ; on renforce pour LightDM.
cat > /etc/lightdm/lightdm.conf.d/60-lexos-autologin.conf <<EOF
[Seat:*]
autologin-user=${LEXOS_LIVE_USER}
autologin-user-timeout=0
autologin-session=xfce
EOF

# (le thème GTK est produit par le hook 0600 — LexOS Noir)

# --- Le live user peut utiliser sudo sans mot de passe ----------------------
#  Voulu en session démo : rien à protéger sur une clé USB, et l'installateur
#  en a besoin. Mais Calamares recopie le système tel quel sur le disque, ce
#  fichier compris : sur la machine installée, quelqu'un qui nomme son compte
#  « lex » hériterait en silence d'un sudo sans mot de passe.
#  D'où le garde-fou ci-dessous, qui efface le fichier à tout démarrage qui
#  n'est pas une session live.
cat > /etc/sudoers.d/lexos-live <<EOF
${LEXOS_LIVE_USER} ALL=(ALL) NOPASSWD: ALL
EOF
chmod 0440 /etc/sudoers.d/lexos-live

chmod 0755 /usr/lib/lexos/live-sudo-guard 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
	systemctl enable lexos-live-sudo-guard.service >/dev/null 2>&1 \
		&& echo "[lexos]   garde-fou sudo activé" \
		|| echo "[lexos]   !! garde-fou sudo non activé"
fi

# --- Compte « invite » : repli pour la session invité -----------------------
# allow-guest=true (ci-dessus) laisse LightDM proposer sa propre session
# invité via le paquet lightdm-guest-session — ajouté en best-effort dans
# optional-packages/20-desktop.list, car sa disponibilité dans les dépôts
# Debian n'est pas garantie. En complément (deux paliers, comme ailleurs dans
# LexOS), on crée ici un vrai compte « invite » qui existe toujours, que ce
# paquet soit installé ou non : sans mot de passe utilisable (compte
# verrouillé), et surtout sans sudo ni groupe d'administration.
# Note : un vrai nettoyage du $HOME à la déconnexion demanderait un script de
# session PAM (pam_exec) — hors périmètre ici ; ce compte n'est qu'une cible
# de connexion de repli, sûre par construction.
id invite >/dev/null 2>&1 || \
	useradd -m -s /bin/bash -c "Invité LexOS — session limitée, sans mot de passe, sans droits admin" invite
passwd -l invite >/dev/null 2>&1 || true

if [ -r /usr/share/lexos/branding/mascot.png ]; then
	mkdir -p /var/lib/AccountsService/icons
	cp /usr/share/lexos/branding/mascot.png /var/lib/AccountsService/icons/invite
fi

# --- Navigateur et applications par défaut ----------------------------------
mkdir -p /etc/xdg
cat > /etc/xdg/mimeapps.list <<'EOF'
[Default Applications]
text/html=firefox-esr.desktop
x-scheme-handler/http=firefox-esr.desktop
x-scheme-handler/https=firefox-esr.desktop
text/plain=org.xfce.mousepad.desktop
inode/directory=thunar.desktop
image/png=org.xfce.ristretto.desktop
image/jpeg=org.xfce.ristretto.desktop
EOF

# --- Entrées de menu LexOS ---------------------------------------------------
mkdir -p /usr/share/applications

cat > /usr/share/applications/lexos-about.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=À propos de ${LEXOS_NAME}
Name[en]=About ${LEXOS_NAME}
Comment=Informations sur le système
Exec=lexos-welcome --about
Icon=lexos
Terminal=false
Categories=System;
Keywords=lexos;about;systeme;
EOF

cat > /usr/share/applications/lexos-share.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Partager un fichier
Name[en]=Share a file
Comment=Envoyer des photos et des fichiers vers un téléphone (QR code, KDE Connect, Bluetooth)
Exec=xfce4-terminal --title="Partage LexOS" --command="lexos-share qr %F"
Icon=lexos-share
Terminal=false
Categories=Utility;FileTransfer;
Keywords=partage;share;qr;telephone;photo;image;
MimeType=image/png;image/jpeg;image/gif;image/webp;application/pdf;
EOF

cat > /usr/share/applications/lexos-ecran-telephone.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Écran du téléphone
Name[en]=Phone screen
Comment=Afficher et contrôler l'écran d'un téléphone Android sur l'ordinateur (scrcpy)
Exec=xfce4-terminal --title="Écran du téléphone — LexOS" --hold -e "lexos ecran-telephone"
Icon=lexos-share
Terminal=false
Categories=Utility;FileTransfer;
Keywords=telephone;phone;ecran;screen;mirroring;scrcpy;android;
EOF

cat > /usr/share/applications/lexos-vide-memoire.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Vide mémoire +
Name[en]=Empty memory +
Comment=Extraire TOUS les fichiers et photos d'un téléphone ou d'une clé USB en une fois
Exec=xfce4-terminal --title="Vide mémoire + — LexOS" --hold -e "lexos vide-memoire"
Icon=lexos-usb
Terminal=false
Categories=Utility;FileTransfer;
Keywords=vide;memoire;extraire;copier;import;telephone;usb;photos;sauvegarde;
EOF

cat > /usr/share/applications/lexos-terminal-appareil.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Terminal de l'appareil
Name[en]=Device shell
Comment=Ouvrir un terminal SUR le téléphone Android (adb shell, débogage USB requis)
Exec=xfce4-terminal --title="Terminal de l'appareil — LexOS" --hold -e "lexos terminal-appareil"
Icon=lexos-terminal
Terminal=false
Categories=Utility;TerminalEmulator;
Keywords=terminal;shell;adb;telephone;android;appareil;console;
EOF

cat > /usr/share/applications/lexos-format.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Formater une clé USB ou un téléphone
Name[en]=Format a USB key or phone
Comment=Effacer et reformater un support amovible — jamais le disque système, confirmation exigée
Exec=xfce4-terminal --title="Formater — LexOS" --hold -e "lexos format"
Icon=lexos-usb
Terminal=false
Categories=System;Filesystem;
Keywords=formater;format;effacer;cle;usb;telephone;disque;
EOF

cat > /usr/share/applications/lexos-capture.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Capture d'écran
Name[en]=Screenshot
Comment=Photographier l'écran, une fenêtre ou une zone (Impr écr)
Exec=lexos capture
Icon=lexos-camera
Terminal=false
Categories=Graphics;Utility;
Keywords=capture;ecran;screenshot;photo;image;impression;
Actions=Fenetre;Zone;Video;

[Desktop Action Fenetre]
Name=Capturer la fenêtre active
Exec=lexos capture fenetre

[Desktop Action Zone]
Name=Capturer une zone
Exec=lexos capture zone

[Desktop Action Video]
Name=Enregistrer l'écran en vidéo
Exec=xfce4-terminal --title="Enregistrement — LexOS" --hold -e "lexos capture video"
EOF

cat > /usr/share/applications/lexos-capture-video.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Enregistreur d'écran
Name[en]=Screen recorder
Comment=Enregistrer l'écran en vidéo avec le son du système (Ctrl+Maj+R)
Exec=xfce4-terminal --title="Enregistrement — LexOS" --hold -e "lexos capture video"
Icon=lexos-camera
Terminal=false
Categories=AudioVideo;Recorder;
Keywords=enregistrer;video;ecran;record;screencast;ffmpeg;
EOF

cat > /usr/share/applications/lexos-logitheque.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Logithèque
Name[en]=Software
Comment=Installer des applications en quelques clics (dépôts Debian et Flathub)
Exec=lexos logitheque
Icon=system-software-install
Terminal=false
Categories=System;PackageManager;
Keywords=logitheque;boutique;applications;installer;paquets;software;store;flatpak;
EOF

cat > /usr/share/applications/lexos-perf.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Performance de la machine
Name[en]=Machine performance
Comment=Petit, médium, performant ou performance max
Exec=lexos-perf --gui
Icon=lexos-perf-medium
Terminal=false
Categories=Settings;System;
Keywords=performance;batterie;vitesse;cpu;profil;
EOF

cat > /usr/share/applications/lexos-display.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Écrans
Name[en]=Displays
Comment=Plusieurs écrans : étendre, dupliquer, choisir l'écran principal
Exec=lexos-display gui
Icon=video-display
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=ecran;moniteur;display;hdmi;projecteur;multi;
EOF

cat > /usr/share/applications/lexos-ia.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=IA locale
Name[en]=Local AI
Comment=Assistant IA 100% local (Ollama) — rien n'est envoyé sur internet
Exec=xfce4-terminal --title="IA locale — LexOS" -e "lexos ia"
Icon=lexos
Terminal=false
Categories=System;Utility;
Keywords=ia;ai;intelligence artificielle;agent;ollama;assistant;
EOF

cat > /usr/share/applications/lexos-secure.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Sécurité
Name[en]=Security
Comment=Pare-feu, antivirus, anti-intrusion, anti-rootkit
Exec=xfce4-terminal --title="Sécurité — LexOS" --hold -e "lexos secure; bash"
Icon=lexos-secure
Terminal=false
Categories=System;Security;
Keywords=securite;security;pare-feu;firewall;antivirus;confidentialite;privacy;
EOF

cat > /usr/share/applications/lexos-avion.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Mode avion
Name[en]=Airplane mode
Comment=Couper ou rallumer Wi-Fi, Bluetooth et données mobiles
Exec=lexos-net avion toggle
Icon=airplane-mode
Terminal=false
Categories=Settings;System;
Keywords=avion;airplane;wifi;bluetooth;radio;
EOF

# --- Action « Partager » dans le clic droit du gestionnaire de fichiers -----
mkdir -p /etc/skel/.config/Thunar
cat > /etc/skel/.config/Thunar/uca.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <icon>lexos-share</icon>
    <name>Partager avec LexOS</name>
    <submenu></submenu>
    <unique-id>lexos-share-1</unique-id>
    <command>xfce4-terminal --title=&quot;Partage LexOS&quot; --hold --command=&quot;lexos-share qr %F&quot;</command>
    <description>Envoyer vers un téléphone par QR code</description>
    <range>*</range>
    <patterns>*</patterns>
    <startup-notify/>
    <image-files/>
    <other-files/>
    <text-files/>
    <audio-files/>
    <video-files/>
    <directories/>
  </action>
  <action>
    <icon>lexos-zip</icon>
    <name>Extraire ici</name>
    <submenu></submenu>
    <unique-id>lexos-unzip-1</unique-id>
    <command>lexos-unzip %F</command>
    <description>Extraire l'archive dans un dossier à côté d'elle</description>
    <range>*</range>
    <patterns>*.zip;*.tar;*.tar.gz;*.tgz;*.tar.bz2;*.tbz2;*.tar.xz;*.txz;*.7z;*.rar</patterns>
    <startup-notify/>
    <other-files/>
  </action>
  <action>
    <icon>lexos-terminal</icon>
    <name>Ouvrir un terminal ici</name>
    <submenu></submenu>
    <unique-id>lexos-terminal-1</unique-id>
    <command>xfce4-terminal --working-directory=%f</command>
    <description>Ouvrir un terminal dans ce dossier</description>
    <range></range>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
  <action>
    <icon>drive-removable-media</icon>
    <name>Formater ce support…</name>
    <submenu></submenu>
    <unique-id>lexos-format-1</unique-id>
    <command>lexos-format --gui %f</command>
    <description>Formater une clé USB ou un téléphone (jamais le disque système)</description>
    <range></range>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
  <action>
    <icon>insert-image</icon>
    <name>Créer un autocollant</name>
    <submenu></submenu>
    <unique-id>lexos-sticker-1</unique-id>
    <command>lexos-sticker --gui %f</command>
    <description>Découper le sujet de la photo en autocollant (PNG à fond transparent)</description>
    <range>*</range>
    <patterns>*.png;*.PNG;*.jpg;*.JPG;*.jpeg;*.JPEG;*.webp;*.WEBP;*.bmp;*.BMP</patterns>
    <startup-notify/>
    <image-files/>
  </action>
</actions>
EOF

# --- Raccourcis clavier ------------------------------------------------------
SKEL_XFCONF="/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$SKEL_XFCONF"
cat > "$SKEL_XFCONF/xfce4-keyboard-shortcuts.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="custom" type="empty">
      <property name="&lt;Super&gt;Return"  type="string" value="xfce4-terminal"/>
      <property name="&lt;Super&gt;e"       type="string" value="thunar"/>
      <property name="&lt;Super&gt;a"       type="string" value="lexos-net avion toggle"/>
      <property name="&lt;Super&gt;p"       type="string" value="lexos-perf --gui"/>
      <property name="&lt;Super&gt;s"       type="string" value="xfce4-appfinder"/>
      <property name="&lt;Super&gt;d"       type="string" value="lexos-display gui"/>
      <property name="XF86Display"          type="string" value="lexos-display gui"/>
      <property name="XF86WLAN"             type="string" value="lexos-net avion toggle"/>
      <property name="Print"                type="string" value="xfce4-screenshooter"/>
      <property name="override" type="bool" value="true"/>
    </property>
  </property>
  <!-- Agrandir les fenêtres : bouton de la barre de titre, double-clic sur la
       barre, et ces raccourcis. Pas de « override » ici, volontairement — il
       remplacerait TOUS les raccourcis de fenêtre par défaut (Alt+Tab,
       Alt+F4, changement de bureau…) au lieu de s'y ajouter. -->
  <property name="xfwm4" type="empty">
    <property name="custom" type="empty">
      <property name="&lt;Super&gt;Up"    type="string" value="maximize_window_key"/>
      <property name="&lt;Super&gt;Down"  type="string" value="unmaximize_window_key"/>
      <property name="&lt;Super&gt;Left"  type="string" value="tile_left_key"/>
      <property name="&lt;Super&gt;Right" type="string" value="tile_right_key"/>
      <property name="F11"                type="string" value="fullscreen_key"/>
    </property>
  </property>
</channel>
EOF

echo "[lexos] hook 0400 : ok"

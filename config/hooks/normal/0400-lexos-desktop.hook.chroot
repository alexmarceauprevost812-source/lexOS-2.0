Name[en]=Disks
Comment=La santé des disques avant qu'ils meurent — SMART, remplissage, espace
Comment[en]=Disk health before they die — SMART, usage, space
Exec=xfce4-terminal --hold --title="Disques — LexOS" -e "lexos disques"
Icon=lexos-disque
Terminal=false
Categories=System;Utility;
Keywords=disque;disk;smart;espace;plein;ssd;nvme;sante;santé;
EOF

cat > /usr/share/applications/lexos-sauvegarde.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Sauvegarde
Name[en]=Backup
Comment=Tes fichiers, copiés pour de vrai — chiffré, restaurable fichier par fichier
Comment[en]=Your files, truly backed up — encrypted, restorable file by file
Exec=xfce4-terminal --hold --title="Sauvegarde — LexOS" -e "lexos sauvegarde"
Icon=lexos
Terminal=false
Categories=System;Utility;Archiving;
Keywords=sauvegarde;backup;borg;copie;restaurer;timeshift;

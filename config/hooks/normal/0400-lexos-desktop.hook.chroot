cat > /usr/share/applications/lexos-perf.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Performance de la machine
Name[en]=Machine performance
Comment=Petit, médium, performant ou performance max
Exec=lexos-perf --gui
Icon=lexos-perf-medium
Terminal=false
Categories=Settings;System;
Keywords=performance;batterie;vitesse;cpu;profil;
EOF

cat > /usr/share/applications/lexos-display.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Écrans
Name[en]=Displays
Comment=Plusieurs écrans : étendre, dupliquer, choisir l'écran principal
Exec=lexos-display gui
Icon=video-display
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=ecran;moniteur;display;hdmi;projecteur;multi;
EOF

#  DEUX ENTRÉES, DEUX MÉTIERS. Celle-ci ouvrait « IA locale » sur un
#  terminal — mais l'agent en terminal et la fenêtre qui explique pourquoi
#  c'est lent ne sont pas le même outil, et deux entrées du même nom dans le
#  menu, c'est un tirage au sort. Le terminal garde son nom de métier.
cat > /usr/share/applications/lexos-ia.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=IA — agent (terminal)
Name[en]=AI agent (terminal)
Comment=L'agent IA local : il exécute des commandes pour toi, avec confirmation
Exec=xfce4-terminal --title="IA locale — LexOS" -e "lexos ia"
Icon=lexos
Terminal=false
Categories=System;Utility;
Keywords=ia;ai;intelligence artificielle;agent;ollama;assistant;terminal;
EOF

cat > /usr/share/applications/lexos-ia-locale.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=IA locale
Name[en]=Local AI
Comment=Un modèle de langage sur ta machine — quelle carte, quels modèles, et une discussion
Comment[en]=A language model on your machine — hardware, models, and a chat
Exec=lexos-ia-locale
Icon=lexos
Terminal=false
StartupNotify=true
Categories=System;Utility;
Keywords=ia;ai;intelligence artificielle;llama;llama.cpp;ollama;modele;modèle;gguf;local;hors ligne;
EOF

#  Les six assistants IA en ligne (Claude, ChatGPT, Gemini, Perplexity,
#  Mistral, Copilot), chacun en fenêtre dédiée. Une entrée de menu et non
#  six : c'est le sélecteur de lexos-assistants qui fait le choix — six
#  icônes presque identiques dans le menu, personne ne les distingue.
cat > /usr/share/applications/lexos-assistants.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Assistants IA
Name[en]=AI Assistants
Comment=Claude, ChatGPT, Gemini, Perplexity, Mistral, Copilot — en fenêtre dédiée
Comment[en]=Claude, ChatGPT, Gemini, Perplexity, Mistral, Copilot — each in its own window
Exec=lexos assistants
Icon=lexos
Terminal=false
StartupNotify=true
Categories=Network;Utility;
Keywords=ia;ai;assistant;claude;chatgpt;gemini;perplexity;mistral;copilot;
EOF

#  La couche diagnostic et sauvegarde — née de l'audit « carte des trous » :
#  huit outils prévus, zéro écrit, et l'icône du disque qui attendait son
#  panneau depuis le build 60. Trois entrées de menu, en terminal : ces
#  outils PARLENT, et un diagnostic qu'on ne lit pas n'existe pas.
cat > /usr/share/applications/lexos-medecin.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Médecin LexOS
Name[en]=LexOS Doctor
Comment=« Qu'est-ce qui ne va pas ? » — services, disque, mémoire, chauffe, réseau, journal
Comment[en]=One-command triage: services, disk, memory, heat, network, logs
Exec=xfce4-terminal --hold --title="Médecin — LexOS" -e "lexos medecin"
Icon=lexos
Terminal=false
Categories=System;Utility;
Keywords=diagnostic;probleme;problème;panne;lent;medecin;médecin;doctor;sante;santé;
EOF

cat > /usr/share/applications/lexos-disques.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0

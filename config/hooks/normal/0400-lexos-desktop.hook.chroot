# --- Action « Partager » dans le clic droit du gestionnaire de fichiers -----
mkdir -p /etc/skel/.config/Thunar
cat > /etc/skel/.config/Thunar/uca.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <icon>preferences-desktop-wallpaper</icon>
    <name>Définir comme fond d'écran</name>
    <submenu></submenu>
    <unique-id>lexos-fond-ecran-1</unique-id>
    <command>lexos wallpaper %f remplir</command>
    <description>Utilise cette image comme fond d'écran, sur tous les écrans branchés</description>
    <range>1</range>
    <patterns>*.jpg;*.jpeg;*.JPG;*.JPEG;*.png;*.PNG;*.webp;*.WEBP;*.avif;*.bmp;*.tif;*.tiff;*.gif</patterns>
    <image-files/>
    <startup-notify/>
  </action>
  <action>
    <icon>package-x-generic</icon>
    <name>Run ins — installer depuis cette archive</name>
    <submenu></submenu>
    <unique-id>lexos-run-ins-1</unique-id>
    <command>xfce4-terminal --title=&quot;Run ins — LexOS&quot; --hold --command=&quot;lexos run-ins %f&quot;</command>
    <description>Extrait l'archive, montre ce qu'elle contient, et demande avant d'exécuter quoi que ce soit</description>
    <range>1</range>
    <patterns>*.zip;*.ZIP</patterns>
    <startup-notify/>
    <other-files/>
  </action>
  <action>
    <icon>lexos-share</icon>
    <name>Partager avec LexOS</name>
    <submenu></submenu>
    <unique-id>lexos-share-1</unique-id>
    <command>xfce4-terminal --title=&quot;Partage LexOS&quot; --hold --command=&quot;lexos-share qr %F&quot;</command>
    <description>Envoyer vers un téléphone par QR code</description>
    <range>*</range>
    <patterns>*</patterns>
    <startup-notify/>
    <image-files/>
    <other-files/>
    <text-files/>
    <audio-files/>
    <video-files/>
    <directories/>
  </action>
  <action>
    <icon>lexos-zip</icon>
    <name>Extraire ici</name>
    <submenu></submenu>
    <unique-id>lexos-unzip-1</unique-id>
    <command>lexos-unzip %F</command>
    <description>Extraire l'archive dans un dossier à côté d'elle</description>
    <range>*</range>
    <patterns>*.zip;*.tar;*.tar.gz;*.tgz;*.tar.bz2;*.tbz2;*.tar.xz;*.txz;*.7z;*.rar</patterns>
    <startup-notify/>
    <other-files/>
  </action>
  <action>
    <icon>lexos-terminal</icon>
    <name>Ouvrir un terminal ici</name>
    <submenu></submenu>
    <unique-id>lexos-terminal-1</unique-id>
    <command>xfce4-terminal --working-directory=%f</command>
    <description>Ouvrir un terminal dans ce dossier</description>
    <range></range>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
  <action>
    <icon>drive-removable-media</icon>
    <name>Formater ce support…</name>
    <submenu></submenu>
    <unique-id>lexos-format-1</unique-id>
    <command>lexos-format --gui %f</command>
    <description>Formater une clé USB ou un téléphone (jamais le disque système)</description>
    <range></range>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
  <action>
    <icon>insert-image</icon>
    <name>Créer un autocollant</name>
    <submenu></submenu>
    <unique-id>lexos-sticker-1</unique-id>
    <command>lexos-sticker --gui %f</command>
    <description>Découper le sujet de la photo en autocollant (PNG à fond transparent)</description>
    <range>*</range>
    <patterns>*.png;*.PNG;*.jpg;*.JPG;*.jpeg;*.JPEG;*.webp;*.WEBP;*.bmp;*.BMP</patterns>
    <startup-notify/>
    <image-files/>
  </action>
</actions>
EOF

SKEL_XFCONF="/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$SKEL_XFCONF"

# --- Horloge du panneau : la marque au centre, comme la démo ----------------
#  La démo affiche « lexOS ⚡ Pro   mer. 12 août 17 h 19 » au centre de la
#  barre. Le panneau, lui, n'affichait que la date et l'heure. La saveur ne
#  peut pas être écrite en dur dans le XML — elle change d'une ISO à l'autre —
#  donc on l'injecte ici.
#
#  Le XML livré contient déjà un format VALABLE (« lexOS  %a %d %b  %H h %M »).
#  Si cette substitution échoue, on garde donc une horloge correcte, juste
#  sans le nom de la saveur. Jamais de jeton non remplacé à l'écran.
case "${LEXOS_FLAVOUR:-standard}" in
	pro)    SAVEUR_AFFICHEE="Pro" ;;
	gaming) SAVEUR_AFFICHEE="Gaming" ;;
	dev)    SAVEUR_AFFICHEE="Dev" ;;
	full)   SAVEUR_AFFICHEE="Full" ;;
	*)      SAVEUR_AFFICHEE="" ;;
esac

#  L'éclair de la démo est un emoji : sans police emoji installée il
#  s'afficherait en carré vide, au beau milieu de la barre. On ne le pose
#  que si la police est réellement là, sinon un point médian fait l'affaire.
if ls /usr/share/fonts/truetype/noto/NotoColorEmoji* >/dev/null 2>&1; then
	SEPARATEUR_MARQUE="⚡"
else
	SEPARATEUR_MARQUE="·"
fi

if [ -n "$SAVEUR_AFFICHEE" ] && [ -f "$SKEL_XFCONF/xfce4-panel.xml" ]; then
	FORMAT_HORLOGE="lexOS ${SEPARATEUR_MARQUE} ${SAVEUR_AFFICHEE}   %a %d %b  %H h %M"
	sed -i "s|value=\"lexOS  %a %d %b  %H h %M\"|value=\"${FORMAT_HORLOGE}\"|g" \
		"$SKEL_XFCONF/xfce4-panel.xml"
	if grep -qF "$FORMAT_HORLOGE" "$SKEL_XFCONF/xfce4-panel.xml"; then
		echo "[lexos]   horloge : ${FORMAT_HORLOGE}"
	else
		echo "[lexos]   !! horloge non personnalisée — format par défaut conservé"
	fi
fi

# --- Météo dans la barre : seulement si le greffon est réellement là -------
#  Le panneau livré déclare un greffon « genmon » (plugin-13) qui affiche la
#  sortie de « lexos-meteo --panneau » — c'est le « ☁ 20° » de la démo.
#  xfce4-genmon-plugin voyage dans les paquets OPTIONNELS : son absence
#  n'arrête pas la construction. Mais un panneau qui déclare un greffon
#  absent affiche une tuile cassée avec un point d'exclamation, à demeure,
#  au milieu de la barre. On préfère retirer la météo que livrer ça.
if [ -f "$SKEL_XFCONF/xfce4-panel.xml" ]; then
	if [ -e /usr/share/xfce4/panel/plugins/genmon.desktop ]; then
		echo "[lexos]   météo : greffon genmon présent"
	else
		#  Le bloc plugin-13 ne contient que des propriétés auto-fermantes :
		#  la première balise fermante rencontrée est bien la sienne.
		sed -i '/<property name="plugin-13"/,/<\/property>/d' "$SKEL_XFCONF/xfce4-panel.xml"
		sed -i '\|<value type="int" value="13"/>|d' "$SKEL_XFCONF/xfce4-panel.xml"
		echo "[lexos]   !! genmon absent — météo retirée du panneau"
	fi
fi

# --- Raccourcis clavier ------------------------------------------------------
cat > "$SKEL_XFCONF/xfce4-keyboard-shortcuts.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="custom" type="empty">
      <property name="&lt;Super&gt;Return"  type="string" value="xfce4-terminal"/>
      <property name="&lt;Super&gt;e"       type="string" value="thunar"/>
      <property name="&lt;Super&gt;a"       type="string" value="lexos-net avion toggle"/>
      <property name="&lt;Super&gt;p"       type="string" value="lexos-perf --gui"/>
      <property name="&lt;Super&gt;s"       type="string" value="xfce4-appfinder"/>
      <property name="&lt;Super&gt;d"       type="string" value="lexos-display gui"/>
      <property name="XF86Display"          type="string" value="lexos-display gui"/>
      <property name="XF86WLAN"             type="string" value="lexos-net avion toggle"/>
      <property name="Print"                type="string" value="xfce4-screenshooter"/>
      <property name="override" type="bool" value="true"/>
    </property>
  </property>
  <!-- Agrandir les fenêtres : bouton de la barre de titre, double-clic sur la
       barre, et ces raccourcis. Pas de « override » ici, volontairement — il
       remplacerait TOUS les raccourcis de fenêtre par défaut (Alt+Tab,
       Alt+F4, changement de bureau…) au lieu de s'y ajouter. -->
  <property name="xfwm4" type="empty">
    <property name="custom" type="empty">
      <property name="&lt;Super&gt;Up"    type="string" value="maximize_window_key"/>
      <property name="&lt;Super&gt;Down"  type="string" value="unmaximize_window_key"/>
      <property name="&lt;Super&gt;Left"  type="string" value="tile_left_key"/>
      <property name="&lt;Super&gt;Right" type="string" value="tile_right_key"/>
      <property name="F11"                type="string" value="fullscreen_key"/>
    </property>
  </property>
</channel>
EOF

echo "[lexos] hook 0400 : ok"

#!/bin/sh
# =============================================================================
#  LexOS — configuration du bureau (LightDM, XFCE, PolicyKit)
#  Ne fait rien si la saveur est « minimal » (pas de serveur X).
# =============================================================================
set -e

if [ ! -x /usr/sbin/lightdm ] && [ ! -x /usr/bin/startxfce4 ]; then
	echo "[lexos] hook 0400 : pas de bureau installé, ignoré"
	exit 0
fi

echo "[lexos] hook 0400 : bureau"

LEXOS_NAME="LexOS"
LEXOS_LIVE_USER="lex"
#  Les noms de thèmes ne sont plus lus ici : l'apparence de l'écran de
#  connexion est passée au hook 0410, et le bureau au 0600. Les garder en
#  double, c'est se préparer à en corriger un et pas l'autre.

if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
fi

# --- LightDM : écran de connexion -------------------------------------------
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-lexos.conf <<EOF
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
greeter-hide-users=false
allow-guest=true
EOF

#  L'APPARENCE de l'écran de connexion (le noir, l'orange, le démon en fond)
#  vit dans le hook 0410 : elle a sa propre logique de repli et son propre
#  banc d'essai. Ici on ne pose que le SIÈGE — quel greeter, quelle session.

# --- Compte de session live : créé DÈS LA CONSTRUCTION -----------------------
#  Correctif (construction 12) : on comptait sur live-config pour créer le
#  compte « ${LEXOS_LIVE_USER} » à l'amorçage à partir du paramètre noyau
#  « username=… ». Sur Debian trixie ce paramètre nu n'était pas honoré de
#  façon fiable : le compte n'existait pas, l'autologin du tty (login -f)
#  échouait en boucle (« Authentication failure ») et LightDM ne proposait
#  que la session invité — impossible d'atteindre le bureau ni Calamares.
#  On crée donc le compte ICI, dans le chroot, pour qu'il existe TOUJOURS :
#  autologin du tty, écran de connexion LightDM et connexion en console
#  fonctionnent alors tous les trois.
if ! id "${LEXOS_LIVE_USER}" >/dev/null 2>&1; then
	useradd -m -s /bin/bash -c "${LEXOS_NAME} Live" "${LEXOS_LIVE_USER}"
fi
#  Groupes utiles au bureau (ignore ceux qui n'existent pas encore).
for g in sudo audio video plugdev netdev cdrom dip users bluetooth lpadmin scanner; do
	getent group "$g" >/dev/null 2>&1 && adduser "${LEXOS_LIVE_USER}" "$g" >/dev/null 2>&1 || true
done
#  Mot de passe de secours = le nom du compte (ex. « lex » / « lex ») : sert
#  à la connexion manuelle si l'autologin est un jour désactivé. Le compte
#  n'est PAS verrouillé, sinon « login -f » échouerait comme avant.
echo "${LEXOS_LIVE_USER}:${LEXOS_LIVE_USER}" | chpasswd
passwd -u "${LEXOS_LIVE_USER}" >/dev/null 2>&1 || true

# --- Session live : autologin ------------------------------------------------
# live-config gère déjà l'autologin ; on renforce pour LightDM.
cat > /etc/lightdm/lightdm.conf.d/60-lexos-autologin.conf <<EOF
[Seat:*]
autologin-user=${LEXOS_LIVE_USER}
autologin-user-timeout=0
autologin-session=xfce
EOF

# --- Autologin aussi en console (tty1) : le compte existe désormais ----------
#  Renfort du même correctif : on pose l'autologin getty nous-mêmes, sans
#  dépendre de live-config, pour que la première console ouvre une session
#  « ${LEXOS_LIVE_USER} » même si live-config ne l'a pas configuré.
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/lexos-autologin.conf <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin ${LEXOS_LIVE_USER} --noclear %I \$TERM
EOF

# (le thème GTK est produit par le hook 0600 — LexOS Noir)

# --- Le live user peut utiliser sudo sans mot de passe ----------------------
#  Voulu en session démo : rien à protéger sur une clé USB, et l'installateur
#  en a besoin. Mais Calamares recopie le système tel quel sur le disque, ce
#  fichier compris : sur la machine installée, quelqu'un qui nomme son compte
#  « lex » hériterait en silence d'un sudo sans mot de passe.
#  D'où le garde-fou ci-dessous, qui efface le fichier à tout démarrage qui
#  n'est pas une session live.
cat > /etc/sudoers.d/lexos-live <<EOF
${LEXOS_LIVE_USER} ALL=(ALL) NOPASSWD: ALL
EOF
chmod 0440 /etc/sudoers.d/lexos-live

#  Le garde-fou efface, sur un système INSTALLÉ, les commodités qui n'ont de
#  sens que sur la clé USB : sudo sans mot de passe, ET l'ouverture de session
#  automatique sur le compte « lex ». Cette dernière était oubliée — elle
#  ouvrait le compte de la démo sur la machine installée, si bien qu'on
#  n'atteignait jamais l'écran où choisir SON compte, et qu'on croyait
#  l'installateur fautif de ne pas l'avoir créé.
#  PAS DE « || true » NI DE « || echo » DANS CETTE ZONE, ET C'EST DÉLIBÉRÉ.
#  Ce fichier est le correctif du bogue du 12 août (« le système installé
#  ouvrait la session de démo, jamais celle de l'utilisateur »). Tel que
#  c'était écrit, s'il disparaissait ou si le service refusait de s'activer,
#  la construction RÉUSSISSAIT, l'ISO sortait, et TOUTES les machines
#  installées à partir d'elle rouvraient la session de démo — le bogue
#  revenu à l'identique. Le seul signe aurait été deux lignes « !! » perdues
#  dans un journal de trois heures que personne ne lit.
#  Il vaut cent fois mieux perdre une construction que livrer ça.
if [ ! -f /usr/lib/lexos/demo-guard ]; then
	echo "[lexos] !! /usr/lib/lexos/demo-guard ABSENT — sans lui, toute machine installée rouvre la session de démo au lieu du compte de l'utilisateur." >&2
	exit 1
fi
chmod 0755 /usr/lib/lexos/demo-guard

if ! systemctl enable lexos-demo-guard.service >/dev/null 2>&1; then
	echo "[lexos] !! lexos-demo-guard.service refuse de s'activer — le garde-fou ne tournerait jamais sur les machines installées." >&2
	exit 1
fi
echo "[lexos]   garde-fou démo activé (sudo + ouverture automatique)"

#  Contrôle de construction : le garde-fou doit connaître les trois fichiers
#  qu'il est chargé d'effacer. Si l'un des chemins change ailleurs sans être
#  reporté ici, on ARRÊTE — le découvrir sur une machine installée qui ouvre
#  la session de démo coûte infiniment plus cher qu'une construction perdue.
#  On les parcourt tous avant de sortir, pour dire d'un coup TOUT ce qui
#  manque au lieu d'obliger à trois constructions successives.
MANQUE=0
for CIBLE in /etc/sudoers.d/lexos-live \
             /etc/lightdm/lightdm.conf.d/60-lexos-autologin.conf \
             /etc/systemd/system/getty@tty1.service.d/lexos-autologin.conf; do
	grep -qF "$CIBLE" /usr/lib/lexos/demo-guard || {
		echo "[lexos] !! ${CIBLE} est écrit ici mais le garde-fou ne l'efface pas — il resterait sur la machine installée." >&2
		MANQUE=1
	}
done
[ "$MANQUE" -eq 0 ] || exit 1

# --- Compte « invite » : repli pour la session invité -----------------------
# allow-guest=true (ci-dessus) laisse LightDM proposer sa propre session
# invité via le paquet lightdm-guest-session — ajouté en best-effort dans
# optional-packages/20-desktop.list, car sa disponibilité dans les dépôts
# Debian n'est pas garantie. En complément (deux paliers, comme ailleurs dans
# LexOS), on crée ici un vrai compte « invite » qui existe toujours, que ce
# paquet soit installé ou non : sans mot de passe utilisable (compte
# verrouillé), et surtout sans sudo ni groupe d'administration.
# Note : un vrai nettoyage du $HOME à la déconnexion demanderait un script de
# session PAM (pam_exec) — hors périmètre ici ; ce compte n'est qu'une cible
# de connexion de repli, sûre par construction.
id invite >/dev/null 2>&1 || \
	useradd -m -s /bin/bash -c "Invité LexOS — session limitée, sans mot de passe, sans droits admin" invite
passwd -l invite >/dev/null 2>&1 || true

if [ -r /usr/share/lexos/branding/mascot.png ]; then
	mkdir -p /var/lib/AccountsService/icons
	cp /usr/share/lexos/branding/mascot.png /var/lib/AccountsService/icons/invite
fi

# --- Navigateur et applications par défaut ----------------------------------
#  ALEX, PHOTO DU FICHIER « Navigateur Web Chromium » : « garder lui officiel
#  comme navigateur ». Ce fichier disait firefox-esr, et lui seul.
#
#  ON NE DEVINE PAS LE NOM DU .desktop, ON LE CHERCHE — meme lecon que pour le
#  gestionnaire de fichiers, ou trois correctifs de suite ont vise un nom
#  suppose. Le hook 0250 installe deja chromium (optional-packages/
#  20-desktop.list), il est donc present quand on passe ici.
#
#  ET LES DEUX SONT ECRITS, DANS CET ORDRE. La valeur de « [Default
#  Applications] » est une LISTE essayee dans l'ordre, en sautant ce qui n'est
#  pas installe : si Chromium venait a manquer, firefox-esr prend le relais
#  sans qu'on ait a le detecter. Un seul nom aurait laisse LexOS sans
#  navigateur par defaut le jour ou ce paquet change.
NAVIGATEURS=""
for N in chromium.desktop chromium-browser.desktop firefox-esr.desktop; do
	for R in /usr/local/share/applications /usr/share/applications; do
		if [ -r "$R/$N" ]; then
			NAVIGATEURS="${NAVIGATEURS}${N};"
			break
		fi
	done
done
#  Aucun des deux installe (ISO minimale, construction partielle) : on ecrit
#  quand meme la paire attendue plutot qu'une ligne vide, qui laisserait XFCE
#  sans reponse du tout.
[ -n "$NAVIGATEURS" ] || NAVIGATEURS="chromium.desktop;firefox-esr.desktop;"
echo "[lexos]   navigateur par defaut : ${NAVIGATEURS}"

# --- Ce qu'on telecharge s'installe d'un double-clic -------------------------
#  ALEX : « quand on telecharge, l'application soit deja installee au lieu de
#  passer par le terminal ».
#
#  Avant ces lignes, mimeapps.list ne nommait que sept types : les pages web,
#  le texte, les dossiers, le PNG et le JPEG. Un .deb, une AppImage, un
#  .flatpakref double-clique ne trouvait AUCUNE reponse — le double-clic ne
#  faisait litteralement rien.
#
#  ET LE PIEGE QUI REND CES LIGNES MUETTES : GIO IGNORE EN SILENCE un .desktop
#  dont le programme « Exec= » n'existe pas. Il ne le signale nulle part, et
#  update-desktop-database l'inscrit quand meme dans mimeinfo.cache — on croit
#  donc l'association posee alors que « gio mime » repond « No default
#  applications ». On verifie donc que le programme est la, et on l'ecrit dans
#  le journal de construction.
OUVRIR_DESKTOP="lexos-ouvrir.desktop"
if [ -x /usr/bin/lexos-ouvrir ] && [ -r "/usr/share/applications/$OUVRIR_DESKTOP" ]; then
	echo "[lexos]   double-clic sur un fichier telecharge : $OUVRIR_DESKTOP"
else
	echo "[lexos]   !! lexos-ouvrir ou son .desktop manque — le double-clic sur un .deb ne fera rien"
fi

mkdir -p /etc/xdg
cat > /etc/xdg/mimeapps.list <<EOF
[Default Applications]
text/html=${NAVIGATEURS}
x-scheme-handler/http=${NAVIGATEURS}
x-scheme-handler/https=${NAVIGATEURS}
text/plain=org.xfce.mousepad.desktop
inode/directory=thunar.desktop
image/png=org.xfce.ristretto.desktop
image/jpeg=org.xfce.ristretto.desktop
application/vnd.debian.binary-package=${OUVRIR_DESKTOP}
application/vnd.appimage=${OUVRIR_DESKTOP}
application/x-iso9660-appimage=${OUVRIR_DESKTOP}
application/vnd.flatpak.ref=${OUVRIR_DESKTOP}
application/vnd.flatpak.repo=${OUVRIR_DESKTOP}
application/x-rpm=${OUVRIR_DESKTOP}
application/x-redhat-package-manager=${OUVRIR_DESKTOP}
application/x-shellscript=${OUVRIR_DESKTOP}
application/x-executable=${OUVRIR_DESKTOP}
EOF
#  LES DEUX TYPES D'AppImage, PAS UN SEUL. Le motif « *.appimage » pese 60
#  pour application/vnd.appimage et 50 pour application/x-iso9660-appimage :
#  sur le seul nom, c'est vnd.appimage qui gagne, mais des que le contenu est
#  reniflé — et Thunar le renifle — une AppImage de type 1 redevient
#  x-iso9660-appimage. Une regle qui n'en couvrirait qu'un laisserait la
#  moitie des AppImage sans reponse.
#
#  LE .rpm EST LA EXPRES. Ce n'est pas un format de LexOS, et justement :
#  sans cette ligne, un .rpm telecharge ne fait rien et personne ne sait
#  pourquoi. Avec elle, lexos-ouvrir explique que c'est le paquet de Fedora
#  et renvoie a la Logitheque, au lieu d'un silence.
#
#  x-shellscript ET x-executable : deux des quatre formats que lexos-ouvrir
#  annonce lui-meme au double-clic (.deb, AppImage, .sh, .flatpakref) restaient
#  sans reponse ici — un .sh telecharge s'ouvrait dans Mousepad (sous-classe
#  de text/plain), un ELF nu n'avait aucun gestionnaire du tout. Sans cette
#  ligne, poser_script et sa barriere « montre le script puis tape lancer »
#  ne sont atteignables qu'en ligne de commande. INDISPENSABLE : lexos-defaut
#  doit aussi cesser de ranger x-shellscript dans sa categorie « texte »,
#  sinon le premier reglage « Editeur de texte » des Parametres reecrit
#  ~/.config/mimeapps.list et annule cette ligne.
#
#  Et on rafraichit le cache : « [Default Applications] » suffit au
#  double-clic, mais c'est mimeinfo.cache qui fait apparaitre « Installer ce
#  fichier » dans le menu « Ouvrir avec ». Le hook 0265 le fait deja pour ce
#  dossier ; le refaire ici ne coute rien et ne depend plus de l'ordre.
if command -v update-desktop-database >/dev/null 2>&1; then
	update-desktop-database /usr/share/applications 2>/dev/null || true
fi

# --- « Note perso » — l'identité LexOS de l'éditeur de texte -----------------
#  Dans la démo, l'éditeur s'appelle « Note perso » et porte le carnet orange
#  (branding/icon-note.svg). Sur l'ISO, le carnet était bien installé comme
#  icône (lexos-note, hook 0300)… et JAMAIS UTILISÉ : le menu montrait
#  « Éditeur de texte Mousepad » avec l'icône générique. Même outil, deux
#  noms — pour qui passe de la démo au vrai bureau, c'est une application
#  qui manque.
#
#  POURQUOI /usr/local ET PAS UNE RETOUCHE DU FICHIER DU PAQUET. Les menus
#  cherchent les .desktop dans l'ordre de XDG_DATA_DIRS, où /usr/local/share
#  passe AVANT /usr/share : un fichier du même nom y prend la priorité, sans
#  toucher à ce que dpkg a posé. Une mise à jour de mousepad ne ramènera
#  donc jamais l'ancien nom — la retouche directe, elle, sauterait à la
#  première mise à jour.
if [ -r /usr/share/applications/org.xfce.mousepad.desktop ]; then
	mkdir -p /usr/local/share/applications
	sed -e 's/^Name=.*/Name=Note perso/' \
	    -e 's/^Name\[fr\].*/Name[fr]=Note perso/' \
	    -e 's/^Icon=.*/Icon=lexos-note/' \
	    -e 's/^GenericName=.*/GenericName=Notes et textes/' \
	    -e 's/^GenericName\[fr\].*/GenericName[fr]=Notes et textes/' \
	    /usr/share/applications/org.xfce.mousepad.desktop \
	    > /usr/local/share/applications/org.xfce.mousepad.desktop
	#  Sans Name[fr] dans l'original, le sed ne l'aura pas créé : on
	#  l'ajoute pour que le nom tienne aussi dans une session anglaise —
	#  « Note perso » est le nom PROPRE de l'application, pas un libellé.
	grep -q '^Name\[fr\]=' /usr/local/share/applications/org.xfce.mousepad.desktop || \
		sed -i '/^Name=/a Name[fr]=Note perso' \
			/usr/local/share/applications/org.xfce.mousepad.desktop
	echo "[lexos]   Mousepad devient « Note perso » (carnet orange)"
else
	echo "[lexos]   mousepad absent — pas de « Note perso » à habiller"
fi

# --- « Fichiers » : l'icône du gestionnaire de fichiers, pour de bon ---------
#  ALEX, TROISIÈME SIGNALEMENT : « le gestionnaire de fichiers est toujours
#  avec un engrenage au lieu du fichier. » Quatrième icône du dock, juste
#  après le terminal : un engrenage bleu-gris.
#
#  ═══ POURQUOI LES DEUX CORRECTIFS PRÉCÉDENTS N'ONT RIEN CHANGÉ ═══
#  On avait posé cinq alias dans le thème (Thunar, thunar, org.xfce.thunar,
#  file-manager, system-file-manager → folder-open), puis déclaré
#  « apps/scalable » dans index.theme. Les deux étaient de bonnes idées, et
#  aucune n'a produit d'effet — le crochet 0605 RÉÉCRIT index.theme d'après le
#  disque, donc apps/scalable y était déjà. Le second correctif était un
#  non-événement, et on l'a livré sans le savoir.
#
#  ═══ ON ARRÊTE DE DEVINER LE NOM QUE THUNAR DEMANDE ═══
#  Toutes ces tentatives partageaient un pari : que Thunar réclame l'une des
#  cinq écritures qu'on a devinées, et que GTK aille la chercher là où on
#  croit. Deux inconnues, et aucune vérifiable depuis ce dépôt.
#
#  Ici, plus de pari : on ne fournit plus une icône en espérant qu'on la
#  demande, ON ÉCRIT LA DEMANDE. Une copie du .desktop de Thunar est posée
#  dans /usr/local/share/applications — qui passe AVANT /usr/share dans
#  XDG_DATA_DIRS, exactement le procédé déjà employé pour « Note perso » juste
#  au-dessus — avec « Icon=folder-open ». Ce nom-là n'est pas un pari : c'est
#  le dossier orange que le thème porte dans « places/scalable », le SEUL
#  dossier dont les photos d'Alex prouvent qu'il est bien parcouru.
#
#  Une seule entrée de menu, pas de doublon : c'est le MÊME fichier, masqué.
#
#  ═══ ET LE NOM DU FICHIER LUI-MÊME EST CHERCHÉ, PAS SUPPOSÉ ═══
#  Trois endroits écrivaient « thunar.desktop » en dur (le dock, les favoris
#  du menu, les applications par défaut). Si Debian l'a renommé en
#  « org.xfce.thunar.desktop », ces trois-là pointent déjà dans le vide — et
#  un lanceur introuvable est précisément ce qui fait afficher un engrenage
#  générique. On le cherche donc sur le disque, et on recale les trois.
#  Les quatre chemins sont surchargeables pour que ce bloc soit ÉPROUVABLE
#  hors ISO — même procédé que le bloc « connexion » du crochet 0600, et pour
#  la même raison : sans ça, ces vingt lignes ne se vérifient qu'en
#  construisant une image et en la démarrant. Les marqueurs ci-dessous ne sont
#  pas des décorations : tests/test_lexos_fichiers_icone.sh découpe entre les
#  deux et EXÉCUTE ce fragment.
# >>> banc: fichiers
FIC_APPS="${LEXOS_APPS:-/usr/share/applications}"
FIC_LOCAL="${LEXOS_APPS_LOCAL:-/usr/local/share/applications}"
FIC_SKEL="${LEXOS_SKEL:-/etc/skel}"
FIC_MIME="${LEXOS_MIMEAPPS:-/etc/xdg/mimeapps.list}"

THUNAR_DESKTOP=""
for C in "$FIC_APPS/thunar.desktop" \
         "$FIC_APPS/org.xfce.thunar.desktop" \
         "$FIC_APPS/Thunar.desktop"; do
	if [ -r "$C" ]; then THUNAR_DESKTOP="$C"; break; fi
done
if [ -z "$THUNAR_DESKTOP" ]; then
	for C in "$FIC_APPS"/*[Tt]hunar*.desktop; do
		[ -r "$C" ] || continue
		#  Les fenêtres annexes de Thunar (réglages, gravure) ont leur propre
		#  .desktop : on ne veut que le gestionnaire lui-même.
		grep -q '^NoDisplay=true' "$C" && continue
		THUNAR_DESKTOP="$C"; break
	done
fi

if [ -n "$THUNAR_DESKTOP" ] && [ -r "$THUNAR_DESKTOP" ]; then
	THUNAR_ID="$(basename "$THUNAR_DESKTOP")"
	#  LA PREUVE QU'ON N'AVAIT PAS. Ces deux lignes disent, dans le journal de
	#  construction, le vrai nom du fichier et le vrai nom d'icône qu'il
	#  réclame. Si la 95 montre encore un engrenage, on saura enfin laquelle
	#  des hypothèses était la bonne au lieu d'en inventer une quatrième.
	echo "[lexos]   gestionnaire de fichiers : ${THUNAR_ID}"
	echo "[lexos]   il réclamait : Icon=$(sed -n 's/^Icon=//p' "$THUNAR_DESKTOP" | head -1)"

	mkdir -p "$FIC_LOCAL"
	sed 's|^Icon=.*|Icon=folder-open|' "$THUNAR_DESKTOP" > "$FIC_LOCAL/$THUNAR_ID"
	#  Un .desktop sans ligne « Icon= » : le sed n'aurait rien eu à remplacer.
	#  On l'insère alors DANS le premier groupe — l'ajouter à la fin la
	#  poserait dans la dernière action, où elle ne servirait à rien.
	if ! grep -q '^Icon=folder-open$' "$FIC_LOCAL/$THUNAR_ID"; then
		sed -i '0,/^\[Desktop Entry\]/s//&\nIcon=folder-open/' "$FIC_LOCAL/$THUNAR_ID"
	fi
	echo "[lexos]   Fichiers porte maintenant le dossier orange (Icon=folder-open)"

	#  ─── LE DOCK ───
	#  Plank ne lit pas XDG_DATA_DIRS : son .dockitem porte un CHEMIN. Il
	#  faut donc le faire pointer sur la copie, sinon le dock resterait le
	#  seul endroit du bureau à montrer l'ancienne icône.
	DOCKITEM="$FIC_SKEL/.config/plank/dock1/launchers/02-files.dockitem"
	if [ -f "$DOCKITEM" ]; then
		{
			echo "[PlankDockItemPreferences]"
			echo "Launcher=file://$FIC_LOCAL/$THUNAR_ID"
		} > "$DOCKITEM"
		echo "[lexos]   dock : 02-files pointe sur ${THUNAR_ID}"
	fi

	#  ─── LES FAVORIS DU MENU ET LES APPLICATIONS PAR DÉFAUT ───
	#  Ceux-là désignent le fichier par son IDENTIFIANT, que XDG_DATA_DIRS
	#  résout vers notre copie : il n'y a qu'à corriger le nom s'il a changé.
	if [ "$THUNAR_ID" != "thunar.desktop" ]; then
		PANNEAU="$FIC_SKEL/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
		[ -f "$PANNEAU" ] && sed -i "s|thunar\.desktop|${THUNAR_ID}|g" "$PANNEAU"
		[ -f "$FIC_MIME" ] && \
			sed -i "s|^inode/directory=.*|inode/directory=${THUNAR_ID}|" "$FIC_MIME"
		echo "[lexos]   « thunar.desktop » n'existe plus : trois références recalées sur ${THUNAR_ID}"
	fi
else
	#  Ce n'est pas anodin : sans lui, le dock a un lanceur mort, les dossiers
	#  ne s'ouvrent sur rien, et l'engrenage générique reste.
	echo "[lexos]   !! AUCUN .desktop de gestionnaire de fichiers trouvé — le dock gardera un engrenage"
fi
# <<< banc: fichiers

# --- Entrées de menu LexOS ---------------------------------------------------
mkdir -p /usr/share/applications

cat > /usr/share/applications/lexos-about.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=À propos de ${LEXOS_NAME}
Name[en]=About ${LEXOS_NAME}
Comment=Informations sur le système
Exec=lexos-welcome --about
Icon=lexos
Terminal=false
Categories=System;
Keywords=lexos;about;systeme;
EOF

cat > /usr/share/applications/lexos-share.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Partager un fichier

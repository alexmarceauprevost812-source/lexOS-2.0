#!/bin/sh
# =============================================================================
#  LexOS — configuration du bureau (LightDM, XFCE, PolicyKit)
#  Ne fait rien si la saveur est « minimal » (pas de serveur X).
# =============================================================================
set -e

if [ ! -x /usr/sbin/lightdm ] && [ ! -x /usr/bin/startxfce4 ]; then
	echo "[lexos] hook 0400 : pas de bureau installé, ignoré"
	exit 0
fi

echo "[lexos] hook 0400 : bureau"

LEXOS_NAME="LexOS"
LEXOS_GTK_BASE_THEME="Arc-Dark"
LEXOS_ICON_THEME="Papirus-Dark"
LEXOS_LIVE_USER="lex"

if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
fi

# --- LightDM : écran de connexion -------------------------------------------
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-lexos.conf <<EOF
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
greeter-hide-users=false
allow-guest=true
EOF

cat > /etc/lightdm/lightdm-gtk-greeter.conf <<EOF
[greeter]
background=/usr/share/backgrounds/lexos/wallpaper.png
theme-name=${LEXOS_GTK_BASE_THEME}
icon-theme-name=${LEXOS_ICON_THEME}
font-name=Noto Sans 11
xft-antialias=true
xft-hintstyle=hintslight
xft-rgba=rgb
indicators=~host;~spacer;~clock;~spacer;~layout;~session;~a11y;~power
clock-format=%A %d %B — %H:%M
position=50%,center 55%,center
default-user-image=/usr/share/lexos/branding/mascot.png
user-background=false
hide-user-image=false
round-user-image=true
EOF

# --- Compte de session live : créé DÈS LA CONSTRUCTION -----------------------
#  Correctif (construction 12) : on comptait sur live-config pour créer le
#  compte « ${LEXOS_LIVE_USER} » à l'amorçage à partir du paramètre noyau
#  « username=… ». Sur Debian trixie ce paramètre nu n'était pas honoré de
#  façon fiable : le compte n'existait pas, l'autologin du tty (login -f)
#  échouait en boucle (« Authentication failure ») et LightDM ne proposait
#  que la session invité — impossible d'atteindre le bureau ni Calamares.
#  On crée donc le compte ICI, dans le chroot, pour qu'il existe TOUJOURS :
#  autologin du tty, écran de connexion LightDM et connexion en console
#  fonctionnent alors tous les trois.
if ! id "${LEXOS_LIVE_USER}" >/dev/null 2>&1; then
	useradd -m -s /bin/bash -c "${LEXOS_NAME} Live" "${LEXOS_LIVE_USER}"
fi
#  Groupes utiles au bureau (ignore ceux qui n'existent pas encore).
for g in sudo audio video plugdev netdev cdrom dip users bluetooth lpadmin scanner; do
	getent group "$g" >/dev/null 2>&1 && adduser "${LEXOS_LIVE_USER}" "$g" >/dev/null 2>&1 || true
done
#  Mot de passe de secours = le nom du compte (ex. « lex » / « lex ») : sert
#  à la connexion manuelle si l'autologin est un jour désactivé. Le compte
#  n'est PAS verrouillé, sinon « login -f » échouerait comme avant.
echo "${LEXOS_LIVE_USER}:${LEXOS_LIVE_USER}" | chpasswd
passwd -u "${LEXOS_LIVE_USER}" >/dev/null 2>&1 || true

# --- Session live : autologin ------------------------------------------------
# live-config gère déjà l'autologin ; on renforce pour LightDM.
cat > /etc/lightdm/lightdm.conf.d/60-lexos-autologin.conf <<EOF
[Seat:*]
autologin-user=${LEXOS_LIVE_USER}
autologin-user-timeout=0
autologin-session=xfce
EOF

# --- Autologin aussi en console (tty1) : le compte existe désormais ----------
#  Renfort du même correctif : on pose l'autologin getty nous-mêmes, sans
#  dépendre de live-config, pour que la première console ouvre une session
#  « ${LEXOS_LIVE_USER} » même si live-config ne l'a pas configuré.
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/lexos-autologin.conf <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin ${LEXOS_LIVE_USER} --noclear %I \$TERM
EOF

# (le thème GTK est produit par le hook 0600 — LexOS Noir)

# --- Le live user peut utiliser sudo sans mot de passe ----------------------
#  Voulu en session démo : rien à protéger sur une clé USB, et l'installateur
#  en a besoin. Mais Calamares recopie le système tel quel sur le disque, ce
#  fichier compris : sur la machine installée, quelqu'un qui nomme son compte
#  « lex » hériterait en silence d'un sudo sans mot de passe.
#  D'où le garde-fou ci-dessous, qui efface le fichier à tout démarrage qui
#  n'est pas une session live.
cat > /etc/sudoers.d/lexos-live <<EOF
${LEXOS_LIVE_USER} ALL=(ALL) NOPASSWD: ALL
EOF
chmod 0440 /etc/sudoers.d/lexos-live

#  Le garde-fou efface, sur un système INSTALLÉ, les commodités qui n'ont de
#  sens que sur la clé USB : sudo sans mot de passe, ET l'ouverture de session
#  automatique sur le compte « lex ». Cette dernière était oubliée — elle
#  ouvrait le compte de la démo sur la machine installée, si bien qu'on
#  n'atteignait jamais l'écran où choisir SON compte, et qu'on croyait
#  l'installateur fautif de ne pas l'avoir créé.
chmod 0755 /usr/lib/lexos/demo-guard 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
	systemctl enable lexos-demo-guard.service >/dev/null 2>&1 \
		&& echo "[lexos]   garde-fou démo activé (sudo + ouverture automatique)" \
		|| echo "[lexos]   !! garde-fou démo non activé"
fi

#  Contrôle de construction : le garde-fou doit connaître les trois fichiers
#  qu'il est chargé d'effacer. Si l'un des chemins change ailleurs sans être
#  reporté ici, on le dit maintenant plutôt que de le découvrir sur une
#  machine installée qui ouvre la session de démo.
for CIBLE in /etc/sudoers.d/lexos-live \
             /etc/lightdm/lightdm.conf.d/60-lexos-autologin.conf \
             /etc/systemd/system/getty@tty1.service.d/lexos-autologin.conf; do
	grep -qF "$CIBLE" /usr/lib/lexos/demo-guard \
		|| echo "[lexos]   !! ${CIBLE} n'est pas dans le garde-fou démo"
done

# --- Compte « invite » : repli pour la session invité -----------------------
# allow-guest=true (ci-dessus) laisse LightDM proposer sa propre session
# invité via le paquet lightdm-guest-session — ajouté en best-effort dans
# optional-packages/20-desktop.list, car sa disponibilité dans les dépôts
# Debian n'est pas garantie. En complément (deux paliers, comme ailleurs dans
# LexOS), on crée ici un vrai compte « invite » qui existe toujours, que ce
# paquet soit installé ou non : sans mot de passe utilisable (compte
# verrouillé), et surtout sans sudo ni groupe d'administration.
# Note : un vrai nettoyage du $HOME à la déconnexion demanderait un script de
# session PAM (pam_exec) — hors périmètre ici ; ce compte n'est qu'une cible
# de connexion de repli, sûre par construction.
id invite >/dev/null 2>&1 || \
	useradd -m -s /bin/bash -c "Invité LexOS — session limitée, sans mot de passe, sans droits admin" invite
passwd -l invite >/dev/null 2>&1 || true

if [ -r /usr/share/lexos/branding/mascot.png ]; then
	mkdir -p /var/lib/AccountsService/icons
	cp /usr/share/lexos/branding/mascot.png /var/lib/AccountsService/icons/invite
fi

# --- Navigateur et applications par défaut ----------------------------------
mkdir -p /etc/xdg
cat > /etc/xdg/mimeapps.list <<'EOF'
[Default Applications]
text/html=firefox-esr.desktop
x-scheme-handler/http=firefox-esr.desktop
x-scheme-handler/https=firefox-esr.desktop
text/plain=org.xfce.mousepad.desktop
inode/directory=thunar.desktop
image/png=org.xfce.ristretto.desktop
image/jpeg=org.xfce.ristretto.desktop
EOF

# --- « Note perso » — l'identité LexOS de l'éditeur de texte -----------------
#  Dans la démo, l'éditeur s'appelle « Note perso » et porte le carnet orange
#  (branding/icon-note.svg). Sur l'ISO, le carnet était bien installé comme
#  icône (lexos-note, hook 0300)… et JAMAIS UTILISÉ : le menu montrait
#  « Éditeur de texte Mousepad » avec l'icône générique. Même outil, deux
#  noms — pour qui passe de la démo au vrai bureau, c'est une application
#  qui manque.
#
#  POURQUOI /usr/local ET PAS UNE RETOUCHE DU FICHIER DU PAQUET. Les menus
#  cherchent les .desktop dans l'ordre de XDG_DATA_DIRS, où /usr/local/share
#  passe AVANT /usr/share : un fichier du même nom y prend la priorité, sans
#  toucher à ce que dpkg a posé. Une mise à jour de mousepad ne ramènera
#  donc jamais l'ancien nom — la retouche directe, elle, sauterait à la
#  première mise à jour.
if [ -r /usr/share/applications/org.xfce.mousepad.desktop ]; then
	mkdir -p /usr/local/share/applications
	sed -e 's/^Name=.*/Name=Note perso/' \
	    -e 's/^Name\[fr\].*/Name[fr]=Note perso/' \
	    -e 's/^Icon=.*/Icon=lexos-note/' \
	    -e 's/^GenericName=.*/GenericName=Notes et textes/' \
	    -e 's/^GenericName\[fr\].*/GenericName[fr]=Notes et textes/' \
	    /usr/share/applications/org.xfce.mousepad.desktop \
	    > /usr/local/share/applications/org.xfce.mousepad.desktop
	#  Sans Name[fr] dans l'original, le sed ne l'aura pas créé : on
	#  l'ajoute pour que le nom tienne aussi dans une session anglaise —
	#  « Note perso » est le nom PROPRE de l'application, pas un libellé.
	grep -q '^Name\[fr\]=' /usr/local/share/applications/org.xfce.mousepad.desktop || \
		sed -i '/^Name=/a Name[fr]=Note perso' \
			/usr/local/share/applications/org.xfce.mousepad.desktop
	echo "[lexos]   Mousepad devient « Note perso » (carnet orange)"
else
	echo "[lexos]   mousepad absent — pas de « Note perso » à habiller"
fi

# --- Entrées de menu LexOS ---------------------------------------------------
mkdir -p /usr/share/applications

cat > /usr/share/applications/lexos-about.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=À propos de ${LEXOS_NAME}
Name[en]=About ${LEXOS_NAME}
Comment=Informations sur le système
Exec=lexos-welcome --about
Icon=lexos
Terminal=false
Categories=System;
Keywords=lexos;about;systeme;
EOF

cat > /usr/share/applications/lexos-share.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Partager un fichier
Name[en]=Share a file
Comment=Envoyer des photos et des fichiers vers un téléphone (QR code, KDE Connect, Bluetooth)
Exec=xfce4-terminal --title="Partage LexOS" --command="lexos-share qr %F"
Icon=lexos-share
Terminal=false
Categories=Utility;FileTransfer;
Keywords=partage;share;qr;telephone;photo;image;
MimeType=image/png;image/jpeg;image/gif;image/webp;application/pdf;
EOF

cat > /usr/share/applications/lexos-ecran-telephone.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Écran du téléphone
Name[en]=Phone screen
Comment=Afficher et contrôler l'écran d'un téléphone Android sur l'ordinateur (scrcpy)
Exec=xfce4-terminal --title="Écran du téléphone — LexOS" --hold -e "lexos ecran-telephone"
Icon=lexos-share
Terminal=false
Categories=Utility;FileTransfer;
Keywords=telephone;phone;ecran;screen;mirroring;scrcpy;android;
EOF

# --- Cartes LexOS ------------------------------------------------------------
#  Une vraie fenêtre graphique, pas un terminal : Terminal=false et pas de
#  xfce4-terminal dans Exec, contrairement aux outils en ligne de commande
#  ci-dessus.
cat > /usr/share/applications/lexos-cartes.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Cartes LexOS
Name[en]=LexOS Maps
Comment=Carte du monde : position, fuseau horaire, météo, thème jour/nuit
Comment[en]=World map: position, time zone, weather, day/night theme
Exec=lexos-cartes
Icon=/usr/share/lexos/cartes/icone.png
Terminal=false
StartupNotify=true
StartupWMClass=Cartes LexOS
Categories=Utility;Education;Geography;
Keywords=carte;cartes;map;maps;gps;position;météo;meteo;fuseau;monde;osm;
EOF

# --- GPS d'Alex (Map IA) -----------------------------------------------------
#  La carte de navigation écrite par Alex : itinéraires, adresses, points
#  d'intérêt. Fenêtre graphique comme « Cartes LexOS », dont elle réutilise
#  le programme (mêmes besoins : serveur local pour la géolocalisation).
cat > /usr/share/applications/lexos-gps.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=GPS d'Alex
Name[en]=Alex's GPS
Comment=Navigation : itinéraires, adresses, points d'intérêt, vue satellite
Comment[en]=Navigation: routes, addresses, points of interest, satellite view
Exec=lexos-gps
Icon=/usr/share/lexos/gps/icone.png
Terminal=false
StartupNotify=true
StartupWMClass=GPS d'Alex
Categories=Utility;Education;Geography;
Keywords=gps;navigation;itineraire;itinéraire;route;carte;map;adresse;satellite;trajet;
EOF

cat > /usr/share/applications/lexos-studio.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Studio+ LexOS
Name[en]=Studio+ LexOS
Comment=Atelier image, vidéo et son — retouche, montage, autocollants
Exec=xfce4-terminal --title="Studio+ LexOS" --hold -e "lexos studio"
Icon=lexos-studio
Terminal=false
Categories=Graphics;AudioVideo;
Keywords=studio;image;photo;video;montage;retouche;autocollant;gimp;kdenlive;
Actions=Photo;Video;Autocollant;

[Desktop Action Photo]
Name=Retouche photo (GIMP)
Exec=xfce4-terminal --title="Studio+ — photo" --hold -e "lexos studio ouvrir photo"

[Desktop Action Video]
Name=Montage vidéo (Kdenlive)
Exec=xfce4-terminal --title="Studio+ — vidéo" --hold -e "lexos studio ouvrir video"

[Desktop Action Autocollant]
Name=Découper un autocollant
Exec=xfce4-terminal --title="Studio+ — autocollant" --hold -e "lexos studio liste"
EOF

cat > /usr/share/applications/lexos-vide-memoire.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Vide mémoire +
Name[en]=Empty memory +
Comment=Extraire TOUS les fichiers et photos d'un téléphone ou d'une clé USB en une fois
Exec=xfce4-terminal --title="Vide mémoire + — LexOS" --hold -e "lexos vide-memoire"
Icon=lexos-usb
Terminal=false
Categories=Utility;FileTransfer;
Keywords=vide;memoire;extraire;copier;import;telephone;usb;photos;sauvegarde;
EOF

cat > /usr/share/applications/lexos-terminal-appareil.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Terminal de l'appareil
Name[en]=Device shell
Comment=Ouvrir un terminal SUR le téléphone Android (adb shell, débogage USB requis)
Exec=xfce4-terminal --title="Terminal de l'appareil — LexOS" --hold -e "lexos terminal-appareil"
Icon=lexos-terminal
Terminal=false
Categories=Utility;TerminalEmulator;
Keywords=terminal;shell;adb;telephone;android;appareil;console;
EOF

#  N'apparaît que sur un Mac : ailleurs, un lanceur « Mac (Apple) » serait
#  du bruit. OnlyShowIn ne sait pas filtrer par matériel, alors le lanceur
#  vérifie lui-même et s'explique s'il n'a rien à faire.
cat > /usr/share/applications/lexos-mac.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Mac (Apple)
Name[en]=Mac (Apple)
Comment=Ce Mac : Wi-Fi Broadcom, ventilateurs, touches F1-F12
Exec=xfce4-terminal --title="Mac (Apple) — LexOS" --hold -e "lexos mac"
Icon=lexos-mac
Terminal=false
Categories=System;HardwareSettings;
Keywords=mac;apple;macbook;imac;broadcom;wifi;ventilateur;fnmode;clavier;t2;
EOF

cat > /usr/share/applications/lexos-format.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Formater une clé USB ou un téléphone
Name[en]=Format a USB key or phone
Comment=Effacer et reformater un support amovible — jamais le disque système, confirmation exigée
Exec=xfce4-terminal --title="Formater — LexOS" --hold -e "lexos format"
Icon=lexos-usb
Terminal=false
Categories=System;Filesystem;
Keywords=formater;format;effacer;cle;usb;telephone;disque;
EOF

cat > /usr/share/applications/lexos-capture.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Capture d'écran
Name[en]=Screenshot
Comment=Photographier l'écran, une fenêtre ou une zone (Impr écr)
Exec=lexos capture
Icon=lexos-camera
Terminal=false
Categories=Graphics;Utility;

cat > /usr/share/applications/lexos-github.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=GitHub
Comment=Ouvrir GitHub dans le navigateur
Exec=xdg-open https://github.com
Icon=lexos-github

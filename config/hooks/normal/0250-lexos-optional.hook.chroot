#!/bin/sh
# =============================================================================
#  LexOS — installation « best effort » des paquets non essentiels
# =============================================================================
#  live-build interrompt la construction dès qu'un paquet d'une liste
#  n'existe pas. C'est le bon comportement pour le noyau ou le serveur X.
#  Ça l'est beaucoup moins pour un thème d'icônes ou un lecteur vidéo :
#  un nom qui change entre deux versions de Debian ne devrait pas coûter
#  une heure de construction.
#
#  Ce hook installe donc les paquets de confort un par un, tolère les
#  absences, et laisse un rapport dans /etc/lexos/optional-report.
# =============================================================================
set -e

echo "[lexos] hook 0250 : paquets optionnels"

#  DIR/REPORT/CONF SONT SURCHARGEABLES — pas pour qu'on les change en
#  production, mais pour que ce hook soit ÉPROUVABLE sur un banc (même
#  raison que LEXOS_THEMES dans le hook 0610) : sans ça, le tester en vrai
#  exige un vrai apt, un vrai /usr/share/lexos et le droit d'écrire dans
#  /etc/lexos. Les valeurs par défaut sont les vraies.
DIR="${LEXOS_OPTIONAL_DIR:-/usr/share/lexos/optional-packages}"
REPORT="${LEXOS_OPTIONAL_REPORT:-/etc/lexos/optional-report}"
FLAVOUR="standard"

CONF="${LEXOS_BUILD_CONF:-/etc/lexos/build.conf}"
if [ -r "$CONF" ]; then
	# shellcheck disable=SC1090,SC1091
	. "$CONF"
	FLAVOUR="${LEXOS_FLAVOUR:-standard}"
fi

if [ ! -d "$DIR" ]; then
	echo "[lexos]   aucun dossier de paquets optionnels — rien à faire"
	exit 0
fi

# --- Quelles listes s'appliquent à cette saveur ? ---------------------------
#  UNE SEULE RÉPONSE POUR TOUTES LES SAVEURS DE BUREAU.
#
#  Avant, chaque saveur avait sa propre ligne, et les lignes ne disaient pas
#  la même chose. Conséquences réelles, invisibles à la construction :
#
#    · la saveur « pro » — celle de l'Alienware, la plus complète en
#      principe — n'a JAMAIS reçu 60-full.list. Pas de LibreOffice, pas de
#      Thunderbird, pas d'evince, pas de GParted, pas de Timeshift.
#    · la saveur « dev » — celle du portable, celle sur laquelle Alex teste
#      tout — n'a reçu ni 70-gaming ni 75-pro-gamer ni 60-full.
#
#  Autrement dit : Alex essayait le bureau sur le portable, puis retrouvait
#  un bureau DIFFÉRENT sur l'Alienware, sans que rien ne le prévienne. Un
#  test qui ne teste pas la même chose que ce qu'on livre ne sert à rien.
#
#  Désormais toutes les saveurs de bureau installent exactement les mêmes
#  applications. La seule différence qui subsiste entre les ISO est
#  MATÉRIELLE : le pilote NVIDIA propriétaire (hook 0260, saveur « pro »
#  seulement — le portable n'a pas de carte NVIDIA, le lui poser risquerait
#  l'écran noir qu'on passe justement notre temps à chasser).
#
#  « minimal » reste à part : c'est une ISO sans bureau, par définition.
LISTS="00-core.list 10-installer.list"
BUREAU_COMPLET="15-essentiel.list 20-desktop.list 30-dock-effets.list \
40-partage.list 41-reseau-plus.list 45-capture.list 46-studio.list 47-apple.list 48-comptes.list \
49-bienetre.list 50-dev.list 51-dev-outils.list 52-ia-locale.list 54-sauvegarde.list 55-cartes.list 56-reglages.list 57-python.list \
58-prive.list 59-diagnostic.list \
60-full.list 70-gaming.list 75-pro-gamer.list 80-securite.list \
90-decoupe-image.list 95-logitheque.list"

case "$FLAVOUR" in
	minimal)
		;;
	*)
		LISTS="$LISTS $BUREAU_COMPLET"
		# Steam et Wine ont besoin des paquets 32 bits (i386) — non bloquant
		# si indisponible.
		dpkg --add-architecture i386 2>/dev/null || true
		;;
esac

# --- Collecte des noms -------------------------------------------------------
#  UNE LISTE ABSENTE N'EST PAS UN PAQUET ABSENT. Tolérer un paquet manquant
#  est sain — les dépôts bougent. Tolérer une LISTE manquante ne l'est pas :
#  c'est une catégorie entière de fonctions qui disparaît de l'ISO sans un
#  bruit. C'est arrivé dans l'ancien dépôt : deux listes réclamées mais
#  jamais écrites, 89 paquets envolés, des sections de Paramètres vides à
#  l'écran, et pour seule trace une ligne de journal noyée dans une heure de
#  construction. On le dit donc FORT, en tête du rapport, et
#  LEXOS_STRICT_LISTS=1 en fait une erreur qui arrête la construction.
WANTED="$(mktemp)"
LISTES_ABSENTES=""
for L in $LISTS; do
	[ -r "$DIR/$L" ] || { LISTES_ABSENTES="${LISTES_ABSENTES} $L"; continue; }
	grep -Ev '^[[:space:]]*(#|$)' "$DIR/$L" >> "$WANTED" || true
done
sort -u "$WANTED" -o "$WANTED"

if [ -n "$LISTES_ABSENTES" ]; then
	echo "[lexos]   !! ============================================================"
	echo "[lexos]   !! LISTES ABSENTES :${LISTES_ABSENTES}"
	echo "[lexos]   !! Chacune est une catégorie entière d'outils qui ne sera"
	echo "[lexos]   !! PAS dans l'ISO. Vérifier optional-packages/ ou retirer"
	echo "[lexos]   !! ces noms du hook 0250."
	echo "[lexos]   !! ============================================================"
	if [ "${LEXOS_STRICT_LISTS:-0}" = "1" ]; then
		echo "[lexos]   LEXOS_STRICT_LISTS=1 — on s'arrête ici."
		exit 1
	fi
fi

TOTAL="$(wc -l < "$WANTED")"
echo "[lexos]   saveur ${FLAVOUR} : ${TOTAL} paquets optionnels envisagés"

#  Preuve dans le journal : ce nombre doit être IDENTIQUE d'une saveur de
#  bureau à l'autre. S'il diffère entre l'ISO du portable et celle de
#  l'Alienware, c'est que les deux bureaux ne sont plus les mêmes.
if [ "$FLAVOUR" != "minimal" ]; then
	echo "[lexos]   bureau identique sur toutes les saveurs : ${TOTAL} paquets optionnels, $(set -- $LISTS; echo $#) listes"
fi

# --- LA FENÊTRE DU MICROLOGICIEL WI-FI, ÉCRITE NOIR SUR BLANC ---------------
#  iwlwifi (Wi-Fi 7 Intel, dont le BE200 de l'Alienware ACT1250) n'accepte
#  qu'un intervalle de versions d'API, et l'archive Debian livre ce qu'elle
#  veut. Tant que les deux se croisent, le Wi-Fi marche ; le jour où ils ne se
#  croisent plus, il disparaît sans un mot — le noyau écrira bien la raison
#  dans son propre journal, mais rien ici ne la répète. On imprime les deux
#  ensembles à CHAQUE construction : ça ne coûte rien, et ça transforme une
#  panne muette en une ligne de journal qu'on peut relire après coup.
#
#  UNE FONCTION, APPELÉE DES DEUX CÔTÉS DE L'EMBRANCHEMENT QUI SUIT. La passe
#  groupée réussie fait un « exit 0 » à elle — sans ça, ce rapport ne se
#  serait vu QUE dans le chemin de reprise, c'est-à-dire quasiment jamais :
#  la passe groupée est le cas normal, celui qui réussit le plus souvent.
#
#  VOLONTAIREMENT NON BLOQUANT. On ne sait pas encore, dans ce hook, si
#  --firmware-chroot a déjà déposé ses fichiers à ce stade de la construction
#  ou seulement après : tant que ce n'est pas confirmé sur une vraie ISO, une
#  sortie « aucun fichier » pourrait être un faux négatif sur une image saine.
#
#  LE REPLI SE MESURE SUR UNE VARIABLE, PAS SUR LE CODE DE SORTIE DU PIPELINE.
#  « ls … | sed … || echo repli » se serait rattaché au code de sortie de
#  sed, qui réussit même sur une entrée vide (zéro ligne lue, zéro ligne
#  transformée, sortie 0) : le repli ne se serait donc JAMAIS déclenché,
#  fichiers présents ou pas — un contrôle qui ne peut pas échouer ne contrôle
#  rien, la même famille de panne que le filtre de shebang du build 66.
rapporter_iwlwifi() {
	FW_DIR="${LEXOS_FIRMWARE_DIR:-/usr/lib/firmware}"
	if [ -d "$FW_DIR" ]; then
		FICHIERS_IWL="$(ls "$FW_DIR"/iwlwifi-gl-*.ucode 2>/dev/null || true)"
		if [ -n "$FICHIERS_IWL" ]; then
			echo "[lexos]   micrologiciels iwlwifi présents dans l'image :"
			printf '%s\n' "$FICHIERS_IWL" | sed 's|.*/|[lexos]     |'
		else
			echo "[lexos]   !! AUCUN fichier iwlwifi-gl-* — pas de Wi-Fi 7 Intel"
		fi
	fi
	if command -v modinfo >/dev/null 2>&1; then
		VERSIONS_IWL="$(modinfo iwlwifi 2>/dev/null | grep -o 'iwlwifi-gl-[a-z0-9-]*\.ucode' | sort -u || true)"
		if [ -n "$VERSIONS_IWL" ]; then
			echo "[lexos]   versions réclamées par le pilote iwlwifi du noyau :"
			printf '%s\n' "$VERSIONS_IWL" | sed 's|^|[lexos]     |'
		else
			echo "[lexos]   (modinfo muet — noyau pas encore en place ici)"
		fi
	fi
}

# --- LE SON : PAS SEULEMENT UN PAQUET QUI MANQUE, UN INTRUS QUI ENTRE ------
#  pipewire-audio est désormais dans la liste STRICTE (flavours/pro/pro.list.chroot),
#  installée par live-build AVANT que ce hook ne tourne — s'il manquait, la
#  construction se serait déjà arrêtée. Pas la peine de le remettre dans
#  MATERIEL_VITAL, qui ne surveille QUE le monde « au mieux » de CE hook.
#  Le risque qui reste n'est plus une absence, c'est une INTRUSION, et elle
#  se joue elle aussi PENDANT l'installation stricte, pas ici : blueman
#  (strict lui aussi) recommande « pulseaudio-module-bluetooth |
#  libspa-0.2-bluetooth » — une ALTERNATIVE, et APT satisfait la première
#  qui se résout. Sans pipewire-audio, rien n'empêchait la première (le vrai
#  démon PulseAudio) d'entrer à côté de PipeWire : deux serveurs de son sur
#  la même carte, et le greffon dont PipeWire a réellement besoin, absent —
#  un casque Bluetooth qui s'appaire et reste muet, sans la moindre erreur.
#  pipewire-audio porte d'ailleurs « Conflicts: pulseaudio,
#  pulseaudio-module-bluetooth » (vérifié dans le paquet lui-même) : une fois
#  strict, il empêche structurellement la première alternative de blueman de
#  se résoudre. Ce contrôle est donc la confirmation qu'on attend, pas une
#  dernière ligne de défense — mais mieux vaut le lire dans le journal qu'à
#  l'usage, sur la machine d'Alex.
#
#  APPELÉE DES DEUX CÔTÉS DE LA PASSE GROUPÉE, PAS SEULEMENT DE LA REPRISE.
#  Contrairement à MATERIEL_VITAL (qui ne veut dire quelque chose que si LA
#  PASSE OPTIONNELLE a échoué), l'état de pulseaudio/libspa-0.2-bluetooth ne
#  dépend PAS de cette passe : il vient de l'installation STRICTE, déjà
#  terminée avant que ce hook ne démarre. Le vérifier seulement quand la
#  passe optionnelle échoue laisserait le cas normal — la passe groupée qui
#  réussit — sans aucune vérification, exactement le trou que ce hook
#  dénonce ailleurs pour le matériel vital.
verifier_son() {
	if dpkg-query -W -f='${Status}' pulseaudio 2>/dev/null | grep -q '^install ok installed'; then
		echo "[lexos]   !! ============================================================"
		echo "[lexos]   !! PULSEAUDIO EST INSTALLÉ alors que LexOS tourne sur PipeWire."
		echo "[lexos]   !! Regarde qui l'a tiré :  apt-cache rdepends --installed pulseaudio"
		echo "[lexos]   !! ============================================================"
	else
		echo "[lexos]   son : PipeWire seul, pas de PulseAudio"
	fi

	if dpkg-query -W -f='${Status}' libspa-0.2-bluetooth 2>/dev/null | grep -q '^install ok installed'; then
		echo "[lexos]   son Bluetooth : greffon libspa-0.2-bluetooth présent"
	else
		echo "[lexos]   !! GREFFON BLUETOOTH ABSENT — un casque Bluetooth restera MUET"
	fi
}

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq || echo "[lexos]   !! apt-get update a échoué, on continue"

# --- Première passe : tout d'un coup, c'est bien plus rapide ---------------
# shellcheck disable=SC2046
if apt-get install -y --no-install-recommends $(tr '\n' ' ' < "$WANTED") >/dev/null 2>&1; then
	echo "[lexos]   tous les paquets optionnels installés d'un bloc"
	mkdir -p "$(dirname "$REPORT")"
	{
		echo "# Paquets optionnels — saveur ${FLAVOUR}"
		[ -n "$LISTES_ABSENTES" ] && echo "# !! LISTES ABSENTES :${LISTES_ABSENTES}"
		echo "# Tous installés."
		cat "$WANTED"
	} > "$REPORT"
	rm -f "$WANTED"
	verifier_son
	rapporter_iwlwifi
	echo "[lexos] hook 0250 : ok"
	exit 0
fi

echo "[lexos]   au moins un paquet pose problème — reprise un par un"

# --- Seconde passe : un par un, on note ce qui manque -----------------------
OK_COUNT=0
KO_LIST=""

#  NOMS DE RECHANGE. Un paquet peut changer de nom d'une version de Debian
#  à l'autre, ou disparaître au profit d'un autre : « ppsspp-qt » devient
#  « ppsspp », un cœur libretro est renommé… Une ligne peut donc proposer
#  plusieurs noms séparés par « | », essayés dans l'ordre ; le premier qui
#  s'installe gagne. Sans ça, un simple changement de nom faisait perdre la
#  fonction entière — c'est ce qui est arrivé à six paquets d'un coup, dont
#  protontricks, qui sert justement à débloquer les jeux Windows.
while IFS= read -r LIGNE; do
	[ -n "$LIGNE" ] || continue
	POSE=""
	OLDIFS="$IFS"; IFS='|'
	for PKG in $LIGNE; do
		IFS="$OLDIFS"
		[ -n "$PKG" ] || continue
		if apt-get install -y --no-install-recommends "$PKG" >/dev/null 2>&1; then
			POSE="$PKG"; break
		fi
		IFS='|'
	done
	IFS="$OLDIFS"
	if [ -n "$POSE" ]; then
		OK_COUNT=$((OK_COUNT + 1))
		#  Dire lequel a été retenu quand ce n'est pas le premier proposé :
		#  sinon on croit avoir installé « ppsspp-qt » alors que c'est
		#  « ppsspp » qui est là, et on cherche le mauvais nom au dépannage.
		case "$LIGNE" in
			"$POSE") ;;
			*) echo "[lexos]   ${LIGNE} -> ${POSE}" ;;
		esac
	else
		KO_LIST="${KO_LIST}${LIGNE}
"
		echo "[lexos]   !! indisponible : ${LIGNE}"
	fi
done < "$WANTED"

KO_COUNT="$(printf '%s' "$KO_LIST" | grep -c . || true)"

mkdir -p "$(dirname "$REPORT")"
{
	echo "# Paquets optionnels — saveur ${FLAVOUR}"
	[ -n "$LISTES_ABSENTES" ] && echo "# !! LISTES ABSENTES :${LISTES_ABSENTES}"
	echo "# Installés : ${OK_COUNT}    Indisponibles : ${KO_COUNT}"
	echo
	if [ -n "$KO_LIST" ]; then
		echo "# Non installés (nom absent de l'archive, ou conflit) :"
		printf '%s' "$KO_LIST"
	fi
} > "$REPORT"

echo "[lexos]   ${OK_COUNT} installés, ${KO_COUNT} indisponibles (détail : ${REPORT})"

# --- LE MATÉRIEL N'EST PAS UN CONFORT ---------------------------------------
#  Ces paquets-ci sont dans une liste « au mieux » comme les autres, mais leur
#  absence ne coûte pas une commodité : elle coûte le Wi-Fi, le son, ou la
#  stabilité du processeur. Sur l'Alienware d'Alex, firmware-iwlwifi EST le
#  Wi-Fi 7 BE200, et le câble Ethernet n'est pas branché — sans lui, la
#  machine démarre sans aucun réseau, et la seule trace serait une ligne
#  « indisponible » noyée dans une heure de journal.
#
#  On ne les rend pas obligatoires (config/package-lists/) : un nom de paquet
#  de micrologiciel change entre deux versions de Debian, et ça coûterait une
#  construction entière à chaque fois. On les rend BRUYANTS, et on laisse le
#  choix d'en faire une erreur dure avec LEXOS_STRICT_FIRMWARE=1.
#
#  Ce bloc ne tourne QUE dans la reprise un par un : si la passe groupée plus
#  haut a réussi (ligne ~120), TOUS les paquets de $WANTED — matériel vital
#  compris — sont garantis installés, et il n'y a rien à vérifier ici.
MATERIEL_VITAL="firmware-iwlwifi firmware-realtek firmware-misc-nonfree \
firmware-sof-signed intel-microcode amd64-microcode"

VITAL_MANQUANT=""
for P in $MATERIEL_VITAL; do
	printf '%s' "$KO_LIST" | grep -qx "$P" && VITAL_MANQUANT="${VITAL_MANQUANT} $P"
done

if [ -n "$VITAL_MANQUANT" ]; then
	echo "[lexos]   !! ============================================================"
	echo "[lexos]   !! MATÉRIEL VITAL ABSENT :${VITAL_MANQUANT}"
	echo "[lexos]   !! Ce ne sont pas des commodités : Wi-Fi, son, microcode."
	echo "[lexos]   !! L'ISO démarrera, mais du matériel ne répondra pas, et"
	echo "[lexos]   !! rien à l'écran ne dira pourquoi."
	echo "[lexos]   !! ============================================================"
	if [ "${LEXOS_STRICT_FIRMWARE:-0}" = "1" ]; then
		echo "[lexos]   LEXOS_STRICT_FIRMWARE=1 — on s'arrête ici."
		rm -f "$WANTED"
		exit 1
	fi
else
	echo "[lexos]   matériel vital : $(set -- $MATERIEL_VITAL; echo $#) paquets, tous présents"
fi

verifier_son
rapporter_iwlwifi
rm -f "$WANTED"

# --- Vérification quotidienne des mises à jour (notification seulement) ----
#  Les mises à jour de SÉCURITÉ s'installent déjà toutes seules
#  (unattended-upgrades, /etc/apt/apt.conf.d/20auto-upgrades). Ce minuteur ne
#  fait que prévenir quand il en reste d'autres à appliquer à la main.
if command -v systemctl >/dev/null 2>&1; then
	systemctl enable lexos-update-check.timer >/dev/null 2>&1 \
		&& echo "[lexos]   lexos-update-check.timer activé" \
		|| echo "[lexos]   !! lexos-update-check.timer non activé"
fi

echo "[lexos] hook 0250 : ok"

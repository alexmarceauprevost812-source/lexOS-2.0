#!/bin/sh
# =============================================================================
#  LexOS — Claude (IA d'Anthropic) et Claude Terminal : icônes, lanceurs,
#  Claude Code embarqué dans l'image
# =============================================================================
#  Deux applications d'un coup :
#    - Claude Terminal : Claude Code, l'assistant de programmation
#                    d'Anthropic, dans sa propre fenêtre de terminal. EMBARQUÉ
#                    DANS L'IMAGE (npm install -g, plus bas dans ce hook) —
#                    demande d'Alex : « Claude Terminal va déjà être
#                    téléchargé dans l'ISO ». lexos-claude-installation
#                    (autostart de session, PAS un service systemd — voir
#                    plus bas pourquoi) rattrape la dernière version dès
#                    qu'un vrai réseau existe.
#    - Claude      : l'appli claude.ai, ouverte en fenêtre dédiée par le
#                    lanceur « lexos claude app ».
#
#  Ce hook pose donc les icônes, les deux lanceurs de bureau, et embarque
#  Claude Code lui-même. Rien n'est bloquant : si l'embarquement échoue (pas
#  de réseau pendant la construction), le lanceur « lexos claude » installe
#  Claude Code tout seul au premier lancement. Les deux icônes de bureau,
#  elles, sont toujours là.
# =============================================================================
set -e

echo "[lexos] hook 0420 : Claude et Claude Code"

have() { command -v "$1" >/dev/null 2>&1; }

# --- Les DEUX icônes : Claude, et Claude Terminal ---------------------------
#  ALEX, PHOTO DU DOCK : deux étoiles identiques, côte à côte. Les deux
#  lanceurs portaient « Icon=lexos-claude » — le même dessin pour
#  l'application claude.ai et pour le terminal de Claude. Rien ne disait
#  lequel ouvrait quoi.
#
#  Claude Terminal a donc son icône : le tracé OFFICIEL d'Anthropic, celui de
#  claude-icon.svg, inchangé — mais ROUGE sur le noir de LexOS au lieu du
#  terracotta sur crème.
#
#  CE COMMENTAIRE A DÉJÀ DIT LE CONTRAIRE, ET C'EST INSTRUCTIF. J'avais lu
#  « pour le terminal, même logo que celui-là » comme « fais-lui l'icône du
#  Terminal », et livré le cadre et le « >_ » d'icon-terminal.svg repeints en
#  rouge. Alex a repris : « logo officiel de Claude mais en ROUGE ». Le
#  dessin a été refait, la ligne qui décrivait l'ancien est restée — une
#  description fausse dans un fichier qu'on relit pour comprendre, c'est
#  l'erreur qui se rejoue toute seule à la prochaine lecture.
#
#  Trois icônes, trois lectures — le Terminal garde son cadre à l'accent et
#  son « >_ », Claude Terminal est l'étoile ROUGE sur noir, Claude l'étoile
#  terracotta sur crème.
#
#  UNE SEULE BOUCLE POUR LES DEUX. Les écrire l'une après l'autre aurait
#  donné deux blocs à tenir à jour, et le second aurait fini par oublier ce
#  que le premier avait appris — les tailles 16, 22 et 24, précisément.
ICONES="claude-icon:lexos-claude claude-terminal-icon:lexos-claude-terminal"
for PAIRE in $ICONES; do
	SRC="${PAIRE%%:*}"; NOM="${PAIRE#*:}"
	SVG="/usr/share/lexos/branding/${SRC}.svg"
	[ -r "$SVG" ] || SVG="branding/${SRC}.svg"       # selon le contexte du hook
	if [ ! -r "$SVG" ]; then
		echo "[lexos]   !! ${SRC}.svg introuvable — « $NOM » sera une icône générique"
		continue
	fi
	#  MÊMES TAILLES QUE TOUTES LES AUTRES ICÔNES LexOS (hook 0300).
	#  Ce hook avait exactement le même trou que celui de Chrome : 16, 22 et
	#  24 px manquaient. Aux tailles absentes, GTK bascule sur la version
	#  vectorielle, et comme le dock agrandit l'icône survolée, le dessin
	#  change sous la souris. Alex avait bien dit « plusieurs applications » —
	#  il y en avait deux, et c'est le contrôle du hook 0700 qui a nommé la
	#  seconde, dès la première construction où il tournait.
	POSEES=0
	for SIZE in 16 22 24 32 48 64 128 256; do
		DIR="/usr/share/icons/hicolor/${SIZE}x${SIZE}/apps"
		mkdir -p "$DIR"
		if have rsvg-convert; then
			rsvg-convert -w "$SIZE" -h "$SIZE" "$SVG" -o "$DIR/${NOM}.png" 2>/dev/null \
				&& POSEES=$((POSEES + 1)) || true
		elif have convert; then
			convert -background none -resize "${SIZE}x${SIZE}" "$SVG" "$DIR/${NOM}.png" 2>/dev/null \
				&& POSEES=$((POSEES + 1)) || true
		fi
	done
	echo "[lexos]   $NOM : ${POSEES}/8 tailles"
	#  Et PAS de version vectorielle : à 83 px (le dock au survol, zoom 130 %)
	#  seul « scalable » répondrait, et l'image changerait sous la souris.
	VDIR="/usr/share/icons/hicolor/scalable/apps"
	mkdir -p "$VDIR"; rm -f "$VDIR/${NOM}.svg"
done
have gtk-update-icon-cache && \
	gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true

# --- Claude Code : DANS L'IMAGE, dès la construction ------------------------
#  UN RETOUR EN ARRIÈRE ASSUMÉ, ET C'EST ALEX QUI L'A DEMANDÉ : « Claude
#  Terminal va déjà être téléchargé dans l'ISO ». On l'avait sorti de
#  l'image pour trois raisons réelles — version figée au jour de la
#  construction, session live qui ne garde rien, image plus grosse pour du
#  code qui vient du réseau. Elles tenaient, mais elles pesaient moins
#  qu'une quatrième qu'on n'avait pas assez pesée : SANS RÉSEAU AU PREMIER
#  DÉMARRAGE, PAS DE CLAUDE DU TOUT. Le Claude Terminal est maintenant une
#  application du dock avec sa page de connexion : cliquer dessus et
#  regarder un téléchargement échouer parce que le Wi-Fi n'était pas encore
#  configuré, c'est l'application qui a l'air cassée.
#
#  Les trois ennuis d'avant sont chacun contenus :
#    · la version figée — lexos-claude-installation (autostart de session,
#      même mécanisme que lexos-firstrun) rattrape la dernière version dès
#      qu'un vrai réseau existe, à la première ouverture de session ;
#      « lexos claude update » existe aussi, à la main ;
#    · la place en session live — assumée : c'est le prix pour que le
#      Claude Terminal marche dès la clé USB ;
#    · le poids de l'image — mesuré en dizaines de Mo sur une ISO de
#      plusieurs Go, pas en centaines.
#
#  UN DÉFAUT RÉEL, TROUVÉ EN ÉCRIVANT CE COMMENTAIRE : la ligne qui suivait
#  ici activait « lexos-claude-installation.service » — un NOM DE SERVICE
#  SYSTEMD DONT LE FICHIER D'UNITÉ N'A JAMAIS EXISTÉ dans ce dépôt.
#  « systemctl enable » échouait donc silencieusement à CHAQUE construction
#  depuis que cette ligne existe, tombait dans son « || echo », et le
#  message de repli s'affichait à chaque fois sans que personne ne le
#  remarque — exactement la famille de silence que ce fichier dénonce
#  ailleurs. Root cause : npm installe sous le compte qui l'exécute, pas
#  sous root au démarrage — un service systemd n'était pas la bonne forme
#  ici. lexos-firstrun avait déjà résolu ce problème par l'autostart de
#  session ; lexos-claude-installation (le SCRIPT, pas un service) suit le
#  même chemin.
#
#  BEST-EFFORT, ET BRUYANT : si npm manque ici ou si le réseau du chroot
#  refuse, on le DIT en travers du journal et on continue — le service et
#  le lanceur « lexos claude » restent les filets, exactement comme avant.
if have npm; then
	if npm install -g @anthropic-ai/claude-code >/dev/null 2>&1; then
		V="$(claude --version 2>/dev/null || echo "version non lisible")"
		echo "[lexos]   Claude Code embarqué dans l'image : ${V}"
	else
		echo "[lexos]   !! npm n'a pas pu installer Claude Code (réseau du chroot ?)"
		echo "[lexos]   !! — le service et le lanceur l'installeront au premier démarrage"
	fi
else
	echo "[lexos]   !! npm absent au moment du hook 0420 — Claude Code non embarqué"
	echo "[lexos]   !! — le service et le lanceur l'installeront au premier démarrage"
fi

#  lexos-claude-installation (le script) et son autostart de session sont
#  posés directement dans /etc/skel par ce dépôt (usr/bin/ et
#  etc/skel/.config/autostart/) : rien à activer ici, contrairement à un
#  service systemd. Le lanceur « lexos claude » garde son propre filet.
if have lexos-claude-installation; then
	echo "[lexos]   lexos-claude-installation : présent, rattrapera la version à la 1re session"
else
	echo "[lexos]   !! lexos-claude-installation introuvable — le lanceur « lexos claude » prendra le relais"
fi

# --- Lanceurs de bureau -----------------------------------------------------
mkdir -p /usr/share/applications

#  « CLAUDE TERMINAL » — LE NOM CHOISI PAR ALEX : « un 2e terminal mais
#  juste pour toi, on va l'appeler claude-terminal ». Le lanceur garde son
#  NOM DE FICHIER (lexos-claude-code.desktop) : le dock Plank le référence
#  par chemin (13-claude-code.dockitem), le renommer casserait l'épingle.
#  Seul ce qui s'affiche change. Et il ne lance plus xfce4-terminal en
#  direct : lexos-claude-terminal porte l'habillage dédié (couleurs, icône,
#  sans barres de menus) ET les replis si xfce4-terminal manque — un lanceur
#  qui écrit lui-même la commande du terminal les aurait perdus.
cat > /usr/share/applications/lexos-claude-code.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Claude Terminal
Name[en]=Claude Terminal
Comment=Le terminal de Claude — s'ouvre directement dans Claude Code (compte Anthropic requis)
Comment[en]=Claude's own terminal — opens straight into Claude Code (Anthropic account required)
Exec=lexos-claude-terminal
Icon=lexos-claude-terminal
Terminal=false
StartupNotify=true
Categories=Development;Utility;
Keywords=claude;code;claude-terminal;terminal;ia;ai;anthropic;assistant;programmation;developpement;cli;
EOF

cat > /usr/share/applications/lexos-claude.desktop <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Claude
Name[en]=Claude
Comment=L'application Claude (claude.ai) — l'IA d'Anthropic, en fenêtre
Comment[en]=The Claude app (claude.ai) — Anthropic's AI, in its own window
Exec=lexos claude app
Icon=lexos-claude
Terminal=false
StartupNotify=true
StartupWMClass=Claude
Categories=Network;Utility;
Keywords=claude;ia;ai;anthropic;chat;assistant;conversation;
EOF

have update-desktop-database && \
	update-desktop-database /usr/share/applications >/dev/null 2>&1 || true

echo "[lexos] hook 0420 : ok"

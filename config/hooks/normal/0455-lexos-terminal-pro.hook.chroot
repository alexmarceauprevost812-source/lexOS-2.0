#!/bin/sh
set -e
# =============================================================================
#  hook 0455 — LexOS Pro Terminal : l'icône
# =============================================================================
#  ALEX : « c'est le new terminal officiel de LexOS Pro, pour le terminal
#  normal je veux que ce soit lui qui le remplace. »
#
#  L'application elle-même (lexos-pro-terminal, /usr/lib/lexos/terminal-pro.py,
#  /usr/share/lexos/terminal-pro/web/ et le lanceur de menu) vient de
#  config/includes.chroot — même patron que Paramètres LexOS et Cartes
#  LexOS (hook 0450 : « ce hook ne fait que poser l'entrée de menu »). Ici,
#  seule l'icône a besoin d'un pas imprévisible (rendre un SVG en PNG) ; le
#  reste est déjà écrit noir sur blanc dans le dépôt.
#
#  ON REPEINT « icon-terminal.svg », PAS UN DESSIN NEUF. C'est le même
#  écran-et-chevron « >_ » qui sert déjà de socle à l'icône de Claude
#  Terminal (0420) : un terminal générique, reconnaissable, sans en
#  commander un nouveau.
# =============================================================================
echo "[lexos] hook 0455 : LexOS Pro Terminal"

have() { command -v "$1" >/dev/null 2>&1; }

#  Surchargeables pour éprouver ce hook sur un banc sans construire une ISO —
#  même procédé que LEXOS_THEMES au 0610 et LEXOS_ICONES_HICOLOR au 0425.
ICONES_DIR="${LEXOS_ICONES_HICOLOR:-/usr/share/icons/hicolor}"

NOM="lexos-pro-terminal"
SVG="/usr/share/lexos/branding/icon-terminal.svg"
[ -r "$SVG" ] || SVG="branding/icon-terminal.svg"   # selon le contexte du hook

if [ -r "$SVG" ]; then
	POSEES=0
	for SIZE in 16 22 24 32 48 64 128 256; do
		DIR="${ICONES_DIR}/${SIZE}x${SIZE}/apps"
		mkdir -p "$DIR"
		if have rsvg-convert; then
			rsvg-convert -w "$SIZE" -h "$SIZE" "$SVG" -o "$DIR/${NOM}.png" 2>/dev/null \
				&& POSEES=$((POSEES + 1)) || true
		elif have convert; then
			convert -background none -resize "${SIZE}x${SIZE}" "$SVG" "$DIR/${NOM}.png" 2>/dev/null \
				&& POSEES=$((POSEES + 1)) || true
		fi
	done
	echo "[lexos]   $NOM : ${POSEES}/8 tailles"
	#  PAS DE VERSION SCALABLE : à la taille du dock survolé (le zoom
	#  agrandit l'icône), une version vectorielle changerait de dessin sous
	#  la souris — la leçon retenue à la construction 70 (hook 0700 le
	#  vérifie).
	VDIR="${ICONES_DIR}/scalable/apps"
	mkdir -p "$VDIR"; rm -f "$VDIR/${NOM}.svg"
	have gtk-update-icon-cache && \
		gtk-update-icon-cache -f "$ICONES_DIR" >/dev/null 2>&1 || true
else
	echo "[lexos]   !! icon-terminal.svg introuvable — LexOS Pro Terminal aura une icône générique"
fi

if [ ! -x "${LEXOS_BIN_DIR:-/usr/bin}/lexos-pro-terminal" ]; then
	echo "[lexos]   !! /usr/bin/lexos-pro-terminal manquant — l'entrée de menu n'ouvrira rien"
fi
if [ ! -r "${LEXOS_TERMINAL_PRO_WEB:-/usr/share/lexos/terminal-pro/web}/index.html" ]; then
	echo "[lexos]   !! l'interface web de LexOS Pro Terminal est manquante"
fi

# =============================================================================
#  LE TERMINAL PRINCIPAL DU SYSTÈME
# =============================================================================
#  ALEX : « je voudrais juste que le terminal principal du système soit le
#  terminal LexOS Pro ».
#
#  Trois branchements, et ils ne font PAS la même chose :
#    · l'assistant XFCE (helpers) sert à « Ouvrir un terminal ici » de Thunar,
#      à Ctrl+Alt+T et à « exo-open --launch TerminalEmulator » ;
#    · l'alternative Debian « x-terminal-emulator » sert à tout le reste du
#      système — c'est elle qu'appellent les programmes qui ne connaissent
#      pas XFCE ;
#    · le canal xfce4-keyboard-shortcuts (Super+T, Super+Entrée) pointe déjà
#      sur lexos-pro-terminal : rien à faire de ce côté.
ALT_PONT="${LEXOS_BIN_DIR:-/usr/bin}/lexos-pro-terminal.wrapper"
AIDE_SYS="${LEXOS_XFCE_HELPERS:-/usr/share/xfce4/helpers}/lexos-pro-terminal.desktop"

if [ -r "$AIDE_SYS" ]; then
	echo "[lexos]   assistant XFCE posé : LexOS Pro Terminal est proposé comme émulateur"
	#  « Applications par défaut » de LexOS ne balaie QUE /usr/share/xfce4/
	#  helpers : sans ce fichier-là, la page ne voit pas LexOS Pro Terminal,
	#  même si helpers.rc le nomme. Vérifié dans lexos-defaut.
else
	echo "[lexos]   !! assistant XFCE manquant — la page « Applications par défaut » ne le proposera pas"
fi

#  ═══ L'ALTERNATIVE PASSE PAR UN PONT, JAMAIS PAR LE LANCEUR ═══
#  terminal-pro.py ne traite AUCUN argument. Brancher le lanceur directement
#  ferait ouvrir une fenêtre vide, sans rien lancer, chaque fois qu'un
#  programme fait « x-terminal-emulator -e une-commande ». Le pont renvoie
#  ces cas-là vers le Terminal classique, qui sait les traiter.
#  PRIORITÉ 60 : au-dessus des 40 de xfce4-terminal.wrapper, pour gagner en
#  mode automatique aussi, pas seulement après un --set.
if [ -x "$ALT_PONT" ] && have update-alternatives; then
	update-alternatives --install /usr/bin/x-terminal-emulator \
		x-terminal-emulator "$ALT_PONT" 60 >/dev/null 2>&1 \
		&& update-alternatives --set x-terminal-emulator "$ALT_PONT" >/dev/null 2>&1 \
		&& echo "[lexos]   x-terminal-emulator → LexOS Pro Terminal (par le pont)" \
		|| echo "[lexos]   !! update-alternatives a refusé — x-terminal-emulator reste sur l'ancien"
elif [ ! -x "$ALT_PONT" ]; then
	echo "[lexos]   !! $ALT_PONT manquant — x-terminal-emulator reste sur le Terminal classique"
fi

#  ═══ ET LE SQUELETTE DIT LE MÊME CHOIX ═══
#  helpers.rc est le fichier qu'XFCE lit pour savoir quel émulateur ouvrir.
#  Sans lui, le premier lancement retomberait sur le défaut du système.
SKEL_XFCE="${LEXOS_SKEL:-/etc/skel}/.config/xfce4"
mkdir -p "$SKEL_XFCE"
if [ -f "$SKEL_XFCE/helpers.rc" ]; then
	if grep -q '^TerminalEmulator=' "$SKEL_XFCE/helpers.rc"; then
		sed -i 's|^TerminalEmulator=.*|TerminalEmulator=lexos-pro-terminal|' \
			"$SKEL_XFCE/helpers.rc"
	else
		printf 'TerminalEmulator=lexos-pro-terminal\n' >> "$SKEL_XFCE/helpers.rc"
	fi
else
	printf 'TerminalEmulator=lexos-pro-terminal\n' > "$SKEL_XFCE/helpers.rc"
fi
echo "[lexos]   helpers.rc du squelette : TerminalEmulator=lexos-pro-terminal"

#  ═══ xterm.js : LA GRILLE DE CARACTÈRES DU TERMINAL ═══
#  LexOS Pro Terminal ouvre un VRAI pseudo-terminal. Ce qui en sort n'est
#  plus une suite de lignes mais un flot d'ordres — place le curseur ici,
#  efface de là — et il faut une grille de caractères pour les interpréter.
#  C'est xterm.js, livré par le paquet Debian « node-xterm » (liste
#  obligatoire lexos-core), JAMAIS par npm : même règle que PySide6 pour le
#  pont, écrite en toutes lettres dans lexos-pro-terminal.
#
#  DES LIENS, PAS DES COPIES : une mise à jour du paquet profite alors
#  directement à la page, et l'ISO ne porte pas deux fois 300 Ko.
#
#  ET ON CHERCHE LES CHEMINS, ON NE LES ÉCRIT PAS EN DUR. « dpkg -L » dit où
#  le paquet a VRAIMENT posé ses fichiers ; si un jour Debian déplace
#  /usr/share/nodejs, le hook suit au lieu de poser un lien mort — et un lien
#  mort ici, c'est un terminal principal qui s'ouvre sur du noir, sans un mot.
WEB="${LEXOS_TERMINAL_PRO_WEB:-/usr/share/lexos/terminal-pro/web}"
VENDOR="$WEB/vendor"

trouver_js() {
	#  1) ce que dpkg dit du paquet ; 2) à défaut, les emplacements connus.
	for chemin in $(dpkg -L node-xterm 2>/dev/null | grep -E "/$1\$"); do
		[ -f "$chemin" ] && { printf '%s' "$chemin"; return 0; }
	done
	for chemin in /usr/share/nodejs/*/lib/"$1" /usr/share/nodejs/*/css/"$1" \
	              /usr/lib/nodejs/*/lib/"$1"; do
		[ -f "$chemin" ] && { printf '%s' "$chemin"; return 0; }
	done
	return 1
}

if [ -d "$WEB" ]; then
	mkdir -p "$VENDOR"
	MANQUE=""
	for FICHIER in xterm.js xterm.css xterm-addon-fit.js; do
		SRC="$(trouver_js "$FICHIER" || true)"
		if [ -n "$SRC" ]; then
			ln -sf "$SRC" "$VENDOR/$FICHIER"
			echo "[lexos]   vendor/$FICHIER → $SRC"
		else
			MANQUE="$MANQUE $FICHIER"
		fi
	done
	if [ -n "$MANQUE" ]; then
		#  ON ARRÊTE LA CONSTRUCTION. Ce n'est pas une fonction en moins :
		#  c'est le terminal qui remplace Super+T et l'icône du dock qui
		#  s'ouvrirait sur un rectangle noir. Une ISO qui a l'air correcte et
		#  dont le terminal n'affiche rien est pire qu'une construction qui
		#  échoue en le disant — c'est la leçon des dossiers blancs de
		#  l'ISO 72 et de l'écran de démarrage disparu.
		echo "[lexos]   !! introuvable :$MANQUE"
		echo "[lexos]   !! le paquet node-xterm est-il bien installé ? (liste lexos-core)"
		exit 1
	fi
else
	echo "[lexos]   !! $WEB absent — vendor/ non posé"
	exit 1
fi

#  ═══ LE LANCEUR 11 EST REVENU À LEXOS PRO TERMINAL ═══
#  Il faisait « xfce4-terminal --hold -e "lexos capture video" », parce qu'il
#  a besoin d'un VRAI pty et de « --hold ». Les deux existent maintenant :
#  le pty (pty.fork, une session par volet) et lire_arguments() dans
#  terminal-pro.py, qui garde le volet ouvert après la commande.
#  Depuis le 2026-10-23, ce lanceur n'est plus dans la barre du haut (Alex :
#  « retirer définitivement les anciens outils ») ; « --hold » reste, pour
#  toute commande qu'on veut lire jusqu'au bout.

echo "[lexos] hook 0455 : ok"

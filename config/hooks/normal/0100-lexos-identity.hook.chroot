#!/bin/sh
# =============================================================================
#  LexOS — identité système (os-release, issue, motd, GRUB)
# =============================================================================
set -e

echo "[lexos] hook 0100 : identité système"

# Valeurs de repli si build.conf n'a pas été généré (build manuel via `lb build`)
LEXOS_NAME="LexOS"
LEXOS_ID="lexos"
LEXOS_VERSION="1.0"
LEXOS_CODENAME="Nomad"
LEXOS_TAGLINE="Explore. Build. Own your machine."
LEXOS_HOME_URL="https://github.com/alexmarceauprevost812-source/lexOS-2.0"
LEXOS_BUG_URL="${LEXOS_HOME_URL}/issues"
LEXOS_BUILD_DATE="unknown"
LEXOS_BUILD_ID="nogit"
LEXOS_FLAVOUR="standard"
LEXOS_DEBIAN_SUITE="bookworm"

if [ -r /etc/lexos/build.conf ]; then
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf
else
	echo "[lexos] avertissement : /etc/lexos/build.conf absent, valeurs par défaut"
	mkdir -p /etc/lexos
fi

# --- TI-LEX-OS Pro -----------------------------------------------------------
#  L'édition pour jouer porte son propre nom, partout où le système
#  s'annonce : écran de démarrage, « À propos », lexfetch, GRUB. Ce n'est
#  pas un habillage — c'est une autre ISO, avec Wine, Proton, les pilotes
#  Vulkan et l'arsenal du joueur déjà en place. Autant qu'elle se présente
#  comme telle plutôt que de laisser croire à un LexOS ordinaire.
if [ "$LEXOS_FLAVOUR" = "pro" ]; then
	LEXOS_NAME="TI-LEX-OS Pro"
	LEXOS_TAGLINE="Play. Build. Own your machine."
fi

DEBIAN_VERSION="$(cat /etc/debian_version 2>/dev/null || echo 'unknown')"
VERSION_CODENAME_LOWER="$(echo "$LEXOS_CODENAME" | tr '[:upper:]' '[:lower:]')"

# --- os-release --------------------------------------------------------------
cat > /usr/lib/os-release <<EOF
PRETTY_NAME="${LEXOS_NAME} ${LEXOS_VERSION} (${LEXOS_CODENAME})"
NAME="${LEXOS_NAME}"
VERSION_ID="${LEXOS_VERSION}"
VERSION="${LEXOS_VERSION} (${LEXOS_CODENAME})"
VERSION_CODENAME=${VERSION_CODENAME_LOWER}
ID=${LEXOS_ID}
ID_LIKE=debian
HOME_URL="${LEXOS_HOME_URL}"
SUPPORT_URL="${LEXOS_HOME_URL}"
BUG_REPORT_URL="${LEXOS_BUG_URL}"
LOGO=${LEXOS_ID}
ANSI_COLOR="1;38;5;208"
DEBIAN_BASE="${LEXOS_DEBIAN_SUITE} (${DEBIAN_VERSION})"
LEXOS_FLAVOUR="${LEXOS_FLAVOUR}"
LEXOS_BUILD_DATE="${LEXOS_BUILD_DATE}"
LEXOS_BUILD_ID="${LEXOS_BUILD_ID}"
EOF

rm -f /etc/os-release
ln -s ../usr/lib/os-release /etc/os-release

# --- lsb-release -------------------------------------------------------------
cat > /etc/lsb-release <<EOF
DISTRIB_ID=${LEXOS_NAME}
DISTRIB_RELEASE=${LEXOS_VERSION}
DISTRIB_CODENAME=${VERSION_CODENAME_LOWER}
DISTRIB_DESCRIPTION="${LEXOS_NAME} ${LEXOS_VERSION} (${LEXOS_CODENAME})"
EOF

# --- Bannière de console (issue) --------------------------------------------
# \e ne s'interprète pas dans issue : on utilise printf pour insérer ESC.
ESC="$(printf '\033')"
O="${ESC}[38;5;208m"   # orange
D="${ESC}[2m"          # atténué
R="${ESC}[0m"          # reset

cat > /etc/issue <<EOF
${O}   __         _____ _____ ${R}
${O}  / /  _____ / __  |  ___|${R}
${O} / /  / _ \\ \\/ / | | |___ ${R}
${O}/ /__|  __/>  <  | |___  |${R}
${O}\\____/\\___/_/\\_\\ |_____/  ${R}

 ${LEXOS_NAME} ${LEXOS_VERSION} « ${LEXOS_CODENAME} »  ${D}(\\l sur \\n)${R}
 ${D}${LEXOS_TAGLINE}${R}

EOF

cat > /etc/issue.net <<EOF
${LEXOS_NAME} ${LEXOS_VERSION} (${LEXOS_CODENAME})
EOF

# --- Message du jour ---------------------------------------------------------
cat > /etc/motd <<EOF

  ${O}${LEXOS_NAME} ${LEXOS_VERSION}${R} « ${LEXOS_CODENAME} » — saveur ${LEXOS_FLAVOUR}
  ${D}build ${LEXOS_BUILD_DATE} (${LEXOS_BUILD_ID}) · base Debian ${LEXOS_DEBIAN_SUITE}${R}

  ${D}lexfetch${R}        infos système
  ${D}lexos help${R}      outils LexOS
  ${D}lexos update${R}    mettre à jour le système

EOF

# --- GRUB du système installé ------------------------------------------------
mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/lexos.cfg <<EOF
GRUB_DISTRIBUTOR="${LEXOS_NAME}"
#  ── L'ANIMATION SEULE À L'ÉCRAN ─────────────────────────────────────────
#  ALEX : « qu'on ne voie pas les outils ouvrir quand il fait l'animation ».
#  « quiet splash » ne suffisait pas : quiet BAISSE le niveau des messages du
#  noyau, il ne le coupe pas, et il ne dit rien du tout à systemd ni à udev —
#  qui sont justement ceux qui écrivent les lignes de services.
#     loglevel=3 .................... les messages du noyau de niveau
#                                     info/notice, qui s'impriment malgré quiet
#     udev.log_level=3 .............. les lignes d'udev pendant la détection
#                                     du matériel
#     systemd.show_status=false ..... les « [  OK  ] Started … » de systemd
#     rd.systemd.show_status=false .. les mêmes, mais dans l'initramfs, AVANT
#                                     que le vrai système ne démarre
#     vt.global_cursor_default=0 .... le curseur qui clignote par-dessus
#                                     l'animation
#  Les mêmes réglages sont dans auto/config (BOOTAPPEND), sinon la correction
#  ne vaudrait que pour le système installé et pas pour la clé USB.
#  Ils ne sont PAS dans BOOTAPPEND_FAILSAFE, et c'est volontaire : le mode
#  secours doit rester bavard — auto/config explique longuement pourquoi.
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 udev.log_level=3 systemd.show_status=false rd.systemd.show_status=false vt.global_cursor_default=0"
#  ── LE MENU DE DÉMARRAGE ────────────────────────────────────────────────
#  Le thème vit dans /usr/share/grub/themes/lexos, livré par includes.chroot.
#  Ce chemin-là est celui que Debian utilise pour ses propres thèmes
#  (desktop-base) : grub-mkconfig sait calculer la bonne adresse même quand
#  /boot est sur une partition séparée, et il charge tout seul les polices
#  .pf2 trouvées dans le dossier du thème.
GRUB_THEME="/usr/share/grub/themes/lexos/theme.txt"
#  ═══ GRUB_BACKGROUND VIDE, ET C'EST VOULU — LE RECTANGLE BLEU ═══
#  ALEX, PHOTO DU ThinkPad : après avoir choisi LexOS, un grand rectangle
#  bleu-turquoise à vagues au milieu de l'écran, « Loading Linux… » par-dessus.
#  « On dirait que mon logiciel est complètement planté. »
#
#  Ce bloc disait avant : « GRUB_THEME et GRUB_BACKGROUND ne se cumulent pas :
#  le thème gagne, on nomme le thème et rien d'autre ». C'est vrai pour
#  00_header, qui choisit l'un OU l'autre. C'est faux pour
#  /etc/grub.d/05_debian_theme, qui tourne quoi qu'il arrive et qui, quand
#  GRUB_BACKGROUND n'est PAS DÉFINI, va chercher l'image de desktop-base
#  (/usr/share/desktop-base/grub_background.sh, puis desktop-grub.png) et
#  écrit « background_image … » dans grub.cfg. Le thème gagne pour le menu ;
#  la ZONE TERMINAL, elle, laissait transparaître cette image — les vagues
#  turquoise de trixie.
#
#  La règle de 05_debian_theme est écrite dans son code (bogue Debian
#  #608263) : si GRUB_BACKGROUND est DÉFINI — même vide — il n'essaie RIEN
#  d'autre. Une valeur vide, c'est donc « pas d'image de fond, point », y
#  compris quand desktop-base est installé, et sans toucher au fichier de
#  Debian. Le thème pose EN PLUS un terminal-box noir : deux verrous, pour
#  que le repli n'ait jamais de bleu à montrer. tests/test_lexos_grub.sh
#  joue le vrai 05_debian_theme avec et sans desktop-base.
GRUB_BACKGROUND=""
#  ═══ « Loading Linux… » RESTE À L'ÉCRAN, ET CE N'EST PAS UN OUBLI ═══
#  Sur la même photo, le texte « Loading Linux 6.x… » s'écrivait par-dessus
#  le rectangle bleu. Ce texte vient de /etc/grub.d/10_linux, qui l'écrit
#  dans grub.cfg selon une variable de shell nommée quiet_boot. LU DANS LE
#  SCRIPT, PAS SUPPOSÉ : quiet_boot est une AFFECTATION EN DUR en tête de
#  10_linux (grub 2.12 : « quiet_boot="1" », ligne 24 de la copie
#  d'Ubuntu ; la copie de trixie n'était pas lisible depuis la machine de
#  construction — les miroirs Debian y sont coupés — et Alex la vérifie
#  avec : grep -n quiet_boot /etc/grub.d/10_linux). Les seules variables
#  que 10_linux lit dans /etc/default sont GRUB_CMDLINE_LINUX*,
#  GRUB_DEFAULT, GRUB_DEVICE*, GRUB_DISABLE_*, GRUB_DISTRIBUTOR,
#  GRUB_EARLY_INITRD_LINUX_*, GRUB_FORCE_PARTUUID, GRUB_GFXPAYLOAD_LINUX,
#  GRUB_RECOVERY_TITLE et GRUB_TOP_LEVEL : AUCUNE ne pilote quiet_boot.
#  Il n'existe donc PAS de réglage à poser ici pour faire taire le
#  message — et patcher 10_linux est exclu : c'est un fichier de
#  configuration du paquet grub-common, la prochaine mise à jour le
#  réécrirait. On ne pose rien. Avec la zone terminal peinte en noir, le
#  message s'écrit en blanc sur noir pendant une seconde, comme sur
#  n'importe quel Debian : ce n'est plus un écran « planté ».
#  tests/test_lexos_grub.sh vérifie qu'aucune variable inventée n'apparaît
#  dans ce fichier — chaque GRUB_* posée ici est lue par grub-mkconfig ou
#  par un script de /etc/grub.d de la machine.
#  Le thème est calé sur une grille 1920 x 1080. « auto » laisse le firmware
#  choisir, et sur un téléviseur il choisit parfois un mode que la dalle
#  n'aime pas ; on propose donc 1080p d'abord, avec des replis, et « auto »
#  en dernier recours pour ne jamais se retrouver sans menu du tout.
GRUB_GFXMODE="1920x1080,1280x720,1024x768,auto"
#  Garder le mode graphique pour le noyau aussi : sans ça, GRUB rend la main
#  en mode texte et l'écran clignote entre deux résolutions au démarrage.
GRUB_GFXPAYLOAD_LINUX=keep
#  LA LIGNE QUI REND LE DOUBLE DÉMARRAGE POSSIBLE.
#  Depuis GRUB 2.06, Debian coupe la recherche des autres systèmes par
#  défaut (GRUB_DISABLE_OS_PROBER=true). Conséquence si on n'y touche pas :
#  on installe LexOS à côté de Windows, tout se passe bien... et le menu de
#  démarrage n'affiche que LexOS. Windows est toujours sur le disque, mais
#  il faut passer par le menu du BIOS pour l'atteindre — ce qui ressemble à
#  s'y méprendre à une perte de données.
#  On la remet donc à false, et os-prober est dans la liste OBLIGATOIRE.
GRUB_DISABLE_OS_PROBER=false
#  ── LE CHOIX AU DÉMARRAGE : WINDOWS PAR DÉFAUT, HUIT SECONDES ──────────
#  Demande d'Alex : Windows sert à jouer, LexOS à travailler. Au démarrage,
#  le menu propose les deux ; si personne ne touche à rien, la machine part
#  sur Windows. C'est le bon réglage pour une machine partagée : celui qui
#  allume pour jouer n'a rien à faire, celui qui vient travailler appuie sur
#  une flèche.
#
#  « menu » est indispensable : sans lui, GRUB peut cacher le menu derrière
#  un compte à rebours discret, et on ne voit pas qu'il y a un choix.
GRUB_TIMEOUT=8
GRUB_TIMEOUT_STYLE=menu
#  ═══ CES 8 SECONDES RETARDENT L'ANIMATION DE DÉMARRAGE — CE QUI A ÉTÉ
#      MESURÉ, ET CE QUI N'EST PAS FAIT ═══
#  ALEX veut voir sa vidéo « tout de suite après Lenovo ». Entre les deux il
#  y a ce menu. Sur une machine SANS autre système, ces 8 secondes
#  n'apportent rien. Trois chemins ont été examinés dans les fichiers de la
#  machine — AUCUN N'EST APPLIQUÉ : le compromis appartient à Alex.
#
#  1. LE DÉLAI NE PEUT PAS DÉPENDRE D'os-prober DANS LA MÊME PASSE.
#     /etc/grub.d/00_header écrit « set timeout= » à partir de GRUB_TIMEOUT,
#     et il tourne AVANT /etc/grub.d/30_os-prober (00 avant 30) : quand le
#     délai est écrit, personne ne sait encore si Windows est là.
#  2. PATCHER 00_header : écarté pour la raison déjà écrite plus bas au
#     sujet de 30_os-prober — le fichier appartient à grub-common, et une
#     mise à jour du paquet le réécrirait.
#  3. RETOUCHER grub.cfg APRÈS COUP (sed) : écarté aussi. grub.cfg est
#     REFAIT à chaque mise à jour de noyau ; il faudrait une machine à
#     re-poser la retouche indéfiniment, et le jour où elle cesse de
#     marcher, personne ne le voit.
#
#  CE QUI SERAIT POSSIBLE, SI ALEX LE VEUT : un fichier à nous dans
#  /etc/grub.d/, numéroté APRÈS 30_os-prober, qui écrit dans grub.cfg une
#  condition évaluée PAR GRUB AU DÉMARRAGE :
#        if [ "\${saved_entry}" = "" ]; then set timeout=3; fi
#  « saved_entry » n'est écrit dans grubenv QUE par lexos-grub-defaut, et
#  SEULEMENT quand il a trouvé une entrée Windows (voir
#  /usr/lib/lexos/grub-defaut-voisin). Vide veut donc dire « pas d'autre
#  système ». La condition est relue à CHAQUE démarrage — installer Windows
#  plus tard rend d'office ses 8 secondes au menu, sans rien reconstruire —
#  et « load_env » est déjà émis par 00_header, donc la variable existe.
#  Ce que ça coûte : au premier démarrage d'un double amorçage, avant que
#  lexos-grub-defaut n'ait tourné une fois, le menu passerait à 3 s. Il
#  revient à 8 s au démarrage suivant.
#  RIEN DE TOUT ÇA N'EST FAIT ICI. Le menu reste à 8 secondes.
#  POURQUOI « saved » ET NON « 0 ».
#  « 0 » désigne la PREMIÈRE entrée du menu — et la première entrée est
#  LexOS, pas Windows : os-prober tourne dans 30_os-prober, après le
#  10_linux qui liste les noyaux LexOS. Le document reçu propose de renuméroter
#  os-prober en 09_os-prober et de désactiver le 30. Ça marche, mais
#  /etc/grub.d/30_os-prober appartient à grub-common : une mise à jour du
#  paquet lui rendrait son droit d'exécution, et Windows apparaîtrait DEUX
#  fois dans le menu, sans que personne comprenne pourquoi.
#
#  « saved » est le mécanisme prévu par GRUB pour exactement ça : l'entrée
#  par défaut est lue dans /boot/grub/grubenv, et « grub-set-default » l'y
#  écrit par son TITRE. Le service lexos-grub-defaut la pose au premier
#  démarrage du système installé, quand os-prober a enfin vu le vrai disque.
#  Aucun fichier de Debian n'est touché, et rien ne casse à la mise à jour.
#
#  Si aucun Windows n'est trouvé, rien n'est écrit : grubenv reste vide et
#  GRUB démarre sur LexOS. Le défaut est donc toujours sûr.
GRUB_DEFAULT=saved
#  À false volontairement : « true » ferait de la DERNIÈRE entrée choisie le
#  nouveau défaut. On veut que Windows reste le défaut même après un
#  démarrage sur LexOS — sinon le réglage se retourne au premier usage.
GRUB_SAVEDEFAULT=false
EOF

# --- Métadonnées internes ----------------------------------------------------
mkdir -p /etc/lexos
printf '%s\n' "${LEXOS_VERSION}" > /etc/lexos/version
printf '%s %s (%s) — flavour=%s build=%s %s\n' \
	"${LEXOS_NAME}" "${LEXOS_VERSION}" "${LEXOS_CODENAME}" \
	"${LEXOS_FLAVOUR}" "${LEXOS_BUILD_DATE}" "${LEXOS_BUILD_ID}" \
	> /etc/lexos/release

echo "[lexos] hook 0100 : ok"

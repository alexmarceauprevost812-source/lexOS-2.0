# =============================================================================
#  LexOS — réglages par défaut du dock Plank (barre verticale de gauche)
# =============================================================================

[net/launchpad/plank/docks/dock1]
position='left'
alignment='center'
items-alignment='center'
offset=0
icon-size=48
hide-mode='intelligent'

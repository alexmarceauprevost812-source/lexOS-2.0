# =============================================================================
#  LexOS — réglages par défaut du dock Plank
# =============================================================================
#  Position par défaut : à DROITE de l'écran.
#  Modifiable à tout moment : lexos dock <droite|gauche|bas|haut>
#  ou clic droit sur le dock → Préférences.
# =============================================================================

[net/launchpad/plank/docks/dock1]
position='right'
alignment='center'
items-alignment='center'
offset=0
#  ALEX, PHOTO DE LA 73 : « le bouton du centre, le grossir aussi, et celui
#  de gauche aussi — lui à gauche on ne voit vraiment pas beaucoup. »
#  48 px, c'est le défaut de Plank, pensé pour un dock qui se cache. Le nôtre
#  est à demeure sur le côté : il a la place, et ces icônes sont le premier
#  chemin vers chaque application. 64 px les rend visibles d'un coup d'œil
#  sans manger l'écran — sur un 1366x768, le dock passe de 48 à 64 px de
#  large, soit 5 % de la largeur.
icon-size=64
hide-mode='intelligent'
hide-delay=0
unhide-delay=0
theme='Transparent'
zoom-enabled=true
#  Le grossissement au survol suit : 150 % de 64 donnait une icône énorme
#  au passage de la souris. 130 % de 64 fait 83 px — le même effet, à la même
#  échelle relative qu'avant.
zoom-percent=130
pressure-reveal=true
show-dock-item=false
lock-items=false
monitor=''
#  Ordre calqué sur DOCK dans web-demo/index.html : Navigateur, Chrome,
#  Terminal, Fichiers, Note perso, Claude, Claude Code, Partager, Capture,
#  Studio+, Logithèque, Paramètres, Installer, À propos. (Le dernier bouton
#  de la démo, « Applications », est déjà le bouton Applications du panneau —
#  pas de doublon dans le dock.)
#  Chrome est juste après Firefox : les deux navigateurs côte à côte. Son
#  icône est là dès le premier démarrage ; le premier clic propose
#  l'installation depuis le dépôt officiel de Google (voir lexos-chrome).
dock-items=['00-firefox.dockitem','15-chrome.dockitem','01-terminal.dockitem','02-files.dockitem','03-editor.dockitem','12-claude.dockitem','13-claude-code.dockitem','14-musique.dockitem','05-partage.dockitem','09-capture.dockitem','10-studio.dockitem','11-logitheque.dockitem','08-settings.dockitem','06-install.dockitem','07-about.dockitem']

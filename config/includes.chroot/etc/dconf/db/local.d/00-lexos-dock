# =============================================================================
#  LexOS — réglages par défaut du dock Plank
# =============================================================================
#  Position par défaut : à DROITE de l'écran.
#  Modifiable à tout moment : lexos dock <droite|gauche|bas|haut>
#  ou clic droit sur le dock → Préférences.
# =============================================================================

[net/launchpad/plank/docks/dock1]
position='right'
alignment='center'
items-alignment='center'
offset=0
icon-size=48
hide-mode='intelligent'
hide-delay=0
unhide-delay=0
theme='Transparent'
zoom-enabled=true
zoom-percent=150
pressure-reveal=true
show-dock-item=false
lock-items=false
monitor=''
#  Ordre calqué sur DOCK dans web-demo/index.html : Navigateur, Terminal,
#  Fichiers, Note perso, Claude, Claude Code, Partager, Capture, Studio+,
#  Logithèque, Paramètres, Installer, À propos. (Le dernier bouton de la démo,
#  « Applications », est déjà le bouton Applications du panneau — pas de
#  doublon dans le dock.)
dock-items=['00-firefox.dockitem','01-terminal.dockitem','02-files.dockitem','03-editor.dockitem','12-claude.dockitem','13-claude-code.dockitem','05-partage.dockitem','09-capture.dockitem','10-studio.dockitem','11-logitheque.dockitem','08-settings.dockitem','06-install.dockitem','07-about.dockitem']

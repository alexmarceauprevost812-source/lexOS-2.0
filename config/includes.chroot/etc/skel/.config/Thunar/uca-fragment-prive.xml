<!--
  Fragment à insérer dans etc/skel/.config/Thunar/uca.xml, juste avant
  la balise fermante </actions>.

  appliquer.sh le fait tout seul : il n'écrase JAMAIS le uca.xml existant
  (« Définir comme fond d'écran », « Ouvrir un terminal ici »… restent en place).

  Si un jour il faut le faire à la main :
      nano config/includes.chroot/etc/skel/.config/Thunar/uca.xml
  puis coller le bloc <action>…</action> ci-dessous avant </actions>.
-->
<action>
	<icon>changes-prevent</icon>
	<name>Mettre en privé</name>
	<submenu></submenu>
	<unique-id>1755799200000000-1</unique-id>
	<command>lexos-prive ajouter %F</command>
	<description>Déplacer dans le coffre chiffré — illisible sans le mot de passe</description>
	<range>*</range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>changes-allow</icon>
	<name>Ouvrir mes fichiers privés</name>
	<submenu></submenu>
	<unique-id>1755799200000000-2</unique-id>
	<command>lexos-prive dossier</command>
	<description>Déverrouiller le coffre et l'ouvrir dans Fichiers</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>

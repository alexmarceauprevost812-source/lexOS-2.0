<?xml version="1.0" encoding="UTF-8"?>
<!--
  LexOS — actions du clic droit dans Fichiers (Thunar).

  Ce fichier REMPLACE celui que Thunar génère au premier lancement : on y
  recopie donc aussi son action par défaut (« Ouvrir un terminal ici »),
  sinon on la ferait disparaître en ajoutant les nôtres.

  Les deux actions LexOS répondent à la demande : clic droit sur une image
  -> la mettre en fond d'écran ; clic droit sur un GIF ou une vidéo -> en
  faire un fond d'écran ANIMÉ (mascotte comprise).
-->
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Ouvrir un terminal ici</name>
	<submenu></submenu>
	<unique-id>1000000000000000-1</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Ouvre un terminal dans le dossier affiché</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>folder</icon>
	<name>Étiqueter ce dossier</name>
	<submenu></submenu>
	<unique-id>1756569600000000-1</unique-id>
	<command>lexos-etiquette %F</command>
	<description>Écrit les trois premières lettres de son nom sur le dossier</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Définir comme fond d'écran</name>
	<submenu></submenu>
	<unique-id>1000000000000000-2</unique-id>
	<command>lexos-fond-ecran %f</command>
	<description>Met cette image en fond d'écran LexOS</description>
	<range></range>
	<patterns>*.jpg;*.jpeg;*.png;*.webp;*.bmp;*.svg;*.JPG;*.JPEG;*.PNG</patterns>
	<image-files/>
</action>
<action>
	<icon>changes-prevent</icon>
	<name>Mettre en privé</name>
	<submenu></submenu>
	<unique-id>1755799200000000-1</unique-id>
	<command>lexos-prive ajouter %F</command>
	<description>Déplacer dans le coffre chiffré — illisible sans le mot de passe</description>
	<range>*</range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>changes-allow</icon>
	<name>Ouvrir mes fichiers privés</name>
	<submenu></submenu>
	<unique-id>1755799200000000-2</unique-id>
	<command>lexos-prive dossier</command>
	<description>Déverrouiller le coffre et l'ouvrir dans Fichiers</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
</actions>

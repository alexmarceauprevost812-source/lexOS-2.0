<?xml version="1.0" encoding="UTF-8"?>
<!--
  LexOS — barre du haut, façon Ubuntu.
  Le dock vertical de gauche est géré par Plank (voir ~/.config/plank).
-->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="dark-mode" type="bool" value="true"/>

  <property name="panels" type="array">
    <value type="int" value="1"/>

    <property name="panel-1" type="empty">
      <!--  p=2 : BORD HAUT, centrée horizontalement — comme la démo.
            Elle valait « p=6 », qui chez XFCE désigne le coin BAS-GAUCHE en
            VERTICAL, alors que « mode=0 » juste en dessous la déclare
            horizontale. Une barre horizontale accrochée à un ancrage
            vertical : XFCE la posait hors de vue, et elle n'est jamais
            apparue sur aucune construction. Alex a signalé « il manque le
            menu en haut de l'écran » — elle ne manquait pas, elle était
            rangée dans un coin.
            Repères : 2 = haut · 5 = gauche · 8 = droite · 11 = bas. -->
      <property name="position"        type="string" value="p=2;x=0;y=0"/>
      <property name="position-locked" type="bool"   value="true"/>
      <property name="length"          type="uint"   value="100"/>
      <property name="length-adjust"   type="bool"   value="true"/>
      <property name="size"            type="uint"   value="30"/>
      <property name="icon-size"       type="uint"   value="16"/>
      <property name="mode"            type="uint"   value="0"/>
      <property name="autohide-behavior" type="uint" value="0"/>
      <property name="enter-opacity"   type="uint"   value="100"/>
      <property name="leave-opacity"   type="uint"   value="100"/>
      <property name="background-style" type="uint"  value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.000000"/>
        <value type="double" value="0.000000"/>
        <value type="double" value="0.000000"/>
        <value type="double" value="1.000000"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="14"/>
        <value type="int" value="9"/>
        <value type="int" value="10"/>
        <value type="int" value="11"/>
        <value type="int" value="13"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="16"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="15"/>
        <value type="int" value="12"/>
        <value type="int" value="8"/>
      </property>
    </property>
  </property>

  <property name="plugins" type="empty">

    <!-- 1 · Menu principal (équivalent « Activités ») -->
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-title"      type="string" value="Applications"/>
      <property name="button-icon"       type="string" value="lexos"/>
      <property name="show-button-title" type="bool"   value="false"/>
      <property name="show-button-icon"  type="bool"   value="true"/>
      <property name="show-app-icons"    type="bool"   value="true"/>
      <property name="load-hierarchy"    type="bool"   value="false"/>
      <!-- Grille d'icônes façon démo (APPS / renderApps()), recherche en avant. -->
      <property name="view-mode"         type="int"    value="1"/>
      <property name="category-icon-size" type="int"   value="1"/>
      <property name="item-icon-size"    type="int"    value="2"/>
      <property name="menu-width"        type="int"    value="500"/>
      <property name="menu-height"       type="int"    value="560"/>
      <property name="position-search-alternate" type="bool" value="true"/>
      <property name="position-commands-alternate" type="bool" value="true"/>
      <property name="position-categories-horizontal" type="bool" value="false"/>
      <property name="favorites" type="array">
        <value type="string" value="firefox-esr.desktop"/>
        <value type="string" value="xfce4-terminal.desktop"/>
        <value type="string" value="thunar.desktop"/>
        <value type="string" value="org.xfce.mousepad.desktop"/>
        <value type="string" value="lexos-github.desktop"/>
        <value type="string" value="lexos-about.desktop"/>
      </property>
    </property>

    <!-- 9-11 · Capture rapide (#quickcap de la démo), à côté du bouton Applications -->
    <property name="plugin-9" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="lexos-capture-photo.desktop"/>
      </property>
    </property>
    <property name="plugin-10" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="lexos-capture-zone.desktop"/>
      </property>
    </property>
    <property name="plugin-11" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="lexos-capture-video.desktop"/>
      </property>
    </property>

    <!-- 2 · Espace élastique -->
    <!-- 13 · Météo — « ☁ 20° », comme la démo.
         genmon se contente de LANCER une commande et d'afficher sa sortie :
         le texte, l'infobulle et l'action du clic sont décidés par
         lexos-meteo lui-même (balises <txt>, <tool>, <click>). Changer de
         ville ne touche donc jamais à la configuration du panneau.
         La mise en cache est DANS le script : même si le panneau
         interrogeait toutes les secondes, le réseau n'est sollicité qu'un
         quart d'heure au plus. -->
    <!-- 14 · LES PASTILLES DE BUREAUX, à côté du logo — comme dans la démo.
         C'était un manque relevé à l'audit : les quatre bureaux existaient,
         mais RIEN à l'écran ne disait sur lequel on se trouvait ni s'il y
         avait des fenêtres ailleurs. Il fallait ouvrir les Paramètres pour
         le savoir, ce qui est exactement l'inverse d'un indicateur.
         « miniature-view » à false : des carrés numérotés, lisibles d'un
         coup d'oeil, plutôt que des vignettes minuscules illisibles à cette
         taille. Une seule rangée : la barre est horizontale. -->
    <property name="plugin-14" type="string" value="pager">
      <property name="workspace-scrolling" type="bool" value="true"/>
      <property name="miniature-view"      type="bool" value="false"/>
      <property name="rows"                type="uint" value="1"/>
      <property name="numbering"           type="bool" value="true"/>
    </property>

    <!-- 15 · LE CENTRE DE NOTIFICATIONS — la cloche et son compteur.
         Autre manque de l'audit : rien ne signalait passivement qu'une
         notification était passée. Une notification manquée était perdue
         pour de bon. Ce greffon (fourni par xfce4-notifyd) garde le journal,
         affiche un point quand il y a du non-lu, et donne « Tout effacer ». -->
    <property name="plugin-15" type="string" value="notification-plugin"/>

    <property name="plugin-13" type="string" value="genmon">
      <property name="command"       type="string" value="lexos-meteo --panneau"/>
      <property name="update-period" type="int"    value="900000"/>
      <property name="use-label"     type="bool"   value="false"/>
      <property name="font"          type="string" value="Noto Sans 10"/>
    </property>

    <!-- 16 · LES APPAREILS BRANCHÉS — la rangée d'icônes de la démo (haut
         droite) : imprimante, écran externe, casque, clé USB, disque dur.
         Même mécanique que la météo : genmon lance lexos-peripheriques, qui
         décide de tout. Rien de branché = sortie vide = aucune place prise.
         Cinq secondes entre deux lectures : trois petites commandes locales
         (lpstat, xrandr, pactl, lsblk), aucun réseau — brancher une clé se
         voit presque tout de suite sans coûter quoi que ce soit. -->
    <property name="plugin-16" type="string" value="genmon">
      <property name="command"       type="string" value="lexos-peripheriques --panneau"/>
      <property name="update-period" type="int"    value="5000"/>
      <property name="use-label"     type="bool"   value="false"/>
      <property name="font"          type="string" value="Noto Sans 10"/>
    </property>

    <property name="plugin-2" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style"  type="uint" value="0"/>
    </property>

    <!-- 3 · Horloge centrale -->
    <property name="plugin-3" type="string" value="clock">
      <property name="mode"         type="uint"   value="2"/>
      <property name="digital-format" type="string" value="lexOS  %a %d %b  %H h %M"/>
      <property name="digital-time-format" type="string" value="lexOS  %a %d %b  %H h %M"/>
      <property name="tooltip-format" type="string" value="%A %d %B %Y"/>
    </property>

    <!-- 4 · Espace élastique -->
    <property name="plugin-4" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style"  type="uint" value="0"/>
    </property>

    <!-- 5 · Zone de notification -->
    <property name="plugin-5" type="string" value="systray">
      <property name="square-icons"  type="bool" value="true"/>
      <property name="symbolic-icons" type="bool" value="true"/>
    </property>

    <!-- 6 · Son -->
    <property name="plugin-6" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
      <property name="show-notifications"        type="bool" value="true"/>
    </property>

    <!-- 7 · Batterie / énergie -->
    <property name="plugin-7" type="string" value="power-manager-plugin"/>

    <!-- 12 · Réglages rapides (#qsBtn de la démo) -->
    <property name="plugin-12" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="lexos-settings.desktop"/>
      </property>
    </property>

    <!-- 8 · Session (verrouiller, éteindre) -->
    <property name="plugin-8" type="string" value="actions">
      <property name="appearance" type="int" value="0"/>
      <property name="items" type="array">
        <value type="string" value="+lock-screen"/>
        <value type="string" value="+switch-user"/>
        <value type="string" value="+separator"/>
        <value type="string" value="+suspend"/>
        <value type="string" value="+restart"/>
        <value type="string" value="+shutdown"/>
        <value type="string" value="+separator"/>
        <value type="string" value="+logout"/>
      </property>
    </property>

  </property>
</channel>

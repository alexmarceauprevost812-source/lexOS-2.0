<?xml version="1.0" encoding="UTF-8"?>
<!--
  LexOS — les notifications.

  Ce fichier n'existait pas : xfce4-notifyd tournait sur ses réglages d'usine,
  c'est-à-dire une bulle grise carrée dans le coin haut-droit. Alex a demandé
  la forme de son image — une carte sombre aux coins ronds. L'arrondi lui-même
  vient de ~/.config/gtk-3.0/gtk.css (#XfceNotifyWindow) ; ici on règle ce qui
  ne peut PAS se décider en CSS : où elles apparaissent, combien de temps elles
  restent, et ce qui se passe quand l'écran est occupé.
-->
<channel name="xfce4-notifyd" version="1.0">
  <!--  « Default » suit le thème GTK du bureau, donc notre feuille CSS.
        Un thème nommé (Bright, Smoke…) apporterait ses propres couleurs et
        écraserait l'arrondi qu'on vient de poser. -->
  <property name="theme" type="string" value="Default"/>

  <!--  4 = EN HAUT AU CENTRE, juste sous l'horloge. Demande d'Alex
        (2026-10-19) : « un espace pour les notifications au centre de
        l'écran, en haut ». C'est aussi là que se clique l'heure pour relire
        les notifications passées (lexos-volet agenda) : elles apparaissent
        et se retrouvent au même endroit.

        ⚠ L'ANCIENNE VALEUR ÉTAIT FAUSSE, ET LE COMMENTAIRE MENTAIT.
        Ce fichier disait « 1 = haut-droit ». Dans les sources de
        xfce4-notifyd (common/xfce-notify-common.h, XfceNotifyPosition) :
          0 haut-gauche · 1 BAS-GAUCHE · 2 haut-droit · 3 bas-droit
          4 haut-centre · 5 bas-centre
        Les bulles sortaient donc en bas à gauche — la capture d'écran
        d'Alex le montre (« Capture d'écran » posée en bas à gauche).

        Les versions récentes rangent ce réglage sous forme de texte
        (« top-center ») ; un entier comme celui-ci est converti tout seul
        au démarrage du démon (xfce_notify_migrate_enum_setting). -->
  <property name="notify-location" type="uint" value="4"/>

  <!--  Huit secondes. Assez pour lire deux lignes sans se presser, assez peu
        pour ne pas rester en travers d'un film. -->
  <property name="expire-timeout" type="int" value="8"/>

  <property name="initial-opacity" type="double" value="0.95"/>

  <!--  Les notifications passées restent consultables : sans ça, celle qu'on
        rate pendant qu'on est parti chercher un café est perdue pour de bon. -->
  <property name="notification-log" type="bool" value="true"/>
  <property name="log-level" type="uint" value="0"/>
  <property name="log-level-apps" type="uint" value="0"/>

  <!--  Silence automatique en plein écran : pendant un film ou un jeu, une
        bulle qui s'ouvre par-dessus est une nuisance, pas un service. Elles
        sont gardées au journal et se retrouvent en sortant. -->
  <property name="do-not-disturb" type="bool" value="false"/>
  <property name="suppress-duplicates" type="bool" value="true"/>
</channel>

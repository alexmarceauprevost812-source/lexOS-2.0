<?xml version="1.0" encoding="UTF-8"?>
<!--
  LexOS — gestionnaire de fenêtres.
  Compositing actif : c'est lui qui donne les fondus fluides quand Compiz
  n'est pas disponible (machine sans accélération 3D).
-->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme"                     type="string" value="Yaru-dark"/>
    <!--  CE COMMENTAIRE DISAIT LE CONTRAIRE DE CE QU'ON A MESURÉ, ET IL
          AURAIT COÛTÉ UNE ISO DE PLUS. Il affirmait que passer la police de
          10 à 13 suffisait à grossir les boutons, « inutile de fabriquer un
          thème à nous ». L'ISO 70 a montré l'inverse à l'écran : la barre a
          grandi, LES BOUTONS SONT RESTÉS À 28 px. Le thème xfwm4 d'Arc est
          fait d'images de taille fixe, et xfwm4 n'a aucun réglage de taille
          de bouton — la taille du bouton EST celle de son image. C'est
          justement pour ça que le hook 0610 existe et fabrique un thème
          dérivé. Laisser ici la thèse démentie, c'était s'exposer à supprimer
          le hook un jour en croyant faire du ménage.
          Cette police reste utile pour ce qu'elle fait VRAIMENT : la hauteur
          de la barre et la lisibilité du titre. -->
    <property name="title_font"                type="string" value="Noto Sans Bold 13"/>
    <!--  À GAUCHE, COMME LA DÉMO. Dans web-demo/index.html, « .tbar » pose
          l'icône puis « .ttitle{flex:1} » : le titre commence juste après
          l'icône, il n'est pas centré. Sur l'ISO 73 il l'était, et c'est la
          première différence qu'on voit en posant les deux fenêtres côte à
          côte. Alex : « faire la page des fichiers pareille comme la 2e
          image ». -->
    <property name="title_alignment"           type="string" value="left"/>
    <!--  ALEX : « ajouter un bouton jaune pour réduire les fenêtres, à droite
          de l'écran ». Il n'y en avait AUCUN : « |OMC » ne porte que le menu,
          l'agrandissement et la fermeture, et sans le « H » (hide) aucune
          fenêtre ne pouvait être réduite à la souris.

          ALEX, PRÉCISION : « on pourrait garder en haut à droite : bouton
          rouge pour fermer, bouton jaune pour réduire, bouton gris pour
          mettre la page de côté. » TROIS boutons — le « O » du menu est
          donc retiré : il n'était d'ailleurs pas visible sur ses photos,
          Arc livrant une icône de menu vide.

          L'ORDRE EST CELUI QUE TOUT LE MONDE CONNAÎT : réduire, agrandir,
          fermer — la fermeture au bout, la plus loin du doigt qui vise
          « réduire ». Tout ce qui suit la barre verticale est aligné à
          DROITE, ce qu'Alex demande.

          Le crochet 0610 redessine le bouton « réduire » en disque jaune,
          dans le langage du thème : rouge pour fermer, jaune pour réduire. -->
    <property name="button_layout"             type="string" value="|HMC"/>
    <property name="use_compositing"           type="bool"   value="true"/>
    <property name="frame_opacity"             type="int"    value="100"/>
    <property name="inactive_opacity"          type="int"    value="100"/>
    <property name="move_opacity"              type="int"    value="90"/>
    <property name="resize_opacity"            type="int"    value="90"/>
    <property name="popup_opacity"             type="int"    value="100"/>
    <property name="show_frame_shadow"         type="bool"   value="true"/>
    <property name="show_popup_shadow"         type="bool"   value="true"/>
    <property name="show_dock_shadow"          type="bool"   value="true"/>
    <property name="zoom_desktop"              type="bool"   value="true"/>
    <property name="box_move"                  type="bool"   value="false"/>
    <property name="box_resize"                type="bool"   value="false"/>
    <!--  ÉCRIT EXPLICITEMENT, PAS LAISSÉ AU DÉFAUT : Alt + glisser déplace
          une fenêtre depuis N'IMPORTE QUEL point d'elle — y compris quand sa
          barre de titre est passée au-dessus de l'écran, le cas exact du
          gros texte sur un petit écran. Un défaut de xfwm4 peut changer
          d'une version à l'autre ; celui-ci est trop important pour en
          dépendre. Compromis connu : Alt+glisser gêne quelques applications
          (éditeurs graphiques, machines virtuelles) — c'est le compromis
          habituel de XFCE, accepté partout. -->
    <property name="easy_click"                type="string" value="Alt"/>
    <property name="snap_to_border"            type="bool"   value="true"/>
    <property name="snap_to_windows"           type="bool"   value="true"/>
    <property name="snap_width"                type="int"    value="12"/>
    <property name="wrap_workspaces"           type="bool"   value="false"/>
    <property name="tile_on_move"              type="bool"   value="true"/>
    <property name="borderless_maximize"       type="bool"   value="true"/>
    <property name="click_to_focus"            type="bool"   value="true"/>
    <property name="focus_new"                 type="bool"   value="true"/>
    <property name="raise_on_click"            type="bool"   value="true"/>
    <property name="cycle_draw_frame"          type="bool"   value="true"/>
    <property name="cycle_preview"             type="bool"   value="true"/>
    <property name="workspace_count"           type="int"    value="4"/>

    <!-- LA ROULETTE NE CHANGE DE BUREAU QU'EN HAUT À GAUCHE, SUR LES POINTS.
         Demande d'Alex, après essai sur sa machine : la molette au milieu du
         bureau changeait d'espace de travail — on pose la souris pour lire,
         on effleure la roulette, et tout l'écran se remplace. Un geste
         anodin ne doit pas déplacer le décor entier.

         Ce réglage coupe la molette DE XFWM SUR LE BUREAU. Le sélecteur à
         quatre points, lui, garde sa propre molette (workspace-scrolling
         dans xfce4-panel.xml) : pour changer de page, on VISE les points —
         clic ou roulette dessus, au choix. Le geste devient volontaire. -->
    <property name="scroll_workspaces"         type="bool"   value="false"/>

    <!-- LES QUATRE PETITS POINTS, ET POURQUOI C'EST ICI.
         La barre affichait « 1 - Espace de travail 1 », « 2 - Espace de
         travail 2 »… : quatre pavés de texte qui mangeaient le tiers de la
         barre pour redire quatre fois le même mot. Alex l'a vu sur sa
         première ISO et il avait raison.

         Le sélecteur d'espaces de XFCE n'a pas de mode « points » : il
         affiche le NOM de chaque espace. On lui donne donc un nom qui EST
         un point. Le point actif se distingue par l'état du bouton, que la
         feuille gtk.css peint en couleur d'accent — d'où la « bulle » qui
         change quand on change d'espace.

         Le nom reste modifiable dans Paramètres → Espaces de travail pour
         qui veut les rebaptiser. -->
    <property name="workspace_names" type="array">
      <value type="string" value="●"/>
      <value type="string" value="●"/>
      <value type="string" value="●"/>
      <value type="string" value="●"/>
    </property>
  </property>
</channel>

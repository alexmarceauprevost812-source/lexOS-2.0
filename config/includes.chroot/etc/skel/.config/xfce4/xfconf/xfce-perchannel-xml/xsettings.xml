<?xml version="1.0" encoding="UTF-8"?>
<!-- LexOS — réglages généraux d'apparence -->
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName"        type="string" value="Yaru-dark"/>
    <!-- « LexOS » ne contient QUE les dossiers et hérite de Papirus-Dark
         pour tout le reste (voir /usr/share/icons/LexOS/index.theme). On ne
         perd donc aucune icône : on remplace les six poches du dossier
         personnel par celles de la démo, et rien d'autre. -->
    <property name="IconThemeName"    type="string" value="LexOS"/>
    <property name="DoubleClickTime"  type="int"    value="400"/>
    <property name="CursorBlink"      type="bool"   value="true"/>
    <property name="EnableEventSounds" type="bool"  value="false"/>
  </property>
  <property name="Xft" type="empty">
    <property name="DPI"       type="int"    value="-1"/>
    <property name="Antialias" type="int"    value="1"/>
    <property name="Hinting"   type="int"    value="1"/>
    <property name="HintStyle" type="string" value="hintslight"/>
    <property name="RGBA"      type="string" value="rgb"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName"           type="string" value="Noto Sans 10"/>
    <property name="MonospaceFontName"  type="string" value="Fira Code 10"/>
    <property name="CursorThemeName"    type="string" value="Adwaita"/>
    <property name="CursorThemeSize"    type="int"    value="24"/>
    <property name="DecorationLayout"   type="string" value="icon:minimize,maximize,close"/>
    <property name="ButtonImages"       type="bool"   value="true"/>
    <property name="MenuImages"         type="bool"   value="true"/>
    <!-- LA TAILLE DES ICÔNES DU SÉLECTEUR DE FICHIERS, ET C'EST LA SEULE
         MANIÈRE. GtkFileChooserWidget lit GTK_ICON_SIZE_MENU dans
         change_icon_theme() — la liste de « Ouvrir les fichiers » n'a pas
         de taille à elle. 24 px au lieu des 16 par défaut : un dossier se
         distingue d'un fichier sans se pencher sur l'écran.
         AUCUN CSS NE PEUT LE FAIRE : « -gtk-icon-size » n'existe qu'en
         GTK 4. Ne pas retenter dans lexos-theme-gen ni dans
         prive-theme/gtk-3.0/gtk.css, c'est mesuré.
         LA MÊME VALEUR EST ÉCRITE DANS /etc/gtk-3.0/settings.ini par le
         hook 0600, et les deux doivent rester d'accord : xfsettingsd
         écrase settings.ini une fois la session ouverte, mais settings.ini
         sert AVANT — notamment dans l'installateur. Un banc les compare.
         CONSÉQUENCE ASSUMÉE : les icônes des MENUS grossissent aussi
         (MenuImages=true, juste au-dessus). C'est le même jeton GTK ;
         on ne peut pas séparer les deux. -->
    <property name="IconSizes"          type="string" value="gtk-menu=24,24"/>
    <property name="ApplicationPreferDarkTheme" type="bool" value="true"/>
  </property>
</channel>

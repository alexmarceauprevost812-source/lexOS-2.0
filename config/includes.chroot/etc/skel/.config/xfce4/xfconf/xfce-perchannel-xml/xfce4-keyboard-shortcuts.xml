<?xml version="1.0" encoding="UTF-8"?>
<!--
  LexOS — raccourcis clavier. LE FICHIER UNIQUE.

  CE QUI S'EST PASSÉ, ET QUI NE DOIT PLUS SE REPRODUIRE.
  Il y avait DEUX jeux de raccourcis : celui-ci, livré tel quel, et un autre
  écrit par le hook 0400 au moment de la construction — qui faisait
  « cat > » sur ce même chemin et l'écrasait ENTIÈREMENT. Le jeu qui
  arrivait dans l'ISO était donc le second, et il ne gardait AUCUN des
  raccourcis de capture : Maj+Impr écr, Alt+Impr écr, Ctrl+Maj+R et les
  accords Super+chiffre ne faisaient rien. Pendant ce temps l'aide de « lexos »
  continuait de les annoncer à l'utilisateur : le système mentait sur son
  propre mode d'emploi.

  Les deux jeux sont maintenant FUSIONNÉS ICI, et le hook 0400 ne réécrit
  plus ce fichier — il se contente de vérifier qu'il est bien arrivé.

  DEUX CONFLITS TRANCHÉS EN FUSIONNANT :
   · Super+1/2/3 servaient aux captures. Ils vont désormais aux BUREAUX
     VIRTUELS, parce que c'est ce que promet la démo et ce qu'affichent les
     Paramètres (« Super+1 à Super+N »). Les captures passent à
     Super+Maj+chiffre — même geste, un doigt de plus.
   · Super+a lançait la logithèque ici et le mode avion là. Le mode avion
     garde le « a » (avion), la logithèque prend « l ».

  Les captures passent toutes par « lexos capture » plutôt que d'appeler
  xfce4-screenshooter en direct : c'est lui qui range les fichiers dans
  ~/Images/Captures avec un nom horodaté, sans écraser la capture d'avant.
-->
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="default" type="empty"/>
    <property name="custom" type="empty">
      <property name="override" type="bool" value="true"/>

      <!-- Captures d'écran -->
      <property name="Print"                type="string" value="lexos capture"/>
      <property name="&lt;Alt&gt;Print"     type="string" value="lexos capture fenetre"/>
      <property name="&lt;Shift&gt;Print"   type="string" value="lexos capture zone"/>
      <!-- Ctrl+Maj+R lance la vidéo DANS un terminal : c'est cette fenêtre
           qui porte le Ctrl+C qui arrête l'enregistrement. -->
      <property name="&lt;Primary&gt;&lt;Shift&gt;r" type="string"
                value="xfce4-terminal --title=Enregistrement --hold -e &quot;lexos capture video&quot;"/>
      <!-- La démo propose l'accord « Espace maintenue + chiffre » ; xfconf ne
           sait décrire qu'un raccourci à modificateurs, pas une touche
           maintenue. Super+Maj+chiffre garde le geste et l'ordre. -->
      <property name="&lt;Super&gt;&lt;Shift&gt;1" type="string" value="lexos capture"/>
      <property name="&lt;Super&gt;&lt;Shift&gt;2" type="string" value="lexos capture zone"/>
      <property name="&lt;Super&gt;&lt;Shift&gt;3" type="string"
                value="xfce4-terminal --title=Enregistrement --hold -e &quot;lexos capture video&quot;"/>

      <!-- Lancer -->
      <!-- ALEX : « c'est le new terminal officiel de LexOS Pro, pour le
           terminal normal je veux que ce soit lui qui le remplace. » Le
           Terminal classique (xfce4-terminal) reste installe et atteignable
           via lexos-pro-terminal, argument classique, ou l'action
           secondaire du dock, pour vim/nano/htop et tout ce qui a besoin
           d'un vrai pty. -->
      <property name="&lt;Super&gt;Return"  type="string" value="lexos-pro-terminal"/>
      <property name="&lt;Super&gt;t"       type="string" value="lexos-pro-terminal"/>
      <property name="&lt;Super&gt;e"       type="string" value="thunar"/>
      <property name="&lt;Super&gt;s"       type="string" value="xfce4-appfinder"/>
      <property name="&lt;Super&gt;l"       type="string" value="lexos logitheque"/>

      <!-- LES RÉGLAGES DE LA FENÊTRE ACTIVE — PAS CEUX DE L'ORDINATEUR.
           Un thème de barre de titre ne sait lancer AUCUNE commande à nous
           au clic (xfwm4 et Compiz n'ont que des actions fixes : fermer,
           réduire, agrandir, le menu système) — la pastille verte ne peut
           donc pas appeler ceci directement. Le raccourci est la seule
           porte réelle : lexos-app-settings lit la fenêtre au premier plan
           (xdotool, EWMH — marche pareil sous les deux gestionnaires) et
           ouvre SES préférences à elle (Firefox, Thunar, le terminal…),
           avec un repli sur les Paramètres LexOS pour tout le reste. -->
      <property name="&lt;Super&gt;comma"  type="string" value="lexos reglages-fenetre"/>

      <!-- LA VUE D'ENSEMBLE. Deux entrées pour une seule chose :
           · F13 n'existe sur aucun clavier — c'est exprès. xcape l'émet
             quand on relâche Super SANS avoir rien tapé d'autre, ce qui
             donne le « Super seule » d'Ubuntu sans voler Super+1 ;
           · Super+Tab reste utilisable au clavier même si xcape manque. -->
      <property name="F13"                  type="string" value="lexos apercu"/>
      <property name="&lt;Super&gt;Tab"     type="string" value="lexos apercu"/>

      <!-- Réglages rapides -->
      <property name="&lt;Super&gt;a"       type="string" value="lexos-net avion toggle"/>
      <property name="&lt;Super&gt;p"       type="string" value="lexos-perf --gui"/>
      <property name="&lt;Super&gt;d"       type="string" value="lexos-display gui"/>
      <property name="XF86Display"          type="string" value="lexos-display gui"/>
      <property name="XF86WLAN"             type="string" value="lexos-net avion toggle"/>

      <!-- LA LOUPE. C'est ce qu'Alex a choisi quand on lui a demandé ce que
           voulait dire « la fenêtre reste à sa place, juste le reste zoome » :
           la loupe, pas les fenêtres bornées.

           Tout le travail de fond était déjà fait — « lexos access loupe on »
           essaie magnus, puis kmag, refuse proprement sous Wayland, et ferme
           tout au « off ». Le paquet voyage dans l'ISO (56-reglages.list).
           Il manquait seulement le moyen de l'ATTEINDRE : il fallait ouvrir
           un terminal et taper la commande. Pour une fonction d'accessibilité
           c'est à l'envers — celui qui a besoin d'une loupe pour lire l'écran
           est exactement celui qui n'arrivera pas à lire un terminal.

           DEUX TOUCHES POUR LA MÊME CHOSE, ET CE N'EST PAS UN OUBLI. Alex est
           sur un clavier québécois : le « + » n'y est pas une touche, c'est
           Maj+=. Un raccourci lié au seul symbole « plus » peut donc ne
           jamais se déclencher — livré, lu par XFCE, et sans effet. On lie
           les deux formes plutôt que de parier sur une seule. « equal » est
           la touche physique, « plus » le symbole : selon la disposition,
           c'est l'une ou l'autre qui arrive.

           À VÉRIFIER SUR LA MACHINE : laquelle des deux répond réellement
           sous une disposition québécoise. Les deux sont posées pour que ça
           marche dans tous les cas, pas parce qu'on sait laquelle sert. -->
      <property name="&lt;Super&gt;plus"    type="string" value="lexos access loupe on"/>
      <property name="&lt;Super&gt;equal"   type="string" value="lexos access loupe on"/>
      <property name="&lt;Super&gt;minus"   type="string" value="lexos access loupe off"/>
    </property>
  </property>

  <!-- Fenêtres et bureaux. PAS de « override » ici, volontairement : il
       remplacerait TOUS les raccourcis par défaut de XFCE (Alt+Tab, Alt+F4,
       Ctrl+Alt+flèches…) au lieu de s'y ajouter. -->
  <property name="xfwm4" type="empty">
    <property name="custom" type="empty">
      <property name="&lt;Super&gt;Up"    type="string" value="maximize_window_key"/>
      <property name="&lt;Super&gt;Down"  type="string" value="unmaximize_window_key"/>
      <property name="&lt;Super&gt;Left"  type="string" value="tile_left_key"/>
      <property name="&lt;Super&gt;Right" type="string" value="tile_right_key"/>

      <!-- PARTAGER L'ÉCRAN À PLUSIEURS, ET CHOISIR LA PLACE.
           Demandé par Alex : « quand on a plusieurs partagés, on soit capable
           de le positionner à la place qu'on veut ». On n'avait que les deux
           moitiés gauche/droite — impossible de mettre quatre fenêtres, ni
           d'en poser une en haut.

           Les huit actions ci-dessous sont celles que xfwm4 porte VRAIMENT :
           relevées dans son binaire (strings xfwm4 | grep tile_.*_key), pas
           devinées. Une action mal nommée ne dit rien et ne fait rien — le
           genre de silence qu'on passe nos journées à fermer.

           LE CHOIX DES TOUCHES, ET POURQUOI IL SE RETIENT. Début, Fin, Page
           haut et Page bas forment un carré de 2×2 sur le clavier, à la même
           place que les quatre coins de l'écran :

                 Début      Page↑              haut-gauche   haut-droit
                 Fin        Page↓              bas-gauche    bas-droit

           Le geste est donc le dessin de ce qu'on veut. Aucune autre paire de
           touches ne donne ça, et surtout pas quatre flèches qui n'ont que
           quatre directions pour huit positions.

           Super+Ctrl+Haut/Bas complètent les moitiés : Super+Haut est déjà
           « plein écran » et on ne le lui reprend pas. -->
      <property name="&lt;Super&gt;Home"      type="string" value="tile_up_left_key"/>
      <property name="&lt;Super&gt;Page_Up"   type="string" value="tile_up_right_key"/>
      <property name="&lt;Super&gt;End"       type="string" value="tile_down_left_key"/>
      <property name="&lt;Super&gt;Page_Down" type="string" value="tile_down_right_key"/>
      <property name="&lt;Super&gt;&lt;Primary&gt;Up"   type="string" value="tile_up_key"/>
      <property name="&lt;Super&gt;&lt;Primary&gt;Down" type="string" value="tile_down_key"/>
      <property name="F11"                type="string" value="fullscreen_key"/>
      <!--  LA PORTE DE SORTIE. Une fenêtre plus haute que l'écran — un
            dialogue sous gros texte, par exemple — n'a AUCUN moyen d'être
            rattrapée sans ces deux touches : ses boutons sont sous le bord,
            et sa barre de titre peut l'être aussi. Alt+F7 puis les flèches
            déplacent, Entrée valide ; Alt+F8 redimensionne. Ce sont les
            valeurs traditionnelles de XFCE — quelqu'un qui vient d'ailleurs
            les connaît déjà. -->
      <property name="&lt;Alt&gt;F7"      type="string" value="move_window_key"/>
      <property name="&lt;Alt&gt;F8"      type="string" value="resize_window_key"/>

      <!-- LES BUREAUX, ENFIN BRANCHÉS. Les Paramètres promettaient
           « Super+1 à Super+N » alors que rien n'y répondait. -->
      <property name="&lt;Super&gt;1" type="string" value="workspace_1_key"/>
      <property name="&lt;Super&gt;2" type="string" value="workspace_2_key"/>
      <property name="&lt;Super&gt;3" type="string" value="workspace_3_key"/>
      <property name="&lt;Super&gt;4" type="string" value="workspace_4_key"/>
      <property name="&lt;Super&gt;5" type="string" value="workspace_5_key"/>
    </property>
  </property>
</channel>

#!/bin/sh
# =============================================================================
#  lexos-live-sudo-guard — retire le sudo sans mot de passe hors session démo
# =============================================================================
#  La session démo donne à « lex » un sudo sans mot de passe : c'est voulu, il
#  n'y a rien à protéger sur une clé USB en lecture seule, et l'installateur
#  en a besoin.
#
#  Le problème : Calamares copie le système de fichiers tel quel sur le disque,
#  /etc/sudoers.d/lexos-live compris. Sur la machine installée, ce fichier
#  reste — et si l'utilisateur nomme son compte « lex » (le nom qu'il a sous
#  les yeux depuis le début de la démo), il hérite en silence d'un sudo sans
#  mot de passe qu'il n'a jamais demandé.
#
#  Ce garde-fou tourne à chaque démarrage : hors session live, il efface le
#  fichier. Il ne dépend d'aucun réglage de Calamares — même une installation
#  faite autrement (copie manuelle, clonage de disque) est rattrapée.
# =============================================================================
set -e

SUDOERS=/etc/sudoers.d/lexos-live

# En session démo (boot=live dans la ligne de commande du noyau) : on garde.
if grep -qa 'boot=live' /proc/cmdline 2>/dev/null; then
	exit 0
fi

# Partout ailleurs — donc sur un système installé : on retire.
if [ -e "$SUDOERS" ]; then
	rm -f "$SUDOERS"
	echo "[lexos] sudo sans mot de passe retiré (système installé, pas une démo)"
fi

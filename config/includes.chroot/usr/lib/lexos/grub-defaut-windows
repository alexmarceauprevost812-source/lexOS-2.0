#!/bin/sh
#  ALIAS DE COMPATIBILITÉ — ce script s'appelle maintenant grub-defaut-voisin.
#  Il ne cherchait que Windows ; il sait maintenant poser un voisin Linux
#  aussi (« lexos dualboot defaut voisin »). Une machine installée AVANT ce
#  changement garde une unité lexos-grub-defaut.service qui pointe encore
#  ici : on la fait suivre au lieu de la casser.
exec /usr/lib/lexos/grub-defaut-voisin "$@"

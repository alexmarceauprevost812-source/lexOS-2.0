<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>LexOS</vendor>
  <vendor_url>https://github.com/alexmarceauprevost812-source/lexOS-2.0</vendor_url>

  <!--
    UNE ACTION PAR VERBE de lexos-pilotes-maj. pkexec choisit l'action dont
    exec.path ET exec.argv1 correspondent (pkexec.c:272-330, polkit 126).

    « verifier » ne fait qu'apt-get update : le mot de passe est gardé
    quelques minutes (auth_admin_keep), comme les autres actions LexOS.

    « installer » écrit sur le système : le mot de passe est redemandé À
    CHAQUE FOIS (auth_admin). Avec une seule action en auth_admin_keep, un
    mot de passe tapé pour « Vérifier » autorisait pendant 5 minutes une
    installation sans aucune fenêtre ; la page annonçait pourtant « Une
    fenêtre va demander ton mot de passe ». La fenêtre est la seule
    confirmation de l'installation : elle ne doit pas pouvoir sauter.
  -->
  <action id="org.lexos.pilotes.verifier">
    <description>Rechercher les nouvelles versions des pilotes graphiques</description>
    <description xml:lang="en">Check for new graphics driver versions</description>
    <message>LexOS Pilotes doit rafraîchir la liste des paquets (apt-get update). Rien n'est installé.</message>
    <message xml:lang="en">LexOS Pilotes needs to refresh the package lists (apt-get update). Nothing is installed.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/lexos-pilotes-maj</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">verifier</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.lexos.pilotes.installer">
    <description>Mettre à jour les pilotes de la carte graphique</description>
    <description xml:lang="en">Update graphics card drivers</description>
    <message>LexOS Pilotes doit installer les nouvelles versions du pilote graphique, de Mesa et des micrologiciels. Aucun paquet n'est retiré : une mise à jour qui en retirerait un est refusée.</message>
    <message xml:lang="en">LexOS Pilotes needs to install new graphics driver, Mesa and firmware versions. No package is removed: an update that would remove one is refused.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/lexos-pilotes-maj</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">installer</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>

# =============================================================================
#  Paramètres LexOS — la fenêtre Qt, ET les outils derrière chaque section
# =============================================================================
#  La fenêtre des Paramètres affiche 32 sections, comme la démo web. Mais une
#  section sans logiciel derrière est un décor : le bouton s'affiche et rien
#  ne répond. L'inventaire démo-contre-ISO (collé par Alex, recoupé avec nos
#  listes réelles) a montré des sections à moitié meublées. Cette liste donne
#  à CHAQUE section ses outils. Best effort comme le reste : un paquet
#  disparu de Debian n'arrête pas la construction, il est listé au rapport.

# --- La fenêtre elle-même (Qt) ----------------------------------------------
#  PySide6 vient des paquets Debian et non de pip, pour ne pas écraser des
#  fichiers gérés par dpkg. Redit dans 57-python.list, dédoublonné au hook.
python3-pyside6.qtwidgets
python3-pyside6.qtwebenginewidgets
python3-pyside6.qtcore
python3-pyside6.qtgui

# --- Écrans -----------------------------------------------------------------
#  ddcutil pilote la luminosité et le contraste des écrans EXTERNES par le
#  câble (DDC/CI) — sans lui, la section Écrans ne règle que la dalle interne.
ddcutil
i2c-tools

# --- Son --------------------------------------------------------------------
#  easyeffects : égaliseur et effets PipeWire ; helvum : brancher les flux.
easyeffects
helvum
pulseaudio-utils

# --- Énergie ----------------------------------------------------------------
powertop
upower
tlp-rdw

# --- Souris et pavé tactile -------------------------------------------------
libinput-tools
xinput
#  LES GESTES MULTITOUCHES N'ONT PLUS DE PAQUET DANS DEBIAN. touchegg est
#  absent de trixie (vérifié le 2026-08-22), et ses deux solutions de rechange
#  habituelles — libinput-gestures et fusuma — n'y sont pas non plus. La ligne
#  reste au cas où l'un d'eux revienne. En attendant, libinput-tools et xinput
#  ci-dessus donnent le réglage du pavé (défilement, clic à deux doigts,
#  vitesse) ; ce sont les gestes à trois et quatre doigts qui manquent.
touchegg

# --- Gestion des couleurs ---------------------------------------------------
colord
colord-data
gnome-color-manager
argyll

# --- Tablette graphique -----------------------------------------------------
xserver-xorg-input-wacom
libwacom-bin

# --- Accessibilité ----------------------------------------------------------
#  orca et onboard sont déjà dans 15-essentiel ; voici la voix (espeak-ng),
#  le pont applicatif (at-spi2) et les aides au pointeur.
espeak-ng
espeak-ng-data
#  SANS CECI, ORCA DÉMARRE MUET. Orca ne parle pas à espeak directement : il
#  passe par speech-dispatcher, et speech-dispatcher a besoin de son module
#  espeak-ng pour avoir une voix. Installer Orca sans ces deux-là donne un
#  lecteur d'écran qui se lance, s'annonce actif, et ne dit jamais un mot —
#  la panne la plus décourageante possible pour qui en a besoin.
speech-dispatcher
speech-dispatcher-espeak-ng
at-spi2-core
mousetweaks
#  LA LOUPE : xzoom N'EST PLUS DANS DEBIAN (vérifié sur l'index de trixie le
#  2026-08-22 — absent de main, contrib et non-free). Il a été remplacé ici par
#  magnus, une loupe GTK légère qui suit le pointeur, avec kmag en second choix
#  pour ceux qui ont déjà les bibliothèques KDE. Le repli compte : une section
#  d'accessibilité qui manque son outil est exactement la panne qu'on décrit
#  deux lignes plus haut comme la plus décourageante.
magnus|kmag

# --- Utilisateurs -----------------------------------------------------------
accountsservice

# --- Date et heure ----------------------------------------------------------
xfce4-datetime-plugin

# --- Applications par défaut ------------------------------------------------
exo-utils

# --- Recherche --------------------------------------------------------------
#  plocate est dans 15-essentiel ; catfish est la fenêtre de recherche.
catfish

# --- Multi-tâches -----------------------------------------------------------
#  wmctrl et xdotool : ce que lexos-wm utilise pour ranger les fenêtres.
wmctrl
xdotool

# --- Bureau à distance ------------------------------------------------------
#  remmina est dans 60-full ; voici ses greffons et le sens serveur.
remmina-plugin-rdp
remmina-plugin-vnc
remmina-plugin-spice
x11vnc
tigervnc-standalone-server

# --- Supports amovibles -----------------------------------------------------
xfburn

# --- Confidentialité et sécurité --------------------------------------------
#  Le trousseau : sans lui, chaque Wi-Fi et chaque site redemande son mot de
#  passe à la session suivante.
seahorse
gnome-keyring

# --- Région et langue -------------------------------------------------------
#  hunspell-fr est dans 60-full ; l'anglais et le sélecteur de méthode
#  d'entrée complètent.
hunspell-en-us
ibus
ibus-gtk3

# --- Imprimantes ------------------------------------------------------------
#  cups-browsed + avahi : les imprimantes réseau apparaissent toutes seules.
cups-browsed
avahi-daemon

# --- Apparence --------------------------------------------------------------
gnome-themes-extra

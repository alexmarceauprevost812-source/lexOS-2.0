# =============================================================================
#  Ce qu'un bureau complet a, et qui manquait
# =============================================================================
#  Liste établie en comparant LexOS à ce qu'Ubuntu livre par défaut. Rien
#  ici n'est du confort : ce sont des choses dont l'absence se remarque le
#  jour où on en a besoin, et qui sont alors pénibles à retrouver.
#
#  Deux noms diffèrent de ceux d'Ubuntu, et c'est volontaire :
#    · printer-driver-cups-pdf, et non « cups-pdf » — c'est le nom Debian ;
#    · plocate seul, sans mlocate : plocate le remplace et les deux
#      installés ensemble se disputent la même base d'index.
#  Deux autres ont été écartés :
#    · apt-transport-https est intégré à apt depuis des années, le paquet
#      n'est plus qu'une coquille de transition ;
#    · policykit-1-gnome est l'agent de GNOME ; sous XFCE c'est xfce-polkit
#      qui affiche les demandes de mot de passe.

# --- Micrologiciel ------------------------------------------------------
# fwupd met à jour le BIOS, les SSD et les périphériques depuis le bureau,
# sans clé USB de constructeur ni redémarrage sous Windows. C'est une des
# rares choses qu'on ne peut PAS rattraper à la main facilement.
fwupd

# --- Numériser et photographier -----------------------------------------
simple-scan
sane-utils
cheese

# --- Sauvegarde ----------------------------------------------------------
# Chiffrée, incrémentale, vers un disque externe ou un nuage. Timeshift
# (déjà présent) restaure le SYSTÈME ; deja-dup sauvegarde tes FICHIERS.
# Les deux ne font pas le même travail et ne se remplacent pas.
deja-dup

# --- Petits outils qu'on cherche le premier jour ------------------------
gnome-calculator
gnome-font-viewer
ncdu
inxi
smartmontools
plocate

# --- Archives ------------------------------------------------------------
unrar-free

# --- Lecture vidéo -------------------------------------------------------
# Sans ces codecs, une vidéo H.264 téléchargée ne s'ouvre pas — et le
# message d'erreur ne dit pas qu'il manque un paquet.
libavcodec-extra

# --- Accessibilité -------------------------------------------------------
# Un système sans lecteur d'écran n'est pas utilisable par une personne
# aveugle. Ce n'est pas une option de confort.
orca
onboard

# --- Énergie -------------------------------------------------------------
# Les applications modernes demandent le profil d'énergie par ce service ;
# sans lui, le sélecteur « économie / équilibré / performance » reste
# inerte dans les logiciels qui le proposent.
power-profiles-daemon

# --- Impression ----------------------------------------------------------
# « Imprimer vers PDF » depuis n'importe quelle application.
printer-driver-cups-pdf

# --- Rouages du bureau ---------------------------------------------------
# Sans shared-mime-info, le système ne sait plus quel fichier est quoi ;
# sans desktop-file-utils, les applications installées n'apparaissent pas
# dans le menu. Ils sont presque toujours tirés par une dépendance, mais
# les nommer garantit qu'ils sont là.
shared-mime-info
desktop-file-utils
# ═══ L'AGENT QUI AFFICHE LA FENÊTRE DU MOT DE PASSE ═══
# ALEX, sur son vieil ordinateur : « les boutons dans les paramètres ne
# fonctionnaient pas ».
#
# CE QUI ÉTAIT ÉCRIT ICI ÉTAIT FAUX. Ces lignes disaient : « L'agent qui
# affiche les demandes de mot de passe arrive par les Recommends de
# xfce4-session, et --apt-recommends est à true dans auto/config : il est
# donc déjà là. » Vérifié, et ça ne tient pas :
#
#     apt-cache show xfce4-session | grep ^Recommends:
#     → default-dbus-session-bus | dbus-session-bus,
#       default-logind | logind,
#       light-locker | xfce4-screensaver | xscreensaver |
#       gnome-screensaver | mate-screensaver,
#       systemd-sysv, upower, xfdesktop4, xfwm4
#
# Aucun agent d'authentification là-dedans. Pas un.
#
# polkitd, le démon, est bien installé (desktop.list.chroot) — mais le démon
# n'est PAS l'agent. « pkexec » ne dessine pas lui-même la fenêtre du mot de
# passe : il la demande à un agent qui doit tourner dans la session. Sans
# agent, pkexec échoue sans fenêtre, sans message, sans rien. Et les
# Paramètres passent par pkexec pour la luminosité et le fuseau horaire, une
# douzaine d'outils LexOS aussi en mode graphique. Sur une machine sans agent,
# tous ces boutons sont muets — exactement le symptôme décrit.
#
# ON EN NOMME TROIS, ET C'EST VOULU. Cette liste est « au mieux » : un nom
# absent de l'archive est consigné dans /etc/lexos/optional-report et ne fait
# pas échouer la construction. Nommer plusieurs candidats coûte donc une ligne
# de journal et garantit qu'il en reste un.
#
#   · policykit-1-gnome — LE bon pour XFCE, malgré son nom : son propre
#     fichier d'autostart porte « OnlyShowIn=XFCE;Unity;X-Cinnamon; ».
#     Relevé dans le paquet, pas supposé.
#   · lxpolkit — plus léger. Attention : son autostart Debian porte
#     « Hidden=true », il ne démarre donc JAMAIS de lui-même. C'est
#     /usr/lib/lexos/polkit-agent (autostart lexos-polkit-agent.desktop) qui
#     le lance.
#   · mate-polkit — ne livre aucun autostart du tout ; même remarque.
#
# « xfce-polkit » reste écarté : ce nom n'existe pas dans Debian (journal de
# la construction 8), et le paquet ne s'est jamais matérialisé depuis.
policykit-1-gnome
lxpolkit
mate-polkit
# Le sélecteur de fichiers des applications Flatpak, qui sinon n'en ont pas.
xdg-desktop-portal-gtk

# --- Administration ------------------------------------------------------
# Prévient quand un service tourne encore sur une bibliothèque mise à jour
# — sinon un correctif de sécurité peut rester sans effet jusqu'au
# prochain redémarrage, sans que personne le sache.
needrestart
# add-apt-repository, pour ajouter un dépôt proprement.
# software-properties-common RETIRÉ : absent de trixie (journal de la
# construction 8). Il fournissait add-apt-repository ; sans lui, on écrit
# le fichier .sources à la main dans /etc/apt/sources.list.d/, ce que fait
# déjà « lexos install chrome ».

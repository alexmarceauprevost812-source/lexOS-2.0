# Partage de fichiers et d'images vers un téléphone.
# qrencode est le plus important : c'est lui qui rend « lexos share » utilisable
# sans rien installer côté téléphone.
qrencode
kdeconnect
arp-scan

# scrcpy affiche ET contrôle l'écran d'un téléphone Android sur l'ordinateur
# (câble USB avec débogage activé, ou Wi-Fi via adb tcpip). Le paquet Debian
# tire android-tools-adb automatiquement — rien à ajouter à la main ici.
scrcpy

# android-tools-adb à part : « lexos usb terminal » (un shell SUR le
# téléphone) en a besoin même quand scrcpy n'est pas installé.
android-tools-adb

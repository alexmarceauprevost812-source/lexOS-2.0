#!/usr/bin/env bash
# =============================================================================
#  lexos-welcome — écran de bienvenue (première session) et « À propos »
# =============================================================================
set -uo pipefail

STAMP="${XDG_CONFIG_HOME:-$HOME/.config}/lexos/welcome-done"
BRAND="/usr/share/lexos/branding"
ABOUT_ONLY=0
FIRST_RUN=0

for arg in "$@"; do
	case "$arg" in
		--about)     ABOUT_ONLY=1 ;;
		--first-run) FIRST_RUN=1 ;;
	esac
done

# Au démarrage automatique : on ne montre rien si l'utilisateur a déjà répondu.
if (( FIRST_RUN )) && [[ -f "$STAMP" ]]; then
	exit 0
fi

# --- Informations système ----------------------------------------------------
NAME="LexOS"; VER="?"; CODE="?"; FLAV="?"; BUILD="?"; URL=""
if [[ -r /etc/os-release ]]; then
	# shellcheck disable=SC1091
	. /etc/os-release
	NAME="${NAME:-LexOS}"
	VER="${VERSION_ID:-?}"
	CODE="${VERSION_CODENAME:-?}"
	URL="${HOME_URL:-}"
	FLAV="${LEXOS_FLAVOUR:-?}"
	BUILD="${LEXOS_BUILD_DATE:-?}"
fi

LIVE=0
grep -qa 'boot=live' /proc/cmdline 2>/dev/null && LIVE=1

# --- Repli console -----------------------------------------------------------
tty_fallback() {
	printf '\n  %s %s (%s) — saveur %s, build %s\n' "$NAME" "$VER" "$CODE" "$FLAV" "$BUILD"
	printf '  %s\n\n' "$URL"
	printf '  lexos help    liste des commandes\n'
	printf '  lexfetch      infos système\n\n'
	if (( LIVE )); then
		printf '  Session live : « sudo calamares » pour installer sur le disque.\n\n'
	fi
}

if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
	tty_fallback
	exit 0
fi

# --- Texte du dialogue -------------------------------------------------------
if (( LIVE )); then
	INTRO="Tu es en <b>session live</b> : rien n'est écrit sur ton disque.\nEssaie le système, puis installe-le quand tu es prêt."
else
	INTRO="Bienvenue sur ton système.\nTout est configuré, il n'y a plus qu'à s'en servir."
fi

#  Sur un Mac, deux réglages ne se devinent pas — les ventilateurs que rien
#  ne pilote, la rangée F qui commande la luminosité. Autant le dire ici
#  plutôt que d'attendre que la machine chauffe. Sur tout autre matériel
#  cette ligne n'apparaît pas.
MAC_LIGNE=""
if command -v lexos-mac >/dev/null 2>&1; then
	case "$(lexos-mac classe 2>/dev/null)" in
		intel|t2|efi32) MAC_LIGNE="
  <tt>lexos mac</tt>        ce Mac : Wi-Fi, ventilateurs, touches F" ;;
	esac
fi

MARKUP="<span size='xx-large' weight='bold'>${NAME} ${VER}</span>  <span alpha='60%'>« ${CODE} »</span>

${INTRO}

<span alpha='70%'>saveur ${FLAV}  ·  build ${BUILD}</span>

<b>Pour commencer</b>
  <tt>lexos help</tt>       les commandes du système
  <tt>lexfetch</tt>          la fiche technique de ta machine
  <tt>lexos doctor</tt>   un diagnostic rapide
  <tt>lexos theme light</tt>  passer en thème clair${MAC_LIGNE}"

open_terminal() {
	for t in xfce4-terminal x-terminal-emulator gnome-terminal xterm; do
		if command -v "$t" >/dev/null 2>&1; then
			setsid "$t" >/dev/null 2>&1 &
			return 0
		fi
	done
	return 1
}

open_url() {
	[[ -n "$URL" ]] || return 0
	command -v xdg-open >/dev/null 2>&1 && setsid xdg-open "$URL" >/dev/null 2>&1 &
}

start_installer() {
	if command -v calamares >/dev/null 2>&1; then
		setsid sudo -E calamares >/dev/null 2>&1 &
	else
		notify-send "LexOS" "Installateur introuvable." 2>/dev/null || true
	fi
}

mark_done() {
	mkdir -p "$(dirname "$STAMP")"
	date -u '+%Y-%m-%dT%H:%M:%SZ' > "$STAMP"
}

# --- Dialogue ----------------------------------------------------------------
#  LA MASCOTTE ANIMÉE. Alex : « je la voulais avec son effet d'animation ».
#  Interrogé sur laquelle des trois animations du projet il visait — la
#  mascotte, le fond d'écran animé ou les effets du dock — il a répondu la
#  mascotte.
#
#  L'ANIMATION EXISTAIT DÉJÀ, ET NE JOUAIT QU'À UN SEUL ENDROIT. Le hook 0300
#  construit un thème Plymouth à partir des 16 images de mascot-anim-frames :
#  elle bouge à l'écran de démarrage. Partout ailleurs — cette fenêtre-ci,
#  l'avatar de session — c'est mascot.png, fixe. Et mascot-anim-web.gif voyage
#  dans l'ISO depuis toujours (build.sh l. 211 prend les *.gif), posé sur la
#  machine, utilisé PAR RIEN. 272 Kio embarqués pour ne jamais s'afficher.
#
#  POURQUOI LA VERSION « web » ET PAS L'AUTRE. Les deux sont là :
#  mascot-anim.gif fait 6,6 Mio, mascot-anim-web.gif 272 Kio. Charger 6,6 Mio
#  dans une boîte de dialogue de bienvenue, c'est une fenêtre qui rame à la
#  toute première session — le pire moment pour faire mauvaise impression.
#
#  LA CHAÎNE DE REPLI GARDE SON DERNIER MAILLON. Le GIF passe DEVANT, pas à la
#  place : s'il manque, on perd l'animation, pas la fenêtre.
#
#  À VÉRIFIER SUR UNE MACHINE, ET CE N'EST PAS ACQUIS : yad affiche l'image
#  par un GtkImage, et GTK anime tout seul un GIF chargé depuis un FICHIER.
#  Mais selon la version de yad et la façon dont l'image est chargée, un GIF
#  peut s'afficher FIGÉ SUR SA PREMIÈRE IMAGE — livré, affiché, immobile. Ce
#  serait exactement le genre de correctif qui a l'air fait et ne l'est pas.
#  Rien ici ne peut le prouver : il faut ouvrir la fenêtre et regarder. Si
#  elle est figée, revenir à mascot.png et le dire, plutôt que de contourner —
#  écrire une petite fenêtre GTK pour l'occasion est un autre chantier.
ICON="$BRAND/mascot-anim-web.gif"
[[ -r "$ICON" ]] || ICON="$BRAND/mascot.png"
[[ -r "$ICON" ]] || ICON="/usr/share/pixmaps/lexos.png"

if command -v yad >/dev/null 2>&1; then
	BTNS=(--button="Fermer:0" --button="Ouvrir un terminal:2" --button="Documentation:3")
	(( LIVE && ! ABOUT_ONLY )) && BTNS+=(--button="Installer ${NAME}:4")

	OUT="$(yad --form \
		--title="Bienvenue sur ${NAME}" \
		--window-icon=lexos \
		--image="$ICON" --image-on-top \
		--width=620 --height=430 \
		--center --borders=18 \
		--text="$MARKUP" \
		--field="Ne plus afficher ce message:CHK" false \
		"${BTNS[@]}" 2>/dev/null)"
	RC=$?

	[[ "$OUT" == TRUE* ]] && mark_done

	case $RC in
		2) open_terminal ;;
		3) open_url ;;
		4) start_installer ;;
	esac
	exit 0
fi

if command -v zenity >/dev/null 2>&1; then
	zenity --info --no-markup=false \
		--title="Bienvenue sur ${NAME}" \
		--width=520 \
		--text="$MARKUP" 2>/dev/null
	mark_done
	exit 0
fi

tty_fallback

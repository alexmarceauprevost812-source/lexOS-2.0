#!/usr/bin/env bash
# =============================================================================
#  lexos-welcome — écran de bienvenue (première session) et « À propos »
# =============================================================================
set -uo pipefail

STAMP="${XDG_CONFIG_HOME:-$HOME/.config}/lexos/welcome-done"
BRAND="/usr/share/lexos/branding"
ABOUT_ONLY=0
FIRST_RUN=0

for arg in "$@"; do
	case "$arg" in
		--about)     ABOUT_ONLY=1 ;;
		--first-run) FIRST_RUN=1 ;;
	esac
done

# Au démarrage automatique : on ne montre rien si l'utilisateur a déjà répondu.
if (( FIRST_RUN )) && [[ -f "$STAMP" ]]; then
	exit 0
fi

# --- Informations système ----------------------------------------------------
NAME="LexOS"; VER="?"; CODE="?"; FLAV="?"; BUILD="?"; URL=""
if [[ -r /etc/os-release ]]; then
	# shellcheck disable=SC1091
	. /etc/os-release
	NAME="${NAME:-LexOS}"
	VER="${VERSION_ID:-?}"
	CODE="${VERSION_CODENAME:-?}"
	URL="${HOME_URL:-}"
	FLAV="${LEXOS_FLAVOUR:-?}"
	BUILD="${LEXOS_BUILD_DATE:-?}"
fi

LIVE=0
grep -qa 'boot=live' /proc/cmdline 2>/dev/null && LIVE=1

# --- Repli console -----------------------------------------------------------
tty_fallback() {
	printf '\n  %s %s (%s) — saveur %s, build %s\n' "$NAME" "$VER" "$CODE" "$FLAV" "$BUILD"
	printf '  %s\n\n' "$URL"
	printf '  lexos help    liste des commandes\n'
	printf '  lexfetch      infos système\n\n'
	if (( LIVE )); then
		printf '  Session live : « sudo calamares » pour installer sur le disque.\n\n'
	fi
}

if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
	tty_fallback
	exit 0
fi

# --- Texte du dialogue -------------------------------------------------------
if (( LIVE )); then
	INTRO="Tu es en <b>session live</b> : rien n'est écrit sur ton disque.\nEssaie le système, puis installe-le quand tu es prêt."
else
	INTRO="Bienvenue sur ton système.\nTout est configuré, il n'y a plus qu'à s'en servir."
fi

#  Sur un Mac, deux réglages ne se devinent pas — les ventilateurs que rien
#  ne pilote, la rangée F qui commande la luminosité. Autant le dire ici
#  plutôt que d'attendre que la machine chauffe. Sur tout autre matériel
#  cette ligne n'apparaît pas.
MAC_LIGNE=""
if command -v lexos-mac >/dev/null 2>&1; then
	case "$(lexos-mac classe 2>/dev/null)" in
		intel|t2|efi32) MAC_LIGNE="
  <tt>lexos mac</tt>        ce Mac : Wi-Fi, ventilateurs, touches F" ;;
	esac
fi

MARKUP="<span size='xx-large' weight='bold'>${NAME} ${VER}</span>  <span alpha='60%'>« ${CODE} »</span>

${INTRO}

<span alpha='70%'>saveur ${FLAV}  ·  build ${BUILD}</span>

<b>Pour commencer</b>
  <tt>lexos help</tt>       les commandes du système
  <tt>lexfetch</tt>          la fiche technique de ta machine
  <tt>lexos doctor</tt>   un diagnostic rapide
  <tt>lexos theme light</tt>  passer en thème clair${MAC_LIGNE}"

open_terminal() {
	for t in xfce4-terminal x-terminal-emulator gnome-terminal xterm; do
		if command -v "$t" >/dev/null 2>&1; then
			setsid "$t" >/dev/null 2>&1 &
			return 0
		fi
	done
	return 1
}

open_url() {
	[[ -n "$URL" ]] || return 0
	command -v xdg-open >/dev/null 2>&1 && setsid xdg-open "$URL" >/dev/null 2>&1 &
}

start_installer() {
	if command -v calamares >/dev/null 2>&1; then
		setsid sudo -E calamares >/dev/null 2>&1 &
	else
		notify-send "LexOS" "Installateur introuvable." 2>/dev/null || true
	fi
}

mark_done() {
	mkdir -p "$(dirname "$STAMP")"
	date -u '+%Y-%m-%dT%H:%M:%SZ' > "$STAMP"
}

# --- Dialogue ----------------------------------------------------------------
#  LA MASCOTTE ANIMÉE — CE QU'ON A ESSAYÉ, ET POURQUOI ON S'EST ARRÊTÉ.
#  Alex : « je la voulais avec son effet d'animation ». Interrogé sur laquelle
#  des trois animations du projet il visait — la mascotte, le fond d'écran
#  animé ou les effets du dock — il a répondu la mascotte.
#
#  Elle existe, et elle ne joue qu'à UN endroit : le hook 0300 bâtit un thème
#  Plymouth avec les 16 images de mascot-anim-frames, et elle bouge à l'écran
#  de démarrage. Ici, et pour l'avatar de session, c'est mascot.png, fixe.
#
#  ═══ ET POURQUOI ON N'A PAS PRIS LE GIF, FINALEMENT ═══
#  L'idée était de faire jouer la mascotte ici. Deux mesures l'ont arrêtée :
#
#    · mascot-anim-web.gif fait 180x180 pixels. mascot.png en fait 599x720.
#      Poser le GIF, c'est réduire la mascotte de la fenêtre de bienvenue par
#      TROIS — pour une animation qui n'est même pas certaine de jouer.
#    · l'autre version, mascot-anim.gif, fait bien 1080x1303, mais 6,6 Mio.
#      Six mégaoctets à décoder dans une boîte de dialogue, à la toute
#      première session : c'est le pire moment pour faire ramer la machine.
#
#  Et rien ici ne peut prouver que yad anime le GIF plutôt que d'en afficher
#  la première image, figée. Le pari se solderait donc au mieux par une
#  mascotte trois fois plus petite, au pire par une mascotte trois fois plus
#  petite ET immobile — strictement moins bien qu'aujourd'hui.
#
#  Faire jouer la mascotte dans cette fenêtre demande d'écrire une petite
#  fenêtre GTK à la place de yad, où l'on contrôle le GdkPixbufAnimation et
#  la taille d'affichage. C'est un chantier, pas un chemin de fichier à
#  changer. Elle continue donc de jouer là où elle joue déjà et où elle est
#  belle : l'écran de démarrage (hook 0300, thème Plymouth, 16 images).
ICON="$BRAND/mascot.png"
[[ -r "$ICON" ]] || ICON="/usr/share/pixmaps/lexos.png"

if command -v yad >/dev/null 2>&1; then
	BTNS=(--button="Fermer:0" --button="Ouvrir un terminal:2" --button="Documentation:3")
	(( LIVE && ! ABOUT_ONLY )) && BTNS+=(--button="Installer ${NAME}:4")

	OUT="$(yad --form \
		--title="Bienvenue sur ${NAME}" \
		--window-icon=lexos \
		--image="$ICON" --image-on-top \
		--width=620 --height=430 \
		--center --borders=18 \
		--text="$MARKUP" \
		--field="Ne plus afficher ce message:CHK" false \
		"${BTNS[@]}" 2>/dev/null)"
	RC=$?

	[[ "$OUT" == TRUE* ]] && mark_done

	case $RC in
		2) open_terminal ;;
		3) open_url ;;
		4) start_installer ;;
	esac
	exit 0
fi

if command -v zenity >/dev/null 2>&1; then
	zenity --info --no-markup=false \
		--title="Bienvenue sur ${NAME}" \
		--width=520 \
		--text="$MARKUP" 2>/dev/null
	mark_done
	exit 0
fi

tty_fallback

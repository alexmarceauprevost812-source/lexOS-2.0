#!/usr/bin/env bash
# =============================================================================
#  lexos-capture — captures d'écran et enregistrement vidéo de l'écran
# =============================================================================
#  Photo : xfce4-screenshooter fait le travail (il est déjà dans la saveur
#  standard). Repli sur scrot puis sur « import » d'ImageMagick.
#
#  Vidéo : ffmpeg avec x11grab, qui enregistre l'écran ET le son du système
#  s'il trouve PulseAudio. SimpleScreenRecorder prend le relais si on préfère
#  une interface graphique.
#
#  Tout atterrit dans ~/Images/Captures et ~/Vidéos/Captures, avec un nom
#  horodaté — jamais d'écrasement silencieux.
# =============================================================================
set -uo pipefail

PROG="${0##*/}"

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; E=$'\033[31m'; V=$'\033[32m'
	B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'
else
	O=''; E=''; V=''; B=''; D=''; R=''
fi
say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$V" "$R" "$*"; }
die()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

#  Les dossiers français de XDG existent sur LexOS (locale fr_CA), mais on ne
#  parie pas dessus : xdg-user-dir donne le bon chemin quelle que soit la langue.
dossier() {
	local cle="$1" repli="$2" chemin=""
	if command -v xdg-user-dir >/dev/null 2>&1; then
		chemin="$(xdg-user-dir "$cle" 2>/dev/null)"
	fi
	[[ -n "$chemin" && "$chemin" != "$HOME" ]] || chemin="$HOME/$repli"
	printf '%s\n' "$chemin/Captures"
}

horodatage() { date +%Y-%m-%d_%Hh%Mm%Ss; }

#  L'horodatage descend à la seconde : deux captures rapprochées (raccourci
#  clavier martelé, rafale de zones) tomberaient sur le même nom et la
#  seconde écraserait la première sans rien dire. On suffixe alors _2, _3…
nom_libre() {
	local base="$1" ext="$2" candidat="${1}.${2}" n=2
	while [[ -e "$candidat" ]]; do
		candidat="${base}_${n}.${ext}"
		n=$((n + 1))
	done
	printf '%s\n' "$candidat"
}

# --- Photo -------------------------------------------------------------------
#  mode : plein | fenetre | zone
cmd_photo() {
	local mode="${1:-plein}"
	local dest; dest="$(dossier PICTURES Images)"
	mkdir -p "$dest" || die "Impossible de créer $dest"
	#  LE FORMAT, ET POURQUOI IL SE CHOISIT.
	#  Tout était en PNG. C'est le bon défaut — sans perte, le texte reste net,
	#  et une capture d'écran sert souvent à MONTRER du texte. Mais un plein
	#  écran en PNG pèse deux à quatre mégaoctets : à envoyer par message, ou
	#  quand on en prend cinquante dans la journée, ça compte.
	#  Le réglage vit dans ~/.config/lexos/capture-format ; « lexos capture
	#  qualite » l'écrit, les Paramètres aussi.
	local fmt; fmt="$(lire_format)"
	local fichier; fichier="$(nom_libre "$dest/capture_$(horodatage)" "$(extension_de "$fmt")")"

	#  Cadrage : flameshot ouvre un vrai sélecteur — rectangle redimensionnable
	#  par ses poignées, dimensions affichées en direct — soit le même geste
	#  que l'outil de capture d'Ubuntu. xfce4-screenshooter -r ne propose
	#  qu'un glisser d'un seul trait, sans rattrapage possible.
	#
	#  « --accept-on-select » (documenté dans « man flameshot », vérifié dans
	#  le manuel du paquet plutôt que deviné) : ALEX, PHOTO DU SÉLECTEUR —
	#  « trop d'outils, [je voudrais] juste prendre une photo ». Sans ce
	#  drapeau, une fois la zone dessinée, flameshot ouvre la barre
	#  d'annotation au grand complet (crayon, formes, flèches, texte, minuteur,
	#  grille…) et il faut encore valider — Entrée, ou un clic sur la coche.
	#  Ce drapeau saute cette étape : dès que le rectangle est lâché, la
	#  capture est prise, tout de suite, sans toucher à rien d'autre — plus
	#  simple qu'une touche à retenir, la barre d'outils ne s'affiche même
	#  plus.
	if [[ "$mode" == "zone" ]] && command -v flameshot >/dev/null 2>&1; then
		say "Cadre la zone à la souris — relâche pour capturer, aucune touche à retenir."
		#  flameshot gui écrit lui-même le fichier avec --path ; il sort en
		#  code non nul si l'utilisateur annule, d'où le test sur le fichier.
		flameshot gui --accept-on-select --path "$fichier" >/dev/null 2>&1 || true
		if [[ ! -s "$fichier" ]]; then
			say "Capture annulée."
			exit 0
		fi
		ok "Image : $fichier"
		avertir_capture "$fichier"
		printf '%s\n' "$fichier"
		return 0
	fi

	if command -v xfce4-screenshooter >/dev/null 2>&1; then
		local drapeau
		case "$mode" in
			plein)   drapeau="-f" ;;
			fenetre) drapeau="-w" ;;
			zone)    drapeau="-r" ;;
			*)       die "Mode inconnu : $mode (plein, fenetre ou zone)" ;;
		esac
		say "Capture ${mode}…"
		xfce4-screenshooter "$drapeau" -s "$fichier" >/dev/null 2>&1 \
			|| die "xfce4-screenshooter a échoué."
	elif command -v scrot >/dev/null 2>&1; then
		case "$mode" in
			plein)   scrot "$fichier" ;;
			fenetre) scrot -u "$fichier" ;;
			zone)    scrot -s "$fichier" ;;
			*)       die "Mode inconnu : $mode" ;;
		esac || die "scrot a échoué."
	elif command -v import >/dev/null 2>&1; then
		#  « import » sans argument demande de cliquer une fenêtre ;
		#  -window root prend tout l'écran.
		if [[ "$mode" == "plein" ]]; then
			import -window root "$fichier"
		else
			import "$fichier"
		fi || die "import (ImageMagick) a échoué."
	else
		die "Aucun outil de capture installé (apt install xfce4-screenshooter)."
	fi

	[[ -s "$fichier" ]] || die "Capture annulée — aucun fichier écrit."
	ok "Image : $fichier"
	avertir_capture "$fichier"
	printf '%s\n' "$fichier"
}

# --- Vidéo -------------------------------------------------------------------
cmd_video() {
	local dest; dest="$(dossier VIDEOS Vidéos)"
	mkdir -p "$dest" || die "Impossible de créer $dest"
	local fichier; fichier="$(nom_libre "$dest/ecran_$(horodatage)" mp4)"

	#  Interface graphique demandée explicitement, ou ffmpeg absent.
	if [[ "${1:-}" == "gui" ]]; then
		command -v simplescreenrecorder >/dev/null 2>&1 \
			&& exec simplescreenrecorder
		die "SimpleScreenRecorder n'est pas installé (apt install simplescreenrecorder)."
	fi

	command -v ffmpeg >/dev/null 2>&1 \
		|| die "ffmpeg n'est pas installé (apt install ffmpeg)."
	[[ -n "${DISPLAY:-}" ]] || die "Pas de session graphique (DISPLAY vide)."

	#  Taille réelle de l'écran : x11grab exige une géométrie explicite, et
	#  une valeur codée en dur tronquerait l'image sur tout autre écran.
	local taille=""
	if command -v xdpyinfo >/dev/null 2>&1; then
		taille="$(xdpyinfo | awk '/dimensions:/{print $2; exit}')"
	fi
	[[ -n "$taille" ]] || taille="1920x1080"

	#  Le son du système si PulseAudio répond, sinon vidéo muette : mieux vaut
	#  un enregistrement sans son qu'un ffmpeg qui refuse de démarrer.
	local son=()
	if command -v pactl >/dev/null 2>&1 && pactl info >/dev/null 2>&1; then
		son=(-f pulse -ac 2 -i default)
		say "Son du système : activé"
	else
		say "Son du système : indisponible — vidéo muette"
	fi

	say "Enregistrement de l'écran (${taille})…"
	say "${B}Ctrl+C pour arrêter.${R}"
	ffmpeg -loglevel error -stats \
		-f x11grab -framerate 30 -video_size "$taille" -i "${DISPLAY}" \
		"${son[@]}" \
		-c:v libx264 -preset veryfast -crf 23 -pix_fmt yuv420p \
		-movflags +faststart \
		"$fichier"

	#  Ctrl+C fait sortir ffmpeg en code non nul alors que le fichier est bon :
	#  on juge sur le fichier, pas sur le code de retour.
	if [[ -s "$fichier" ]]; then
		ok "Vidéo : $fichier"
		command -v notify-send >/dev/null 2>&1 \
			&& notify-send "Enregistrement terminé" "$(basename "$fichier")" 2>/dev/null
		printf '%s\n' "$fichier"
	else
		die "Aucune vidéo écrite."
	fi
}

# --- Le format des images ----------------------------------------------------
#  « png » (défaut) : sans perte, le texte reste parfaitement net.
#  « jpeg » : nettement plus léger, au prix d'un texte très légèrement adouci.
#  Ensemble fermé, vérifié des deux côtés.
CONF_LEXOS="${XDG_CONFIG_HOME:-$HOME/.config}/lexos"
FICHIER_FORMAT="$CONF_LEXOS/capture-format"

lire_format() {
	local v=""
	[ -r "$FICHIER_FORMAT" ] && v="$(tr -d '[:space:]' < "$FICHIER_FORMAT")"
	case "$v" in
		jpeg|jpg) printf 'jpeg' ;;
		*)        printf 'png' ;;
	esac
}

extension_de() { [ "$1" = "jpeg" ] && printf 'jpg' || printf 'png'; }

ecrire_format() {
	case "$1" in
		png|jpeg) ;;
		jpg) set -- jpeg ;;
		*) die "Format inconnu : $1   (png ou jpeg)" ;;
	esac
	mkdir -p "$CONF_LEXOS"
	printf '%s\n' "$1" > "$FICHIER_FORMAT"
	ok "Format des captures : $1"
	[ "$1" = "jpeg" ] && say "Plus léger. Pour du texte à lire, le PNG reste plus net."
}

# =============================================================================
#  Après la capture : la retrouver, ou en faire son fond d'écran
# =============================================================================
#  ALEX : « quand on prend une capture d'écran, elle mettait en bas à gauche
#  de l'écran, en écrivant [fond écran] — peux-tu le changer pour qu'on
#  puisse aller la voir directement dans le dossier images ? »
#
#  La bulle ne proposait QU'UN seul geste : « En faire mon fond d'écran ».
#  C'est utile, il l'avait demandé — mais ce n'est pas ce qu'on veut faire
#  neuf fois sur dix d'une capture. Le geste courant, c'est ALLER LA VOIR,
#  et pour ça il fallait retenir le chemin et ouvrir le gestionnaire de
#  fichiers à la main : le fichier est écrit dans un SOUS-dossier
#  (~/Images/Captures), donc même en connaissant « Images » on ne tombe pas
#  dessus du premier coup.
#
#  « Voir dans mes images » passe donc EN PREMIER — les serveurs de
#  notification affichent les boutons dans l'ordre où on les déclare, et le
#  premier est celui qu'on atteint sans réfléchir. Le fond d'écran reste
#  juste à côté : on ajoute un geste, on n'en retire pas un qu'Alex avait
#  demandé.
#
#  ON OUVRE LE DOSSIER, PAS L'IMAGE. « aller la voir dans le dossier
#  images » : c'est le dossier qu'on veut, avec les captures précédentes
#  autour. Ouvrir l'image seule dans une visionneuse répondrait à une autre
#  question — et le clic sur le corps de la bulle le fait déjà.
#
#  notify-send -A affiche un bouton et REND la clé de l'action cliquée ; -w
#  attend ce clic. On lance donc l'attente en arrière-plan, sinon la commande
#  de capture resterait bloquée tant que la bulle est à l'écran.
#  Tous les serveurs de notification ne gèrent pas les actions : si -A n'est
#  pas accepté, on retombe sur la notification simple, sans bouton.
ouvrir_dossier() {
	#  thunar est le gestionnaire de fichiers de LexOS ; xdg-open reste le
	#  repli, comme partout ailleurs — un dossier qui ne s'ouvre pas vaut
	#  mieux qu'un plantage, et un message honnête vaut mieux que les deux.
	if command -v thunar >/dev/null 2>&1; then
		thunar "$1" >/dev/null 2>&1 &
	elif command -v xdg-open >/dev/null 2>&1; then
		xdg-open "$1" >/dev/null 2>&1 &
	else
		return 1
	fi
	return 0
}

avertir_capture() {
	local fichier="$1"
	command -v notify-send >/dev/null 2>&1 || return 0
	local titre="Capture d'écran"
	local corps; corps="$(basename "$fichier")"
	local dossier; dossier="$(dirname "$fichier")"

	if notify-send --help 2>&1 | grep -q -- '--action' \
	   && command -v lexos >/dev/null 2>&1; then
		(
			reponse="$(notify-send -w -i "$fichier" \
				-A "voir=Voir dans mes images" \
				-A "fond=En faire mon fond d'écran" \
				"$titre" "$corps" 2>/dev/null)"
			case "$reponse" in
				voir)
					ouvrir_dossier "$dossier" \
						|| notify-send "$titre" \
						   "Aucun gestionnaire de fichiers pour ouvrir $dossier" 2>/dev/null
					;;
				fond)
					lexos wallpaper "$fichier" remplir >/dev/null 2>&1 \
						&& notify-send -i "$fichier" "Fond d'écran posé" "$corps" 2>/dev/null
					;;
			esac
		) >/dev/null 2>&1 &
		return 0
	fi

	notify-send "$titre" "$corps" -i "$fichier" 2>/dev/null || true
}

# --- Capturer PUIS poser directement en fond d'écran -------------------------
cmd_fond() {
	local mode="${1:-plein}"
	local fichier
	fichier="$(cmd_photo "$mode" | tail -1)"
	[[ -s "$fichier" ]] || die "Aucune image capturée."
	say "Pose en fond d'écran…"
	lexos wallpaper "$fichier" remplir \
		|| die "Le fond d'écran n'a pas pu être posé (lexos wallpaper)."
	ok "C'est ton fond d'écran."
}

cmd_dossier() {
	local img vid
	img="$(dossier PICTURES Images)"; vid="$(dossier VIDEOS Vidéos)"
	printf '%sImages :%s %s\n%sVidéos :%s %s\n' "$B" "$R" "$img" "$B" "$R" "$vid"
	if command -v xdg-open >/dev/null 2>&1; then
		mkdir -p "$img"; xdg-open "$img" >/dev/null 2>&1 &
	fi
}

usage() {
	cat <<EOF
${B}$PROG${R} — captures d'écran et enregistrement vidéo

${B}PHOTO${R}
  ${O}$PROG${R}                  Capture tout l'écran
  ${O}$PROG fenetre${R}          Capture la fenêtre active
  ${O}$PROG zone${R}             Capture une zone choisie à la souris

${B}VIDÉO${R}
  ${O}$PROG video${R}            Enregistre l'écran ${D}(Ctrl+C pour arrêter)${R}
  ${O}$PROG video gui${R}        Ouvre SimpleScreenRecorder

${B}FOND D'ÉCRAN${R}
  ${O}$PROG fond${R}             Capture l'écran et en fait ton fond d'écran
  ${O}$PROG fond zone${R}        Pareil, mais sur une zone choisie à la souris
  ${D}Après chaque capture, la bulle de notification propose deux boutons :
  « Voir dans mes images » (ouvre le dossier des captures) et
  « En faire mon fond d'écran ».${R}

${B}DIVERS${R}
  ${O}$PROG dossier${R}          Où sont rangées les captures

${D}Raccourcis clavier du bureau :
  Impr écr             tout l'écran
  Alt + Impr écr       fenêtre active
  Maj + Impr écr       zone au choix
  Ctrl + Maj + R       démarrer un enregistrement vidéo

  Sans touche Impr écr (petits claviers, portables) :
  Super + Maj + 1      tout l'écran
  Super + Maj + 2      zone au choix
  Super + Maj + 3      enregistrement vidéo${R}
EOF
}

case "${1:-}" in
	""|plein|ecran|photo) cmd_photo plein ;;
	fenetre|window)       cmd_photo fenetre ;;
	zone|region|select)   cmd_photo zone ;;
	video|enregistrer)    shift; cmd_video "${1:-}" ;;
	fond|wallpaper|fond-ecran) shift; cmd_fond "${1:-plein}" ;;
	dossier|ou|where)     cmd_dossier ;;
	format|qualite|qualité)
		shift
		if [ -n "${1:-}" ]; then ecrire_format "$1"
		else printf 'Format des captures : %s\n' "$(lire_format)"
		     printf 'Choisir : %s format png   |   %s format jpeg\n' "$PROG" "$PROG"
		fi ;;
	-h|--help|aide)       usage ;;
	*)                    say "Commande inconnue : $1"; printf '\n'; usage; exit 1 ;;
esac

#!/usr/bin/env bash
# =============================================================================
#  lexos-claude — Claude (l'IA d'Anthropic) et Claude Code sur LexOS
# =============================================================================
#  Deux outils, une seule commande :
#    - lexos claude          : ouvre Claude Code, l'assistant de programmation
#                              d'Anthropic, dans le terminal (« claude »).
#    - lexos claude app      : ouvre l'application Claude (claude.ai) dans une
#                              fenêtre à part, comme une vraie appli.
#    - lexos claude setup    : (ré)installe Claude Code — fait automatiquement
#                              au premier lancement s'il manque.
#    - lexos claude update   : met Claude Code à jour.
#
#  Claude Code est distribué par Anthropic (canal officiel npm). Contrairement
#  à lexos-ia (Ollama, 100 % hors-ligne), Claude tourne dans le nuage : il faut
#  une connexion et un compte Anthropic — la connexion se fait au navigateur au
#  premier lancement.
# =============================================================================
set -uo pipefail

PROG="lexos claude"

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; G=$'\033[32m'; Y=$'\033[33m'; E=$'\033[31m'; B=$'\033[1m'; R=$'\033[0m'
	#  RG (rouge) : PAS un rouge inventé pour l'occasion — c'est « rouge_hi »,
	#  le même accent que fond-anime.py (ACCENTS["rouge"] = #8A1512/#C4211E/
	#  #D8352E) et que le reste de LexOS. En vrai 24 bits, pas en 256 couleurs
	#  approché : xfce4-terminal (où ce script tourne toujours) le rend sans
	#  arrondi, et « --color-bg »/« --color-text » de lexos-claude-terminal,
	#  juste à côté, sont déjà écrits en hexadécimal littéral — même langage.
	RG=$'\033[38;2;216;53;46m'; W=$'\033[38;2;255;255;255m'
else
	O=''; G=''; Y=''; E=''; B=''; R=''; RG=''; W=''
fi
say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
err()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; }
die()  { err "$*"; exit 1; }

# --- Le mot-sigle au début d'une session --------------------------------------
#  ALEX, en montrant le vrai Claude Terminal à côté de la démo web : « claude
#  terminal ouvre pas comme je voyait sur vercel — 3e image, c'est ça qu'il
#  veut voir au début d'une session ». La démo (web-demo/index.html, fonction
#  cctAccueilSession) affiche un mot-sigle « CLAUDE CODE » et « Bonjour,
#  Alex » avant la conversation — ici, « claude » (exec, plus bas) prend tout
#  de suite la main sur le terminal et dessine SA PROPRE interface (le choix
#  du thème au tout premier lancement, puis son propre écran de démarrage) :
#  impossible d'ajouter quoi que ce soit PENDANT cet écran-là sans construire
#  un vrai enrobage de terminal (pty), fragile et hors de propos ici. Ce qui
#  reste possible, et suffit : imprimer le même mot-sigle JUSTE AVANT de lui
#  céder l'écran, comme un générique avant un film.
#
#  LE PRÉNOM NE VIENT PAS D'UN « Alex » ÉCRIT EN DUR. Ce script est embarqué
#  dans l'ISO — donc dans la machine de quiconque installe LexOS, pas
#  seulement celle d'Alex. La démo peut se permettre « Bonjour, Alex » (c'est
#  une page taillée pour lui) ; un fichier système livré à tout le monde ne
#  le peut pas. Le prénom vient du VRAI mécanisme d'identité de LexOS — le
#  champ GECOS que pose « lexos utilisateurs nom-complet » — et retombe sur
#  le nom du compte si personne ne l'a réglé.
prenom() {
	local plein
	plein="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f5)"
	plein="${plein%%,*}"   # GECOS : le nom complet, avant la première virgule
	plein="${plein%% *}"   # le prénom seul, avant le premier espace
	if [[ -n "$plein" ]]; then
		printf '%s' "$plein"
	else
		local u; u="$(id -un)"
		printf '%s' "${u^}"
	fi
}

#  ALEX, sur l'ISO déjà construite avec ce mot-sigle : « je veux il est un
#  theme rouge dans ios dans un fond bien noir et une belle ecriture
#  blanc ». Le mot-sigle passe donc de l'orange de LexOS (accent par
#  défaut, mais Claude Terminal n'est pas « le reste de LexOS ») au rouge
#  ci-dessus, et le texte d'accompagnement — jusqu'ici atténué (« $D ») — en
#  BLANC franc, comme demandé. Le fond, lui, est déjà noir : c'est
#  --color-bg dans lexos-claude-terminal, réglé plus tôt.
banniere() {
	local h salut
	h="$(date +%-H 2>/dev/null || date +%H)"; h="${h#0}"; h="${h:-0}"
	#  Même règle que la démo (cctAccueilSession) : bonsoir de 18 h à 5 h.
	if (( h >= 18 || h < 5 )); then salut="Bonsoir"; else salut="Bonjour"; fi
	printf '\n%s%sCLAUDE\nCODE%s\n' "$B" "$RG" "$R"
	printf '%s✳ %s, %s%s\n' "$RG" "$salut" "$(prenom)" "$R"
	printf '%sLe terminal de Claude, et de personne d'"'"'autre.%s\n' "$W" "$R"
	printf '%sConnexion au navigateur au premier lancement.%s\n\n' "$W" "$R"
}

usage() {
	cat <<EOF
${B}$PROG${R} — Claude Code (assistant de programmation) et l'appli Claude

Usage :
  $PROG                  Ouvre Claude Code dans le terminal (l'installe au besoin)
  $PROG app              Ouvre l'application Claude (claude.ai) en fenêtre
  $PROG setup            Installe Claude Code
  $PROG update           Met Claude Code à jour
  $PROG modele           Montre et choisit le modèle (Opus 5, Opus 4.8, Sonnet 5, Haiku 4.5)
  $PROG modele <nom>     Fixe le modèle : opus, sonnet, haiku, ou un identifiant
  $PROG modele defaut    Efface le choix, Claude Code reprend son défaut
  $PROG "<demande>"      Lance Claude Code sur une demande précise

Exemples :
  $PROG
  $PROG app
  $PROG "explique-moi ce dossier"

Claude tourne dans le nuage (Anthropic) : connexion internet et compte requis.
Pour une IA 100 % locale et hors-ligne, vois plutôt : ${B}lexos ia${R}.
EOF
}

has_claude() { command -v claude >/dev/null 2>&1; }

# --- Le modèle ---------------------------------------------------------------
#  POURQUOI UN RÉGLAGE ICI PLUTÔT QUE « /model » DANS CLAUDE CODE.
#  « /model » change le modèle POUR LA SESSION EN COURS. C'est parfait quand on
#  est déjà dedans, et ça ne sert à rien quand on veut que TOUTES les sessions
#  démarrent sur le même — c'est-à-dire le cas normal. On garde donc le choix
#  dans un fichier à nous et on le passe en « --model » au lancement.
#
#  POURQUOI DES IDENTIFIANTS COMPLETS ET PAS « opus » / « sonnet ».
#  Les raccourcis existent, mais ils pointent vers « le plus récent de la
#  famille » : la même commande ne donnerait pas le même modèle dans six mois,
#  et on ne saurait pas pourquoi la facture ou les réponses ont changé. On
#  ACCEPTE les raccourcis à la saisie — c'est plus court à taper — mais on
#  écrit toujours l'identifiant complet dans le fichier.
CONF_DIR="${LEXOS_CONF:-$HOME/.config/lexos}"
CONF_MODELE="$CONF_DIR/claude-modele"

#  identifiant|nom|contexte|entrée/sortie par million|à quoi ça sert
MODELES=(
	"claude-opus-5|Opus 5|1M|5 \$ / 25 \$|le défaut de Claude Code, et le plus capable des quatre"
	"claude-opus-4-8|Opus 4.8|1M|5 \$ / 25 \$|l'Opus précédent — un modèle précis plutôt que « le plus récent »"
	"claude-sonnet-5|Sonnet 5|1M|2 \$ / 10 \$|nettement moins cher, largement de quoi coder au quotidien"
	"claude-haiku-4-5|Haiku 4.5|200K|1 \$ / 5 \$|le plus rapide et le moins cher, pour les tâches simples"
)

modele_resout() {
	#  Raccourci, identifiant connu, ou identifiant libre. Le dernier cas
	#  existe pour ne pas avoir à modifier ce script chaque fois qu'Anthropic
	#  sort un modèle : on prévient que le nom n'est pas connu, on ne bloque pas.
	local demande="$1" ligne
	case "$demande" in
		opus)   printf 'claude-opus-5';   return 0 ;;
		sonnet) printf 'claude-sonnet-5'; return 0 ;;
		haiku)  printf 'claude-haiku-4-5'; return 0 ;;
	esac
	for ligne in "${MODELES[@]}"; do
		[ "${ligne%%|*}" = "$demande" ] && { printf '%s' "$demande"; return 0; }
	done
	if [[ "$demande" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$ ]]; then
		printf '%s' "$demande"; return 2
	fi
	return 1
}

modele_lu() {
	local m
	m="$(cat "$CONF_MODELE" 2>/dev/null)" || return 0
	m="${m//[[:space:]]/}"
	#  Un fichier abîmé ne doit pas se transformer en argument de commande.
	[[ "$m" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$ ]] && printf '%s' "$m"
}

cmd_modele() {
	local demande="${1:-}" resolu rc ligne id nom ctx prix note actuel
	actuel="$(modele_lu)"

	if [ -z "$demande" ]; then
		say "Modèle utilisé au lancement de ${B}lexos claude${R} :"
		echo
		for ligne in "${MODELES[@]}"; do
			IFS='|' read -r id nom ctx prix note <<<"$ligne"
			if [ "$id" = "$actuel" ]; then printf '  %s●%s ' "$G" "$R"; else printf '    '; fi
			printf '%s%-18s%s %-9s  %-14s %s\n' "$B" "$nom" "$R" "$ctx" "$prix" "$note"
			printf '      %s%s%s\n' "$O" "$id" "$R"
		done
		echo
		if [ -n "$actuel" ]; then
			ok "Réglé sur ${actuel}."
			say "   ${B}$PROG modele defaut${R} pour laisser Claude Code décider."
		else
			say "Aucun choix enregistré — Claude Code prend son défaut (Opus 5)."
		fi
		say "   ${B}$PROG modele sonnet${R}   ${B}$PROG modele haiku${R}   ${B}$PROG modele opus${R}"
		say "   Pour changer le temps d'UNE session seulement : ${B}/model${R} dans Claude Code."
		return 0
	fi

	case "$demande" in
		defaut|défaut|auto|aucun)
			rm -f "$CONF_MODELE" 2>/dev/null
			ok "Choix effacé — Claude Code reprend son défaut."
			return 0 ;;
	esac

	#  Pas de « set +e / set -e » ici : ce script tourne sous « set -uo
	#  pipefail », SANS errexit. Encadrer l'appel de la sorte aurait
	#  ACTIVÉ errexit pour tout ce qui suit — un réglage que le script
	#  n'a jamais eu, et le genre de changement qui se manifeste trois
	#  fonctions plus loin. Le code de retour se lit très bien tel quel.
	resolu="$(modele_resout "$demande")"; rc=$?
	case $rc in
		1) die "Nom de modèle invalide : ${demande}" ;;
		2) warn "« ${resolu} » n'est pas dans la liste connue de LexOS — je l'écris quand même." ;;
	esac

	mkdir -p "$CONF_DIR" || die "Impossible de créer ${CONF_DIR}"
	printf '%s\n' "$resolu" > "$CONF_MODELE" || die "Impossible d'écrire ${CONF_MODELE}"
	ok "Modèle réglé sur ${resolu}."
}

# Rends « claude » trouvable même juste après une installation « native »
# (elle le pose dans ~/.local/bin, pas toujours déjà dans le PATH courant).
ensure_path() {
	case ":$PATH:" in
		*":$HOME/.local/bin:"*) ;;
		*) export PATH="$HOME/.local/bin:$PATH" ;;
	esac
}

install_claude() {
	ensure_path
	if has_claude; then ok "Claude Code est déjà installé."; return 0; fi
	command -v curl >/dev/null 2>&1 || die "curl est requis pour l'installation."

	# 1) Canal officiel npm si npm est là et qu'on peut écrire en global.
	if command -v npm >/dev/null 2>&1; then
		say "Installation de Claude Code (canal officiel npm)…"
		if npm install -g @anthropic-ai/claude-code >/dev/null 2>&1; then
			ensure_path; has_claude && { ok "Claude Code installé."; return 0; }
		fi
		# Sans les droits d'écriture globale, on tente avec sudo si dispo.
		if command -v sudo >/dev/null 2>&1; then
			say "Nouvelle tentative avec les droits administrateur…"
			if sudo npm install -g @anthropic-ai/claude-code >/dev/null 2>&1; then
				ensure_path; has_claude && { ok "Claude Code installé."; return 0; }
			fi
		fi
	fi

	# 2) Installeur natif d'Anthropic (pose « claude » dans ~/.local/bin,
	#    aucun droit administrateur requis).
	say "Installation de Claude Code (installeur officiel Anthropic)…"
	if curl -fsSL https://claude.ai/install.sh | bash >/dev/null 2>&1; then
		ensure_path; has_claude && { ok "Claude Code installé."; return 0; }
	fi

	die "Échec de l'installation de Claude Code. Vérifie la connexion, puis : ${PROG} setup"
}

cmd_update() {
	ensure_path
	has_claude || { install_claude; return $?; }
	say "Mise à jour de Claude Code…"
	if claude update >/dev/null 2>&1; then
		ok "Claude Code est à jour."
	elif command -v npm >/dev/null 2>&1 && npm update -g @anthropic-ai/claude-code >/dev/null 2>&1; then
		ok "Claude Code est à jour."
	else
		warn "Impossible de mettre à jour automatiquement — réessaie plus tard."
	fi
}

# --- L'application Claude : claude.ai dans une fenêtre dédiée ----------------
cmd_app() {
	local url="https://claude.ai"
	for b in chromium google-chrome google-chrome-stable brave-browser microsoft-edge; do
		if command -v "$b" >/dev/null 2>&1; then
			say "Ouverture de l'application Claude…"
			exec "$b" --app="$url" --class=Claude --name=claude-app >/dev/null 2>&1
		fi
	done
	# Pas de navigateur « app-mode » ? On ouvre dans le navigateur par défaut.
	say "Ouverture de Claude dans le navigateur…"
	exec xdg-open "$url"
}

#  L'appelant a-t-il déjà donné un modèle sur la ligne de commande ?
#  Si oui, il gagne : c'est la demande la plus explicite et la plus récente
#  des deux. Passer deux « --model » laisserait Claude Code arbitrer à notre
#  place, et on ne saurait pas lequel a gagné.
modele_deja_donne() {
	local a
	for a in "$@"; do
		case "$a" in --model|--model=*) return 0 ;; esac
	done
	return 1
}

cmd_run() {
	ensure_path
	has_claude || install_claude

	local -a choix=()
	local m; m="$(modele_lu)"
	if [ -n "$m" ] && ! modele_deja_donne "$@"; then
		choix=(--model "$m")
		say "Modèle : ${m}"
	fi

	#  Le mot-sigle est un décor : sur une sortie qui n'est pas un vrai
	#  terminal (script, pipe, NO_COLOR), on garde le seul message qui
	#  porte une vraie information.
	if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
		banniere
	else
		say "Claude Code — connexion au navigateur au premier lancement."
	fi
	exec claude "${choix[@]}" "$@"
}

CMD="${1:-}"
case "$CMD" in
	-h|--help|help)     usage ;;
	setup|install)      install_claude ;;
	update|maj)         cmd_update ;;
	modele|modèle|model) shift 2>/dev/null || true; cmd_modele "${1:-}" ;;
	app|web|appli)      cmd_app ;;
	code|cli|'')        shift 2>/dev/null || true; cmd_run "$@" ;;
	*)                  cmd_run "$@" ;;
esac

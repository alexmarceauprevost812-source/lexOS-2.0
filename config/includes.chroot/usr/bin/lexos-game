#!/usr/bin/env bash
# =============================================================================
#  lexos-game — lance un jeu avec les réglages adaptés à la machine
# =============================================================================
#  Bascule temporairement sur le profil de performance « performant » (sauf
#  si la machine tourne déjà en performant/max), enveloppe la commande avec
#  gamemode et MangoHud s'ils sont installés, puis remet le profil d'avant
#  une fois le jeu fermé. Rien de tout ça n'est requis : chaque brique est
#  utilisée seulement si elle est présente.
# =============================================================================
set -uo pipefail

PROG="${0##*/}"
PERF_STATE="/etc/lexos/performance"

case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
	*UTF-8*|*utf8*|*UTF8*|*utf-8*) ;;
	*) locale -a 2>/dev/null | grep -qiE '^C\.utf-?8$' && export LC_ALL=C.UTF-8 ;;
esac

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; D=$'\033[2m'
	G=$'\033[32m'; Y=$'\033[33m'; E=$'\033[31m'; B=$'\033[1m'; R=$'\033[0m'
else
	O=''; D=''; G=''; Y=''; E=''; B=''; R=''
fi
say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

current_profile() {
	[[ -r "$PERF_STATE" ]] && cat "$PERF_STATE" || printf 'medium'
}

gpu_info() {
	command -v lspci >/dev/null 2>&1 || { printf 'inconnu (pciutils absent)'; return; }
	lspci -mm 2>/dev/null | grep -Ei '"(VGA|3D|Display) controller"' \
		| sed -E 's/.*"[^"]*"[[:space:]]*"([^"]*)"[[:space:]]*"[^"]*"[[:space:]]*"([^"]*)".*/\1 \2/' \
		| head -n1 \
		|| printf 'inconnu'
}

vulkan_ok() {
	command -v vulkaninfo >/dev/null 2>&1 && vulkaninfo --summary >/dev/null 2>&1
}

# =============================================================================
#  Informations sur la machine
# =============================================================================
cmd_info() {
	printf '\n%s%s — matériel détecté%s\n\n' "$B$O" "$PROG" "$R"
	printf '  %-22s %s\n' "Carte graphique" "$(gpu_info)"
	printf '  %-22s %s\n' "Vulkan" "$(vulkan_ok && echo 'oui' || echo 'non (ou vulkan-tools absent)')"
	printf '  %-22s %s\n' "GameMode" "$(command -v gamemoderun >/dev/null 2>&1 && echo 'installé' || echo 'absent')"
	printf '  %-22s %s\n' "MangoHud" "$(command -v mangohud >/dev/null 2>&1 && echo 'installé' || echo 'absent')"
	printf '  %-22s %s\n' "Profil actuel" "$(current_profile)"
	printf '\n  %s%s <commande>%s   lance un jeu avec les réglages adaptés\n\n' "$D" "$PROG" "$R"
}

# =============================================================================
#  Lancement d'un jeu
# =============================================================================
cmd_run() {
	[[ $# -gt 0 ]] || die "Usage : ${PROG} <commande> [arguments…]  (ex. : ${PROG} steam)"

	local prev; prev="$(current_profile)"
	local bumped=0
	case "$prev" in
		performant|max) say "Profil déjà ${prev} — inchangé." ;;
		*)
			say "Passage temporaire au profil performant pour la partie…"
			if command -v lexos >/dev/null 2>&1 && lexos perf performant >/dev/null 2>&1; then
				bumped=1
			else
				warn "Impossible de changer de profil — la partie tourne avec le profil actuel (${prev})."
			fi
			;;
	esac

	local -a wrap=()
	if command -v gamemoderun >/dev/null 2>&1; then
		wrap=(gamemoderun)
		say "GameMode activé."
	fi
	if command -v mangohud >/dev/null 2>&1; then
		export MANGOHUD=1
		say "MangoHud activé (overlay de performance)."
	fi

	say "Lancement : $*"
	"${wrap[@]}" "$@"
	local rc=$?

	if [[ "$bumped" -eq 1 ]]; then
		say "Retour au profil ${prev}…"
		lexos perf "$prev" >/dev/null 2>&1 || true
	fi

	exit "$rc"
}

# =============================================================================
#  Compléments par Flatpak
# =============================================================================
#  Debian 13 n'empaquette pas ces logiciels — sous AUCUN nom. Ce n'est pas un
#  oubli de notre part : protontricks est un outil Python distribué par PyPI,
#  PPSSPP n'est pas dans l'archive Debian, et les cœurs libretro ne sont pas
#  empaquetés séparément. Flathub les publie tous. On les installe donc à la
#  demande, après l'installation du système, plutôt que de gonfler l'ISO.
#
#  Chaque ligne : identifiant Flathub | nom affiché | à quoi ça sert
EXTRAS='com.github.Matoking.protontricks|Protontricks|régler un jeu Windows récalcitrant dans Steam
org.libretro.RetroArch|RetroArch (Flatpak)|version qui télécharge ses propres cœurs, dont PlayStation
org.ppsspp.PPSSPP|PPSSPP|émulateur PlayStation Portable
org.xonotic.Xonotic|Xonotic|jeu de tir libre et rapide'

flathub_pret() {
	command -v flatpak >/dev/null 2>&1 || {
		warn "Flatpak n'est pas installé."
		say  "Installe-le avec : ${B}sudo apt install flatpak${R}"
		return 1
	}
	flatpak remotes 2>/dev/null | grep -q flathub && return 0
	say "Ajout du dépôt Flathub…"
	local -a sudo_pfx=()
	[[ "$(id -u)" -eq 0 ]] || sudo_pfx=(sudo)
	"${sudo_pfx[@]}" flatpak remote-add --if-not-exists flathub \
		https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 && return 0
	warn "Flathub n'a pas pu être ajouté (pas de réseau ?)."
	return 1
}

cmd_extras() {
	local liste_seule=0
	[[ "${1:-}" == "--liste" || "${1:-}" == "-l" ]] && liste_seule=1

	printf '\n%s%s — compléments de jeu%s\n\n' "$B$O" "$PROG" "$R"
	printf '  %sAbsents de Debian 13, disponibles sur Flathub :%s\n\n' "$D" "$R"

	local id nom quoi
	while IFS='|' read -r id nom quoi; do
		[[ -n "$id" ]] || continue
		if flatpak info "$id" >/dev/null 2>&1; then
			printf '  %s✓%s %-22s %s%s%s\n' "$G" "$R" "$nom" "$D" "déjà installé" "$R"
		else
			printf '    %-22s %s%s%s\n' "$nom" "$D" "$quoi" "$R"
		fi
	done <<< "$EXTRAS"

	printf '\n  %sgamescope : inutile de l installer, Steam embarque le sien.%s\n' "$D" "$R"
	printf '  %sManettes Xbox filaires : déjà prises en charge (pilote xpad du noyau).%s\n\n' "$D" "$R"

	[[ "$liste_seule" -eq 1 ]] && return 0

	flathub_pret || return 1

	local pose=0 rate=0
	while IFS='|' read -r id nom quoi; do
		[[ -n "$id" ]] || continue
		flatpak info "$id" >/dev/null 2>&1 && continue
		say "Installation de ${nom}…"
		if flatpak install -y --noninteractive flathub "$id" >/dev/null 2>&1; then
			ok "${nom} installé."
			pose=$((pose + 1))
		else
			warn "${nom} n'a pas pu être installé (${id})."
			rate=$((rate + 1))
		fi
	done <<< "$EXTRAS"

	printf '\n'
	if [[ "$rate" -gt 0 ]]; then
		say "${pose} installé(s), ${rate} en échec — cherche-les dans la Logithèque."
	elif [[ "$pose" -eq 0 ]]; then
		ok "Tout était déjà en place."
	else
		ok "${pose} complément(s) installé(s)."
	fi
	printf '\n'
}

cmd_help() {
	cat <<EOF

${B}${O}${PROG}${R} — lance un jeu avec les réglages adaptés à la machine

${B}USAGE${R}
  ${PROG} info               Matériel détecté : GPU, Vulkan, GameMode, MangoHud
  ${PROG} extras             Installe les compléments absents de Debian (Flathub)
  ${PROG} extras --liste     Montre les compléments sans rien installer
  ${PROG} <commande>…        Lance la commande avec les réglages adaptés

${B}À SAVOIR${R}
  Bascule sur le profil « performant » le temps de la partie (sauf si déjà
  sur performant/max), puis revient au profil précédent à la fermeture.
  Utilise GameMode et MangoHud automatiquement si installés.

  Les jeux Windows passent par Steam (Proton) ou Lutris : les deux sont
  installés d'origine, avec Wine et les bibliothèques 32 bits.

${B}EXEMPLES${R}
  ${D}${PROG} steam${R}
  ${D}${PROG} lutris${R}
  ${D}${PROG} /usr/games/monjeu.x86_64${R}

EOF
}

CMD="${1:-help}"
case "$CMD" in
	help|--help|-h|aide|'') cmd_help ;;
	info)              cmd_info ;;
	extras|complements|compléments) shift; cmd_extras "$@" ;;
	*)                 cmd_run "$@" ;;
esac

#!/bin/sh
# =============================================================================
#  LexOS Pilotes — lanceur de l'appli des mises à jour de la carte graphique
# =============================================================================
#  Démarre le serveur local (usr/lib/lexos/pilotes/serveur.py), qui ouvre la
#  page dans le navigateur. Deuxième clic sur l'icône : le serveur retrouve
#  celui qui tourne déjà et rouvre simplement un onglet dessus.
#
#  CE LANCEUR NE SONDE PLUS DE PORT LUI-MÊME. Il ouvrait la page de QUICONQUE
#  répondait 200 sur 127.0.0.1:7862 — même un autre compte arrivé avant nous,
#  dont la page pouvait réclamer le mot de passe : l'invite sudo maison que
#  LexOS interdit. serveur.py prend un port libre, note {port, jeton} dans
#  $XDG_RUNTIME_DIR (0600), et au deuxième clic exige que le serveur prouve
#  qu'il connaît ce jeton avant d'ouvrir quoi que ce soit.
#
#  LE JETON N'EST JAMAIS UN ARGUMENT, ni d'ici ni du navigateur : /proc/<pid>/
#  cmdline est lisible par tous les comptes. Le navigateur reçoit seulement le
#  chemin d'une page d'ouverture privée (0600), qui porte un ticket à usage
#  unique (voir serveur.py). Rien de secret ne passe donc par « "$@" ».
#
#  L'installation passe par « pkexec lexos-pilotes-maj » : la fenêtre de mot
#  de passe est celle du système, l'appli elle-même ne tourne jamais en root.
# =============================================================================
set -e

MOTEUR_DIR=/usr/lib/lexos/pilotes

if ! command -v python3 >/dev/null 2>&1; then
	echo "[lexos-pilotes] python3 introuvable — le paquet python3 (socle) est-il installé ?" >&2
	exit 1
fi

exec python3 "$MOTEUR_DIR/serveur.py" "$@"

#!/usr/bin/env bash
# =============================================================================
#  lexos-gps — GPS d'Alex (Map IA)
# =============================================================================
#  La carte de navigation écrite par Alex Marceau-Prevost : itinéraires,
#  recherche d'adresses, points d'intérêt, vues satellite. Données
#  OpenStreetMap (Nominatim pour la recherche, Overpass pour les lieux),
#  fonds de carte CartoDB et ArcGIS, calcul d'itinéraire par OSRM.
#
#  ── Pourquoi un serveur HTTP local ──────────────────────────────────────
#  Exactement la même raison que pour « Cartes LexOS », dont ce lanceur
#  réutilise le programme : navigator.geolocation — la position GPS, le
#  coeur d'une application de navigation — exige un « contexte sécurisé »
#  (https ou localhost). Un fichier ouvert en file:// n'en est pas un, et
#  la position resterait introuvable sans que rien ne dise pourquoi.
#  Le serveur n'écoute que la boucle locale, sur un port tiré au lancement :
#  rien de ce dossier n'est visible depuis le réseau.
#
#  ── Ce qui sort vers internet ───────────────────────────────────────────
#  Les bibliothèques Leaflet (unpkg.com), les fonds de carte
#  (basemaps.cartocdn.com, server.arcgisonline.com), la recherche d'adresse
#  (nominatim.openstreetmap.org), les points d'intérêt (overpass-api.de) et
#  le pays de connexion (ipapi.co). Aucun compte, aucune clé. Sans internet,
#  la fenêtre s'ouvre mais la carte reste vide.
# =============================================================================
set -uo pipefail

PROG="${0##*/}"
if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; E=$'\033[31m'; Y=$'\033[33m'; D=$'\033[2m'; R=$'\033[0m'
else
	O=''; E=''; Y=''; D=''; R=''
fi
say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

#  Le même programme que « Cartes LexOS » : mêmes besoins, mêmes pièges
#  résolus. Seuls le nom affiché et le dossier des fichiers changent.
CODE="/usr/lib/lexos/cartes.py"
DONNEES="${LEXOS_GPS_DIR:-/usr/share/lexos/gps}"

case "${1:-}" in
	-h|--help|aide|help)
		cat <<AIDE
${PROG} — GPS d'Alex (Map IA)

  ${O}${PROG}${R}          Ouvre la carte de navigation

Itinéraires, recherche d'adresses, points d'intérêt, vues satellite.
Données OpenStreetMap ; itinéraires par OSRM.

${D}Une connexion à internet est nécessaire : les fonds de carte sont
téléchargés à mesure du déplacement. Aucun compte, aucune clé.${R}
AIDE
		exit 0 ;;
esac

[[ -r "$CODE" ]]        || die "Fichier manquant : $CODE"
[[ -d "$DONNEES/web" ]] || die "Fichiers de la carte introuvables : $DONNEES/web"

#  PySide6 vient des paquets Debian, jamais de « pip --break-system-packages » :
#  ce commutateur écrase des fichiers appartenant à dpkg et finit par casser
#  des logiciels sans rapport. Si le paquet manque, on le dit et on s'arrête.
if ! python3 -c "import PySide6.QtWebEngineWidgets" >/dev/null 2>&1; then
	warn "Le composant Qt WebEngine de PySide6 est absent."
	say  "   ${D}sudo apt install python3-pyside6.qtwebenginewidgets python3-pyside6.qtwidgets${R}"
	say  "N'installe pas PySide6 par pip : il écraserait des fichiers gérés par dpkg."
	exit 1
fi

export LEXOS_CARTES_DIR="$DONNEES"
export LEXOS_CARTES_NOM="GPS d'Alex"
export LEXOS_CARTES_SOUS_TITRE="Map IA"
exec python3 "$CODE" "$@"

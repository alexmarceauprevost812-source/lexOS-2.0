#!/usr/bin/env bash
# =============================================================================
#  lexos-barre-haut — la barre du haut de XFCE (xfce4-panel), éteinte pour de bon
# =============================================================================
#  ALEX (2026-10-22), capture de la barre à l'appui : « pour désactiver
#  infiniment… parce qu'il apparaît tout le temps quand je redémarre mon
#  ordi », puis : « toute la barre du haut ».
#
#  POURQUOI « xfce4-panel --quit » ET PAS « pkill ». xfce4-panel est un
#  client de xfce4-session marqué « redémarrer tout de suite » : un pkill, et
#  la session le relance dans la seconde. « --quit » lui demande de partir
#  DE LUI-MÊME, en le disant à la session — qui ne le relance pas.
#
#  POURQUOI À CHAQUE SESSION. xfce4-session lance la barre à chaque
#  ouverture (Client2 du xfce4-session.xml de /etc/skel), et ce fichier
#  n'est copié qu'à la CRÉATION du compte. L'autostart
#  lexos-barre-haut.desktop appelle donc « demarrer » à chaque session.
#
#  ALEX (2026-10-23) : « retirer définitivement les anciens outils de la
#  barre du haut » — l'appareil photo, la capture de zone (carré pointillé)
#  et le rond orange d'enregistrement. /etc/skel ne les pose plus, mais un
#  compte déjà créé les garde dans xfconfd. « demarrer » les retire UNE fois
#  (fanion dans ~/.local/state/lexos/barre-sans-captures, et de nouveau si
#  un numéro retiré revient), « nettoyer » le refait tout de suite. La
#  capture elle-même reste : Impr, Maj+Impr, Ctrl+Maj+R, le menu, le dock et
#  le volet des Paramètres rapides.
#
#    lexos barre-haut off       éteinte (défaut) en mode Moteur, à chaque session
#    lexos barre-haut on        la ramener (et la relancer tout de suite)
#    lexos barre-haut nettoyer  retirer tout de suite les anciens boutons de capture
#    lexos barre-haut etat
#    lexos barre-haut auto      cachée, elle sort quand la souris touche le haut (0,3 s)
#    lexos barre-haut fixe      toujours affichée (l'ancien comportement)
#
#  ALEX (2026-11-01) : « désactiver l'outil en haut de l'écran, on va le voir
#  juste quand on met la souris là ». /etc/skel pose autohide-behavior=2 pour
#  les nouveaux comptes ; « demarrer » le pose UNE fois sur un compte déjà
#  créé (fanion barre-auto-1), puis laisse Alex libre de revenir à « fixe ».
# =============================================================================
set -uo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/lexos"
ETAT="$CONF/barre-haut"
PANNEAU="${XDG_CONFIG_HOME:-$HOME/.config}/xfce4/panel"
SAUVE="${XDG_STATE_HOME:-$HOME/.local/state}/lexos/barre-sans-captures"

lire() { [ -r "$ETAT" ] && tr -d '[:space:]' < "$ETAT" || printf 'off'; }

#  ALEX : « je veux ravoir celle de LexOS Moteur en haut ». La barre du
#  Moteur REMPLACE celle de XFCE. On ne ferme donc l'ancienne que si le
#  bureau du Moteur est le mode choisi : en mode classique, la barre XFCE
#  est la seule qui reste, et on ne laisse jamais l'écran sans barre.
moteur_choisi() {
	python3 - "$CONF/bureau.json" <<'PY' 2>/dev/null
import json, sys
try:
    sys.exit(0 if json.load(open(sys.argv[1], encoding="utf-8")).get("mode") == "moteur" else 1)
except Exception:
    sys.exit(1)
PY
}

#  La barre doit-elle rester à l'écran ? Non seulement en mode Moteur avec
#  l'état « off » : là, eteindre la ferme.
barre_voulue() { ! { moteur_choisi && [ "$(lire)" != "on" ]; }; }

#  La barre RÉPOND-elle ? « xfce4-panel -r » ou « --quit » lancé sans barre
#  qui tienne son nom sur D-Bus ouvre une boîte de dialogue (main.c, bloc
#  dbus_return) : une erreur « Failed to restart/quit the panel » qui bloque
#  le script jusqu'au clic — ou, selon le code d'erreur, la proposition
#  « Execute » qui RALLUME la barre. Un processus tout juste lancé n'a pas
#  encore pris son nom (g_bus_own_name est asynchrone). On demande donc
#  d'abord à D-Bus ; sans gdbus, on se contente du processus.
barre_en_marche() {
	if command -v gdbus >/dev/null 2>&1; then
		case "$(gdbus call --session --dest org.freedesktop.DBus \
			--object-path /org/freedesktop/DBus \
			--method org.freedesktop.DBus.NameHasOwner org.xfce.Panel 2>/dev/null)" in
			*true*) return 0 ;;
			*) return 1 ;;
		esac
	fi
	pgrep -u "$(id -u)" -x xfce4-panel >/dev/null 2>&1
}

eteindre() {
	command -v xfce4-panel >/dev/null 2>&1 || return 0
	moteur_choisi || return 0
	#  La barre peut démarrer APRÈS cet autostart (l'ordre n'est pas garanti
	#  sous XFCE) : on la guette 20 secondes, et on la ferme dès qu'elle
	#  RÉPOND — avant, « --quit » ouvrirait la boîte d'erreur.
	for _ in $(seq 1 20); do
		if pgrep -u "$(id -u)" -x xfce4-panel >/dev/null 2>&1 && barre_en_marche; then
			xfce4-panel --quit >/dev/null 2>&1 || true
			sleep 1
			pgrep -u "$(id -u)" -x xfce4-panel >/dev/null 2>&1 || return 0
		fi
		sleep 1
	done
	return 0
}

# --- Les anciens boutons de capture ------------------------------------------
#  Toujours par xfconf-query, jamais en éditant le XML : xfconfd garde le
#  canal en mémoire et réécrirait le fichier par-dessus.
#
#  ET TOUJOURS EN C.UTF-8. xfconf-query TRADUIT ce qu'il écrit : sous la
#  langue de LexOS (fr_CA), « Value is an array with 1 items: » devient « La
#  valeur est un tableau de 1 éléments : ». La première version de ce
#  nettoyage a pris cette phrase pour un élément de lanceur et l'a ÉCRITE à
#  la place des boutons (relecture du 2026-10-23, vrais binaires xfconf
#  4.18 en fr_CA). Pas « C » tout court : mesuré, il change les accents en
#  « ? » à la lecture et refuse les octets non ASCII à l'écriture.
xq() { LC_ALL=C.UTF-8 xfconf-query -c xfce4-panel "$@"; }

#  CHAQUE ÉCRITURE EST RELUE. xfconf-query rend 0 même quand xfconfd la
#  REFUSE : mesuré sur 4.18.1, une propriété verrouillée ne change pas, et
#  rien n'est dit (xfconf-query ignore aussi le retour du « -r »). Un refus
#  arrête tout AVANT le fanion : la prochaine session réessaiera.
refus() {
	echo "Barre du haut : xfconf a refusé de changer $1 — rien n'est marqué fait, la prochaine session réessaiera." >&2
	return 1
}
poser_tableau() { # poser_tableau <propriété> <type> <valeur…>
	local prop="$1" type="$2" v
	local -a args=()
	shift 2
	for v in "$@"; do args+=(-t "$type" -s "$v"); done
	xq -p "$prop" -a "${args[@]}" >/dev/null 2>&1
	[ "$(valeurs "$prop" | sed '/^$/d')" = "$(printf '%s\n' "$@")" ] || refus "$prop"
}
effacer() { # effacer <propriété> [-R]
	xq -p "$1" -r "${@:2}" >/dev/null 2>&1
	if xq -p "$1" >/dev/null 2>&1 || { [ "${2:-}" = "-R" ] && xq -p "$1/items" >/dev/null 2>&1; }; then
		refus "$1"
	fi
}

#  « fait-2 » : la première version posait « fait » même quand elle avait
#  abîmé les lanceurs ; ce nouveau nom fait repasser une fois tout compte
#  qu'elle a touché. « retires » garde les numéros déjà retirés.
FAIT="$SAUVE/fait-2"
RETIRES="$SAUVE/retires"

#  Une valeur par ligne, que la propriété soit un tableau ou non.
valeurs() {
	local sortie
	sortie=$(xq -p "$1" 2>/dev/null) || return 1
	case "$sortie" in
		"Value is an array with"*) printf '%s\n' "$sortie" | tail -n +3 ;;
		*) printf '%s\n' "$sortie" ;;
	esac
}

#  est_capture <numéro> <élément> — par le CONTENU, jamais par le numéro :
#  un lanceur ajouté à la main porte un nom horodaté, et Alex a pu refaire
#  sa barre depuis.
est_capture() {
	local nom="${2##*/}" f
	case "$nom" in
		lexos-capture.desktop|lexos-capture-photo.desktop|lexos-capture-zone.desktop|lexos-capture-video.desktop)
			return 0 ;;
	esac
	f="$PANNEAU/launcher-$1/$nom"
	[ -r "$f" ] || return 1
	grep -qE '^Exec=.*lexos[ -]capture' "$f" && return 0
	grep -qE '^Icon=(lexos-camera|lexos-capture-zone|lexos-capture-video)$' "$f"
}

#  Un élément qui ne finit pas par « .desktop », la barre l'ignore (launcher.c,
#  launcher_plugin_items_load) : c'est un débris — celui qu'a écrit la
#  première version, par exemple. Il part avec la capture.
est_debris() { case "$1" in *.desktop) return 1 ;; *) return 0 ;; esac; }

deja_retire() { [ -r "$RETIRES" ] && grep -qx "$1" "$RETIRES"; }
#  La barre peut redonner un numéro libéré à un NOUVEAU greffon d'Alex :
#  dès qu'il porte de vrais éléments, ce numéro n'est plus le nôtre.
oublier() { [ -w "$RETIRES" ] && sed -i "/^$1\$/d" "$RETIRES"; }

#  Un numéro déjà retiré qui REVIENT. Une barre restée en mémoire avec les
#  anciens boutons, à qui on retire un greffon d'un clic droit, réécrit
#  plugin-ids et /plugins/plugin-N depuis sa mémoire — sans items
#  (panel-application.c, SAVE_PLUGIN_IDS) : des lanceurs vides reviendraient.
revenus() {
	local id
	[ -r "$RETIRES" ] || return 1
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		[ "$(valeurs "/plugins/plugin-$id")" = "launcher" ] && return 0
	done < "$RETIRES"
	return 1
}

#  La sauvegarde, AVANT la première écriture : le fichier de xfconfd tel
#  quel, et une liste lisible. « xfconf-query -lv » n'y suffit pas : il
#  écrit « <<UNSUPPORTED>> » à la place de chaque tableau, donc justement
#  à la place de plugin-ids.
sauvegarder() {
	local base xml prop
	base="$SAUVE/avant-$(date +%Y%m%d-%H%M%S)"
	xml="${XDG_CONFIG_HOME:-$HOME/.config}/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
	if [ -r "$xml" ]; then cp "$xml" "$base.xml" || return 1; fi
	while IFS= read -r prop; do
		[ -n "$prop" ] || continue
		printf '%s = %s\n' "$prop" "$(valeurs "$prop" | paste -sd '|')"
	done <<<"$1" > "$base.txt"
}

#  nettoyer [--session] — sans argument : tout de suite, même si c'est déjà
#  fait. --session (l'autostart) : une fois, puis seulement si un numéro
#  retiré revient, en laissant à la barre le temps d'apparaître.
nettoyer() {
	local mode="${1:-}" liste prop id it pid p i ote retirer=" " change=0 deja=0 relance=0 avant apres
	local -a items garder ids args
	#  La barre appartient à la session de l'utilisateur : en root (sudo),
	#  on toucherait au mieux les réglages de root, jamais les siens.
	if [ "$(id -u)" -eq 0 ]; then
		echo "Barre du haut : à lancer SANS sudo, dans ta session : lexos barre-haut nettoyer" >&2
		return 1
	fi
	if ! command -v xfconf-query >/dev/null 2>&1; then
		echo "Barre du haut : xfconf-query absent, rien à nettoyer ici." >&2
		return 1
	fi
	if [ "$mode" = "--session" ] && [ -e "$FAIT" ] && ! revenus; then
		return 0
	fi
	if ! liste=$(xq -l 2>/dev/null); then
		echo "Barre du haut : réglages XFCE injoignables — à lancer dans ta session, sans sudo." >&2
		return 1
	fi
	mkdir -p "$SAUVE" || return 1
	pgrep -u "$(id -u)" -x xfce4-panel >/dev/null 2>&1 && deja=1

	#  1. Un lanceur qui ne porte QUE de la capture (ou des débris) part en
	#     entier ; un lanceur mêlé ne perd que ces éléments-là. Un lanceur
	#     sans élément ne part que si c'est un numéro déjà retiré qui revient :
	#     un lanceur vide qu'Alex aurait posé reste à lui.
	while IFS= read -r prop; do
		case "$prop" in /plugins/plugin-*) ;; *) continue ;; esac
		id=${prop#/plugins/plugin-}
		case "$id" in ''|*[!0-9]*) continue ;; esac
		[ "$(valeurs "$prop")" = "launcher" ] || continue
		mapfile -t items < <(valeurs "$prop/items" | sed '/^$/d')
		garder=(); ote=0
		for it in "${items[@]}"; do
			if est_capture "$id" "$it" || est_debris "$it"; then
				ote=$((ote + 1))
			else
				garder+=("$it")
			fi
		done
		if [ "${#items[@]}" -eq 0 ]; then
			deja_retire "$id" || continue
		elif [ "$ote" -eq 0 ]; then
			deja_retire "$id" && oublier "$id"
			continue
		fi
		if [ "$change" = 0 ]; then
			sauvegarder "$liste" \
				|| { echo "Barre du haut : sauvegarde impossible dans $SAUVE, rien n'est changé." >&2; return 1; }
			change=1
		fi
		if [ "${#garder[@]}" -eq 0 ]; then
			retirer="$retirer$id "
		else
			poser_tableau "$prop/items" string "${garder[@]}" || return 1
			echo "Lanceur $id : capture retirée, gardé : ${garder[*]}"
		fi
	done <<<"$liste"

	#  2. Chaque barre : plugin-ids réécrit SANS ces numéros, les autres dans
	#     l'ordre. Toujours « -a » et un « -t » par valeur : un « -s » seul
	#     changerait le tableau en nombre, et la barre se viderait.
	if [ "$retirer" != " " ]; then
		while IFS= read -r pid; do
			case "$pid" in ''|*[!0-9]*) continue ;; esac
			p="/panels/panel-$pid/plugin-ids"
			mapfile -t ids < <(valeurs "$p" | sed '/^$/d')
			args=()
			for i in "${ids[@]}"; do
				case "$retirer" in *" $i "*) ;; *) args+=("$i") ;; esac
			done
			[ "${#args[@]}" -lt "${#ids[@]}" ] || continue
			if [ "${#args[@]}" -gt 0 ]; then
				poser_tableau "$p" int "${args[@]}" || return 1
			else
				#  xfconf ne garde pas de tableau vide.
				effacer "$p" || return 1
			fi
		done < <(valeurs /panels)
		#  3. Les greffons eux-mêmes, et tout ce qu'il y a dessous.
		for id in $retirer; do
			effacer "/plugins/plugin-$id" -R || return 1
		done
	fi

	#  4. Une barre DÉJÀ affichée garde les anciens boutons en mémoire : elle
	#     se relance, seulement si elle doit rester (en mode Moteur, eteindre
	#     la ferme) et seulement si elle répond.
	if [ "$change" = 1 ] && [ "$deja" = 1 ] && barre_voulue; then
		if [ "$mode" = "--session" ]; then
			for _ in $(seq 1 20); do barre_en_marche && break; sleep 1; done
		fi
		if barre_en_marche; then
			avant=$(pgrep -u "$(id -u)" -x xfce4-panel | sort | paste -sd ' ')
			xfce4-panel -r >/dev/null 2>&1 || true
			for _ in $(seq 1 10); do
				sleep 1
				apres=$(pgrep -u "$(id -u)" -x xfce4-panel | sort | paste -sd ' ')
				if [ -n "$apres" ] && [ "$apres" != "$avant" ]; then relance=1; break; fi
			done
			#  Un « items » encore en attente peut partir quand l'ancienne
			#  barre se ferme (launcher.c, launcher_plugin_free_data) : on
			#  repasse derrière elle.
			for id in $retirer; do
				xq -p "/plugins/plugin-$id" -r -R >/dev/null 2>&1 || true
			done
		fi
	fi

	#  5. Les dossiers des lanceurs : mis de côté avec la sauvegarde, pas
	#     effacés. Laissé seul, launcher-11 ne suffirait pas : la barre
	#     retrouverait lexos-capture-video.desktop dans le menu.
	for id in $retirer; do
		[ -d "$PANNEAU/launcher-$id" ] || continue
		mv "$PANNEAU/launcher-$id" "$SAUVE/launcher-$id.$(date +%s)" \
			|| echo "Barre du haut : $PANNEAU/launcher-$id n'a pas pu être déplacé." >&2
	done
	for id in $retirer; do
		deja_retire "$id" || echo "$id" >> "$RETIRES"
	done

	#  6. Fini seulement si plus aucune barre affichée ne garde les anciens
	#     boutons en mémoire ; sinon la prochaine session repasse.
	if [ "$change" = 0 ] || [ "$deja" = 0 ] || ! barre_voulue || [ "$relance" = 1 ]; then
		touch "$FAIT"
	else
		echo "Barre du haut : la barre n'a pas pu être relancée — les boutons partiront à la prochaine ouverture de session." >&2
	fi
	if [ "$change" = 1 ]; then
		[ "$retirer" != " " ] && echo "Barre du haut : boutons de capture retirés (greffons $(tr ' ' '\n' <<<"$retirer" | sed '/^$/d' | sort -n | paste -sd ' '))."
		echo "Sauvegarde : $SAUVE"
	else
		echo "Barre du haut : aucun bouton de capture, rien à retirer."
	fi
}

# --- Cachée ou fixe -----------------------------------------------------------
#  autohide-behavior : 0 = toujours là, 2 = toujours cachée. Écrit pour CHAQUE
#  barre (panel-1, panel-2…), par xfconf-query : la barre suit tout de suite,
#  sans relance. Relu après, comme le reste (xfconf peut refuser en silence).
masquage() { # masquage <0|2>
	local pid p ok=0
	command -v xfconf-query >/dev/null 2>&1 || { echo "Barre du haut : xfconf-query absent." >&2; return 1; }
	while IFS= read -r pid; do
		case "$pid" in ''|*[!0-9]*) continue ;; esac
		p="/panels/panel-$pid/autohide-behavior"
		xq -p "$p" -n -t uint -s "$1" >/dev/null 2>&1 || xq -p "$p" -s "$1" >/dev/null 2>&1
		[ "$(valeurs "$p")" = "$1" ] || { refus "$p"; return 1; }
		ok=1
	done < <(valeurs /panels)
	[ "$ok" = 1 ]
}
AUTO_FAIT="${XDG_STATE_HOME:-$HOME/.local/state}/lexos/barre-auto-1"

case "${1:-etat}" in
	off|non|0)
		mkdir -p "$CONF"; echo off > "$ETAT"
		eteindre
		if moteur_choisi; then
			echo "Barre du haut XFCE : éteinte. La barre du Moteur prend sa place."
		else
			echo "Barre du haut XFCE : sera éteinte dès que le bureau du Moteur roule (lexos bureau moteur)."
		fi ;;
	on|oui|1)
		mkdir -p "$CONF"; echo on > "$ETAT"
		setsid xfce4-panel >/dev/null 2>&1 &
		echo "Barre du haut : rallumée." ;;
	nettoyer|captures)
		nettoyer ;;
	auto|cachee|cachée)
		masquage 2 && echo "Barre du haut : cachée — elle sort quand la souris touche le haut (0,3 s)." ;;
	fixe|visible)
		masquage 0 && echo "Barre du haut : toujours affichée." ;;
	demarrer)
		if [ ! -e "$AUTO_FAIT" ] && command -v xfconf-query >/dev/null 2>&1; then
			mkdir -p "$(dirname "$AUTO_FAIT")" && masquage 2 >/dev/null 2>&1 && touch "$AUTO_FAIT"
		fi
		[ "$(lire)" = "on" ] || eteindre
		nettoyer --session >/dev/null ;;
	etat|*)
		printf 'Barre du haut : %s\n' "$(lire)" ;;
esac

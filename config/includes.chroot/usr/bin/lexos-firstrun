#!/usr/bin/env bash
# =============================================================================
#  lexos-firstrun — applique l'apparence LexOS à la première ouverture de session
# =============================================================================
#  Les noms d'écrans XFCE ne sont connus qu'une fois la session ouverte : c'est
#  pourquoi le fond d'écran est appliqué ici plutôt que dans un fichier statique.
# =============================================================================
set -uo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lexos"
STAMP="$CONF_DIR/firstrun-done"
mkdir -p "$CONF_DIR"

FORCE=0
[[ "${1:-}" == "--force" ]] && FORCE=1

if (( ! FORCE )) && [[ -f "$STAMP" ]]; then
	exit 0
fi

# Laisse xfdesktop/xfsettingsd s'enregistrer avant de les piloter.
#
#  ATTENTION au piège : « xfconf-query -c xfce4-desktop -l » répond TOUT DE
#  SUITE, parce que le fichier xfce4-desktop.xml livré dans /etc/skel définit
#  déjà /desktop-menu/show. Attendre ça n'attend rien du tout. Ce qu'il faut
#  attendre, c'est que xfdesktop ait DÉCLARÉ SES ÉCRANS — c'est-à-dire qu'une
#  propriété « last-image » apparaisse. Tant qu'elle n'est pas là, on ne sait
#  pas sous quel nom écrire le fond d'écran.
for _ in $(seq 1 40); do
	xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -q 'last-image$' && break
	sleep 0.5
done

# --- Accent et thème ---------------------------------------------------------
ACCENT="orange"
[[ -r /etc/lexos/build.conf ]] && ACCENT="$(
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf 2>/dev/null; printf '%s' "${LEXOS_ACCENT_NAME:-orange}"
)"
[[ -r "$CONF_DIR/accent" ]] && ACCENT="$(cat "$CONF_DIR/accent")"

command -v lexos-theme-gen >/dev/null 2>&1 && lexos-theme-gen "$ACCENT" >/dev/null 2>&1

if command -v xfconf-query >/dev/null 2>&1; then
	#  Le repli nomme LexOS, pas Papirus : c'est ce repli qui repeignait les
	#  dossiers en bleu à la première session quand build.conf manquait.
	#
	#  LE THÈME DE FENÊTRE N'EST PAS LE THÈME GTK. Il l'était ici, et c'était
	#  faux : le hook 0610 dérive « LexOS-Arc-Dark » pour donner des boutons
	#  qu'on puisse viser, et cette ligne le remplaçait par « Arc-Dark » À LA
	#  PREMIÈRE SESSION — les boutons redevenaient petits avant même qu'Alex
	#  ait pu les voir. Exactement la panne des icônes du build 70, sur une
	#  autre clé. Le nom retenu se lit maintenant dans build.conf, où 0610
	#  l'écrit ; le repli reste le thème GTK, comme avant.
	BASE_THEME="Arc-Dark"; ICONS="LexOS"; XFWM_THEME=""
	[[ -r /etc/lexos/build.conf ]] && eval "$(
		# shellcheck disable=SC1091
		. /etc/lexos/build.conf 2>/dev/null
		printf 'BASE_THEME=%q; ICONS=%q; XFWM_THEME=%q' \
			"${LEXOS_GTK_BASE_THEME:-Arc-Dark}" "${LEXOS_ICON_THEME:-LexOS}" \
			"${LEXOS_XFWM_THEME:-}"
	)"
	[[ -n "$XFWM_THEME" ]] || XFWM_THEME="$BASE_THEME"
	xfconf-query -c xsettings -p /Net/ThemeName     -s "$BASE_THEME" 2>/dev/null || true
	xfconf-query -c xsettings -p /Net/IconThemeName -s "$ICONS"      2>/dev/null || true
	xfconf-query -c xfwm4     -p /general/theme     -s "$XFWM_THEME" 2>/dev/null || true
fi

# --- Un seul bureau, pas deux ------------------------------------------------
#  VU SUR LA PHOTO D'ALEX, BUILD 69 : « Bureau » ET « Desktop » côte à côte
#  dans le dossier personnel. La cause est le hook 0500 : pour poser l'icône
#  d'installation quelle que soit la langue, il crée LES DEUX dossiers dans le
#  squelette — et chaque compte hérite du doublon. On ne touche pas au hook
#  (il a raison de couvrir les deux langues AVANT de connaître la locale) :
#  ICI, la locale est connue, xdg-user-dirs a tranché. On déménage le contenu
#  du dossier en trop vers le vrai bureau, et on retire la coquille vide.
BUREAU_REEL="$(xdg-user-dir DESKTOP 2>/dev/null || true)"
[[ -z "$BUREAU_REEL" || "$BUREAU_REEL" == "$HOME" ]] && BUREAU_REEL="$HOME/Bureau"
for D in "$HOME/Bureau" "$HOME/Desktop"; do
	[[ "$D" == "$BUREAU_REEL" ]] && continue
	[[ -d "$D" ]] || continue
	mkdir -p "$BUREAU_REEL"
	#  -n : si le fichier existe déjà des deux côtés (les deux lanceurs du
	#  hook 0500, justement), on garde celui du vrai bureau, on jette l'autre.
	find "$D" -maxdepth 1 -mindepth 1 -exec mv -n {} "$BUREAU_REEL/" \; 2>/dev/null || true
	find "$D" -maxdepth 1 -mindepth 1 -exec rm -rf {} + 2>/dev/null || true
	rmdir "$D" 2>/dev/null || true
done

# --- Le dossier de projets, comme dans la démo --------------------------------
#  La démo montre six poches : DL, IMG, DOC, MUS, VID et PROJ. Les cinq
#  premières sont les dossiers XDG ; « Projets LexOS », lui, n'existait
#  nulle part — la poche PROJ de la démo n'avait pas de dossier réel.
#  L'icône est demandée par gio (metadata::custom-icon-name) : si Thunar
#  l'ignore sur cette version, le dossier reste orange générique — jamais
#  cassé, juste sans sa marque. À regarder sur machine.
if [[ ! -d "$HOME/Projets LexOS" ]]; then
	mkdir -p "$HOME/Projets LexOS" 2>/dev/null || true
	command -v gio >/dev/null 2>&1 \
		&& gio set -t string "$HOME/Projets LexOS" metadata::custom-icon-name folder-projects 2>/dev/null || true
fi

# --- Fond d'écran sur tous les écrans détectés ------------------------------
#  wallpaper.png EST le fond de marque officiel. ALEX : « pour la prochaine
#  ios sa va etre le fond ecren officiel — mais toute noir — avec le
#  demon ». Depuis le hook 0300, wallpaper.png est un LIEN SYMBOLIQUE vers
#  wallpaper-demon.png (le logo TI·LEX·AL sur fond noir) — ce script n'a
#  rien à savoir de ce changement, il continue de lire le même nom.
WALL="/usr/share/backgrounds/lexos/wallpaper.png"
[[ -r "$WALL" ]] || WALL="/usr/share/lexos/branding/wallpaper.svg"

#  pose_fond <chemin-de-propriete>  — l'image, puis son cadrage.
#  image-style 5 = « zoomé pour remplir », le seul cadrage qui ne laisse
#  jamais de bandes noires quelle que soit la définition de l'écran.
#  On tente d'abord la pose simple (propriété déjà déclarée par xfdesktop),
#  puis la création (-n). Dans cet ordre : « -n » exige un type, et imposer
#  un type à une propriété existante est le genre de détail qui marche sur
#  une version de XFCE et pas sur la suivante.
pose_fond() {
	local style="${1%last-image}image-style"
	xfconf-query -c xfce4-desktop -p "$1" -s "$WALL" 2>/dev/null \
		|| xfconf-query -c xfce4-desktop -n -t string -p "$1" -s "$WALL" 2>/dev/null \
		|| return 1
	xfconf-query -c xfce4-desktop -p "$style" -s 5 2>/dev/null \
		|| xfconf-query -c xfce4-desktop -n -t int -p "$style" -s 5 2>/dev/null || true
	return 0
}

appliquer_fond() {
	local found=0 prop sortie ws
	local sorties=()

	while read -r prop; do
		[[ "$prop" == *last-image ]] || continue
		pose_fond "$prop" && found=1
	done < <(xfconf-query -c xfce4-desktop -l 2>/dev/null)

	#  ON ÉCRIT LES PROPRIÉTÉS NOUS-MÊMES — MAIS PAS SOUS N'IMPORTE QUEL NOM.
	#  C'est ici que ça avait raté sur le portable de 2016 : l'ancienne version
	#  créait « /backdrop/screen0/monitor0/workspace0/last-image », un nom de
	#  XFCE 4.10 abandonné depuis. À partir de la 4.12, xfdesktop range chaque
	#  écran sous le nom de sa SORTIE — monitoreDP-1, monitorHDMI-1,
	#  monitorLVDS-1… Il lisait donc une propriété que nous n'écrivions pas, et
	#  affichait son fond bleu. On demande les vrais noms à xrandr.
	#
	#  ═══ ET POURQUOI CE BLOC NE S'EXÉCUTE PLUS « SEULEMENT SI RIEN N'A MARCHÉ » ═══
	#  PHOTO D'ALEX, DEUX ÉCRANS : le fond LexOS sur l'un, le fond pâle de
	#  Debian sur l'autre.
	#
	#  La condition était « si (( ! found )) ». Avec deux écrans, il suffisait
	#  qu'xfdesktop ait déclaré la propriété du PREMIER pour que found passe à
	#  1 — et tout ce bloc était sauté. Le second écran, dont la propriété
	#  n'existait pas encore, n'était jamais couvert. La fonction rendait 0,
	#  « c'est posé », en n'ayant habillé qu'un écran sur deux.
	#
	#  Le passage par xrandr est donc INCONDITIONNEL maintenant. Il ne coûte
	#  rien quand tout est déjà en place : pose_fond réécrit la même valeur.
	#  Et il rattrape le cas qui comptait — l'écran qu'xfdesktop n'a pas
	#  encore vu. La condition « si rien n'a marché » traitait un cas de
	#  panne ; le vrai cas courant, c'est le cas MIXTE.
	if command -v xrandr >/dev/null 2>&1; then
		mapfile -t sorties < <(
			xrandr --listactivemonitors 2>/dev/null |
				awk 'NR > 1 { print $NF }'
		)
	fi
	#  Filet : si xrandr manque ou ne répond rien, on tente les noms de
	#  sortie les plus courants plus l'ancien « monitor0 ». Écrire une
	#  propriété pour un écran absent ne coûte rien — xfdesktop l'ignore.
	#  Mais on ne le déroule QUE si xrandr n'a rien su dire ET qu'aucune
	#  propriété n'existait : quand on connaît les vrais noms, deviner
	#  n'ajoute rien et brouille la trace pour qui lira xfconf plus tard.
	if ((${#sorties[@]} == 0)) && (( ! found )); then
		sorties=(eDP-1 HDMI-1 DP-1 LVDS-1 VGA-1 0)
	fi

	for sortie in "${sorties[@]}"; do
		#  workspace0 suffit quand le mode « même fond partout » est actif
		#  (le défaut) ; on couvre les quatre bureaux pour le cas contraire.
		for ws in 0 1 2 3; do
			pose_fond "/backdrop/screen0/monitor${sortie}/workspace${ws}/last-image" \
				&& found=1
		done
	done

	#  Un seul fond pour tous les bureaux : sans ça, changer de bureau
	#  virtuel ramène le fond bleu sur ceux qu'on n'a pas couverts.
	xfconf-query -c xfce4-desktop -n -t bool \
		-p /backdrop/single-workspace-mode -s true 2>/dev/null || true

	#  0 si on a posé au moins une propriété : c'est l'appelant qui décide
	#  de demander ou non un rafraîchissement à xfdesktop.
	(( found ))
}

if [[ -r "$WALL" ]] && command -v xfconf-query >/dev/null 2>&1; then
	#  xfdesktop ne relit pas toujours de lui-même quand les propriétés sont
	#  créées après son démarrage. On le lui demande — une seule fois, ici :
	#  le rafraîchir à chaque passage de la boucle ci-dessous ferait clignoter
	#  le bureau pendant une minute.
	if appliquer_fond && command -v xfdesktop >/dev/null 2>&1; then
		xfdesktop --reload >/dev/null 2>&1 || true
	fi

	#  ON REPOSE LE FOND PLUSIEURS FOIS, PENDANT UNE MINUTE.
	#
	#  Constaté sur le portable 2016 (build 35) : le bon fond s'affichait à
	#  l'ouverture de session, puis laissait la place au fond bleu de XFCE.
	#  On ne perdait pas parce qu'on écrivait au mauvais endroit — on écrivait
	#  au bon, mais TROP TÔT : xfdesktop terminait son démarrage après nous et
	#  écrivait ses propres valeurs par-dessus.
	#
	#  Deux réponses, et on met les deux. La première est dans le hook 0300 :
	#  le fichier de fond par défaut de XFCE contient désormais l'image LexOS,
	#  donc même perdue, la course ne se voit plus. La seconde est ici : on
	#  repose la propriété toutes les cinq secondes pendant une minute, en
	#  arrière-plan, pour être celui qui écrit en dernier. C'est peu coûteux
	#  et ça couvre aussi le branchement d'un écran externe juste après
	#  l'ouverture de session — cas où xfdesktop crée de nouvelles propriétés.
	#  ═══ MAIS ON S'ARRÊTE DÈS QUE L'UTILISATEUR A CHOISI ═══
	#  Cette boucle réécrit le fond de marque pendant une MINUTE. Quelqu'un
	#  qui ouvre sa toute première session, va droit au menu et pose sa propre
	#  photo dans ce laps de temps se la fait effacer sous les yeux — par nous,
	#  au nom d'une course contre xfdesktop qui est déjà gagnée depuis
	#  longtemps. « J'ai mis mon image et elle est revenue toute seule » est
	#  une panne bien pire que celle qu'on corrigeait ici.
	#
	#  On regarde donc, avant chaque repose, ce que porte la première
	#  propriété. Tant que c'est NOTRE image (ou rien encore), on continue :
	#  c'est le cas de la course. Dès que c'est autre chose, quelqu'un a
	#  décidé — et on ne discute pas avec une décision.
	#
	#  ═══ SAUF QUE « autre chose » PEUT ÊTRE L'ADVERSAIRE LUI-MÊME ═══
	#  Trouvé en relisant ce fichier : le scénario documenté juste au-dessus
	#  — « xfdesktop termine son démarrage après nous et écrit ses propres
	#  valeurs par-dessus » — écrit justement un chemin sous XFCE_BG
	#  ($XFCE_BG, posé par le hook 0300), pas $WALL. La condition d'arrêt
	#  prenait alors CETTE écriture-là pour une décision de l'utilisateur, et
	#  cassait la boucle sans avoir reposé une seule fois — précisément dans
	#  la course qu'elle existe pour gagner. Si le hook 0300 n'a pas pu
	#  remplacer les fichiers XFCE (il le dit lui-même : « !! aucun fond
	#  XFCE remplacé »), la session reste alors sur le bleu.
	#
	#  On exclut donc aussi tout chemin sous XFCE_BG : ce n'est pas un choix,
	#  c'est l'autre coureur.
	XFCE_BG="/usr/share/backgrounds/xfce"
	(
		for _ in $(seq 1 12); do
			sleep 5
			actuel="$(
				xfconf-query -c xfce4-desktop -l 2>/dev/null \
					| grep -m1 -E '/backdrop/.*last-image$' \
					| xargs -r -I{} xfconf-query -c xfce4-desktop -p {} 2>/dev/null
			)"
			if [[ -n "$actuel" && "$actuel" != "$WALL" && "$actuel" != "$XFCE_BG"/* ]]; then
				break
			fi
			appliquer_fond
		done
	) >/dev/null 2>&1 &
fi

# --- PLUS DE FOND ANIMÉ AU DÉMARRAGE ----------------------------------------
#  ALEX : « fond d'écran animé, on peut l'enlever — on voit pas les
#  applications du bureau quand on fait [celui] les textes. On va mettre un
#  fond d'écran tout noir, comme ça on va voir si c'est [le] fond d'écran ou
#  bien une erreur au démarrage. »
#
#  Ce script lançait un fond animé à la première session. On l'a d'abord
#  rendu non automatique, pour trancher le diagnostic — et le verdict est
#  tombé : ALEX, APRÈS ESSAI, « dans les paramètres ça fonctionne tout, mais
#  on perd toutes les applications du bureau quand on met un effet animé ;
#  les applications du bureau restent juste quand [il y] a un fond d'écran
#  fixe. » Le fond animé ÉTAIT bien le coupable.
#
#  LES FONDS ANIMÉS ET VIDÉO SONT DONC RETIRÉS POUR DE BON. La cause est
#  structurelle : leur fenêtre vivait dans le calque
#  _NET_WM_WINDOW_TYPE_DESKTOP, celui de xfdesktop qui dessine les icônes.
#  xfwm4 garantit que ce calque reste sous les fenêtres normales, mais PAS
#  l'ordre relatif de deux fenêtres DANS ce calque — le fond pouvait donc
#  passer devant les icônes sans qu'aucune ligne ne soit « cassée ». Deux
#  correctifs ont été tentés (remonte_xfdesktop, puis son portage shell) ;
#  les deux ont échoué chez Alex, et aucune machine de construction n'a de
#  serveur X pour éprouver le troisième.
#
#  Un bureau qui perd ses icônes est plus grave qu'un bureau sans animation.
#  Tout le code reste dans l'historique git si la question revient.

# --- Matériel Apple ---------------------------------------------------------
#  Sur un Mac, quelques réglages ne se devinent pas : les ventilateurs qui
#  restent au ralenti, la rangée F qui pilote la luminosité. « --auto »
#  n'affiche rien et sort immédiatement si la machine n'est pas un Mac.
command -v lexos-mac >/dev/null 2>&1 && lexos-mac --auto >/dev/null 2>&1 || true

date -u '+%Y-%m-%dT%H:%M:%SZ' > "$STAMP"

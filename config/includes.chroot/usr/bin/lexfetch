#!/usr/bin/env bash
# =============================================================================
#  lexfetch — carte d'identité du système, façon LexOS
# =============================================================================
set -uo pipefail

# L'art ASCII est en UTF-8 : sans locale multi-octets, ${#chaine} compte les
# octets et l'alignement des colonnes part en vrille. On force un repli sûr.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
	*UTF-8*|*utf8*|*UTF8*|*utf-8*) ;;
	*)
		if locale -a 2>/dev/null | grep -qiE '^C\.utf-?8$'; then
			export LC_ALL=C.UTF-8
		fi
		;;
esac

# --- Couleurs ----------------------------------------------------------------
if [[ -t 1 ]] && [[ "${TERM:-dumb}" != "dumb" ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'   # orange
	A=$'\033[38;5;215m'   # ambre
	W=$'\033[38;5;253m'   # texte
	D=$'\033[2m'          # atténué
	B=$'\033[1m'
	R=$'\033[0m'
else
	O=''; A=''; W=''; D=''; B=''; R=''
fi

# --- Le nom et la machine suivent l'INVITE, ils ne la doublent pas ----------
#  « marceau@lexos » est écrit ici, et l'invite le réécrit deux lignes plus
#  bas sur le même écran. Les deux valaient 38;5;208 — par coïncidence, pas
#  par construction : le jour où l'invite a changé d'avis sur la couleur du
#  nom, rien n'aurait tiré la bannière avec elle, et on aurait eu deux
#  « marceau » de deux oranges sur un seul écran.
#  On lit donc la source — ~/.config/lexos/terminal.env, écrit par
#  lexos-theme-gen — avec les valeurs d'avant en repli. Même bascule que
#  __lexos_couleurs : couleur vraie quand le terminal l'annonce, palette 256
#  sinon, parce que la console texte afficherait « 38;2;… » en clair.
#  ON NE SOURCE PAS CE FICHIER : lexfetch lit déjà /etc/os-release et pose
#  ses propres variables ; on en extrait les deux lignes voulues, et rien
#  d'autre n'entre ici.
#  $O n'est PAS détourné : il peint aussi le logo ASCII et la rangée de
#  pastilles, qui n'ont rien à voir avec l'identité.
U="$O"; H="$O"
if [[ -n "$O" ]]; then
	LEXOS_TERM_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/lexos/terminal.env"
	if [[ -r "$LEXOS_TERM_ENV" ]]; then
		case "${COLORTERM:-}" in
			truecolor|24bit) _sfx='' ;;
			*)               _sfx='_256' ;;
		esac
		_u="$(sed -n "s/^LEXOS_PS_UTILISATEUR${_sfx}='\(.*\)'\$/\1/p" "$LEXOS_TERM_ENV" | head -1)"
		_l="$(sed -n "s/^LEXOS_PS_LOGO${_sfx}='\(.*\)'\$/\1/p" "$LEXOS_TERM_ENV" | head -1)"
		[[ -n "$_u" ]] && U=$'\033['"${_u}"'m'
		[[ -n "$_l" ]] && H=$'\033['"${_l}"'m'
	fi
fi

# --- Art ASCII ---------------------------------------------------------------
IFS= read -r -d '' ART <<'EOF' || true
        ▄▄██████████▄▄
     ▄██████████████████▄
  ▄████████████████████████▄
  ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀
   ███▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄███
    ██ ▐████▌    ▐████▌ ██
    ██ ▐████▌    ▐████▌ ██
   ███▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀███
    ███████▄▄▄▄▄▄▄▄███████
    █████  ▄  ▄  ▄  █████
    ████   █  █  █   ████
    ▀███▄  ▀  ▀  ▀  ▄███▀
      ▀███▄▄▄▄▄▄▄▄▄▄███▀
         ▀▀████████▀▀
EOF

ART="${ART%$'\n'}"
mapfile -t ART_LINES <<< "$ART"

# --- Collecte des informations ----------------------------------------------
os_pretty=""; base=""
if [[ -r /etc/os-release ]]; then
	# shellcheck disable=SC1091
	. /etc/os-release
	os_pretty="${PRETTY_NAME:-${NAME:-Linux}}"
	base="${DEBIAN_BASE:-}"
fi
[[ -z "$os_pretty" ]] && os_pretty="$(uname -o 2>/dev/null || echo Linux)"

host_name="$(hostnamectl --static 2>/dev/null || cat /etc/hostname 2>/dev/null || uname -n)"
user_name="${USER:-$(id -un)}"

kernel="$(uname -r)"
arch="$(uname -m)"

uptime_h=""
if command -v uptime >/dev/null 2>&1; then
	uptime_h="$(uptime -p 2>/dev/null | sed 's/^up //')"
fi
if [[ -z "$uptime_h" && -r /proc/uptime ]]; then
	secs="$(cut -d. -f1 /proc/uptime)"
	uptime_h="$(( secs / 86400 ))j $(( (secs % 86400) / 3600 ))h $(( (secs % 3600) / 60 ))m"
fi

pkgs="?"
if command -v dpkg-query >/dev/null 2>&1; then
	pkgs="$(dpkg-query -f '.\n' -W 2>/dev/null | wc -l) (dpkg)"
fi

shell_name="$(basename "${SHELL:-sh}")"
if [[ "$shell_name" == "bash" ]]; then
	shell_name="bash ${BASH_VERSION%%(*}"
fi

de="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-console}}"
term_name="${TERM_PROGRAM:-}"
[[ -z "$term_name" ]] && term_name="$(ps -o comm= -p "${PPID:-$$}" 2>/dev/null || echo "${TERM:-tty}")"

cpu="inconnu"
if [[ -r /proc/cpuinfo ]]; then
	cpu="$(awk -F: '/model name/{gsub(/^ +| +$/,"",$2); print $2; exit}' /proc/cpuinfo)"
	[[ -z "$cpu" ]] && cpu="$(awk -F: '/Model/{gsub(/^ +| +$/,"",$2); print $2; exit}' /proc/cpuinfo)"
	cores="$(nproc 2>/dev/null || echo '?')"
	cpu="${cpu} (${cores} cœurs)"
fi

# --- Le pilote NVIDIA embarqué dans CETTE ISO -------------------------------
#  ═══ POURQUOI ÇA SE LIT ICI, ET PAS SEULEMENT DANS UN RAPPORT ═══
#  Une ISO « pro » peut partir sans pilote NVIDIA : la cascade du hook 0260 a
#  quatre branches, et la dernière est « rien ». Avant, ça ne se voyait nulle
#  part depuis la machine — ni ici, ni dans lexos tv. On démarrait, l'écran
#  restait en console, et on cherchait du côté du BIOS pendant une soirée
#  alors que l'ISO elle-même n'avait pas de quoi afficher quoi que ce soit.
#  Le hook écrit maintenant son résultat dans build.conf ; il se lit d'un
#  coup d'œil, et la ligne est ÉCRITE EN CLAIR quand le pilote manque.
#
#  TROIS RÉPONSES, PAS DEUX. « sans-objet » (saveur standard, qui ne promet
#  aucun pilote NVIDIA) et clé absente (ISO d'avant ce changement) ne sont
#  pas des pannes : on n'affiche alors RIEN, plutôt que d'inquiéter pour rien.
nvidia_ligne=""
flavour=""
LEXOS_BUILD_CONF="${LEXOS_BUILD_CONF:-/etc/lexos/build.conf}"
if [[ -r "$LEXOS_BUILD_CONF" ]]; then
	#  ═══ LA SAVEUR, SUR LA LIGNE « OS » ═══
	#  Rien ne permettait de savoir, DEPUIS LA MACHINE, quelle ISO avait été
	#  gravée. Or les saveurs ne promettent pas la même chose : seule « pro »
	#  embarque un pilote NVIDIA (hook 0260), et c'est exactement la question
	#  qu'on se pose devant un écran resté en console. Six saveurs existent
	#  (minimal, standard, dev, full, gaming, pro) et elles se ressemblent
	#  toutes une fois démarrées.
	#
	#  ⚠ ELLE EST DÉJÀ DANS /etc/os-release, ET C'EST LÀ QU'ON LA LIT.
	#  Le hook 0100 l'y écrit (LEXOS_FLAVOUR), et ce fichier-ci source
	#  os-release une cinquantaine de lignes plus haut : la variable est donc
	#  DÉJÀ posée quand on arrive ici. La première version relisait quand même
	#  build.conf « au cas où la clé manquerait », et son commentaire promettait
	#  de ne rien inventer sur une ISO d'avant ce changement — mais la branche
	#  n'était jamais atteinte, puisque os-release avait déjà tout dit. Le banc
	#  la certifiait verte sans l'exercer : un faux vert de plus.
	#  build.conf reste en second recours, pour une machine dont l'os-release
	#  aurait été remplacé.
	flavour="${LEXOS_FLAVOUR:-}"
	if [[ -z "$flavour" ]]; then
		# shellcheck disable=SC1090
		flavour="$( . "$LEXOS_BUILD_CONF" 2>/dev/null; printf '%s' "${LEXOS_FLAVOUR:-}" )"
	fi
	# shellcheck disable=SC1090
	nv_etat="$( . "$LEXOS_BUILD_CONF" 2>/dev/null; printf '%s' "${LEXOS_NVIDIA_ETAT:-}" )"
	# shellcheck disable=SC1090
	nv_version="$( . "$LEXOS_BUILD_CONF" 2>/dev/null; printf '%s' "${LEXOS_NVIDIA_VERSION:-}" )"
	# shellcheck disable=SC1090
	nv_module="$( . "$LEXOS_BUILD_CONF" 2>/dev/null; printf '%s' "${LEXOS_NVIDIA_MODULE:-}" )"
	case "$nv_etat" in
		ok)
			nvidia_ligne="${nv_version:-installé}"
			[[ "$nv_module" == "non" ]] && nvidia_ligne="${nvidia_ligne} — module noyau ABSENT"
			;;
		absent|absent-accepte)
			nvidia_ligne="ABSENT DE CETTE ISO — voir /etc/lexos/nvidia-report"
			;;
	esac
fi

gpu=""
if command -v lspci >/dev/null 2>&1; then
	gpu="$(lspci 2>/dev/null | grep -Ei 'vga|3d|display' \
		| head -n1 | sed 's/.*: //; s/ (rev .*//')"
fi
[[ -z "$gpu" ]] && gpu="—"

mem="?"
if [[ -r /proc/meminfo ]]; then
	mem_total_kb="$(awk '/MemTotal/{print $2}' /proc/meminfo)"
	mem_avail_kb="$(awk '/MemAvailable/{print $2}' /proc/meminfo)"
	mem_used_mb=$(( (mem_total_kb - mem_avail_kb) / 1024 ))
	mem_total_mb=$(( mem_total_kb / 1024 ))
	mem="${mem_used_mb} Mio / ${mem_total_mb} Mio"
fi

disk="$(df -h / 2>/dev/null | awk 'NR==2{print $3" / "$2" ("$5")"}')"
[[ -z "$disk" ]] && disk="—"

res="—"
if command -v xrandr >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
	res="$(xrandr --current 2>/dev/null | awk '/\*/{printf "%s ", $1}' | sed 's/ $//')"
	[[ -z "$res" ]] && res="—"
fi

# --- Construction du panneau d'infos ----------------------------------------
INFO=()
#  Le nom dans l'orange de l'invite, la machine dans le vert de « LEXOS » :
#  la bannière dit la même chose que la ligne d'en dessous.
INFO+=("${B}${U}${user_name}${W}@${B}${H}${host_name}${R}")
INFO+=("${D}────────────────────────────────${R}")
add() { INFO+=("${A}${1}${R}${D}:${R} ${W}${2}${R}"); }

if [[ -n "$flavour" ]]; then
	add "OS       " "$os_pretty · $flavour · $arch"
else
	#  Ni os-release ni build.conf ne la donnent : on n'invente pas
	#  « standard », on affiche la ligne comme avant.
	add "OS       " "$os_pretty $arch"
fi
[[ -n "$base" ]] && add "Base     " "Debian $base"
add "Noyau    " "$kernel"
add "Uptime   " "${uptime_h:-—}"
add "Paquets  " "$pkgs"
add "Shell    " "$shell_name"
add "Bureau   " "$de"
[[ "$res" != "—" ]] && add "Écran    " "$res"
add "Terminal " "$term_name"
add "CPU      " "$cpu"
[[ "$gpu" != "—" ]] && add "GPU      " "$gpu"
[[ -n "$nvidia_ligne" ]] && add "Pilote NV" "$nvidia_ligne"
add "Mémoire  " "$mem"
add "Disque / " "$disk"
INFO+=("")
INFO+=("${O}███${A}███${W}███${D}███${R}   ${D}lexos help${R}")

# --- Rendu côte à côte -------------------------------------------------------
art_w=0
for l in "${ART_LINES[@]}"; do
	(( ${#l} > art_w )) && art_w=${#l}
done

rows=$(( ${#ART_LINES[@]} > ${#INFO[@]} ? ${#ART_LINES[@]} : ${#INFO[@]} ))
top_pad=$(( (${#ART_LINES[@]} - ${#INFO[@]}) / 2 ))
(( top_pad < 0 )) && top_pad=0

echo
for (( i = 0; i < rows; i++ )); do
	art="${ART_LINES[i]:-}"
	pad=$(( art_w - ${#art} ))
	(( pad < 0 )) && pad=0
	printf '%s%s%s%*s   ' "$O" "$art" "$R" "$pad" ""

	idx=$(( i - top_pad ))
	if (( idx >= 0 && idx < ${#INFO[@]} )); then
		printf '%s' "${INFO[idx]}"
	fi
	printf '\n'
done
echo

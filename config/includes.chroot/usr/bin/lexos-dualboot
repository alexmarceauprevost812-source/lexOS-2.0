#!/bin/sh
# =============================================================================
#  lexos-dualboot — vérifier qu'installer À CÔTÉ D'UN AUTRE SYSTÈME ira bien
# =============================================================================
#  CE QUE CET OUTIL FAIT, ET SURTOUT CE QU'IL NE FAIT PAS.
#
#  Il LIT. Il ne redimensionne rien, il n'écrit sur aucune partition, il ne
#  crée rien. Toutes ses commandes sont en lecture seule : lsblk, parted
#  print, ntfsresize --info (qui simule et n'écrit jamais), efibootmgr sans
#  argument. On peut le lancer autant de fois qu'on veut, à n'importe quel
#  moment, sans aucun risque pour Windows.
#
#  POURQUOI IL NE REDIMENSIONNE PAS TOUT SEUL. La tentation existait :
#  réduire la partition Windows automatiquement pour préparer exactement
#  40 Go. Deux raisons de ne pas le faire, et elles sont solides :
#
#    1. Calamares le fait déjà, et mieux. Son écran « Installer à côté de »
#       montre un curseur qui découpe la partition existante, et son code de
#       redimensionnement NTFS tourne sur des millions de machines depuis des
#       années. Un script maison, écrit ici, n'aurait jamais été essayé sur
#       le disque de personne avant celui d'Alex. Sur un disque qui contient
#       ses jeux et ses fichiers, ce n'est pas un pari acceptable.
#    2. Calamares montre toujours un résumé et demande confirmation avant
#       d'écrire. Un script lancé automatiquement, non.
#
#  Le rôle de cet outil est donc celui d'un copilote : il dit ce que Windows
#  raconte, prévient de ce qui bloquerait, et donne LE CHIFFRE EXACT à régler
#  sur le curseur de Calamares. La décision et l'écriture restent à
#  l'installateur et à l'utilisateur.
#
#  Tout est du logiciel libre : lsblk et parted (GPL), ntfsresize de ntfs-3g
#  (GPL-2), os-prober (GPL), GRUB (GPL-3). Aucun outil propriétaire.
# =============================================================================
set -u

#  LES OUTILS DE DISQUE ET DE MATERIEL NE SONT PAS DANS LE PATH D'UN
#  PROGRAMME DU BUREAU. Debian ne met les repertoires sbin dans le PATH que
#  pour root (/etc/profile teste l'UID) : un compte ordinaire recoit
#  /usr/local/bin:/usr/bin:/bin et rien d'autre. Un outil lance depuis une
#  action du clic droit ou depuis les Parametres ne trouvait donc pas des
#  commandes pourtant installees, et annoncait « outil manquant » a tort.
#  Voir lexos-format, ou le defaut s'est vu en premier.
#  EN QUEUE, JAMAIS EN TETE, et ce n'est pas un detail de style : mis
#  devant, ces repertoires passeraient AVANT ce que l'utilisateur — ou un
#  banc d'essai — a deja mis dans son PATH. Les bancs de ce depot injectent
#  de faux outils par un repertoire en tete de PATH ; les doubler par les
#  vrais aurait rendu ces bancs aveugles. Attrape par deux d'entre eux, qui
#  ont rougi tout de suite.
#  Sans risque la ou ces repertoires n'existent pas : un chemin absent du
#  disque ne coute rien dans un PATH.
#  SEAM DE BANC. Un banc qui simule un outil ABSENT le fait en
#  restreignant le PATH ; lui rajouter les sbin le rendrait aveugle et
#  ferait passer pour presente une commande que la machine reelle
#  n'aurait pas. LEXOS_SANS_SBIN=1 desactive l'ajout.
[ "${LEXOS_SANS_SBIN:-}" = "1" ] || PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"
export PATH

PROG="${0##*/}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
	O=$(printf '\033[38;5;208m'); G=$(printf '\033[32m'); Y=$(printf '\033[33m')
	E=$(printf '\033[31m');       B=$(printf '\033[1m');  D=$(printf '\033[2m')
	R=$(printf '\033[0m')
else
	O=''; G=''; Y=''; E=''; B=''; D=''; R=''
fi

titre() { printf '\n%s%s%s\n' "$B$O" "$*" "$R"; }
ok()    { printf '  %s✓%s %s\n' "$G" "$R" "$*"; }
attn()  { printf '  %s!%s %s\n' "$Y" "$R" "$*"; }
non()   { printf '  %s✗%s %s\n' "$E" "$R" "$*"; }
info()  { printf '    %s%s%s\n' "$D" "$*" "$R"; }

#  La place visée pour LexOS, en gigaoctets. 40 Go est le choix d'Alex :
#  assez pour être à l'aise, et un plafond qu'il ne veut pas dépasser.
#  ALEX : « je voudrais qu'on choisisse le nombre de mémoire qu'il peut
#  prendre ». C'était une variable d'environnement — donc, en pratique,
#  inatteignable : personne n'écrit « LEXOS_DUALBOOT_CIBLE_GO=60 lexos
#  dualboot » devant un disque qu'il a peur d'abîmer. Ça se demande
#  maintenant en clair : « lexos dualboot 60 ». La variable reste, pour les
#  bancs et pour qui scripte.
CIBLE_GO="${LEXOS_DUALBOOT_CIBLE_GO:-40}"
#  Ce dont LexOS a réellement besoin — le même plancher que requiredStorage
#  dans partition.conf. En dessous, ça ne rentre pas.
PLANCHER_GO="${LEXOS_DUALBOOT_PLANCHER_GO:-25}"
#  Ce qu'on refuse de prendre à Windows : sous ce seuil de place LIBRE
#  restante, Windows commence à mal fonctionner (mises à jour qui échouent,
#  fichier d'échange à l'étroit).
WINDOWS_LIBRE_MIN_GO="${LEXOS_WINDOWS_LIBRE_MIN_GO:-30}"
#  Le même seuil pour un Linux voisin, mais PLUS BAS, et ce n'est pas un
#  arrondi : Windows a besoin d'air pour ses mises à jour cumulatives et son
#  fichier d'échange, un Linux beaucoup moins. Lui prendre 30 Go « par
#  symétrie » aurait refusé des découpes parfaitement saines.
LINUX_LIBRE_MIN_GO="${LEXOS_LINUX_LIBRE_MIN_GO:-10}"

case "${1:-}" in
	-h|--help|aide|help)
		cat <<AIDE
${B}${PROG}${R} — vérifier avant d'installer LexOS à côté d'un autre système

  ${O}${PROG}${R}              Le bilan complet — le voisin, la place, le démarrage
  ${O}${PROG} ${B}60${R}${R}           Le même bilan, en visant ${B}60 Go${R} pour LexOS

  ${O}${PROG} defaut${R}       Quel système démarre tout seul aujourd'hui
  ${O}${PROG} defaut lexos${R}  LexOS part tout seul après les 8 secondes
  ${O}${PROG} defaut voisin${R} C'est le voisin qui part tout seul

Le voisin peut être ${B}Windows${R} ou un autre ${B}Linux${R} (Ubuntu, Mint, Fedora…).

${B}Cet outil ne modifie RIEN.${R} Il lit le disque et te dit quoi faire.
Le redimensionnement, c'est l'installateur qui le fait, avec sa
confirmation à l'écran.

Réglages (variables d'environnement) :
  ${D}LEXOS_DUALBOOT_CIBLE_GO${R}       place visée pour LexOS   ${D}(défaut : 40)${R}
  ${D}LEXOS_WINDOWS_LIBRE_MIN_GO${R}    libre à laisser à Windows ${D}(défaut : 30)${R}
  ${D}LEXOS_LINUX_LIBRE_MIN_GO${R}      libre à laisser au Linux voisin ${D}(défaut : 10)${R}
AIDE
		exit 0
		;;
esac

# =============================================================================
#  « defaut » — LA SEULE COMMANDE DE CE FICHIER QUI ÉCRIVE QUELQUE CHOSE
# =============================================================================
#  L'en-tête dit « il LIT, il ne modifie rien » et ça reste vrai de TOUT le
#  bilan : lancé sans argument, ou avec un nombre de gigaoctets, cet outil ne
#  touche à rien. « defaut » est une commande à part, qu'il faut taper, qui
#  porte son effet dans son nom, et qui n'écrit NI sur une partition NI dans
#  une table de partitions : une ligne dans /etc/lexos/dualboot-defaut.
#
#  POURQUOI ELLE EXISTE. Le choix passait par une variable d'environnement —
#  donc, en pratique, par personne : « la raison est écrite noir sur blanc »
#  quelques lignes plus haut pour la taille, et elle vaut mot pour mot ici.
#
#  UN SEUL ÉCRIVAIN DE grubenv. On n'écrit PAS grubenv d'ici : on pose le
#  choix, puis on relance /usr/lib/lexos/grub-defaut-voisin, qui est déjà le
#  service qui le fait à chaque démarrage. Deux écrivains pour un fichier,
#  c'est deux vérités — la faute que ce dépôt a déjà payée ailleurs.
CHOIX_FICHIER="${LEXOS_DUALBOOT_DEFAUT_FICHIER:-/etc/lexos/dualboot-defaut}"
SERVICE_DEFAUT="${LEXOS_GRUB_DEFAUT_BIN:-/usr/lib/lexos/grub-defaut-voisin}"

lire_choix() {
	[ -r "$CHOIX_FICHIER" ] || { printf ''; return 0; }
	_lc="$(tr -d '[:space:]' < "$CHOIX_FICHIER" 2>/dev/null)"
	case "$_lc" in lexos|voisin) printf '%s' "$_lc" ;; *) printf '' ;; esac
}

if [ "${1:-}" = "defaut" ]; then
	titre "LE SYSTÈME QUI DÉMARRE TOUT SEUL"
	ACTUEL="$(lire_choix)"
	case "${2:-}" in
		"")
			#  LECTURE SEULE : on dit ce qui est écrit, et ce que ça donne.
			if [ -z "$ACTUEL" ]; then
				info "aucun choix écrit dans $CHOIX_FICHIER"
				ok "LexOS part tout seul, sauf si un Windows est installé à côté"
				info "(Windows d'abord : c'est la demande d'origine — Windows pour jouer.)"
			else
				ok "choix écrit : ${B}${ACTUEL}${R}"
			fi
			if command -v grub-editenv >/dev/null 2>&1; then
				EN="$(grub-editenv - list 2>/dev/null | sed -n 's/^saved_entry=//p' | head -1)"
				if [ -n "$EN" ]; then
					info "grubenv désigne aujourd'hui : ${EN}"
				else
					info "grubenv ne désigne rien : GRUB part sur sa première entrée (LexOS)."
				fi
			else
				attn "grub-editenv absent — l'état réel de grubenv n'a PAS été lu"
			fi
			printf '\n'
			info "Pour changer : ${PROG} defaut lexos   ·   ${PROG} defaut voisin"
			exit 0
			;;
		lexos|voisin)
			VOULU="$2"
			#  ═══ IL FAUT LES DROITS, ET ON NE LES DEMANDE PAS SOI-MÊME ═══
			#  Pas d'invite de mot de passe maison : on dit la commande
			#  exacte à retaper. C'est la règle du dépôt, et c'est aussi la
			#  seule façon qu'Alex voie ce qu'il autorise.
			if [ "$(id -u)" != "0" ]; then
				non "il faut les droits d'administrateur pour écrire ce choix"
				printf '\n'
				printf '  %sÀ retaper tel quel :%s\n' "$B" "$R"
				printf '      %ssudo %s defaut %s%s\n' "$B$O" "$PROG" "$VOULU" "$R"
				printf '\n'
				exit 1
			fi
			mkdir -p "$(dirname "$CHOIX_FICHIER")" 2>/dev/null || true
			if printf '%s\n' "$VOULU" > "$CHOIX_FICHIER" 2>/dev/null; then
				ok "choix enregistré : ${VOULU}  (${CHOIX_FICHIER})"
			else
				non "impossible d'écrire $CHOIX_FICHIER — rien n'a changé"
				exit 1
			fi
			#  ON APPLIQUE TOUT DE SUITE. Sans ça, le choix ne prendrait effet
			#  qu'au démarrage SUIVANT — et un réglage qui ne se voit pas
			#  passe pour un réglage qui ne marche pas.
			if [ -x "$SERVICE_DEFAUT" ]; then
				if "$SERVICE_DEFAUT"; then
					ok "appliqué maintenant — le menu reste 8 s pour choisir l'autre"
				else
					attn "le choix est écrit, mais son application a échoué"
					info "Il sera repris au prochain démarrage (service lexos-grub-defaut)."
				fi
			else
				attn "$SERVICE_DEFAUT introuvable — le choix est écrit mais PAS appliqué"
				info "Il sera repris au prochain démarrage si le service est installé."
			fi
			exit 0
			;;
		*)
			non "« $2 » : je ne connais que « lexos » et « voisin »"
			printf '  Exemple : %s defaut voisin\n' "$PROG" >&2
			exit 2
			;;
	esac
fi

# --- La taille demandée, s'il y en a une ------------------------------------
#  ON REFUSE PLUTÔT QUE DE DEVINER. « lexos dualboot 60Go », « lexos dualboot
#  soixante », « lexos dualboot -60 » : chacun a l'air d'un chiffre et n'en
#  est pas un. Les prendre pour 0 ou pour 60 au petit bonheur donnerait un
#  conseil de découpe faux sur le disque qui contient les jeux d'Alex. On dit
#  ce qu'on a compris et on s'arrête, avant d'avoir rien affiché d'autre.
#
#  Le PLANCHER est le même que « requiredStorage » dans partition.conf : sous
#  ce chiffre, LexOS ne rentre pas, et conseiller une découpe qui ne rentre
#  pas ne rend service à personne. Le PLAFOND (4000 Go) n'existe que pour
#  attraper la faute de frappe — « 400 » tapé « 4000 » sur un disque de 500.
TAILLE_DEMANDEE=""
case "${1:-}" in
	"")           ;;
	--taille)     TAILLE_DEMANDEE="${2:-}" ;;
	--taille=*)   TAILLE_DEMANDEE="${1#--taille=}" ;;
	*)            TAILLE_DEMANDEE="$1" ;;
esac
if [ -n "$TAILLE_DEMANDEE" ]; then
	case "$TAILLE_DEMANDEE" in
		''|*[!0-9]*)
			printf '%s : « %s » n'\''est pas un nombre de gigaoctets.\n' \
				"$PROG" "$TAILLE_DEMANDEE" >&2
			printf '  Exemple : %s 60   (soixante gigaoctets pour LexOS)\n' "$PROG" >&2
			exit 2
			;;
	esac
	if [ "$TAILLE_DEMANDEE" -lt "$PLANCHER_GO" ]; then
		printf '%s : %s Go, c'\''est moins que le minimum de %s Go — LexOS n'\''y tiendrait pas.\n' \
			"$PROG" "$TAILLE_DEMANDEE" "$PLANCHER_GO" >&2
		exit 2
	fi
	if [ "$TAILLE_DEMANDEE" -gt 4000 ]; then
		printf '%s : %s Go, c'\''est plus grand que tout disque courant — faute de frappe ?\n' \
			"$PROG" "$TAILLE_DEMANDEE" >&2
		exit 2
	fi
	CIBLE_GO="$TAILLE_DEMANDEE"
fi

# --- Trouver Windows --------------------------------------------------------
#  On cherche la plus GROSSE partition NTFS, pas la première : un disque
#  Windows porte souvent une petite NTFS de récupération (« Recovery », 500 Mo
#  à 1 Go) avant la vraie partition système. Réduire celle-là n'apporterait
#  rien et casserait les outils de réparation de Windows.
trouver_windows() {
	lsblk -brno NAME,FSTYPE,SIZE 2>/dev/null \
		| awk '$2=="ntfs" && $3+0 > 20000000000 {print $3, $1}' \
		| sort -rn | head -1 | awk '{print $2}'
}

#  UN WINDOWS CHIFFRÉ N'EST PAS UN DISQUE VIDE. BitLocker ne présente pas
#  « ntfs » à lsblk (via blkid) mais « BitLocker » : trouver_windows() ne
#  trouvait donc rien, et le message qui suivait disait « soit ce disque n'a
#  pas Windows » — sur un disque qui EN a un, simplement verrouillé. Sur une
#  machine chiffrée, c'était une invitation à installer « à côté » en
#  croyant qu'il n'y avait rien à côté de quoi installer, alors que
#  l'installateur aurait proposé d'utiliser le disque entier.
trouver_windows_chiffre() {
	lsblk -brno NAME,FSTYPE,SIZE 2>/dev/null \
		| awk 'tolower($2) ~ /bitlocker/ && $3+0 > 20000000000 {print $3, $1}' \
		| sort -rn | head -1 | awk '{print $2}'
}

# --- Trouver un AUTRE LINUX -------------------------------------------------
#  ALEX : « l'ISO, peux-tu l'installer à côté d'un autre logiciel comme
#  Ubuntu ? » Oui — Calamares sait déjà découper une partition ext4 comme il
#  découpe une NTFS, et os-prober voit un Ubuntu comme il voit un Windows.
#  Ce qui manquait, c'était CET OUTIL : il ne cherchait que du NTFS, donc
#  devant un disque Ubuntu il annonçait « aucune partition Windows trouvée »
#  et laissait Alex sans le chiffre à régler sur le curseur.
#
#  ON EXCLUT NOTRE PROPRE RACINE, et ce n'est pas une précaution théorique :
#  lancé depuis un LexOS DÉJÀ INSTALLÉ, l'ext4 le plus gros du disque est le
#  nôtre. Sans ce filtre, l'outil proposerait sereinement de se réduire
#  lui-même pour se faire de la place. Depuis la clé USB le cas ne se pose
#  pas (la racine est un squashfs), donc il ne se verrait qu'après coup, sur
#  la machine d'Alex.
racine_a_nous() {
	_ra="$(findmnt -no SOURCE / 2>/dev/null | head -1)"
	case "$_ra" in
		/dev/*) printf '%s' "${_ra#/dev/}" ;;
		*)      printf '' ;;
	esac
}

trouver_linux() {
	_tlnous="$(racine_a_nous)"
	lsblk -brno NAME,FSTYPE,SIZE 2>/dev/null \
		| awk -v nous="$_tlnous" '
			($2=="ext4" || $2=="ext3" || $2=="btrfs" || $2=="xfs") \
			&& $3+0 > 20000000000 && $1 != nous {print $3, $1, $2}' \
		| sort -rn | head -1 | awk '{print $2, $3}'
}

#  UN LINUX CHIFFRÉ OU EN LVM N'EST PAS UN DISQUE VIDE NON PLUS — et c'est
#  EXACTEMENT le cas de l'Alienware d'Alex, dont l'Ubuntu est en LUKS2 + LVM.
#
#  Le même piège que BitLocker, à l'autre bout : dans un LUKS, lsblk montre
#  « crypto_LUKS » sur la partition, et l'ext4 n'apparaît qu'APRÈS
#  déverrouillage, sur un périphérique /dev/mapper qui n'existe pas encore.
#  Dans un LVM, c'est « LVM2_member ». Dans les deux cas trouver_linux() ne
#  voyait rien, et l'outil enchaînait « aucune autre partition Linux » puis
#  « aucun voisin : l'installateur proposera d'utiliser le disque en entier ».
#  Sur le disque qui porte l'Ubuntu d'Alex. C'est la phrase la plus dangereuse
#  que cet outil pouvait prononcer, et il la prononçait avec aplomb.
#
#  ON NE MESURE PAS CE VOISIN-LÀ, et ce n'est pas un manque de courage :
#  Calamares ne sait PAS redimensionner une partition chiffrée ni un volume
#  LVM. Donner un chiffre à régler sur un curseur qui n'apparaîtra jamais
#  serait pire que de se taire. Ce qu'il faut dire, c'est qu'il y a quelque
#  chose là, et par où passer.
trouver_linux_chiffre() {
	_tlcnous="$(racine_a_nous)"
	lsblk -brno NAME,FSTYPE,SIZE 2>/dev/null \
		| awk -v nous="$_tlcnous" '
			($2=="crypto_LUKS" || $2=="LVM2_member") \
			&& $3+0 > 20000000000 && $1 != nous {print $3, $1, $2}' \
		| sort -rn | head -1 | awk '{print $2, $3}'
}

#  LA PLACE OCCUPÉE DANS UN EXT4, SANS LE MONTER. C'est l'équivalent exact de
#  « ntfsresize --info » pour Windows : dumpe2fs -h ne lit que le superbloc,
#  n'écrit jamais rien, et vient d'e2fsprogs, qui est dans la liste des
#  paquets OBLIGATOIRES de LexOS. Il donne aussi l'état du système de
#  fichiers : un ext4 « not clean » ne se redimensionne pas plus qu'un
#  Windows hiberné.
#  Rend « <utilisé en Go> <état> » ; rien du tout s'il n'a pas pu lire.
mesurer_ext4() { # mesurer_ext4 <périphérique>
	command -v dumpe2fs >/dev/null 2>&1 || return 1
	dumpe2fs -h "$1" 2>/dev/null | awk '
		/^Block count:/      { bc = $3 }
		/^Free blocks:/      { fb = $3 }
		/^Block size:/       { bs = $3 }
		#  « not clean » fait DEUX mots : prendre $3 seul aurait affiché
		#  « état : not », qui ne veut rien dire pour qui le lit.
		/^Filesystem state:/ { st = $3; for (i = 4; i <= NF; i++) st = st " " $i }
		END {
			if (bc == "" || fb == "" || bs == "") exit 1
			printf "%d %s\n", (bc - fb) * bs / 1000000000, (st == "" ? "inconnu" : st)
		}'
}

# --- La partition EFI, la table de partitions, et comment on les lit --------
#  ═══ B3/B4 : LE MODE D'AMORÇAGE ET LA PLACE SUR L'EFI PARTAGÉE ═══
#  ALEX : « LexOS Pro à côté d'Ubuntu 26.04.1 dans mon ThinkPad ».
#  Deux pièges qui se voient TARD — après l'installation, ou des semaines
#  après — et qui doivent être dits AVANT de toucher au disque :
#    · UEFI d'un bord, BIOS de l'autre : deux systèmes vivants dont aucun ne
#      voit l'autre. Pas théorique sur cette machine : l'installation de
#      juillet sur le ThinkPad avait une table MS-DOS (« partition primaire
#      n°1 » + « logique n°5 »), signature du mode BIOS.
#    · une partition EFI trop petite : partition.conf RÉUTILISE celle du
#      voisin, et sa taille est ce qu'Ubuntu a choisi. LexOS y ajoute shim
#      et grubx64.efi. Une installation qui échoue à la TOUTE DERNIÈRE
#      étape, celle de grub-install, est le pire moment possible.

#  La partition EFI par son TYPE de partition, pas par son nom ni par son
#  drapeau : c12a7328-… est le GUID que la norme UEFI lui réserve sur une
#  table GPT ; 0xef est son équivalent sur une table MS-DOS.
trouver_esp() {
	lsblk -brno NAME,PARTTYPE 2>/dev/null \
		| awk 'tolower($2)=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" || tolower($2)=="0xef" {print $1; exit}'
}

#  La table de partitions d'un disque : « gpt » ou « msdos », lu par parted
#  print (lecture seule). Rien du tout si parted manque ou ne répond pas.
table_du_disque() { # table_du_disque </dev/sdX>
	command -v parted >/dev/null 2>&1 || return 1
	parted -sm "$1" print 2>/dev/null | awk -F: 'NR==2 {print $6}'
}

#  ═══ LIRE L'EFI SANS RIEN Y ÉCRIRE ═══
#  Depuis la clé USB, la partition EFI du disque n'est montée nulle part —
#  et df, comme ls, ne sait rien d'une partition non montée. On la monte
#  donc EN LECTURE SEULE (-o ro), dans un dossier temporaire, et on la
#  démonte aussitôt après. Un montage « ro » n'écrit pas un octet sur la
#  partition : le contrat « il lit » tient. Sans les droits, on ne monte
#  pas — et on DIT que la mesure n'a pas été faite, au lieu d'inventer.
#  Si elle est déjà montée (LexOS installé : /boot/efi), on lit là où elle
#  est et on ne touche à rien.
ESP_MNT=""
ESP_MONTEE_PAR_NOUS=""
ESP_RAISON=""
ouvrir_esp() { # ouvrir_esp <nom de partition sans /dev/>
	_oe="/dev/$1"
	ESP_MNT="$(findmnt -no TARGET "$_oe" 2>/dev/null | head -1)"
	[ -n "$ESP_MNT" ] && return 0
	if [ "$(id -u)" != "0" ]; then
		ESP_RAISON="partition EFI non montée et pas les droits pour la lire — relance avec sudo pour cette mesure"
		return 1
	fi
	_oed="$(mktemp -d -t lexos-dualboot-efi.XXXXXX 2>/dev/null)" || { ESP_RAISON="mktemp a échoué"; return 1; }
	if mount -o ro,noatime "$_oe" "$_oed" 2>/dev/null; then
		ESP_MNT="$_oed"; ESP_MONTEE_PAR_NOUS=1
		return 0
	fi
	rmdir "$_oed" 2>/dev/null
	ESP_RAISON="mount -o ro a refusé $_oe"
	return 1
}
fermer_esp() {
	[ -n "$ESP_MONTEE_PAR_NOUS" ] || return 0
	umount "$ESP_MNT" 2>/dev/null && rmdir "$ESP_MNT" 2>/dev/null
	ESP_MONTEE_PAR_NOUS=""
	return 0
}
#  Quoi qu'il arrive — Ctrl-C au milieu compris — on ne laisse pas un
#  montage temporaire derrière nous.
trap fermer_esp EXIT INT TERM

# --- Le disque et la partition ----------------------------------------------
WIN_PART="$(trouver_windows)"

#  ON CHERCHE LE VOISIN LINUX ICI, AVANT D'AFFICHER QUOI QUE CE SOIT.
#  Sa SECTION vient plus bas, mais son existence change ce que la section
#  Windows a le droit de dire : « aucune partition Windows — l'installateur
#  proposera d'utiliser tout le disque » est rassurant sur un disque vide et
#  FAUX sur un disque qui porte un Ubuntu. C'est la phrase qui déciderait
#  Alex à laisser l'installateur tout prendre.
LNX_LIGNE="$(trouver_linux)"
LNX_PART="${LNX_LIGNE%% *}"
LNX_FS="${LNX_LIGNE##* }"

#  ET LE VOISIN CHIFFRÉ / LVM, pour la même raison, au même moment : sa
#  présence change elle aussi ce que les sections suivantes ont le droit de
#  dire. On ne le cherche que si aucun voisin en clair n'a été trouvé — un
#  disque qui porte les deux (un /boot ext4 et un LVM chiffré à côté) est
#  déjà couvert par le voisin en clair, et deux annonces pour un seul
#  système embrouilleraient plus qu'elles n'aideraient.
LNXC_PART=""
LNXC_FS=""
if [ -z "$LNX_PART" ]; then
	LNXC_LIGNE="$(trouver_linux_chiffre)"
	LNXC_PART="${LNXC_LIGNE%% *}"
	LNXC_FS="${LNXC_LIGNE##* }"
fi

titre "WINDOWS"
if [ -z "$WIN_PART" ]; then
	WIN_CHIFFRE="$(trouver_windows_chiffre)"
	if [ -n "$WIN_CHIFFRE" ]; then
		#  ON NE S'ARRÊTE PAS ICI. Cet outil ne fait jamais que lire et ne
		#  s'interrompt jamais en cours de route — même sans Windows trouvé
		#  du tout, il continue jusqu'au bilan de démarrage (UEFI, GRUB,
		#  os-prober), qui reste vrai et utile quel que soit l'état de
		#  Windows. WIN_DEV reste vide à dessein : personne ne peut réduire
		#  une partition chiffrée, il n'y a donc rien à céder côté place.
		non "Windows est là, sur /dev/${WIN_CHIFFRE}, mais il est CHIFFRÉ (BitLocker)"
		printf '\n'
		printf '  Personne — ni LexOS, ni Calamares, ni GParted — ne peut réduire\n'
		printf '  une partition chiffrée. Il faut d'\''abord la déchiffrer.\n\n'
		printf '  %sÀ faire dans Windows, une seule fois :%s\n' "$B" "$R"
		printf '    1. Paramètres → Confidentialité et sécurité → Chiffrement de l'\''appareil\n'
		printf '    2. Désactiver le chiffrement (compter plusieurs heures)\n'
		printf '    3. Décocher aussi le démarrage rapide, puis Arrêter\n\n'
		info "NOTE ta clé de récupération avant de toucher à quoi que ce soit."
		info "Tant que ce n'est pas fait, l'installateur ne verra ici qu'un disque"
		info "sans Windows — et pourrait proposer d'utiliser le disque ENTIER."
	else
		attn "aucune partition Windows (NTFS) de plus de 20 Go trouvée"
		info "Soit ce disque n'a pas Windows, soit il n'est pas branché."
		if [ -n "$LNX_PART" ]; then
			info "Mais il y a un autre Linux dessus — voir la section suivante."
		elif [ -n "$LNXC_PART" ]; then
			#  LA PHRASE « l'installateur proposera d'utiliser tout le disque »
			#  N'A PAS LE DROIT DE SORTIR ICI : il y a bien un système, il est
			#  seulement illisible d'ici.
			info "Mais il y a un système CHIFFRÉ ou en LVM dessus — voir la section suivante."
		else
			info "Dans ce cas l'installateur proposera d'utiliser tout le disque."
		fi
	fi
	WIN_DEV=""
else
	WIN_DEV="/dev/${WIN_PART}"
	WIN_DISQUE="/dev/$(lsblk -rno PKNAME "$WIN_DEV" 2>/dev/null | head -1)"
	WIN_TAILLE_O="$(lsblk -brno SIZE "$WIN_DEV" 2>/dev/null | head -1)"
	WIN_TAILLE_GO=$((WIN_TAILLE_O / 1000000000))
	ok "Windows trouvé sur ${WIN_DEV} (disque ${WIN_DISQUE})"
	info "taille de sa partition : ${WIN_TAILLE_GO} Go"
fi

# --- Windows a-t-il été VRAIMENT éteint ? -----------------------------------
#  C'est le piège numéro un, et il est invisible : « Démarrage rapide », activé
#  par défaut sur Windows 10 et 11, ne l'éteint pas vraiment — il l'hiberne.
#  Le système de fichiers reste marqué comme en cours d'utilisation, et AUCUN
#  outil ne peut le redimensionner sans risquer de le corrompre. Calamares
#  refusera, ou pire, réussira à moitié.
#
#  On ne devine pas : ntfsresize --info dit lui-même s'il peut travailler.
#  --info ne fait que lire et calculer, il n'écrit jamais.
if [ -n "$WIN_DEV" ]; then
	titre "WINDOWS EST-IL VRAIMENT ÉTEINT ?"
	if ! command -v ntfsresize >/dev/null 2>&1; then
		attn "ntfsresize absent — impossible de vérifier ici"
		info "Le paquet ntfs-3g le fournit. L'installateur vérifiera de son côté."
	else
		RAPPORT="$(ntfsresize --info --no-progress-bar --force "$WIN_DEV" 2>&1)"
		if printf '%s' "$RAPPORT" | grep -qi "hibernat\|dirty\|unclean\|is scheduled\|chkdsk"; then
			non "Windows est HIBERNÉ ou n'a pas été éteint proprement"
			printf '\n'
			printf '  %sÀ faire dans Windows, une seule fois :%s\n' "$B" "$R"
			printf '    1. Panneau de configuration → Options d'\''alimentation\n'
			printf '    2. « Choisir l'\''action des boutons d'\''alimentation »\n'
			printf '    3. « Modifier des paramètres actuellement non disponibles »\n'
			printf '    4. Décocher %s« Activer le démarrage rapide »%s\n' "$B" "$R"
			printf '    5. Enregistrer, puis %sArrêter%s (pas Redémarrer, pas Veille)\n' "$B" "$R"
			printf '\n'
			info "Sans ça, personne ne peut redimensionner Windows sans l'abîmer."
			info "Ce n'est pas un défaut de LexOS : c'est Windows qui reste à moitié allumé."
		else
			MINI_O="$(printf '%s' "$RAPPORT" | grep -i "You might resize at" | grep -oE '[0-9]+' | head -1)"
			ok "Windows est proprement éteint — il peut être redimensionné"
			if [ -n "$MINI_O" ]; then
				MINI_GO=$((MINI_O / 1000000000))
				info "au plus petit, sa partition tiendrait en ${MINI_GO} Go"
			fi
		fi
	fi
fi

# --- Le voisin Linux, s'il y en a un ----------------------------------------
titre "UN AUTRE LINUX ?"
LNX_DEV=""
if [ -n "$LNX_PART" ]; then
	LNX_DEV="/dev/${LNX_PART}"
	LNX_TAILLE_O="$(lsblk -brno SIZE "$LNX_DEV" 2>/dev/null | head -1)"
	LNX_TAILLE_GO=$(( ${LNX_TAILLE_O:-0} / 1000000000 ))
	ok "un autre Linux occupe ${LNX_DEV} (${LNX_FS}, ${LNX_TAILLE_GO} Go)"
	info "Ubuntu, Mint, Fedora… — l'installateur sait le découper comme il découpe Windows."
	info "Et os-prober le mettra dans le menu de démarrage, au même titre."
elif [ -n "$LNXC_PART" ]; then
	LNXC_DEV="/dev/${LNXC_PART}"
	LNXC_TAILLE_O="$(lsblk -brno SIZE "$LNXC_DEV" 2>/dev/null | head -1)"
	LNXC_TAILLE_GO=$(( ${LNXC_TAILLE_O:-0} / 1000000000 ))
	case "$LNXC_FS" in
		crypto_LUKS) QUOI="chiffré (LUKS)" ;;
		LVM2_member) QUOI="en volume LVM" ;;
		*)           QUOI="$LNXC_FS" ;;
	esac
	non "un système ${QUOI} occupe ${LNXC_DEV} (${LNXC_TAILLE_GO} Go)"
	printf '\n'
	#  ═══ B5 : LE CAS NOMMÉ, POUR QU'ALEX S'Y RECONNAISSE ═══
	#  « crypto_LUKS » ne parle à personne. « Ubuntu installé avec le
	#  chiffrement complet du disque » est la case qu'il a cochée — ou pas —
	#  dans l'installateur d'Ubuntu, et c'est par ce nom-là qu'il la
	#  retrouvera.
	printf '  C'\''est ce qu'\''on obtient avec %s« Ubuntu installé avec le chiffrement\n' "$B"
	printf '  complet du disque »%s (la case cochée dans l'\''installateur d'\''Ubuntu),\n' "$R"
	printf '  ou avec un Linux posé en LVM. Ce n'\''est PAS un disque vide — il y a un\n'
	printf '  système là-dedans, et personne ne peut le mesurer sans le\n'
	printf '  déverrouiller d'\''abord.\n\n'
	printf '  %sCalamares ne sait pas redimensionner ça.%s L'\''écran « Installer à\n' "$B" "$R"
	printf '  côté de » ne s'\''affichera donc pas.\n\n'
	#  LA SEULE SORTIE VRAIMENT SIMPLE, EN PREMIER. Réduire après coup un
	#  LUKS + LVM, c'est quatre commandes qui ne pardonnent pas une étape
	#  sautée ; laisser de la place AU MOMENT d'installer Ubuntu, c'est un
	#  curseur. On donne le curseur d'abord, et les quatre commandes après,
	#  pour qui sait ce qu'il fait — pas comme conseil par défaut.
	printf '  %sLa sortie simple :%s laisser de l'\''espace libre AU MOMENT d'\''installer\n' "$B" "$R"
	printf '  Ubuntu — « Installation personnalisée », et ne pas lui donner tout le\n'
	printf '  disque (garder %s Go non alloués). Puis installer LexOS dans cet espace.\n' "$CIBLE_GO"
	printf '  Si Ubuntu est déjà posé et chiffré, le plus sûr est de le RÉINSTALLER\n'
	printf '  ainsi, sauvegarde faite, plutôt que de le réduire après coup.\n\n'
	printf '  %sRéduire après coup — pour qui sait ce qu'\''il fait, dans l'\''ordre :%s\n' "$B" "$R"
	printf '    1. resize2fs    — réduire le système de fichiers\n'
	printf '    2. lvreduce     — réduire le volume logique\n'
	printf '    3. pvresize     — réduire le volume physique\n'
	printf '    4. cryptsetup resize — réduire le conteneur chiffré\n'
	printf '    5. GParted      — réduire enfin la partition\n\n'
	info "Puis : installer LexOS en partitionnement MANUEL, dans l'espace non alloué."
	info "Sauvegarde d'abord. Cette suite-là ne pardonne pas une étape sautée."
else
	info "aucune autre partition Linux de plus de 20 Go sur ce disque."
fi

# --- Combien de place peut-on prendre ? -------------------------------------
#  ═══ UN SEUL CALCUL, DEUX VOISINS ═══
#  Ce raisonnement — ce qui est libre, moins ce qu'on laisse au voisin, contre
#  ce qu'on vise — était écrit en dur pour Windows. Le recopier pour Linux
#  aurait donné deux versions à tenir d'accord, et c'est exactement la faute
#  qui a donné trois palettes de panneaux différentes dans ce dépôt. Il est
#  donc dans une fonction, et les deux voisins l'appellent.
conseil_place() { # conseil_place <nom> <taille Go> <utilisé Go> <libre mini Go> <astuce>
	_cn="$1"; _ct="$2"; _cu="$3"; _cmin="$4"; _cast="$5"
	_clib=$((_ct - _cu))
	info "${_cn} utilise ${_cu} Go sur ${_ct} Go (${_clib} Go de libre)"

	_cess=$((_clib - _cmin))
	[ "$_cess" -lt 0 ] && _cess=0

	if [ "$_cess" -ge "$CIBLE_GO" ]; then
		ok "il y a de quoi donner ${CIBLE_GO} Go à LexOS"
		printf '\n'
		printf '  %sSur l'\''écran « Installer à côté de », règle le curseur à :%s\n' "$B" "$R"
		printf '      %s%s Go pour LexOS%s\n' "$B$O" "$CIBLE_GO" "$R"
		printf '\n'
		info "${_cn} garderait alors $((_ct - CIBLE_GO)) Go, dont $((_clib - CIBLE_GO)) Go de libre."
	elif [ "$_cess" -ge "$PLANCHER_GO" ]; then
		attn "les ${CIBLE_GO} Go visés ne rentrent pas, mais LexOS tient quand même"
		printf '\n'
		printf '  %sRègle le curseur à au plus :%s %s%s Go%s\n' "$B" "$R" "$B$O" "$_cess" "$R"
		printf '\n'
		info "Pour atteindre ${CIBLE_GO} Go, libère $((CIBLE_GO - _cess)) Go dans ${_cn}"
		info "$_cast"
	else
		non "pas assez de place : ${_cess} Go cessibles, il en faut ${PLANCHER_GO} au minimum"
		printf '\n'
		info "Libère au moins $((PLANCHER_GO - _cess)) Go dans ${_cn}, puis relance cette vérification."
		info "$_cast"
	fi
}

# --- B3 : le mode d'amorçage, AVANT de parler de place ----------------------
#  ═══ UEFI D'UN BORD, BIOS DE L'AUTRE = LES DEUX NE SE VERRONT JAMAIS ═══
#  Trois lectures, toutes sans écriture :
#    1. le système COURANT démarre-t-il en UEFI ?  -> /sys/firmware/efi
#    2. la table du disque est-elle GPT ou MS-DOS ? -> parted print
#    3. y a-t-il une partition EFI, et le voisin y a-t-il son dossier ?
#  Si les trois ne concordent pas, on le dit FORT et on dit quoi faire —
#  AVANT de donner un chiffre à régler sur un curseur.
titre "LE MODE D'AMORÇAGE"
#  Le disque du voisin, quel qu'il soit. Avant, WIN_DISQUE n'existait que
#  pour Windows : la mesure d'espace non partitionné, plus bas, ne tournait
#  donc JAMAIS devant un voisin Linux. Un seul nom pour les deux.
DISQUE=""
for _cand in "${WIN_DEV:-}" "${LNX_DEV:-}" "${LNXC_DEV:-}"; do
	[ -n "$_cand" ] || continue
	_pk="$(lsblk -rno PKNAME "$_cand" 2>/dev/null | head -1)"
	[ -n "$_pk" ] && { DISQUE="/dev/$_pk"; break; }
done
[ -n "${WIN_DISQUE:-}" ] || WIN_DISQUE="$DISQUE"

if [ -d /sys/firmware/efi ]; then MODE_ICI="UEFI"; else MODE_ICI="BIOS"; fi
TABLE=""
[ -n "$DISQUE" ] && TABLE="$(table_du_disque "$DISQUE")"
ESP_PART="$(trouver_esp)"

if [ "$MODE_ICI" = "UEFI" ]; then
	ok "cette session a démarré en UEFI"
else
	attn "cette session a démarré en BIOS/CSM"
fi
case "$TABLE" in
	gpt)   ok "table de partitions GPT sur ${DISQUE} — celle qu'UEFI attend" ;;
	msdos) attn "table de partitions MS-DOS sur ${DISQUE} — la signature d'une installation en mode BIOS" ;;
	"")    attn "table de partitions non lue$( [ -n "$DISQUE" ] && printf ' sur %s' "$DISQUE" ) (parted absent, ou pas de voisin trouvé)" ;;
	*)     info "table de partitions : ${TABLE}" ;;
esac

VOISIN_UEFI=""      # "" = pas mesuré · "oui" · "non"
VOISIN_UEFI_NOM=""
if [ -n "$ESP_PART" ]; then
	ok "partition EFI présente : /dev/${ESP_PART}"
	if ouvrir_esp "$ESP_PART"; then
		#  Les dossiers de /EFI, sauf BOOT (le chargeur de secours, pas un
		#  système) et le nôtre. Ce qui reste, c'est le voisin.
		AUTRES=""; TOUS=""
		for _d in "$ESP_MNT"/EFI/*/; do
			[ -d "$_d" ] || continue
			_n="$(basename "$_d")"
			TOUS="$TOUS $_n"
			case "$(printf '%s' "$_n" | tr '[:upper:]' '[:lower:]')" in
				boot|*lexos*) ;;
				*) AUTRES="$AUTRES $_n" ;;
			esac
		done
		if [ -n "$AUTRES" ]; then
			VOISIN_UEFI="oui"; VOISIN_UEFI_NOM="${AUTRES# }"; VOISIN_UEFI_NOM="${VOISIN_UEFI_NOM%% *}"
			ok "le voisin y a son chargeur : EFI/${VOISIN_UEFI_NOM} — il démarre en UEFI"
		else
			VOISIN_UEFI="non"
			attn "aucun chargeur de voisin dans EFI/ (seulement :${TOUS:- rien})"
		fi
	else
		info "le contenu de la partition EFI n'a PAS été lu : ${ESP_RAISON}"
	fi
elif [ "$MODE_ICI" = "UEFI" ]; then
	non "aucune partition EFI sur ce disque — et cette session est en UEFI"
	info "L'installateur devra en CRÉER une : partition.conf compte sur celle du voisin."
fi

#  ═══ LE VERDICT : ÇA CONCORDE, OU ÇA NE CONCORDE PAS ═══
DISCORDE=""
[ "$MODE_ICI" = "UEFI" ] && [ "$TABLE" = "msdos" ]    && DISCORDE="${DISCORDE}A"
[ "$MODE_ICI" = "BIOS" ] && [ "$VOISIN_UEFI" = "oui" ] && DISCORDE="${DISCORDE}B"
[ "$MODE_ICI" = "UEFI" ] && [ -z "$ESP_PART" ]         && DISCORDE="${DISCORDE}C"
[ "$MODE_ICI" = "BIOS" ] && [ "$TABLE" = "gpt" ] && [ -n "$ESP_PART" ] && DISCORDE="${DISCORDE}D"

if [ -n "$DISCORDE" ]; then
	printf '\n'
	non "LES DEUX SYSTÈMES NE SERAIENT PAS DANS LE MÊME MODE D'AMORÇAGE"
	printf '\n'
	printf '  Un LexOS en BIOS à côté d'\''un Ubuntu en UEFI (ou l'\''inverse) donne deux\n'
	printf '  systèmes vivants sur le disque dont AUCUN ne voit l'\''autre dans son menu.\n'
	printf '  Ça ne se voit pas à l'\''installation : ça se voit au redémarrage suivant.\n\n'
	printf '  %sÀ faire AVANT de toucher au disque :%s\n' "$B" "$R"
	case "$DISCORDE" in
		*B*|*D*)
			printf '    · Redémarre sur la clé %sen UEFI%s : BIOS (F1 sur le ThinkPad) → Startup →\n' "$B" "$R"
			printf '      %sUEFI Only%s, puis choisis l'\''entrée « UEFI: … » de la clé.\n' "$B" "$R"
			printf '      Le voisin est en UEFI ; LexOS doit l'\''être aussi.\n'
			;;
		*A*)
			printf '    · Ce disque a une table MS-DOS : il a été préparé pour le mode BIOS.\n'
			printf '      Le plus sain sur cette machine : %sles deux en UEFI%s — Ubuntu réinstallé\n' "$B" "$R"
			printf '      en UEFI (table GPT, partition EFI), puis LexOS à côté.\n'
			printf '      Sinon, les deux en BIOS : redémarre la clé en mode « Legacy ».\n'
			;;
		*C*)
			printf '    · Aucune partition EFI : ou bien le voisin est en BIOS (alors démarre\n'
			printf '      la clé en Legacy aussi), ou bien le disque est vide de tout système.\n'
			;;
	esac
	printf '\n'
	info "Tant que ça ne concorde pas, le chiffre de place ci-dessous ne sert à rien."
else
	ok "cohérent : session ${MODE_ICI}$( [ -n "$TABLE" ] && printf ', table %s' "$TABLE" )$( [ "$VOISIN_UEFI" = "oui" ] && printf ', voisin en UEFI' )"
	[ -z "$VOISIN_UEFI" ] && [ -n "$ESP_PART" ] && info "(le mode du voisin lui-même n'a pas été lu — voir ci-dessus)"
fi

# --- B4 : la place sur la partition EFI partagée ----------------------------
#  partition.conf RÉUTILISE l'EFI existante — donc celle du voisin, à la
#  taille qu'il a choisie. LexOS y ajoute shim + grubx64.efi (quelques Mo).
#  On mesure la place LIBRE avec df (lecture seule), et on prévient sous
#  50 Mo, AVEC LE CHIFFRE : le hook 0500 tient déjà ce raisonnement pour
#  grub-install lui-même — même logique, autre ressource.
EFI_LIBRE_MIN_MO="${LEXOS_EFI_LIBRE_MIN_MO:-50}"
if [ -n "$ESP_PART" ]; then
	if [ -n "$ESP_MNT" ]; then
		EFI_LIBRE_KO="$(df -Pk "$ESP_MNT" 2>/dev/null | awk 'NR==2 {print $4}')"
		EFI_TAILLE_KO="$(df -Pk "$ESP_MNT" 2>/dev/null | awk 'NR==2 {print $2}')"
		if [ -n "$EFI_LIBRE_KO" ]; then
			EFI_LIBRE_MO=$((EFI_LIBRE_KO / 1024)); EFI_TAILLE_MO=$((${EFI_TAILLE_KO:-0} / 1024))
			if [ "$EFI_LIBRE_MO" -lt "$EFI_LIBRE_MIN_MO" ]; then
				non "partition EFI presque pleine : ${EFI_LIBRE_MO} Mo libres sur ${EFI_TAILLE_MO} Mo (il en faut ${EFI_LIBRE_MIN_MO})"
				info "LexOS y ajoute son shim et son grubx64.efi. Trop juste, et l'installation"
				info "échouerait à la TOUTE DERNIÈRE étape, celle de grub-install — après le"
				info "redimensionnement. Fais de la place dans EFI/ (vieux noyaux, anciens"
				info "chargeurs) depuis le voisin, puis relance."
			else
				ok "partition EFI : ${EFI_LIBRE_MO} Mo libres sur ${EFI_TAILLE_MO} Mo — de quoi ajouter LexOS"
			fi
		else
			attn "place libre sur la partition EFI : NON MESURÉE (df n'a rien rendu sur ${ESP_MNT})"
		fi
	else
		attn "place libre sur la partition EFI : NON MESURÉE — ${ESP_RAISON:-partition non lue}"
	fi
fi
fermer_esp

titre "LA PLACE POUR LEXOS"
if [ -n "$WIN_DEV" ]; then
	#  L'espace occupé DANS Windows, lu par ntfsresize (lecture seule). C'est
	#  ce chiffre qui compte : une partition de 900 Go dont 200 sont utilisés
	#  peut céder beaucoup ; une de 250 Go pleine à 240 ne peut rien céder.
	UTILISE_GO=""
	if [ -n "${RAPPORT:-}" ]; then
		U_O="$(printf '%s' "$RAPPORT" | grep -i "space in use" | grep -oE '[0-9]+ MB' | grep -oE '[0-9]+' | head -1)"
		[ -n "$U_O" ] && UTILISE_GO=$((U_O / 1000))
	fi

	if [ -n "$UTILISE_GO" ] && [ "$UTILISE_GO" -gt 0 ]; then
		conseil_place "Windows" "$WIN_TAILLE_GO" "$UTILISE_GO" "$WINDOWS_LIBRE_MIN_GO" \
			"Windows → Paramètres → Système → Stockage montre ce qui prend de la place."
	else
		attn "impossible de lire la place utilisée dans Windows"
		info "L'installateur le mesurera lui-même sur son écran de partage."
		info "Vise ${CIBLE_GO} Go pour LexOS, et laisse au moins ${WINDOWS_LIBRE_MIN_GO} Go de libre à Windows."
	fi
elif [ -n "$LNX_DEV" ]; then
	#  MÊME RAISONNEMENT, AUTRE INSTRUMENT. ntfsresize lit le NTFS ; dumpe2fs
	#  lit l'ext4. Les deux ne font que lire.
	LNX_MESURE=""
	case "$LNX_FS" in ext4|ext3) LNX_MESURE="$(mesurer_ext4 "$LNX_DEV")" ;; esac
	LNX_UTILISE_GO="${LNX_MESURE%% *}"
	#  « # » ET PAS « ## ». L'état tient en DEUX mots — « not clean » — et
	#  « ${x##* } » retire le plus long préfixe finissant par une espace,
	#  donc rendait « clean » sur un système de fichiers qui ne l'était pas.
	#  L'avertissement ne se serait jamais déclenché, et Alex aurait
	#  redimensionné un disque en cours d'utilisation sur la foi d'un outil
	#  qui disait que tout allait bien. Attrapé au banc d'essai, pas en
	#  relisant.
	LNX_ETAT="${LNX_MESURE#* }"

	if [ -n "$LNX_MESURE" ] && [ "$LNX_ETAT" != "clean" ]; then
		attn "le système de fichiers de ${LNX_DEV} n'est pas « clean » (état : ${LNX_ETAT})"
		info "Éteins ce Linux proprement — pas de veille, pas d'hibernation — puis relance."
		info "Un système de fichiers en cours d'utilisation ne se redimensionne pas sans risque."
	fi

	if [ -n "$LNX_UTILISE_GO" ] && [ "$LNX_UTILISE_GO" -gt 0 ]; then
		conseil_place "ce Linux" "$LNX_TAILLE_GO" "$LNX_UTILISE_GO" "$LINUX_LIBRE_MIN_GO" \
			"Dans ce Linux : vide la corbeille, les Téléchargements, et « sudo apt clean »."
	else
		attn "impossible de lire la place utilisée dans ${LNX_DEV} (${LNX_FS})"
		info "dumpe2fs ne lit que l'ext2/3/4 ; pour btrfs ou xfs, l'installateur mesurera lui-même."
		info "Vise ${CIBLE_GO} Go pour LexOS, et laisse au moins ${LINUX_LIBRE_MIN_GO} Go de libre au voisin."
	fi

	#  L'espace déjà NON PARTITIONNÉ : s'il y en a, rien à redimensionner.
	#  « DISQUE », pas « WIN_DISQUE » : celui-là n'existait que devant un
	#  Windows, et cette mesure ne tournait donc jamais devant un Ubuntu.
	if command -v parted >/dev/null 2>&1 && [ -n "${DISQUE:-}" ]; then
		LIBRE_BRUT="$(parted -sm "$DISQUE" unit GB print free 2>/dev/null \
			| awk -F: '/free/ {gsub("GB","",$4); if ($4+0 > 1) s+=$4} END {print int(s)}')"
		if [ -n "$LIBRE_BRUT" ] && [ "$LIBRE_BRUT" -ge 1 ]; then
			ok "${LIBRE_BRUT} Go déjà libres hors partition sur ce disque"
			[ "$LIBRE_BRUT" -ge "$PLANCHER_GO" ] && \
				info "C'est peut-être suffisant sans toucher au voisin du tout."
		fi
	fi
elif [ -n "$LNXC_PART" ]; then
	#  MÊME INTERDIT QU'À LA SECTION WINDOWS : il y a un système là, on ne
	#  dit pas à Alex que l'installateur peut prendre le disque en entier.
	non "la place ne se calcule pas ici : le voisin est chiffré ou en LVM"
	info "Libère l'espace depuis ce système-là (voir la section précédente),"
	info "puis reviens — LexOS s'installera dans l'espace non alloué."
else
	info "Aucun voisin sur le disque : l'installateur proposera de l'utiliser en entier."
fi

# --- Le menu de démarrage ---------------------------------------------------
titre "LE MENU DE DÉMARRAGE"
if command -v os-prober >/dev/null 2>&1; then
	ok "os-prober présent — le menu de LexOS pourra proposer l'autre système"
else
	non "os-prober absent — l'autre système n'apparaîtrait PAS dans le menu"
	info "C'est un paquet obligatoire de LexOS : signale-le, c'est un défaut."
fi

if grep -rqs '^GRUB_DISABLE_OS_PROBER=false' /etc/default/grub /etc/default/grub.d 2>/dev/null; then
	ok "la recherche des autres systèmes est activée"
else
	attn "GRUB_DISABLE_OS_PROBER=false introuvable"
	info "Après installation : sudo lexos-dualboot pour revérifier."
fi

#  Le mode d'amorçage a sa propre section plus haut (B3). Ici : les entrées
#  du micrologiciel, et LE piège du duo Linux + Linux.
if [ "$MODE_ICI" = "UEFI" ] && command -v efibootmgr >/dev/null 2>&1; then
	EFI_SORTIE="$(efibootmgr 2>/dev/null)"
	N="$(printf '%s\n' "$EFI_SORTIE" | grep -c '^Boot[0-9]')"
	info "${N} entrée(s) de démarrage UEFI aujourd'hui ; après installation il en faut une de plus"
fi

# --- B2 : UBUNTU, LUI, NE VERRA PAS LEXOS DANS SON MENU ---------------------
#  ═══ LE VRAI PIÈGE DU DUO LINUX + LINUX, ET IL SE VOIT DES SEMAINES APRÈS ═══
#  Depuis GRUB 2.06, os-prober est DÉSACTIVÉ par défaut. LexOS corrige ça
#  chez lui (GRUB_DISABLE_OS_PROBER=false, hook 0100) — mais pas chez le
#  voisin. Or Ubuntu relance update-grub à chaque mise à jour de noyau. Si
#  c'est le GRUB d'Ubuntu qui tient l'amorçage, son menu n'affichera
#  qu'Ubuntu, et LexOS disparaîtra du démarrage. Rien ne sera perdu sur le
#  disque, mais on ne pourra plus y entrer sans passer par le BIOS — et ça
#  n'arrivera pas le jour de l'installation : ça arrivera à la première mise
#  à jour de noyau d'Ubuntu.
#
#  On LIT l'ordre de démarrage UEFI (efibootmgr sans argument = lecture
#  seule), on dit lequel des deux GRUB est aux commandes, et si c'est celui
#  du voisin, on donne les commandes exactes à taper CHEZ LUI. On ne les
#  exécute pas : ce n'est pas notre système.
if [ -n "${LNX_DEV:-}" ] || [ -n "${LNXC_PART:-}" ]; then
	printf '\n'
	QUI_COMMANDE=""   # "" = pas lu · "lexos" · "voisin" · "autre"
	if [ "$MODE_ICI" = "UEFI" ] && [ -n "${EFI_SORTIE:-}" ]; then
		#  BootOrder: 0002,0001,… — la PREMIÈRE entrée est celle qui part.
		PREMIER="$(printf '%s\n' "$EFI_SORTIE" | sed -n 's/^BootOrder: *\([0-9A-Fa-f]*\).*/\1/p' | head -1)"
		if [ -n "$PREMIER" ]; then
			PREMIER_NOM="$(printf '%s\n' "$EFI_SORTIE" | sed -n "s/^Boot${PREMIER}\*\{0,1\}[[:space:]]*\(.*\)$/\1/p" | head -1)"
			case "$(printf '%s' "$PREMIER_NOM" | tr '[:upper:]' '[:lower:]')" in
				*lexos*)                     QUI_COMMANDE="lexos" ;;
				*ubuntu*|*debian*|*fedora*|*mint*|*grub*|*shim*|*linux*) QUI_COMMANDE="voisin" ;;
				"")                          QUI_COMMANDE="" ;;
				*)                           QUI_COMMANDE="autre" ;;
			esac
		fi
	fi
	case "$QUI_COMMANDE" in
		lexos)
			ok "c'est le GRUB de LexOS qui tient l'amorçage (première entrée UEFI : « ${PREMIER_NOM} »)"
			info "Son os-prober est actif : le menu montrera les deux systèmes."
			;;
		voisin)
			attn "c'est le GRUB du VOISIN qui tient l'amorçage (première entrée UEFI : « ${PREMIER_NOM} »)"
			;;
		autre)
			info "première entrée UEFI : « ${PREMIER_NOM} » — ni LexOS ni un Linux reconnu"
			;;
		*)
			info "l'ordre de démarrage UEFI n'a pas été lu (mode BIOS, ou efibootmgr absent) :"
			info "on ne sait pas lequel des deux GRUB commande."
			;;
	esac
	#  LES COMMANDES SONT DONNÉES DANS TOUS LES CAS où le voisin est un
	#  Linux — même quand LexOS commande aujourd'hui : le jour où Ubuntu
	#  reprendra l'amorçage (une réinstallation de son GRUB, un changement
	#  d'ordre dans le BIOS), c'est CE réglage-là qui évitera la disparition.
	#  Et on dit POURQUOI en une phrase : sans ça, personne ne le refera dans
	#  six mois.
	printf '\n'
	printf '  %sUne fois, côté Ubuntu (dans un terminal d'\''Ubuntu, pas d'\''ici) :%s\n' "$B" "$R"
	printf '    sudo sed -i '\''s/^#*GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/'\'' /etc/default/grub\n'
	printf '    grep -q GRUB_DISABLE_OS_PROBER /etc/default/grub || echo '\''GRUB_DISABLE_OS_PROBER=false'\'' | sudo tee -a /etc/default/grub\n'
	printf '    sudo update-grub\n'
	printf '\n'
	info "Pourquoi : le GRUB d'Ubuntu ne cherche PAS les autres systèmes par défaut ;"
	info "sans ce réglage, sa prochaine mise à jour de noyau efface LexOS de SON menu."
fi

# --- Le résumé --------------------------------------------------------------
titre "CE QU'IL FAUT RETENIR"
#  La première consigne ne vaut que pour un voisin Windows : le « démarrage
#  rapide » est une invention de Windows, et l'afficher devant un disque
#  Ubuntu enverrait Alex chercher une case qui n'existe nulle part.
if [ -n "$WIN_DEV" ] || [ -n "${WIN_CHIFFRE:-}" ]; then
	printf '  1. Dans Windows : décocher le %sDémarrage rapide%s, puis %sArrêter%s.\n' "$B" "$R" "$B" "$R"
else
	printf '  1. Éteindre le système voisin %sproprement%s — pas en veille, pas en hibernation.\n' "$B" "$R"
fi
printf '  2. Sauvegarder ce qui compte. %sPar principe%s, avant tout partage de disque.\n' "$B" "$R"
#  ═══ SECURE BOOT PEUT RESTER ACTIVÉ, ET CETTE LIGNE DISAIT LE CONTRAIRE ═══
#  grub-efi-amd64-signed et shim-signed sont dans la liste OBLIGATOIRE de
#  LexOS (lexos-core.list.chroot) : le système installé démarre avec Secure
#  Boot actif. Dire « Disabled » envoyait Alex désactiver une protection
#  pour rien — et sur un disque partagé avec Ubuntu, toucher au Secure Boot
#  est un réglage de plus à défaire. La touche du BIOS n'est pas la même
#  partout non plus : F2 sur l'Alienware, F1 sur le ThinkPad (le menu F12
#  n'y répond pas, même avec Fn).
printf '  3. Dans le BIOS (F1 sur le ThinkPad, F2 sur l'\''Alienware) : %sUEFI Only%s.\n' "$B" "$R"
printf '     Secure Boot peut %srester activé%s — LexOS embarque grub-efi-amd64-signed.\n' "$B" "$R"
#  DEVANT UN VOISIN CHIFFRÉ OU EN LVM, LA CONSIGNE 4 SERAIT FAUSSE : l'écran
#  « Installer à côté de » ne sait pas découper ça, et son curseur ne
#  proposerait rien d'utilisable. Envoyer Alex l'y chercher quand même, c'est
#  l'envoyer buter sur un écran qui ne répond pas — ou pire, cliquer ailleurs.
if [ -n "${LNXC_PART:-}" ] && [ -z "${WIN_DEV:-}" ] && [ -z "${LNX_DEV:-}" ]; then
	printf '  4. %sLibérer la place D'\''ABORD%s, depuis le système voisin (resize2fs,\n' "$B" "$R"
	printf '     lvreduce, pvresize, cryptsetup resize, GParted — dans cet ordre).\n'
	printf '  5. Puis installer en %spartitionnement manuel%s, dans l'\''espace non alloué.\n' "$B" "$R"
	printf '     %sPas%s « Installer à côté de » : il ne sait pas redimensionner un\n' "$B" "$R"
	printf '     disque chiffré ni un volume LVM.\n'
else
	printf '  4. Dans l'\''installateur : %s« Installer à côté de »%s, curseur à %s%s Go%s.\n' "$B" "$R" "$B$O" "$CIBLE_GO" "$R"
	printf '  5. Lire l'\''écran de résumé avant de valider. Rien n'\''est écrit avant.\n'
fi
printf '\n'
printf '  %sCet outil n'\''a rien modifié.%s Relance-le autant de fois que tu veux.\n' "$D" "$R"
printf '\n'

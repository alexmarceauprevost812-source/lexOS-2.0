gparted|gparted|Utilitaires|Partitionner les disques|https://gparted.org
timeshift|timeshift|Utilitaires|Points de restauration du système|https://github.com/linuxmint/timeshift
remmina|remmina|Utilitaires|Bureau à distance (RDP, VNC, SSH)|https://remmina.org
synaptic|synaptic|Utilitaires|Gestionnaire de paquets détaillé|https://www.nongnu.org/synaptic/
"

# --- Résolution d'un nom simple vers un paquet Debian ------------------------
#  Un nom inconnu n'est pas une erreur : c'est peut-être un vrai paquet Debian
#  que le catalogue ne connaît pas. On le laisse passer tel quel à apt.
resoudre() {
	local nom="$1"
	while IFS='|' read -r cle pkg _cat _desc _lien; do
		[[ -n "$cle" ]] || continue
		if [[ "$cle" == "$nom" || "$pkg" == "$nom" ]]; then
			printf '%s\n' "$pkg"
			return 0
		fi
	done <<< "$CATALOGUE"
	printf '%s\n' "$nom"
}

# --- Élévation de privilèges -------------------------------------------------
sudo_cmd() {
	if [[ "$(id -u)" -eq 0 ]]; then
		"$@"
	elif command -v sudo >/dev/null 2>&1; then
		sudo "$@"
	elif command -v pkexec >/dev/null 2>&1; then
		pkexec "$@"
	else
		die "Impossible d'obtenir les droits d'administration (ni sudo ni pkexec)."
	fi
}

# --- Le site officiel d'une application --------------------------------------
#  Le catalogue porte l'adresse du projet lui-même, pas celle d'un
#  intermédiaire : c'est là qu'on trouve le code, les notes de version et
#  la façon de signaler un défaut. Un miroir de téléchargement n'apprend
#  rien de tout ça.
cmd_site() {
	local nom="${1:-}"
	[[ -n "$nom" ]] || die "Usage : $PROG site <nom>"
	local cle pkg cat desc lien
	while IFS='|' read -r cle pkg cat desc lien; do
		[[ -n "$cle" ]] || continue
		if [[ "$cle" == "$nom" || "$pkg" == "$nom" ]]; then
			printf '\n%s%s%s  %s(%s)%s\n  %s\n\n' \
				"$B" "$cle" "$R" "$D" "$pkg" "$R" "$desc"
			#  Deux adresses, deux usages : le site du projet dit ce qu'est
			#  le logiciel et qui le fait ; la page Debian dit quelle version
			#  est empaquetée dans trixie, avec quelles dépendances, et
			#  propose le téléchargement direct pour chaque architecture.
			printf '  %sProjet%s  %s%s%s\n' "$B" "$R" "$O" "$lien" "$R"
			if [[ "$pkg" == "google-chrome-stable" ]]; then
				#  Chrome n'est pas empaqueté par Debian : la page
				#  packages.debian.org n'existe pas pour lui. C'est le dépôt
				#  de Google qui le distribue, et c'est celui-là qu'on montre.
				printf '  %sDépôt%s   %shttps://dl.google.com/linux/chrome/deb/%s\n\n' \
					"$B" "$R" "$O" "$R"
			else
				printf '  %sDebian%s  %shttps://packages.debian.org/trixie/%s%s\n\n' \
					"$B" "$R" "$O" "$pkg" "$R"
			fi
			if command -v xdg-open >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
				setsid xdg-open "$lien" >/dev/null 2>&1 &
				printf '  %sle site du projet est ouvert dans le navigateur%s\n' "$D" "$R"
			fi
			return 0
		fi
	done <<< "$CATALOGUE"
	die "Inconnu du catalogue : $nom  ($PROG liste)"
}

cmd_liste() {
	printf '%s%sCatalogue de la Logithèque%s\n\n' "$B" "$O" "$R"
	local cat_courante=""
	while IFS='|' read -r cle pkg cat desc _lien; do
		[[ -n "$cle" ]] || continue
		if [[ "$cat" != "$cat_courante" ]]; then
			cat_courante="$cat"
			printf '\n%s%s%s\n' "$B" "$cat" "$R"
		fi
		if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "ok installed"; then
			printf '  %s✓%s %-14s %s%-18s%s %s\n' "$V" "$R" "$cle" "$D" "$pkg" "$R" "$desc"
		else
			printf '    %-14s %s%-18s%s %s\n' "$cle" "$D" "$pkg" "$R" "$desc"
		fi
	done <<< "$CATALOGUE"
	printf '\n%sInstaller :%s %s install <nom>   %s(✓ = déjà installé)%s\n' \
		"$B" "$R" "$PROG" "$D" "$R"
}

cmd_install() {
	[[ $# -gt 0 ]] || die "Rien à installer. Essaie « $PROG liste » pour voir le catalogue."
	local pkgs=() nom pkg
	for nom in "$@"; do
		pkg="$(resoudre "$nom")"
		#  Chrome n'est dans aucun dépôt Debian : apt ne peut rien pour lui.
		#  Il a son propre installateur, qui ajoute d'abord le dépôt officiel
		#  de Google. On le reconnaît ici pour que « logitheque install chrome »
		#  marche comme tous les autres noms du catalogue.
		if [[ "$pkg" == "google-chrome-stable" ]]; then
			say "« $nom » → Google Chrome ${D}(dépôt officiel de Google)${R}"
			sudo_cmd /usr/bin/lexos-install-chrome \
				|| die "Installation de Google Chrome échouée — vérifie ta connexion internet."
			continue
		fi
		pkgs+=("$pkg")
		[[ "$pkg" == "$nom" ]] || say "« $nom » → paquet ${B}${pkg}${R}"
	done
	[[ ${#pkgs[@]} -gt 0 ]] || { ok "Terminé."; return 0; }
	say "Installation : ${pkgs[*]}"
	sudo_cmd apt-get update -qq || say "apt-get update a échoué — on tente quand même"
	if sudo_cmd apt-get install -y "${pkgs[@]}"; then
		ok "Terminé. Les applications apparaissent dans le menu Applications."
	else
		die "L'installation a échoué. Vérifie le nom du paquet (« $PROG chercher <mot> »)."
	fi
}

cmd_retirer() {
	[[ $# -gt 0 ]] || die "Rien à désinstaller."
	local pkgs=() nom
	for nom in "$@"; do pkgs+=("$(resoudre "$nom")"); done
	say "Désinstallation : ${pkgs[*]}"
	sudo_cmd apt-get remove -y "${pkgs[@]}" && ok "Terminé."
}

cmd_chercher() {
	[[ $# -gt 0 ]] || die "Donne un mot à chercher."
	command -v apt-cache >/dev/null 2>&1 || die "apt-cache est introuvable."
	apt-cache search "$@" | head -40
}

# --- Ouverture de la boutique graphique --------------------------------------
cmd_boutique() {
	#  Flathub multiplie par dix le catalogue disponible ; on l'ajoute au
	#  premier lancement si Flatpak est là mais que le dépôt manque.
	if command -v flatpak >/dev/null 2>&1; then
		flatpak remotes 2>/dev/null | grep -q flathub || {
			say "Ajout du dépôt Flathub…"
			sudo_cmd flatpak remote-add --if-not-exists flathub \
				https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 \
				|| say "Flathub non ajouté (pas de réseau ?) — les dépôts Debian restent disponibles"
		}
	fi
	if command -v gnome-software >/dev/null 2>&1; then
		say "Ouverture de GNOME Logiciels…"
		exec gnome-software
	fi
	if command -v plasma-discover >/dev/null 2>&1; then
		exec plasma-discover
	fi
	if command -v synaptic >/dev/null 2>&1; then
		say "GNOME Logiciels n'est pas installé — ouverture de Synaptic."
		#  sudo_cmd est une fonction : pas d'exec possible ici.
		sudo_cmd synaptic
		exit $?
	fi
	say "Aucune boutique graphique installée."
	say "Installe-la avec : ${B}sudo apt install gnome-software${R}"
	printf '\n'
	cmd_liste
}

usage() {
	cat <<EOF
${B}$PROG${R} — installer des applications en quelques clics

  ${O}$PROG${R}                    Ouvre la boutique graphique (GNOME Logiciels)
  ${O}$PROG liste${R}              Catalogue des applications courantes
  ${O}$PROG install${R} <nom…>     Installe (nom simple ou paquet Debian)
  ${O}$PROG retirer${R} <nom…>     Désinstalle
  ${O}$PROG chercher${R} <mot>     Cherche dans tous les paquets Debian

${D}Exemples :
  $PROG install vlc photo bureautique
  $PROG install firefox
  $PROG chercher editeur video${R}
  ${O}$PROG site rust${R}          ${D}le site officiel du projet${R}
EOF
}

case "${1:-}" in
	""|boutique|gui)  cmd_boutique ;;
	liste|list|ls)    cmd_liste ;;
	install|installer|ajouter) shift; cmd_install "$@" ;;
	retirer|remove|desinstaller) shift; cmd_retirer "$@" ;;
	chercher|search)  shift; cmd_chercher "$@" ;;
	-h|--help|aide)   usage ;;
	site|lien)        shift; cmd_site "$@" ;;
	*)                say "Commande inconnue : $1"; printf '\n'; usage; exit 1 ;;
esac

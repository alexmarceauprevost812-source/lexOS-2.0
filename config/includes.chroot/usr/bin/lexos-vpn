#!/usr/bin/env bash
# =============================================================================
#  lexos-vpn — VPN (OpenVPN, WireGuard) via NetworkManager
# =============================================================================
#  Importe un fichier .ovpn ou .conf WireGuard tel quel, sans ré-explication :
#  NetworkManager fait tout le travail, ce script est un raccourci propre.
# =============================================================================
set -uo pipefail

PROG="${0##*/}"

case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
	*UTF-8*|*utf8*|*UTF8*|*utf-8*) ;;
	*) locale -a 2>/dev/null | grep -qiE '^C\.utf-?8$' && export LC_ALL=C.UTF-8 ;;
esac

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; D=$'\033[2m'
	G=$'\033[32m'; Y=$'\033[33m'; E=$'\033[31m'; B=$'\033[1m'; R=$'\033[0m'
else
	O=''; D=''; G=''; Y=''; E=''; B=''; R=''
fi
say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

need_nm() {
	command -v nmcli >/dev/null 2>&1 || die "nmcli introuvable — NetworkManager n'est pas installé."
	nmcli general status >/dev/null 2>&1 || die "NetworkManager ne répond pas (service arrêté ?)."
}
need_root() {
	if [[ $EUID -ne 0 ]]; then
		command -v sudo >/dev/null 2>&1 || die "Droits administrateur nécessaires."
		exec sudo -E "$0" "$@"
	fi
}

vpn_names() {
	nmcli -t -f NAME,TYPE connection show 2>/dev/null \
		| awk -F: '$2=="vpn" || $2=="wireguard" {print $1}'
}

# =============================================================================
#  Importer une configuration (.ovpn ou WireGuard .conf)
# =============================================================================
cmd_import() {
	need_nm
	need_root import "$@"
	local file="${1:-}" name="${2:-}"
	[[ -n "$file" ]] || die "Usage : ${PROG} import <fichier.ovpn ou fichier.conf> [nom]"
	[[ -r "$file" ]] || die "Fichier introuvable : ${file}"

	local kind
	case "${file,,}" in
		*.ovpn)  kind="openvpn" ;;
		*.conf)
			if grep -q '^\[Interface\]' "$file" 2>/dev/null; then
				kind="wireguard"
			else
				die "Fichier .conf non reconnu comme WireGuard (pas de [Interface])."
			fi
			;;
		*) die "Format inconnu : ${file}  (attendu : .ovpn ou .conf WireGuard)" ;;
	esac

	say "Import ${kind} : $(basename "$file")…"
	local out
	if out="$(nmcli connection import type "$kind" file "$file" 2>&1)"; then
		local conn_name
		conn_name="$(sed -n "s/.*'\(.*\)'.*/\1/p" <<< "$out" | head -n1)"
		[[ -n "$name" && -n "$conn_name" ]] && nmcli connection modify "$conn_name" connection.id "$name" >/dev/null 2>&1
		ok "VPN importé : ${name:-$conn_name}"
		printf '  %s%s connect "%s"%s\n' "$D" "$PROG" "${name:-$conn_name}" "$R"
	else
		die "Échec de l'import : ${out}"
	fi
}

cmd_list() {
	need_nm
	local names; names="$(vpn_names)"
	[[ -n "$names" ]] || { warn "Aucun VPN importé — ${PROG} import <fichier>"; return 0; }

	printf '\n  %-28s %-10s %s\n' "VPN" "TYPE" "ÉTAT"
	printf '  %s\n' "$(printf '─%.0s' {1..56})"
	local active; active="$(nmcli -t -f NAME connection show --active 2>/dev/null)"
	while IFS= read -r n; do
		[[ -n "$n" ]] || continue
		local type state
		type="$(nmcli -t -f connection.type connection show "$n" 2>/dev/null | cut -d: -f2)"
		state="—"; grep -qxF "$n" <<< "$active" && state="${G}connecté${R}"
		printf '  %-28s %-10s %b\n' "$n" "${type#*-}" "$state"
	done <<< "$names"
	printf '\n'
}

cmd_connect() {
	need_nm
	local name="${1:-}"
	[[ -n "$name" ]] || die "Usage : ${PROG} connect \"<nom>\"  (voir : ${PROG} list)"
	nmcli connection up id "$name" >/dev/null 2>&1 \
		&& ok "Connecté à « ${name} »" \
		|| die "Connexion à « ${name} » impossible."
}

cmd_disconnect() {
	need_nm
	local name="${1:-}"
	if [[ -z "$name" ]]; then
		name="$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
			| awk -F: '$2=="vpn" || $2=="wireguard" {print $1; exit}')"
		[[ -n "$name" ]] || { warn "Aucun VPN actif."; return 0; }
	fi
	nmcli connection down id "$name" >/dev/null 2>&1 \
		&& ok "Déconnecté de « ${name} »" \
		|| die "Déconnexion de « ${name} » impossible."
}

cmd_remove() {
	need_nm
	need_root remove "$@"
	local name="${1:-}"
	[[ -n "$name" ]] || die "Usage : ${PROG} remove \"<nom>\""
	nmcli connection delete id "$name" >/dev/null 2>&1 \
		&& ok "VPN « ${name} » supprimé." \
		|| die "VPN « ${name} » inconnu."
}

cmd_status() {
	need_nm
	local active
	active="$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
		| awk -F: '$2=="vpn" || $2=="wireguard" {print $1}')"
	if [[ -n "$active" ]]; then
		printf 'VPN : %sconnecté%s (%s)\n' "$G" "$R" "$active"
	else
		printf 'VPN : %saucun actif%s\n' "$D" "$R"
	fi
	printf '  %s%s list%s          VPN importés\n' "$D" "$PROG" "$R"
	printf '  %s%s import <fichier>%s   importer un .ovpn ou un .conf WireGuard\n' "$D" "$PROG" "$R"
}

# =============================================================================
#  VPN gratuits — lesquels valent quelque chose, et pourquoi
# =============================================================================
#  Faire tourner un VPN coûte cher : des serveurs, de la bande passante, du
#  personnel. Quand c'est gratuit et que personne d'autre ne paie, ce sont
#  tes données qui règlent la facture — publicités injectées, historique
#  revendu, bande passante louée à d'autres. Ce n'est pas une supposition :
#  c'est ce qu'on retrouve à chaque étude sur les applications VPN
#  gratuites des magasins d'applications.
#
#  Les exceptions sont celles financées AUTREMENT. C'est le seul critère
#  qui tienne, et c'est pourquoi chaque entrée ci-dessous dit d'où vient
#  l'argent. Si tu ne vois pas qui paie, ne l'installe pas.
#
#  nom|financement|ce que ça vaut|comment l'installer
GRATUITS="proton|Les abonnements payants de Proton (Suisse)|Données illimitées, sans publicité, sans journalisation (audité). Trois pays au niveau gratuit.|compte gratuit sur protonvpn.com, puis télécharge une configuration WireGuard
riseup|Dons — collectif militant Riseup, sans but lucratif|Sans journalisation, sans compte à créer. Débit modeste : c'est de l'infrastructure militante, pas un service commercial.|paquet riseup-vpn
calyx|L'Institut Calyx, organisme sans but lucratif|Même technologie que Riseup (Bitmask). Gratuit, sans compte.|paquet calyx-vpn"

#  Mentionné à part : ce n'est pas gratuit, mais c'est l'option honnête
#  quand on veut du sérieux sans se faire recruter comme produit.
cmd_gratuit() {
	local choix="${1:-}"

	if [[ -z "$choix" ]]; then
		printf '\n%sVPN gratuits qui ne se paient pas sur ton dos%s\n\n' "$B" "$R"
		#  « %s\n » et non « %s » : sans saut de ligne final, `read` renvoie
		#  faux sur la DERNIÈRE entrée et la boucle l'avale en silence.
		printf '%s\n' "$GRATUITS" | while IFS='|' read -r cle argent vaut _comment; do
			printf '  %s%-8s%s %s\n' "$O" "$cle" "$R" "$vaut"
			printf '           %sfinancé par : %s%s\n\n' "$D" "$argent" "$R"
		done
		cat <<EOF
  ${B}Ce qu'un VPN fait, et ce qu'il ne fait pas${R}
    ${G}Il cache${R}    à ton fournisseur d'accès et au réseau local
                quels sites tu visites.
    ${E}Il ne cache pas${R} qui tu es aux sites où tu ouvres une session.
                Connecté à ton courriel, tu es identifié, VPN ou pas.
    ${E}Il ne rend pas anonyme.${R} Pour ça, c'est Tor, et c'est autre chose.

  ${D}Sur un réseau public, HTTPS protège déjà le CONTENU de ce que tu
  envoies. Le VPN, lui, cache la LISTE des sites. C'est utile, mais plus
  modeste que ce que la publicité des VPN laisse croire.${R}

  ${B}Payant, mais honnête${R}
    ${O}Mullvad${R} — 5 € par mois, aucun compte, aucun courriel demandé. Un
    numéro suffit. Si le gratuit ne convient pas, c'est là qu'il faut aller
    plutôt que vers un « gratuit » qui n'en est pas un.

  ${B}Installer${R}
    ${O}${PROG} gratuit proton${R}   ${D}·${R}   ${O}${PROG} gratuit riseup${R}   ${D}·${R}   ${O}${PROG} gratuit calyx${R}
EOF
		return
	fi

	local ligne
	ligne="$(printf '%s' "$GRATUITS" | grep "^${choix}|" || true)"
	[[ -n "$ligne" ]] || die "Inconnu : $choix  (essaie : ${PROG} gratuit)"

	local cle argent vaut _comment
	IFS='|' read -r cle argent vaut _comment <<< "$ligne"
	printf '\n%s%s%s\n  %s\n  %sfinancé par : %s%s\n\n' "$B" "$cle" "$R" "$vaut" "$D" "$argent" "$R"

	case "$cle" in
		proton)
			cat <<EOF
  Proton ne se met pas en place par un paquet Debian : leur dépôt à eux
  devrait être ajouté à ton système, ce que LexOS ne fera pas dans ton dos.
  Le chemin sans dépôt tiers, qui marche avec ce qui est déjà installé :

    1. Crée un compte gratuit sur ${O}https://protonvpn.com${R}
    2. Dans le tableau de bord : ${B}Downloads${R} → ${B}WireGuard configuration${R}
    3. Choisis un serveur, télécharge le fichier ${B}.conf${R}
    4. ${O}${PROG} import ~/Téléchargements/le-fichier.conf "Proton"${R}
    5. ${O}${PROG} connect "Proton"${R}

  ${D}NetworkManager s'occupe du reste. Aucun logiciel supplémentaire, et
  rien d'ajouté à tes sources de paquets.${R}
EOF
			;;
		riseup|calyx)
			#  Seul Riseup est empaqueté dans Debian ; Calyx ne l'est pas
			#  (vérifié au journal de la construction 8). Les deux font
			#  tourner le même client Bitmask, qui se télécharge chez eux.
			local paquet="${cle}-vpn"
			if [[ "$cle" == "calyx" ]]; then
				warn "Calyx n'est pas empaqueté dans Debian."
				say  "Le client Bitmask se télécharge sur ${O}https://calyx.net/vpn${R}"
				say  "C'est le même logiciel que celui de Riseup, avec leurs serveurs."
				say  "${D}Riseup, lui, s'installe par apt : ${PROG} gratuit riseup${R}"
				return
			fi
			printf '  Paquet Debian : %s%s%s\n\n' "$B" "$paquet" "$R"
			if dpkg -s "$paquet" >/dev/null 2>&1; then
				ok "$paquet est déjà installé — lance-le depuis le menu Applications."
			else
				say "À installer : ${D}sudo apt install ${paquet}${R}"
				say "S'il est absent de l'archive, le client Bitmask de ${cle} se télécharge"
				say "sur leur site — ${D}c'est le même logiciel${R}."
			fi
			;;
	esac
}

cmd_help() {
	cat <<EOF

${B}${O}${PROG}${R} — VPN (OpenVPN, WireGuard)

${B}USAGE${R}
  ${PROG} <commande> [arguments]

${B}COMMANDES${R}
  ${D}(défaut)${R}                     État du VPN
  ${D}import${R} <fichier> [nom]       Importe un .ovpn ou un .conf WireGuard
  ${D}list${R}                         VPN importés
  ${D}connect${R} "<nom>"              Se connecte
  ${D}disconnect${R} ["<nom>"]         Se déconnecte ${D}(le VPN actif si omis)${R}
  ${D}remove${R} "<nom>"               Supprime un VPN importé
  ${D}gratuit${R}                      VPN gratuits dignes de confiance
  ${D}gratuit${R} <nom>                 ...et comment mettre celui-là en place

${B}EXEMPLES${R}
  ${D}${PROG} import ~/Téléchargements/mon-fournisseur.ovpn${R}
  ${D}${PROG} import ~/Téléchargements/wg0.conf "Maison"${R}
  ${D}${PROG} connect "Maison"${R}

EOF
}

CMD="${1:-status}"
[[ $# -gt 0 ]] && shift
case "$CMD" in
	help|--help|-h) cmd_help ;;
	status|'')      cmd_status ;;
	import)         cmd_import "$@" ;;
	list|ls)        cmd_list ;;
	connect|co)     cmd_connect "$@" ;;
	disconnect|deco) cmd_disconnect "$@" ;;
	remove|rm)      cmd_remove "$@" ;;
	gratuit|free)   cmd_gratuit "$@" ;;
	*) die "Commande inconnue : ${CMD}  (essaie : ${PROG} help)" ;;
esac

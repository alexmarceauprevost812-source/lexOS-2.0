#!/bin/sh
# =============================================================================
#  lexos-heure — l'horloge de la barre du haut, et son clic
# =============================================================================
#  POURQUOI REMPLACER L'HORLOGE DE XFCE.
#  Alex a demandé qu'un clic sur l'heure ouvre le volet des notifications et
#  de l'agenda. Le greffon horloge de XFCE ouvre SON calendrier et ne sait
#  rien faire d'autre : on ne peut pas lui dire quoi lancer. Le greffon
#  « genmon », lui, affiche la sortie d'une commande ET obéit à la balise
#  <txtclick> — c'est déjà ainsi que la météo fonctionne chez nous. L'horloge
#  passe donc par le même chemin.
#
#  CE QU'ON GAGNE EN PLUS. Le format vit maintenant dans un fichier à nous
#  (~/.config/lexos/horloge) et non dans une propriété xfconf accrochée au
#  NUMÉRO du greffon. Ajouter ou retirer une tuile de la barre renumérote ces
#  propriétés : le réglage « 24 h, avec les secondes » aurait fini par
#  s'appliquer à autre chose, ou par disparaître.
#
#  Trois réglages, ceux que la démo propose : 12 ou 24 heures, les secondes,
#  le jour de la semaine.
# =============================================================================
set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/lexos"
ETAT="$CONF/horloge"

#  Valeurs par défaut : 24 h (le Québec), le jour affiché, pas de secondes.
H12=non
SECONDES=non
JOUR=oui
if [ -r "$ETAT" ]; then
	# shellcheck disable=SC1090
	. "$ETAT" 2>/dev/null || true
fi

#  format <préfixe> — le préfixe est ce qui vient AVANT la date/l'heure. En
#  console c'est « lexOS » tout simple ; dans le panneau c'est le badge
#  stylé de badge_panneau(). Les deux passent par la même horloge derrière :
#  un « lexOS » qui ne dit pas l'heure serait deux vérités séparées à tenir
#  d'accord, exactement le genre de piège que ce fichier évite déjà pour
#  Alt+F7/F8 ailleurs dans le dépôt.
format() {
	F="${1:-lexOS }"
	[ "$JOUR" = oui ] && F="$F %a"
	F="$F %d %b "
	if [ "$H12" = oui ]; then
		F="$F %I h %M"
		[ "$SECONDES" = oui ] && F="$F:%S"
		F="$F %p"
	else
		F="$F %H h %M"
		[ "$SECONDES" = oui ] && F="$F:%S"
	fi
	printf '%s' "$F"
}

#  LE BADGE DE LA BARRE. Alex a envoyé une image — un porte-clés bleu de
#  chaque côté, un fond noir, le texte « <[lexOS⚡pro]> » — et a demandé la
#  même chose en haut de l'écran, « ça va être joli ».
#
#  genmon affiche <txt> avec gtk_label_set_markup() (vérifié : le vrai
#  binaire de xfce4-genmon-plugin appelle cette fonction GTK), donc le
#  Pango en balises <span> s'y rend pour de vrai — pas un espoir. C'est
#  RÉSERVÉ au panneau : la même chaîne dans un terminal (le cas « *) »
#  plus bas) afficherait les balises telles quelles, illisibles.
#
#  Les couleurs ne sont pas choisies au hasard sur la photo : ce sont
#  celles de LexOS, déjà vérifiées ailleurs dans le dépôt (les accents de
#  lexos-theme-gen) — #3584E4 est le bleu « haut » de l'accent bleu, #E8590C
#  l'orange par défaut de LexOS. Le badge reste donc lui-même même si
#  quelqu'un cherchait un jour d'où viennent ces teintes précises.
badge_panneau() {
	printf '🔵 <span font_family="monospace" weight="bold">'
	printf '<span foreground="#3584E4">&lt;[</span>'
	printf '<span foreground="#FFFFFF">lexOS</span>'
	printf '<span foreground="#E8590C">⚡</span>'
	printf '<span foreground="#FFFFFF">pro</span>'
	printf '<span foreground="#3584E4">]&gt;</span>'
	printf '</span> 🔵'
}

case "${1:-}" in
	--panneau|panneau)
		#  genmon lit cette sortie : <txt> s'affiche, <tool> est l'infobulle,
		#  <txtclick> est ce que fait un clic.
		printf '<txt> %s </txt>' "$(date "+$(format "$(badge_panneau) ")")"
		printf '<tool>%s\nClique pour les notifications et l'"'"'agenda</tool>' \
			"$(date '+%A %d %B %Y')"
		printf '<txtclick>lexos-volet agenda</txtclick>\n'
		;;
	--regle|regle)
		#  Écrit par les Paramètres. Chaque clé est validée : rien de ce qui
		#  arrive ici ne sert à construire une commande.
		CLE="${2:-}"; VAL="${3:-}"
		case "$CLE" in h12|secondes|jour) ;; *) echo "clé inconnue" >&2; exit 1 ;; esac
		case "$VAL" in oui|non) ;; *) echo "valeur inconnue" >&2; exit 1 ;; esac
		mkdir -p "$CONF"
		case "$CLE" in
			h12)      H12="$VAL" ;;
			secondes) SECONDES="$VAL" ;;
			jour)     JOUR="$VAL" ;;
		esac
		printf 'H12=%s\nSECONDES=%s\nJOUR=%s\n' "$H12" "$SECONDES" "$JOUR" > "$ETAT"
		#  Rafraîchir la barre tout de suite, sinon le changement n'apparaît
		#  qu'au tour suivant du greffon et on croit que rien n'a marché.
		command -v xfce4-panel >/dev/null 2>&1 \
			&& xfce4-panel --plugin-event=genmon:refresh:bool:true >/dev/null 2>&1
		;;
	--etat|etat)
		printf 'H12=%s\nSECONDES=%s\nJOUR=%s\n' "$H12" "$SECONDES" "$JOUR"
		;;
	*)
		date "+$(format)"
		;;
esac

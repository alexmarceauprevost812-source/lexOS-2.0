#!/usr/bin/env bash
# =============================================================================
#  lexos-settings — Paramètres LexOS
# =============================================================================
#  Une seule fenêtre, une barre latérale, toutes les sections — comme
#  Paramètres → (n'importe quelle section) dans web-demo/index.html.
#  Même patron que lexos-cartes : une fenêtre Qt (PySide6) affiche une page
#  web servie en local ; le pont settings.py exécute les vraies commandes
#  LexOS (lexos net, lexos-perf, lexos theme…) derrière une liste blanche.
# =============================================================================
set -uo pipefail

PROG="${0##*/}"
if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; E=$'\033[31m'; Y=$'\033[33m'; D=$'\033[2m'; R=$'\033[0m'
else
	O=''; E=''; Y=''; D=''; R=''
fi
say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

CODE="/usr/lib/lexos/settings.py"
DONNEES="${LEXOS_SETTINGS_DIR:-/usr/share/lexos/settings}"

case "${1:-}" in
	-h|--help|aide|help)
		cat <<AIDE
${PROG} — Paramètres LexOS

  ${O}${PROG}${R}                Ouvre les Paramètres
  ${O}${PROG}${R} <section>      Ouvre directement sur une section (ex. wifi, apparence)

Réseau, matériel, personnalisation, comptes, périphériques, système —
tout dans une seule fenêtre, comme Paramètres → dans la démo web.
AIDE
		exit 0 ;;
esac

[[ -r "$CODE" ]]        || die "Fichier manquant : $CODE"
[[ -d "$DONNEES/web" ]] || die "Fichiers de l'interface introuvables : $DONNEES/web"

#  PySide6 vient des paquets Debian, jamais de « pip --break-system-packages » :
#  ce commutateur écrase des fichiers appartenant à dpkg et finit par casser
#  des logiciels sans rapport. Si le paquet manque, on le dit et on s'arrête.
if ! python3 -c "import PySide6.QtWebEngineWidgets" >/dev/null 2>&1; then
	warn "Le composant Qt WebEngine de PySide6 est absent."
	say  "   ${D}sudo apt install python3-pyside6.qtwebenginewidgets python3-pyside6.qtwidgets${R}"
	say  "N'installe pas PySide6 par pip : il écraserait des fichiers gérés par dpkg."
	exit 1
fi

# =============================================================================
#  LE DÉMON, S'IL EST LÀ
# =============================================================================
#  Les Paramètres gagnent moins que le volet — ils s'ouvrent trois fois par
#  semaine, pas vingt fois par jour — mais ils gagnent quand même : l'import
#  de settings.py (86 ms mesurées) est déjà payé, et le cache d'état est
#  encore chaud d'une ouverture à l'autre.
#
#  ⚠ ON NE PRÉCHAUFFE PAS ICI, ET C'EST ÉCRIT DANS LE DÉMON : la table des
#  clés par section (CLES_SECTION) vit dans la PAGE. La recopier côté Python
#  en ferait un deuxième endroit à tenir à jour ; préchauffer « tout » à la
#  place lancerait quarante sous-processus pour une section qui en demande
#  trois. On se contente donc de dire au démon qu'une fenêtre s'ouvre.
#
#  LA FENÊTRE PASSE PAR LE MÊME CLIENT LÉGER QUE LE VOLET. Les routes
#  propres aux Paramètres (les vignettes de la galerie) suivent : le démon
#  SOUS-CLASSE le Handler du module, il ne le remplace pas.
PORTS="${XDG_RUNTIME_DIR:-/tmp/lexos-$(id -u)}/lexos/moteur.json"
[[ -r "$PORTS" ]] || PORTS="/tmp/lexos-$(id -u)/moteur.json"

if [[ -r "$PORTS" ]]; then
	PORT="$(python3 -c '
import json, sys
try:
    print(int(json.load(open(sys.argv[1])).get("ports", {}).get("settings", 0)) or "")
except Exception:
    print("")' "$PORTS" 2>/dev/null || true)"
	#  Le démon répond-il VRAIMENT ? Un fichier de ports peut désigner un
	#  démon mort (session fermée brutalement). On ne le croit pas sur
	#  parole, et on ne l'attend pas : deux secondes de plafond.
	if [[ -n "${PORT:-}" ]] && python3 - "$PORT" <<'PRE' >/dev/null 2>&1; then
import sys, urllib.request
with urllib.request.urlopen(
        f"http://127.0.0.1:{sys.argv[1]}/api/prechauffe", timeout=2) as r:
    sys.exit(0 if r.status == 200 else 1)
PRE
		SECTION=""
		if [[ -n "${1:-}" ]] && [[ "${1//-/}" =~ ^[[:alnum:]]+$ ]]; then SECTION="$1"; fi
		MODE="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/lexos/mode" 2>/dev/null || echo sombre)"
		case "$MODE" in clair|sombre) ;; *) MODE=sombre ;; esac
		exec python3 /usr/lib/lexos/moteur/vitrine.py reglages "$PORT" "$SECTION" "$MODE"
	fi
fi

#  Pas de démon, ou un démon muet : le chemin entier, inchangé.
exec python3 "$CODE" "$@"

#!/usr/bin/env bash
# =============================================================================
#  lexos-theme-gen — génère le thème LexOS (GTK + terminal) pour un accent
# =============================================================================
#  Usage :
#     lexos-theme-gen                      # accent et mode courants
#     lexos-theme-gen orange               # change l'accent
#     lexos-theme-gen bleu --target /etc/skel
#     lexos-theme-gen --mode clair         # thème de jour (fond blanchâtre)
#     lexos-theme-gen --mode sombre        # LexOS Noir — défaut
# =============================================================================
set -euo pipefail

ACCENT_NAME=""
MODE=""
TARGET="$HOME"

# --- Arguments ---------------------------------------------------------------
while [[ $# -gt 0 ]]; do
	case "$1" in
		--target)
			TARGET="${2:-$HOME}"
			shift 2
			;;
		--mode)
			MODE="${2:-}"
			shift 2
			;;
		--list)
			# Doit rester d'accord avec la palette plus bas : orange-rouge y
			# figurait sans jamais apparaître ici, et cette liste sert aussi
			# de source à la complétion Tab.
			printf 'orange orange-rouge bleu rouge vert gris violet neon\n'
			exit 0
			;;
		-*)
			printf 'Option inconnue : %s\n' "$1" >&2
			exit 1
			;;
		*)
			ACCENT_NAME="$1"
			shift
			;;
	esac
done

CONF_DIR="$TARGET/.config/lexos"
[[ -z "$ACCENT_NAME" && -r "$CONF_DIR/accent" ]] && ACCENT_NAME="$(cat "$CONF_DIR/accent")"
[[ -z "$ACCENT_NAME" ]] && ACCENT_NAME="orange"

# --- Mode : sombre (LexOS Noir, défaut) ou clair (thème de jour) -----------
[[ -z "$MODE" && -r "$CONF_DIR/mode" ]] && MODE="$(cat "$CONF_DIR/mode")"
[[ -z "$MODE" ]] && MODE="sombre"
case "${MODE,,}" in
	clair|jour|light|day)     MODE="clair" ;;
	sombre|nuit|dark|night|*) MODE="sombre" ;;
esac

# --- Palette des accents -----------------------------------------------------
case "${ACCENT_NAME,,}" in
	# « classique » : le nom que les paramètres affichent pour cette couleur
	# (app.js — ["orange", "Classique", …]). Sans cet alias, un utilisateur
	# qui lisait « Classique » à l'écran et tapait « lexos accent classique »
	# se faisait répondre « Accent inconnu » : l'interface et le terminal ne
	# parlaient pas la même langue.
	orange|ambre|classique) ACCENT="#E8590C"; ACCENT_HI="#FF7A33"; ACCENT_LO="#A84007" ;;
	# « Orange et rouge » — l'accent chaud, celui qui va du terracotta au
	# rouge brique. C'est le second des deux styles proposés en tête des
	# paramètres ; l'orange plus vif ci-dessus reste le style « classique ».
	# Le ton principal est l'argile #D97757, ses appuis sont l'orange franc
	# et le rouge brique déjà retenu plus bas pour son contraste.
	orange-rouge|orangerouge|claude|chaud)
	                       ACCENT="#D97757"; ACCENT_HI="#E8834F"; ACCENT_LO="#C4211E" ;;
	# Bleu 5 de la palette Adwaita — le bleu profond des bureaux Linux.
	bleu|blue)             ACCENT="#1A5FB4"; ACCENT_HI="#3584E4"; ACCENT_LO="#10375F" ;;
	# Rouge brique, celui de la référence fournie : plus profond et moins
	# rosé que le #E5484D d'avant, et son texte blanc passe de 3,91:1 à
	# 5,86:1 — au-dessus du seuil AA, ce que l'ancien ne tenait pas.
	rouge|red)             ACCENT="#C4211E"; ACCENT_HI="#D8352E"; ACCENT_LO="#8A1512" ;;
	vert|green|vert-dark)  ACCENT="#1F8F4E"; ACCENT_HI="#2DBF6B"; ACCENT_LO="#125C32" ;;
	gris|grey|gray|grid)   ACCENT="#8A8A8A"; ACCENT_HI="#B4B4B4"; ACCENT_LO="#5A5A5A" ;;
	violet|purple)         ACCENT="#8B5CF6"; ACCENT_HI="#A78BFA"; ACCENT_LO="#6234D1" ;;
	neon|vert-neon|vertneon) ACCENT="#39FF14"; ACCENT_HI="#7BFF5C"; ACCENT_LO="#1FA30A" ;;
	*)
		printf 'Accent inconnu : %s\n' "$ACCENT_NAME" >&2
		printf 'Disponibles : orange (= classique) orange-rouge bleu rouge vert gris violet neon\n' >&2
		exit 1
		;;
esac
ACCENT_NAME="${ACCENT_NAME,,}"

# --- Palette du bureau : LexOS Noir (sombre, défaut) ou thème de jour ------
#  Les boutons sont peints à l'accent dans les deux modes. Plutôt qu'un seuil
#  approximatif, on calcule le VRAI contraste WCAG du noir et du blanc sur
#  l'accent, et on garde celui qui contraste le mieux.
#  L'ancienne formule (299r+587g+114b > 150) choisissait le blanc sur le bleu
#  et sur l'orange, où le noir contraste pourtant nettement mieux : mesuré,
#  ça donnait 3,3 au lieu de 5,4 — sous le seuil lisible de 4,5.
#  ON EN A FAIT UNE FONCTION, ET PAS PAR GOÛT DU RANGEMENT. Le calcul ne
#  servait qu'à l'accent ; deux boutons y échappaient — « action conseillée »
#  et « suppression » — qui posent un FOND sans jamais poser de couleur de
#  texte. Ils héritaient donc de celle de l'accent : sur un accent bleu, du
#  BLANC se retrouvait sur le rouge #E5484D du bouton de suppression, à 3,9:1.
#  Trouvé par le banc des boutons, pas à l'œil : la règle a l'air correcte
#  isolément, c'est la cascade qui la trahit.
texte_lisible() {   # <#rrggbb> → #000000 ou #FFFFFF, celui qui contraste le mieux
	local h="${1#\#}" rr gg bb sortie
	rr=$((16#${h:0:2})); gg=$((16#${h:2:2})); bb=$((16#${h:4:2}))
	sortie="$(awk -v r="$rr" -v g="$gg" -v b="$bb" '
		function lin(v){ v/=255; return (v<=0.03928) ? v/12.92 : ((v+0.055)/1.055)^2.4 }
		BEGIN{
			L  = 0.2126*lin(r) + 0.7152*lin(g) + 0.0722*lin(b)
			cw = 1.05 / (L + 0.05)      # contraste du blanc
			cb = (L + 0.05) / 0.05      # contraste du noir
			print (cb >= cw) ? "#000000" : "#FFFFFF"
		}')"
	printf '%s' "${sortie:-#FFFFFF}"   # filet si awk venait à manquer
}

BTN_FG="$(texte_lisible "$ACCENT")"

#  r, g, b restent nécessaires ailleurs : bloc_panneau() traduit les rgba() du
#  squelette avec « ${r}, ${g}, ${b} ». Les avoir fondus dans texte_lisible()
#  les a fait disparaître d'ici — et le générateur s'est arrêté sur « r :
#  variable sans valeur ». Attrapé par le banc des boutons, qui n'a plus rien
#  eu à mesurer : une feuille absente est aussi parlante qu'une feuille fausse,
#  à condition que quelqu'un la réclame.
r=$((16#${ACCENT:1:2})); g=$((16#${ACCENT:3:2})); b=$((16#${ACCENT:5:2}))

#  Le rouge du bouton de suppression ne dépend pas de l'accent : il dit
#  « attention », et cette couleur-là ne se choisit pas. Son texte, si.
DANGER="#E5484D"
DANGER_FG="$(texte_lisible "$DANGER")"
TERM_BG="#000000"       # le terminal reste toujours noir, même en thème de jour
#  Vert FONCÉ, et non le vert néon d'avant : c'est la couleur de tout ce que
#  la machine répond. Le néon (#39FF14) reste ce qu'il a toujours été —
#  l'accent « neon », que l'on choisit avec « lexos accent neon ». #00AF5F est
#  exactement le 38;5;35 de l'invite PS1 : les deux ne peuvent plus diverger.
TERM_FG="#00AF5F"       # vert foncé — la sortie du terminal
TERM_FG_HI="#23C97A"    # le même en gras

if [[ "$MODE" == "clair" ]]; then
	# Thème de jour : blanc cassé/crème, jamais blanc pur — texte noir.
	BG="#F7F5F0"
	BG_ALT="#EFEBE3"
	BG_HI="#E5DFD3"
	BORDER="#D9D2C3"
	FG="#1B1A17"
	FG_DIM="#6B675E"
else
	# LexOS Noir : noir pur, écriture blanche.
	BG="#000000"
	BG_ALT="#0A0A0B"
	BG_HI="#141416"
	BORDER="#232326"
	FG="#FFFFFF"
	FG_DIM="#B8B8BC"
fi

mkdir -p "$CONF_DIR" "$TARGET/.config/gtk-3.0" "$TARGET/.config/gtk-4.0" \
         "$TARGET/.config/xfce4/terminal"
printf '%s\n' "$ACCENT_NAME" > "$CONF_DIR/accent"
printf '%s\n' "$MODE" > "$CONF_DIR/mode"

# =============================================================================
#  1. Feuille de style GTK 3
# =============================================================================
#  LE STYLE DU PANNEAU VIENT DU SQUELETTE, ET IL SURVIT.
#  RÉGRESSION TROUVÉE PAR L'AUDIT DU 22 AOÛT : ce générateur écrasait
#  ~/.config/gtk-3.0/gtk.css par simple redirection, et sa sortie ne
#  contenait AUCUNE règle #XfcePanelWindow. Le squelette livrait la barre
#  arrondie, les points des bureaux, les notifications — et lexos-firstrun
#  détruisait tout ça à la PREMIÈRE ouverture de session, sans une erreur.
#  Le fichier était dans l'ISO, installé, et mort avant d'avoir servi.
#
#  La source de vérité est /etc/skel/.config/gtk-3.0/gtk.css — présent sur
#  toute machine LexOS. On le recopie EN TÊTE de la sortie, en traduisant
#  l'accent : le orange par défaut (#E8590C, #FF7A33, #A84007 et le triplet
#  rgba « 232, 89, 12 ») devient l'accent choisi. Si le squelette manque
#  (machine non-LexOS), on le dit dans le CSS et on continue : on perd le
#  panneau stylé, pas le thème entier.
bloc_panneau() {
	#  Surchargeable pour être ÉPROUVABLE hors ISO — même procédé que
	#  LEXOS_ICONES plus bas : sans ça, ce bloc ne se vérifie qu'en
	#  construisant et démarrant une image.
	local squelette="${LEXOS_SKEL:-/etc/skel}/.config/gtk-3.0/gtk.css"
	if [[ ! -r "$squelette" ]]; then
		printf '/* squelette %s illisible : style du panneau non repris */\n' "$squelette"
		return 0
	fi
	printf '/* --- Style du panneau, repris du squelette (accent : %s) --- */\n' "$ACCENT_NAME"
	sed -e "s/#E8590C/${ACCENT}/gI" \
	    -e "s/#FF7A33/${ACCENT_HI}/gI" \
	    -e "s/#A84007/${ACCENT_LO}/gI" \
	    -e "s/232, 89, 12/${r}, ${g}, ${b}/g" \
	    "$squelette"
	printf '\n/* --- Fin du bloc squelette --- */\n'
}

gen_gtk_css() {
bloc_panneau
cat <<EOF
/* =========================================================================
   LexOS Noir — accent : ${ACCENT_NAME} (${ACCENT})
   Généré par lexos-theme-gen. Ne pas éditer : sera écrasé.
   ========================================================================= */

@define-color lexos_accent      ${ACCENT};
@define-color lexos_accent_hi   ${ACCENT_HI};
@define-color lexos_accent_lo   ${ACCENT_LO};
@define-color lexos_bg          ${BG};
@define-color lexos_bg_alt      ${BG_ALT};
@define-color lexos_fg          ${FG};

@define-color theme_bg_color            ${BG};
@define-color theme_base_color          ${BG};
@define-color theme_fg_color            ${FG};
@define-color theme_text_color          ${FG};
@define-color theme_selected_bg_color   ${ACCENT};
@define-color theme_selected_fg_color   ${BTN_FG};
@define-color insensitive_bg_color      ${BG_ALT};
@define-color insensitive_fg_color      ${FG_DIM};
@define-color borders                   ${BORDER};
@define-color unfocused_borders         ${BORDER};
@define-color accent_color              ${ACCENT};
@define-color accent_bg_color           ${ACCENT};
@define-color accent_fg_color           ${BTN_FG};
@define-color window_bg_color           ${BG};
@define-color window_fg_color           ${FG};
@define-color view_bg_color             ${BG};
@define-color view_fg_color             ${FG};
@define-color headerbar_bg_color        ${BG_ALT};
@define-color headerbar_fg_color        ${FG};
@define-color popover_bg_color          ${BG_ALT};
@define-color popover_fg_color          ${FG};

/* --- Fonds : noir pur --------------------------------------------------- */
window, dialog, .background, popover, popover.background,
notebook, notebook > stack, paned, box, grid, viewport,
scrolledwindow, frame, list, listbox, flowbox, .view, textview,
treeview.view, iconview, stack, overlay, assistant, messagedialog {
    background-color: ${BG};
    color: ${FG};
}

headerbar, .titlebar, toolbar, actionbar, searchbar, infobar,
.csd .titlebar, menubar, .menubar {
    background-color: ${BG_ALT};
    background-image: none;
    color: ${FG};
    border-color: ${BORDER};
}

/* --- Écriture blanche partout ------------------------------------------- */
label, .label, textview text, entry, spinbutton, checkbutton, radiobutton,
menuitem, .menuitem, treeview.view, cellrenderertext {
    color: ${FG};
}
label:disabled, .dim-label, .subtitle { color: ${FG_DIM}; }

/* --- Boutons : accent, SANS peindre le « button » nu ---------------------
   Le sélecteur « button » tout nu perdait contre Arc-Dark partout où celui-ci
   est plus précis (des boutons restaient sombres), ET il arrosait les faux
   boutons — listes déroulantes, compteurs, en-têtes de colonnes devenaient
   orange (vu sur la photo d'Alex : le Gestionnaire d'alimentation avec ses
   listes en gros orange). On énumère donc les contextes RÉELS, et on exclut
   plus bas les boutons de structure. */
window button, dialog button, messagedialog button,
headerbar button, .titlebar button, toolbar button, actionbar button,
popover button, infobar button, .dialog-action-area button,
.linked > button {
    background-image: none;
    background-color: ${ACCENT};
    color: ${BTN_FG};
    border: 1px solid ${ACCENT_LO};
    border-radius: 6px;
    text-shadow: none;
    /*  ALEX, PHOTO DE LA 73 : « fais le texte plus gros dans les boutons
        orange — noir, mais un petit peu plus gras, il est trop mince. »
        Le rectangle noir avait disparu, et c'est justement là que le vrai
        problème s'est vu : le libellé était en graisse normale, à la taille
        du texte courant, sur un aplat de couleur vive. Un texte fin sur de
        l'orange se lit moins bien que le même texte sur du noir — l'œil perd
        le contour des lettres dans la vibration du fond.
        600 et non 700 : « un petit peu ». Le gras franc alourdit une rangée
        de quatre boutons.
        1.06em et non un chiffre en pixels : le texte doit suivre « lexos
        access gros-texte » et le facteur d'écran. Une taille figée ici
        annulerait l'agrandissement là où il sert le plus. */
    font-weight: 600;
    font-size: 1.06em;
    /*  Le rembourrage suit la taille, sinon le texte touche la bordure. */
    padding: 6px 16px;
    transition: background-color 140ms ease-out, border-color 140ms ease-out;
}
window button:hover, dialog button:hover, headerbar button:hover,
toolbar button:hover, popover button:hover {
    background-color: ${ACCENT_HI};
    border-color: ${ACCENT};
}
window button:active, window button:checked,
dialog button:active, dialog button:checked {
    background-color: ${ACCENT_LO};
    border-color: ${ACCENT_LO};
}
window button:disabled, dialog button:disabled {
    background-color: ${BG_HI};
    color: ${FG_DIM};
    border-color: ${BORDER};
}

/* --- LE TEXTE DU BOUTON, ET LE NOIR QUI TRAÎNAIT DERRIÈRE -----------------
   PHOTO D'ALEX, FENÊTRE DE BIENVENUE : « il y a du noir sur les boutons
   orange (…) bouton orange et le texte en noir ». Le libellé était posé sur
   un rectangle noir à l'intérieur du bouton, au lieu d'être écrit à même
   l'orange.

   DEUX CAUSES, ET ELLES SONT DANS CE FICHIER.

   1. « color: ${FG} » PLUS HAUT ARROSE TOUS LES LIBELLÉS, y compris ceux qui
      sont DANS un bouton. Le bouton demandait bien ${BTN_FG} (noir, calculé
      pour donner 6,1:1 sur l'orange) — mais son enfant « label » portait sa
      propre couleur blanche, et un enfant qui a sa couleur n'hérite pas.
      Le sélecteur « label » est un type, il gagne sur l'héritage sans même
      avoir à être plus précis. D'où du texte BLANC sur orange : 3,4:1, sous
      le seuil lisible, et pas ce qu'Alex a demandé.

   2. LES ENFANTS DU BOUTON GARDAIENT LEUR FOND. GTK bâtit un bouton comme
      button > label, ou button > box > (image + label). Peindre le bouton ne
      repeint pas ses enfants : le fond sombre que le thème de base dessine
      sur la boîte interne restait, et c'est LUI le rectangle noir de la
      photo. On le retire explicitement.

   « inherit » plutôt que ${BTN_FG} en dur : les boutons de STRUCTURE plus bas
   demandent ${FG} et leurs libellés doivent suivre CE choix-là. Une couleur
   écrite en dur ici les casserait tous. */
/*  ═══ CE QUE LA PREMIÈRE VERSION DE CE CORRECTIF A RATÉ ═══
    Elle énumérait « button > label, button > box, button > box > label… » —
    des combinateurs ENFANT, à une profondeur devinée. Deux choses lui ont
    échappé, et la seconde annulait tout le correctif.

    1. LA PROFONDEUR N'EST PAS CONNUE D'AVANCE. Un bouton texte seul, c'est
       « button > label ». Un bouton icône+texte, c'est « button > box >
       label ». D'autres formes ajoutent une box de plus, ou une grid. Une
       énumération d'enfants directs rate tout ce qui est un cran plus bas :
       le fond noir y reste, et c'est le rectangle de la photo d'Alex.

    2. « color: inherit » HÉRITE DU PARENT DIRECT, PAS DU BOUTON. Et le
       parent direct du libellé, dès qu'il y a une icône, c'est la box — à
       qui la règle des fonds (« box, grid » plus haut) donne EXPLICITEMENT
       color: #FFFFFF. Le libellé héritait donc du BLANC de la box, pas du
       noir du bouton. Mesuré : blanc sur l'orange = 3,58:1, très exactement
       le défaut que ce correctif prétendait réparer. Il était livré, lu par
       GTK, et sans effet — le péché capital de ce projet, commis en le
       corrigeant.

    D'où le combinateur de DESCENDANCE, qui ne présume d'aucune profondeur,
    et « color: inherit » posé AUSSI sur box/grid : la couleur du bouton
    descend alors de proche en proche jusqu'au libellé, quel que soit le
    nombre d'étages. Spécificité 0,0,2 contre 0,0,1 pour la règle des fonds :
    on gagne quelle que soit la position dans la feuille. */
button label, button box, button grid, button image,
button stack, button widget, button contents {
    background-image: none;
    background-color: transparent;
    box-shadow: none;
    border: none;
    color: inherit;
    text-shadow: none;
    /*  LA GRAISSE ET LA TAILLE SE TRANSMETTENT COMME LA COULEUR, et pour la
        même raison : un enfant qui porte les siennes n'hérite pas de celles
        du parent. Sans ces deux lignes, le bouton demanderait du 600 et son
        libellé resterait fin — exactement le piège de « color: inherit »,
        rejoué sur une autre propriété. */
    font-weight: inherit;
    font-size: inherit;
}

/* --- Les boutons de STRUCTURE ne sont pas des boutons --------------------
   Une liste déroulante, une flèche de compteur, un en-tête de colonne, un
   bouton de barre de chemin : GTK les bâtit avec des « button » internes,
   mais personne ne les voit comme des boutons. Ils reprennent l'habit d'un
   champ : fond sombre, liseré discret. Ces règles viennent APRÈS celles de
   l'accent et les battent à spécificité égale ou supérieure. */
combobox button, combobox button.combo, spinbutton button,
treeview header button, header button, .path-bar button, pathbar button,
scrollbar button, calendar button, filechooser .path-bar button {
    background-image: none;
    background-color: ${BG_ALT};
    color: ${FG};
    border: 1px solid ${BORDER};
    border-radius: 6px;
}
combobox button:hover, spinbutton button:hover,
treeview header button:hover, .path-bar button:hover {
    background-color: ${BG_HI};
    border-color: ${ACCENT_LO};
}

/* --- Interrupteurs : l'accent, pas le bleu du thème de base --------------
   Vu sur la photo d'Alex : des interrupteurs BLEUS (Arc-Dark) au milieu
   d'un panneau orange. L'état « allumé » parle la langue de la maison. */
switch {
    background-color: ${BG_HI};
    border: 1px solid ${BORDER};
    border-radius: 999px;
}
switch:checked {
    background-color: ${ACCENT};
    border-color: ${ACCENT_LO};
}
switch slider {
    background-color: #FFFFFF;
    border-radius: 999px;
}
/*  Un bouton d'icône TRANSPARENT sur fond noir pur est invisible tant
    qu'on ne le survole pas — « une boîte sombre avec juste le logo au
    centre », dans les mots d'Alex. Fond très léger et liseré discret :
    visible sans être criard. */
button.flat, button.titlebutton, button.close, button.minimize,
button.maximize, notebook button, .titlebar button.titlebutton {
    background-color: ${BG_HI};
    border: 1px solid ${BORDER};
    border-radius: 6px;
    color: ${FG};
}
button.flat:hover, button.titlebutton:hover {
    background-color: ${BG_HI};
    border-color: ${BORDER};
}
/*  CES DEUX-LÀ POSAIENT UN FOND SANS COULEUR DE TEXTE, et récupéraient donc
    celle de l'accent : sur un accent bleu, du blanc atterrissait sur le rouge
    du bouton de suppression — 3,9:1, sous le seuil. Chacun porte maintenant
    la sienne, calculée sur SON fond. */
button.destructive-action, button.destructive-action label {
    background-color: ${DANGER};
    color: ${DANGER_FG};
    border-color: #A32B2F;
}
button.destructive-action label { background-color: transparent; }
button.suggested-action, button.suggested-action label {
    background-color: ${ACCENT};
    color: ${BTN_FG};
    border-color: ${ACCENT_LO};
}
button.suggested-action label { background-color: transparent; }

/* --- Champs de saisie ---------------------------------------------------- */
entry, spinbutton, .entry, searchbar entry {
    background-color: ${BG_ALT};
    color: ${FG};
    border: 1px solid ${BORDER};
    border-radius: 6px;
    caret-color: ${ACCENT};
}
entry:focus, spinbutton:focus {
    border-color: ${ACCENT};
    box-shadow: inset 0 0 0 1px ${ACCENT};
}
/*  DEUX REGLES ET NON UNE, ET C'EST TOUTE LA DIFFERENCE. Elles etaient
    ecrites « selection, ::selection { … } ». Or « ::selection » n'est pas un
    pseudo-element que GTK3 connait — et selon la regle du CSS, un selecteur
    invalide dans une liste invalide la REGLE ENTIERE. Le « selection » nu,
    lui, est un vrai noeud GTK3 depuis la 3.20 ; il partait a la poubelle avec
    l'autre, et la selection de texte restait BLEUE, celle d'Arc-Dark.
    Separees, la premiere s'applique et la seconde est ignoree toute seule. */
selection {
    background-color: ${ACCENT};
    color: ${BTN_FG};
}
::selection {
    background-color: ${ACCENT};
    color: ${BTN_FG};
}

/* --- Sélection dans les listes ------------------------------------------ */
row:selected, list row:selected, treeview.view:selected,
iconview:selected, flowboxchild:selected, menuitem:hover, .menuitem:hover {
    background-color: ${ACCENT};
    color: ${BTN_FG};
}
row:hover, list row:hover { background-color: ${BG_HI}; }

/* --- Barres de défilement ------------------------------------------------ */
scrollbar { background-color: ${BG}; border-color: ${BORDER}; }
scrollbar slider {
    background-color: ${BORDER};
    border-radius: 8px;
    min-width: 8px;
    min-height: 8px;
}
scrollbar slider:hover { background-color: ${ACCENT}; }

/* --- Progression, curseurs, interrupteurs -------------------------------- */
progressbar progress, levelbar block.filled { background-color: ${ACCENT}; }
progressbar trough, levelbar block.empty, scale trough { background-color: ${BG_HI}; }
scale highlight { background-color: ${ACCENT}; }
scale slider { background-color: ${ACCENT}; border: 1px solid ${ACCENT_LO}; }
switch:checked { background-color: ${ACCENT}; }
switch { background-color: ${BG_HI}; border: 1px solid ${BORDER}; }
check:checked, radio:checked {
    background-color: ${ACCENT};
    border-color: ${ACCENT_LO};
    color: ${BTN_FG};
}

/* --- Onglets -------------------------------------------------------------- */
notebook > header { background-color: ${BG_ALT}; border-color: ${BORDER}; }
notebook > header > tabs > tab { color: ${FG_DIM}; }
notebook > header > tabs > tab:checked {
    color: ${FG};
    box-shadow: inset 0 -3px ${ACCENT};
}

/* --- Panneau XFCE (barre du haut + dock) --------------------------------- */
#XfcePanelWindow {
    background-color: ${BG};
    border: none;
    color: ${FG};
}
#XfcePanelWindow button, .xfce4-panel button {
    background-color: transparent;
    border-color: transparent;
    border-radius: 6px;
    color: ${FG};
}
#XfcePanelWindow button:hover, .xfce4-panel button:hover {
    background-color: ${BG_HI};
}
#XfcePanelWindow button:checked, .xfce4-panel button:checked {
    background-color: ${BG_HI};
    box-shadow: inset 3px 0 ${ACCENT};
}

/* --- Notifications -------------------------------------------------------- */
#XfceNotifyWindow {
    background-color: ${BG_ALT};
    color: ${FG};
    border: 1px solid ${ACCENT};
    border-radius: 10px;
}

/* --- Menus ---------------------------------------------------------------- */
menu, .menu, .context-menu, popover.menu {
    background-color: ${BG_ALT};
    border: 1px solid ${BORDER};
    border-radius: 8px;
}

/* --- Terminal XFCE : toujours noir + vert foncé, même en thème de jour --- */
terminal-window, vte-terminal { background-color: ${TERM_BG}; color: ${TERM_FG}; }

/* --- Liens ---------------------------------------------------------------- */
link, *:link { color: ${ACCENT_HI}; }
EOF
}

#  ATOMIQUE : on génère dans un fichier temporaire et on ne remplace la
#  cible qu'une fois la génération finie — une génération interrompue ne
#  doit pas laisser l'utilisateur sans aucun style.
TMP_CSS="$(mktemp "$TARGET/.config/gtk-3.0/gtk.css.XXXXXX")" \
	&& gen_gtk_css > "$TMP_CSS" && mv -f "$TMP_CSS" "$TARGET/.config/gtk-3.0/gtk.css"
TMP_CSS="$(mktemp "$TARGET/.config/gtk-4.0/gtk.css.XXXXXX")" \
	&& gen_gtk_css > "$TMP_CSS" && mv -f "$TMP_CSS" "$TARGET/.config/gtk-4.0/gtk.css"

# =============================================================================
#  2. GTK 2 (vieilles applications)
# =============================================================================
GTK2_THEME="Arc-Dark"; GTK2_ICONS="Papirus-Dark"
[[ "$MODE" == "clair" ]] && { GTK2_THEME="Arc"; GTK2_ICONS="Papirus"; }
cat > "$TARGET/.gtkrc-2.0" <<EOF
# LexOS — généré par lexos-theme-gen (mode : ${MODE})
gtk-theme-name="${GTK2_THEME}"
gtk-icon-theme-name="${GTK2_ICONS}"
gtk-font-name="Noto Sans 10"
gtk-cursor-theme-name="Adwaita"
style "lexos-default" {
    bg[NORMAL]      = "${BG}"
    bg[PRELIGHT]    = "${BG_HI}"
    bg[SELECTED]    = "${ACCENT}"
    bg[ACTIVE]      = "${BG_ALT}"
    bg[INSENSITIVE] = "${BG_ALT}"
    fg[NORMAL]      = "${FG}"
    fg[PRELIGHT]    = "${FG}"
    fg[SELECTED]    = "${BTN_FG}"
    fg[ACTIVE]      = "${FG}"
    fg[INSENSITIVE] = "${FG_DIM}"
    base[NORMAL]    = "${BG}"
    base[SELECTED]  = "${ACCENT}"
    text[NORMAL]    = "${FG}"
    text[SELECTED]  = "${BTN_FG}"
}
class "GtkWidget" style "lexos-default"
style "lexos-button" = "lexos-default" {
    bg[NORMAL]   = "${ACCENT}"
    bg[PRELIGHT] = "${ACCENT_HI}"
    bg[ACTIVE]   = "${ACCENT_LO}"
}
class "GtkButton" style "lexos-button"
EOF

# =============================================================================
#  3. Terminal XFCE — noir, écriture vert dark, curseur accent
# =============================================================================
cat > "$TARGET/.config/xfce4/terminal/terminalrc" <<EOF
[Configuration]
FontName=Fira Code 11
FontAllowBold=TRUE
MiscAlwaysShowTabs=FALSE
MiscBell=FALSE
MiscBordersDefault=TRUE
MiscCursorBlinks=TRUE
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
MiscDefaultGeometry=100x28
MiscMenubarDefault=FALSE
MiscToolbarDefault=FALSE
MiscConfirmClose=FALSE
MiscShowUnsafePasteDialog=FALSE
ScrollingUnlimited=TRUE
ColorForeground=${TERM_FG}
ColorBackground=${TERM_BG}
ColorCursor=${ACCENT}
ColorCursorForeground=${TERM_BG}
ColorBold=${TERM_FG_HI}
ColorBoldUseDefault=FALSE
ColorSelection=${BTN_FG}
ColorSelectionBackground=${ACCENT}
TabActivityColor=${ACCENT}
ColorPalette=#0B0B0C;#E5484D;${TERM_FG};${ACCENT};#3D8BFD;#8B5CF6;#2AA9A0;#C8C8CC;#4A4A50;#FF6B6F;${TERM_FG_HI};${ACCENT_HI};#6EA8FE;#A78BFA;#4FD6CC;${BTN_FG}
BackgroundMode=TERMINAL_BACKGROUND_TRANSPARENT
BackgroundDarkness=0.94
EOF

# =============================================================================
#  4. Icônes teintées à l'accent (outils fichiers, archives ZIP…)
# =============================================================================
#  Chaque SVG source contient l'orange par défaut comme jeton ; on le
#  remplace par l'accent courant puis on rend les tailles usuelles dans le
#  thème d'icônes de l'utilisateur, qui a priorité sur celui du système.
if command -v rsvg-convert >/dev/null 2>&1; then
	ICON_DIR="$TARGET/.local/share/icons/hicolor"
	for ICON_NAME in files zip wifi bluetooth; do
		ICON_SRC="/usr/share/lexos/branding/icon-${ICON_NAME}.svg"
		[[ -r "$ICON_SRC" ]] || continue
		TMP_SVG="$(mktemp -t lexos-icon-XXXXXX.svg)"
		sed "s/#E8590C/${ACCENT}/gI" "$ICON_SRC" > "$TMP_SVG"
		#  16 et 22 étaient absents : le thème SYSTÈME, lui, les fournit.
		#  Résultat, aux tailles de la barre système l'icône retombait sur la
		#  version orange d'origine pendant qu'elle était bleue (ou verte…)
		#  partout ailleurs. On rend exactement les mêmes tailles que le
		#  thème système, sinon le remplacement est incomplet par construction.
		for S in 16 22 24 32 48 64 128 256; do
			mkdir -p "$ICON_DIR/${S}x${S}/apps"
			rsvg-convert -w "$S" -h "$S" \
				-o "$ICON_DIR/${S}x${S}/apps/lexos-${ICON_NAME}.png" "$TMP_SVG" 2>/dev/null || true
		done
		mkdir -p "$ICON_DIR/scalable/apps"
		rm -f "$ICON_DIR/scalable/apps/lexos-${ICON_NAME}.svg"
		rm -f "$TMP_SVG"
	done
	command -v gtk-update-icon-cache >/dev/null 2>&1 && \
		gtk-update-icon-cache -f "$ICON_DIR" >/dev/null 2>&1 || true
fi

# =============================================================================
#  4b. Les DOSSIERS suivent l'accent, eux aussi
# =============================================================================
#  DANS LA DÉMO, folderColor() rend l'accent courant : changer d'accent
#  repeint les six poches du dossier personnel. Sans ce bloc, l'ISO
#  garderait des dossiers orange sous un thème vert — et c'est la première
#  chose qu'on voit en ouvrant Fichiers.
#
#  On recopie le thème système dans celui de l'utilisateur en substituant
#  les DEUX jetons : #E8590C pour la poche, #A84007 pour le dos (le même
#  orange assombri, comme shade(c, 0.62) dans la démo). Le thème de
#  l'utilisateur passe avant celui du système dans XDG_DATA_DIRS, donc il
#  suffit d'écrire — rien à défaire.
#
#  Ce sont des SVG recopiés tels quels, pas des PNG rendus : un dossier se
#  voit à toutes les tailles, du panneau latéral à la grande vignette, et
#  figer huit tailles rendrait floue la seule qui manque.
#  La racine est surchargeable pour que ce bloc soit ÉPROUVABLE : sur une
#  machine de développement, /usr/share/icons/LexOS n'existe pas — il vit
#  dans config/includes.chroot. Sans cette variable, le seul moyen de
#  vérifier que changer d'accent repeint bien les dossiers serait de
#  construire une ISO et de la démarrer. En service normal elle n'est pas
#  définie et on lit le vrai chemin.
DOSSIERS_RACINE="${LEXOS_ICONES:-/usr/share/icons/LexOS}"
DOSSIERS_SRC="$DOSSIERS_RACINE/places/scalable"
if [[ -d "$DOSSIERS_SRC" ]]; then
	DOSSIERS_DST="$TARGET/.local/share/icons/LexOS"
	mkdir -p "$DOSSIERS_DST/places/scalable"
	#  L'index doit suivre : un dossier d'icônes sans index.theme n'est pas
	#  un thème, et GTK l'ignore en entier — sans rien dire.
	if [[ -r "$DOSSIERS_RACINE/index.theme" ]]; then
		cp -f "$DOSSIERS_RACINE/index.theme" "$DOSSIERS_DST/index.theme"
	fi
	for F in "$DOSSIERS_SRC"/*.svg; do
		[[ -r "$F" ]] || continue
		sed -e "s/#E8590C/${ACCENT}/gI" -e "s/#A84007/${ACCENT_LO}/gI" \
			"$F" > "$DOSSIERS_DST/places/scalable/$(basename "$F")"
	done
	command -v gtk-update-icon-cache >/dev/null 2>&1 && \
		gtk-update-icon-cache -f "$DOSSIERS_DST" >/dev/null 2>&1 || true
fi

# =============================================================================
#  5. Mémoriser l'accent pour les autres outils
# =============================================================================
cat > "$CONF_DIR/theme.conf" <<EOF
LEXOS_MODE=${MODE}
LEXOS_ACCENT_NAME=${ACCENT_NAME}
LEXOS_ACCENT=${ACCENT}
LEXOS_ACCENT_HI=${ACCENT_HI}
LEXOS_ACCENT_LO=${ACCENT_LO}
LEXOS_BG=${BG}
LEXOS_FG=${FG}
LEXOS_BTN_FG=${BTN_FG}
LEXOS_TERM_FG=${TERM_FG}
EOF

if [[ "$MODE" == "clair" ]]; then
	printf 'Thème LexOS — jour (clair) généré — accent : %s (%s)\n' "$ACCENT_NAME" "$ACCENT"
else
	printf 'Thème LexOS Noir généré — accent : %s (%s)\n' "$ACCENT_NAME" "$ACCENT"
fi

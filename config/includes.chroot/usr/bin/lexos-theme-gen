# =============================================================================
#  3b. Les couleurs de l'INVITE, dans un fichier que le shell relit
# =============================================================================
#  POURQUOI UN FICHIER, ET PAS DES COULEURS DANS interactive.sh.
#  L'invite avait ses couleurs écrites EN DUR (« 38;5;35 », « 38;5;208 »)
#  dans interactive.sh, sans aucun lien avec le terminalrc. Deux écritures
#  de la même couleur, libres de diverger — la faute exacte qui a donné
#  trois palettes de panneaux différentes dans ce dépôt.
#
#  Maintenant, une seule source : ce fichier. Et comme l'invite le relit à
#  CHAQUE affichage, les fenêtres DÉJÀ OUVERTES changent à la ligne
#  suivante, sans « source ~/.bashrc » et sans rien rouvrir.
#
#  DEUX ÉCRITURES DE CHAQUE COULEUR, ET CE N'EST PAS UN DOUBLON : la console
#  texte et les vieux ssh ne comprennent pas « 38;2;r;g;b » (couleur vraie)
#  et afficheraient la séquence en clair au milieu de l'invite. Ils reçoivent
#  la version palette 256, choisie pour être la plus proche.
ansi_vrai() { printf '38;2;%d;%d;%d' "$((16#${1:1:2}))" "$((16#${1:3:2}))" "$((16#${1:5:2}))"; }

if [[ "$TERM_EFFECTIF" == "jour" ]]; then
	PS_MACHINE_256="38;5;22"    # vert foncé
	PS_SAISIE_256="38;5;94"     # brun-orange foncé
	PS_ERREUR_256="1;38;5;88"   # rouge foncé
else
	PS_MACHINE_256="38;5;35"
	PS_SAISIE_256="38;5;208"
	PS_ERREUR_256="1;38;5;196"
fi

cat > "$CONF_DIR/terminal.env" <<EOF
# LexOS — couleurs de l'invite, générées par lexos-theme-gen.
# Ne pas éditer : sera écrasé. Pour changer de palette :
#     lexos terminal jour      ·  lexos terminal nuit
#     lexos terminal auto      ·  lexos terminal suivre
LEXOS_TERM_MODE=${TERM_MODE}
LEXOS_TERM_EFFECTIF=${TERM_EFFECTIF}
LEXOS_TERM_BG=${TERM_BG}
LEXOS_TERM_FG=${TERM_FG}
LEXOS_TERM_CURSEUR=${TERM_CURSEUR}
LEXOS_PS_MACHINE='$(ansi_vrai "$TERM_FG")'
LEXOS_PS_SAISIE='$(ansi_vrai "$TERM_SAISIE")'
LEXOS_PS_ERREUR='1;$(ansi_vrai "$TERM_ERREUR")'
LEXOS_PS_DIM='$(ansi_vrai "$TERM_DIM")'
LEXOS_PS_MACHINE_256='${PS_MACHINE_256}'
LEXOS_PS_SAISIE_256='${PS_SAISIE_256}'
LEXOS_PS_ERREUR_256='${PS_ERREUR_256}'
LEXOS_PS_DIM_256='2'
EOF

# =============================================================================
#  4. Icônes teintées à l'accent (outils fichiers, archives ZIP…)
# =============================================================================
#  Chaque SVG source contient l'orange par défaut comme jeton ; on le
#  remplace par l'accent courant puis on rend les tailles usuelles dans le
#  thème d'icônes de l'utilisateur, qui a priorité sur celui du système.
if command -v rsvg-convert >/dev/null 2>&1; then
	ICON_DIR="$TARGET/.local/share/icons/hicolor"
	for ICON_NAME in files zip wifi bluetooth camera capture-zone capture-video; do
		ICON_SRC="/usr/share/lexos/branding/icon-${ICON_NAME}.svg"
		[[ -r "$ICON_SRC" ]] || continue
		TMP_SVG="$(mktemp -t lexos-icon-XXXXXX.svg)"
		sed "s/#E8590C/${ACCENT}/gI" "$ICON_SRC" > "$TMP_SVG"
		#  16 et 22 étaient absents : le thème SYSTÈME, lui, les fournit.
		#  Résultat, aux tailles de la barre système l'icône retombait sur la
		#  version orange d'origine pendant qu'elle était bleue (ou verte…)
		#  partout ailleurs. On rend exactement les mêmes tailles que le
		#  thème système, sinon le remplacement est incomplet par construction.
		for S in 16 22 24 32 48 64 128 256; do
			mkdir -p "$ICON_DIR/${S}x${S}/apps"
			rsvg-convert -w "$S" -h "$S" \
				-o "$ICON_DIR/${S}x${S}/apps/lexos-${ICON_NAME}.png" "$TMP_SVG" 2>/dev/null || true
		done
		mkdir -p "$ICON_DIR/scalable/apps"
		rm -f "$ICON_DIR/scalable/apps/lexos-${ICON_NAME}.svg"
		rm -f "$TMP_SVG"
	done
	command -v gtk-update-icon-cache >/dev/null 2>&1 && \
		gtk-update-icon-cache -f "$ICON_DIR" >/dev/null 2>&1 || true
fi

# =============================================================================
#  4b. Les DOSSIERS suivent l'accent, eux aussi
# =============================================================================
#  DANS LA DÉMO, folderColor() rend l'accent courant : changer d'accent
#  repeint les six poches du dossier personnel. Sans ce bloc, l'ISO
#  garderait des dossiers orange sous un thème vert — et c'est la première
#  chose qu'on voit en ouvrant Fichiers.
#
#  On recopie le thème système dans celui de l'utilisateur en substituant
#  les DEUX jetons : #E8590C pour la poche, #A84007 pour le dos (le même
#  orange assombri, comme shade(c, 0.62) dans la démo). Le thème de
#  l'utilisateur passe avant celui du système dans XDG_DATA_DIRS, donc il
#  suffit d'écrire — rien à défaire.
#
#  Ce sont des SVG recopiés tels quels, pas des PNG rendus : un dossier se
#  voit à toutes les tailles, du panneau latéral à la grande vignette, et
#  figer huit tailles rendrait floue la seule qui manque.
#  La racine est surchargeable pour que ce bloc soit ÉPROUVABLE : sur une
#  machine de développement, /usr/share/icons/LexOS n'existe pas — il vit
#  dans config/includes.chroot. Sans cette variable, le seul moyen de
#  vérifier que changer d'accent repeint bien les dossiers serait de
#  construire une ISO et de la démarrer. En service normal elle n'est pas
#  définie et on lit le vrai chemin.
#  ═══ LE DÉFAUT QUI A COÛTÉ QUATRE ISO, ET CE QU'ALEX A VU ═══
#  Builds 71 à 74 : les dossiers du gestionnaire de fichiers restaient
#  BLEUS (71) puis des FEUILLES BLANCHES (72, 73, 74), alors que le thème
#  système était parfait. Le journal du build 75 le prouve, hook 0605 :
#  19 SVG lisibles, 0 cassée, tous les noms que GTK réclame présents,
#  152 PNG rendus sur huit tailles, index.theme réécrit, cache construit.
#  La construction était irréprochable — donc la faute était ICI, au
#  démarrage.
#
#  C'est Alex qui a donné l'indice décisif, sur le dock : « le fichier
#  change comme tu peux voir quand je mets la souris dessus ». Plank
#  AGRANDIT l'icône au survol. Une icône qui change quand la TAILLE change,
#  ce n'est pas une icône absente — c'est GTK qui choisit ailleurs.
#
#  Et voici pourquoi. Ce bloc écrivait un thème nommé « LexOS » dans le
#  dossier personnel. Le dossier personnel PASSE AVANT /usr/share dans
#  XDG_DATA_DIRS, et deux thèmes de même nom ne se complètent pas : le
#  premier trouvé GAGNE, l'autre n'existe plus. Or cette copie ne contenait
#  QUE « places/scalable ». Le thème complet du système — ses huit tailles
#  fixes, ses icônes d'application — était masqué par une copie qui en
#  portait un neuvième.
#
#  Résultat : aux tailles où Papirus (hérité) offre un PNG exact, il pouvait
#  l'emporter — dossiers BLEUS du build 71. Et le jour où Papirus n'était
#  pas installé, il ne restait plus rien : GTK descendait jusqu'à l'icône
#  générique d'un type inconnu, la FEUILLE BLANCHE des builds 72 à 74.
#
#  ═══ DEUX CORRECTIONS, ET LA PREMIÈRE EST LA PLUS IMPORTANTE ═══
#
#    1. SOUS L'ACCENT PAR DÉFAUT, ON NE COPIE PLUS RIEN. Les SVG du système
#       SONT déjà orange : la copie n'apportait pas une couleur, elle
#       n'apportait qu'un masque. On efface même une copie laissée par un
#       accent précédent — sans quoi revenir à l'orange laisserait le
#       masque en place, et on croirait le correctif inopérant.
#       C'est le cas d'Alex, et donc le cas de presque tout le monde.
#
#    2. SOUS UN AUTRE ACCENT, LA COPIE DEVIENT COMPLÈTE. Mêmes tailles,
#       mêmes icônes d'application, et un index.theme ÉCRIT d'après ce
#       qu'on vient de poser — jamais recopié d'ailleurs. Masquer un thème
#       n'est acceptable que si on le remplace À ÉGALITÉ.
DOSSIERS_RACINE="${LEXOS_ICONES:-/usr/share/icons/LexOS}"
DOSSIERS_SRC="$DOSSIERS_RACINE/places/scalable"
DOSSIERS_DST="$TARGET/.local/share/icons/LexOS"
TAILLES_ICONES="16 22 24 32 48 64 128 256"

if [[ "${ACCENT^^}" == "#E8590C" ]]; then
	#  Rien à teinter : le thème système est déjà de cette couleur. On
	#  retire toute copie antérieure pour cesser de le masquer.
	rm -rf "$DOSSIERS_DST"
elif [[ -d "$DOSSIERS_SRC" ]]; then
	rm -rf "$DOSSIERS_DST"
	mkdir -p "$DOSSIERS_DST/places/scalable"

	teindre() {   # <source> <destination>
		sed -e "s/#E8590C/${ACCENT}/gI" -e "s/#A84007/${ACCENT_LO}/gI" "$1" > "$2"
	}

	for F in "$DOSSIERS_SRC"/*.svg; do
		[[ -r "$F" ]] || continue
		teindre "$F" "$DOSSIERS_DST/places/scalable/$(basename "$F")"
	done

	#  Les icônes d'application (le lanceur « Fichiers ») sont des liens
	#  vers places/ : « sed » les suit et écrit de vrais fichiers.
	if [[ -d "$DOSSIERS_RACINE/apps/scalable" ]]; then
		mkdir -p "$DOSSIERS_DST/apps/scalable"
		for F in "$DOSSIERS_RACINE/apps/scalable"/*.svg; do
			[[ -r "$F" ]] || continue
			teindre "$F" "$DOSSIERS_DST/apps/scalable/$(basename "$F")"
		done
	fi

	#  LES TAILLES FIXES, sans quoi on retombe dans le défaut qu'on corrige.
	if command -v rsvg-convert >/dev/null 2>&1; then
		for CAT in places apps; do
			[[ -d "$DOSSIERS_DST/$CAT/scalable" ]] || continue
			for S in $TAILLES_ICONES; do
				mkdir -p "$DOSSIERS_DST/$CAT/${S}x${S}"
				for F in "$DOSSIERS_DST/$CAT/scalable"/*.svg; do
					[[ -r "$F" ]] || continue
					rsvg-convert -w "$S" -h "$S" \
						-o "$DOSSIERS_DST/$CAT/${S}x${S}/$(basename "$F" .svg).png" \
						"$F" 2>/dev/null || true
				done
			done
		done
	fi

	#  ═══ SI ON N'A PAS PU FAIRE AUSSI BIEN, ON NE MASQUE PAS ═══
	#  Sans les tailles fixes, on n'aurait que du scalable — exactement le
	#  défaut qui a coûté quatre ISO. Mieux vaut des dossiers de la MAUVAISE
	#  couleur mais VISIBLES que des dossiers de la bonne couleur qui ne
	#  s'affichent pas. On efface donc la copie et on laisse le thème système
	#  complet reprendre la main, en le disant.
	#
	#  ═══ CE CONTRÔLE REGARDAIT LES DOSSIERS, PAS LEUR CONTENU ═══
	#  Il cherchait « un dossier nommé 16x16, 22x22… ». Or ces dossiers sont
	#  créés par « mkdir -p » AVANT la conversion, et chaque rsvg-convert se
	#  termine par « || true ». Un rsvg-convert présent mais EN ÉCHEC — une
	#  installation cassée, une bibliothèque manquante, un disque plein —
	#  laissait donc seize dossiers vides, le contrôle les voyait, et on
	#  masquait le thème système avec du scalable seul. Le garde-fou écrit
	#  contre ce défaut précis ne le voyait pas.
	#
	#  Ce n'est pas une hypothèse : l'intégration continue vient de le faire.
	#  Le banc y fabrique un faux rsvg-convert qui s'appuyait sur Pillow, et
	#  Pillow n'est pas installé à cette étape-là. Résultat exact :
	#  « index.theme déclare 2 dossiers pour 18 sur le disque ».
	#
	#  On compte donc les tailles qui contiennent VRAIMENT des fichiers, et
	#  on les veut TOUTES. « À égalité » ne se négocie pas à sept huitièmes :
	#  la taille manquante serait précisément celle que le dock demande.
	#  Un dossier vide est aussi RETIRÉ — par « rm -rf », sûr puisqu'on vient
	#  de vérifier qu'il est vide, et pas par rmdir : ce programme tourne
	#  aussi sur des systèmes réduits, et l'index plus bas ne doit jamais
	#  avoir à se poser la question d'un dossier creux.
	ATTENDUES=0
	for S in $TAILLES_ICONES; do ATTENDUES=$((ATTENDUES + 1)); done
	PLEINES=0
	for D in "$DOSSIERS_DST"/places/[0-9]*; do
		[[ -d "$D" ]] || continue
		if compgen -G "$D/*" >/dev/null; then
			PLEINES=$((PLEINES + 1))
		else
			rm -rf "$D"
		fi
	done
	for D in "$DOSSIERS_DST"/apps/[0-9]*; do
		[[ -d "$D" ]] || continue
		compgen -G "$D/*" >/dev/null || rm -rf "$D"
	done
	if [[ "$PLEINES" -lt "$ATTENDUES" ]]; then
		rm -rf "$DOSSIERS_DST"
		printf 'Icônes : %s tailles fixes sur %s (rsvg-convert absent ou en échec) — les dossiers restent orange (thème système) plutôt que masqués à moitié.\n' \
			"$PLEINES" "$ATTENDUES" >&2
	else

	#  L'INDEX ÉCRIT D'APRÈS LE DISQUE, jamais recopié. Un thème qui déclare
	#  un dossier absent, ou qui en oublie un présent, est ignoré en partie
	#  — sans rien dire. Même règle que le hook 0605 côté système.
	DIRS=""
	for D in "$DOSSIERS_DST"/places/* "$DOSSIERS_DST"/apps/*; do
		[[ -d "$D" ]] || continue
		compgen -G "$D/*" >/dev/null || continue      # dossier vide : on ne le déclare pas
		DIRS="${DIRS:+$DIRS,}${D#"$DOSSIERS_DST"/}"
	done
	{
		echo "[Icon Theme]"
		echo "Name=LexOS"
		echo "Comment=Dossiers de LexOS teintés à l'accent ${ACCENT_NAME}"
		echo "Inherits=Papirus-Dark,Papirus,Adwaita,hicolor"
		echo "Directories=${DIRS}"
		for D in "$DOSSIERS_DST"/places/* "$DOSSIERS_DST"/apps/*; do
			[[ -d "$D" ]] || continue
			compgen -G "$D/*" >/dev/null || continue
			REL="${D#"$DOSSIERS_DST"/}"
			CTX="Places"; [[ "$REL" == apps/* ]] && CTX="Applications"
			T="${REL##*/}"
			echo
			echo "[${REL}]"
			echo "Context=${CTX}"
			if [[ "$T" == "scalable" ]]; then
				echo "Size=512"; echo "MinSize=8"; echo "MaxSize=512"; echo "Type=Scalable"
			else
				echo "Size=${T%%x*}"; echo "Type=Fixed"
			fi
		done
	} > "$DOSSIERS_DST/index.theme"

	command -v gtk-update-icon-cache >/dev/null 2>&1 && \
		gtk-update-icon-cache -f "$DOSSIERS_DST" >/dev/null 2>&1 || true
	fi
fi

# =============================================================================
#  5. Mémoriser l'accent pour les autres outils
# =============================================================================
cat > "$CONF_DIR/theme.conf" <<EOF
LEXOS_MODE=${MODE}
LEXOS_TERM_MODE=${TERM_MODE}
LEXOS_TERM_EFFECTIF=${TERM_EFFECTIF}
LEXOS_ACCENT_NAME=${ACCENT_NAME}
LEXOS_ACCENT=${ACCENT}
LEXOS_ACCENT_HI=${ACCENT_HI}
LEXOS_ACCENT_LO=${ACCENT_LO}
LEXOS_BG=${BG}
LEXOS_FG=${FG}
LEXOS_BTN_FG=${BTN_FG}
LEXOS_TERM_FG=${TERM_FG}
EOF

if [[ "$MODE" == "clair" ]]; then
	printf 'Thème LexOS — jour (clair) généré — accent : %s (%s)\n' "$ACCENT_NAME" "$ACCENT"
else
	printf 'Thème LexOS Noir généré — accent : %s (%s)\n' "$ACCENT_NAME" "$ACCENT"
fi

EOF
}

#  ATOMIQUE : on génère dans un fichier temporaire et on ne remplace la
#  cible qu'une fois la génération finie — une génération interrompue ne
#  doit pas laisser l'utilisateur sans aucun style.
TMP_CSS="$(mktemp "$TARGET/.config/gtk-3.0/gtk.css.XXXXXX")" \
	&& gen_gtk_css > "$TMP_CSS" && mv -f "$TMP_CSS" "$TARGET/.config/gtk-3.0/gtk.css"
TMP_CSS="$(mktemp "$TARGET/.config/gtk-4.0/gtk.css.XXXXXX")" \
	&& gen_gtk_css > "$TMP_CSS" && mv -f "$TMP_CSS" "$TARGET/.config/gtk-4.0/gtk.css"

# =============================================================================
#  2. GTK 2 (vieilles applications)
# =============================================================================
GTK2_THEME="Arc-Dark"; GTK2_ICONS="Papirus-Dark"
[[ "$MODE" == "clair" ]] && { GTK2_THEME="Arc"; GTK2_ICONS="Papirus"; }
cat > "$TARGET/.gtkrc-2.0" <<EOF
# LexOS — généré par lexos-theme-gen (mode : ${MODE})
gtk-theme-name="${GTK2_THEME}"
gtk-icon-theme-name="${GTK2_ICONS}"
gtk-font-name="Noto Sans 10"
gtk-cursor-theme-name="Adwaita"
style "lexos-default" {
    bg[NORMAL]      = "${BG}"
    bg[PRELIGHT]    = "${BG_HI}"
    bg[SELECTED]    = "${ACCENT}"
    bg[ACTIVE]      = "${BG_ALT}"
    bg[INSENSITIVE] = "${BG_ALT}"
    fg[NORMAL]      = "${FG}"
    fg[PRELIGHT]    = "${FG}"
    fg[SELECTED]    = "${BTN_FG}"
    fg[ACTIVE]      = "${FG}"
    fg[INSENSITIVE] = "${FG_DIM}"
    base[NORMAL]    = "${BG}"
    base[SELECTED]  = "${ACCENT}"
    text[NORMAL]    = "${FG}"
    text[SELECTED]  = "${BTN_FG}"
}
class "GtkWidget" style "lexos-default"
style "lexos-button" = "lexos-default" {
    bg[NORMAL]   = "${ACCENT}"
    bg[PRELIGHT] = "${ACCENT_HI}"
    bg[ACTIVE]   = "${ACCENT_LO}"
}
class "GtkButton" style "lexos-button"
EOF

# =============================================================================
#  3. Terminal XFCE — noir, écriture vert dark, curseur accent
# =============================================================================
#  ALEX, PHOTO DU TERMINAL : « écriture plus gros ». 11 -> 13 (+18 %).
#  PHOTO SUIVANTE, MÊME TERMINAL : encore « trop petit ». 13 -> 15 (+15 %
#  de plus, +36 % depuis l'origine). Une seule variable, écrite UNE fois,
#  reprise dans terminalrc ET dans le canal Xfconf juste en dessous —
#  sinon on recrée exactement le défaut que ce bloc découvre à l'instant :
#  deux écritures de la même valeur, libres de diverger.
TERM_POLICE="Fira Code 15"

cat > "$TARGET/.config/xfce4/terminal/terminalrc" <<EOF
[Configuration]
FontName=${TERM_POLICE}
FontAllowBold=TRUE
MiscAlwaysShowTabs=FALSE
MiscBell=FALSE
MiscBordersDefault=TRUE
MiscCursorBlinks=TRUE
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
MiscDefaultGeometry=100x28
MiscMenubarDefault=FALSE
MiscToolbarDefault=FALSE
MiscConfirmClose=FALSE
MiscShowUnsafePasteDialog=FALSE
ScrollingUnlimited=TRUE
ColorForeground=${TERM_FG}
ColorBackground=${TERM_BG}
ColorCursor=${TERM_CURSEUR}
ColorCursorForeground=${TERM_BG}
ColorBold=${TERM_FG_HI}
ColorBoldUseDefault=FALSE
ColorSelection=${TERM_SEL_FG}
ColorSelectionBackground=${TERM_SEL_BG}
TabActivityColor=${TERM_SAISIE}
ColorPalette=${TERM_PALETTE}
BackgroundMode=TERMINAL_BACKGROUND_TRANSPARENT
BackgroundDarkness=${TERM_TRANSPARENCE}
EOF

# =============================================================================
#  3a. CE FICHIER-LÀ NE SUFFIT PLUS — le canal Xfconf, écrit en direct
# =============================================================================
#  DÉCOUVERT EN CHERCHANT POURQUOI LA POLICE D'ALEX NE GROSSISSAIT JAMAIS.
#  xfce4-terminal (depuis la branche 1.1, celle de Xfce 4.20 — la version de
#  trixie) a changé de mécanisme : à SON PREMIER LANCEMENT, il MIGRE
#  terminalrc vers le canal Xfconf « xfce4-terminal », affiche « Your
#  Terminal settings have been migrated to Xfconf. The config file […] is
#  not used anymore. » — et ensuite, terminalrc n'est PLUS JAMAIS RELU.
#  Vérifié en le faisant tourner pour de vrai (xfce4-terminal réel, sous
#  Xvfb) : un compte qui a déjà ouvert un terminal une fois garde pour
#  toujours la police et les couleurs du jour de cette première migration,
#  quel que soit le nombre de fois où ce script réécrit terminalrc ensuite.
#  C'est très exactement le mur des icônes qui se masquaient l'une l'autre
#  (build 70-74), rejoué sur un fichier différent : le bon réglage est écrit
#  au bon endroit, et quelque chose de PLUS TÔT dans la chaîne d'a déjà
#  décidé de ne plus le lire.
#
#  LE CORRECTIF : ne plus dépendre de la migration. On écrit le canal
#  Xfconf NOUS-MÊMES, comme xfwm4.xml et xsettings.xml le sont déjà pour la
#  fenêtre et le thème GTK. Pour un compte tout neuf (le cas normal — cette
#  fonction cible /etc/skel), Xfconf trouve alors le canal DÉJÀ REMPLI à la
#  toute première ouverture : la migration ne se déclenche même pas (elle
#  ne s'active que si le canal est vide), terminalrc devient un simple
#  filet pour les très vieilles versions.
#
#  LES NOMS DE PROPRIÉTÉ SONT VÉRIFIÉS, PAS DEVINÉS : ils ne sont documentés
#  NULLE PART (ni « man xfce4-terminal », ni son fichier .desktop) — on a
#  fait tourner le vrai binaire sur un terminalrc complet et relu EXACTEMENT
#  ce qu'il a écrit dans le canal migré. Une clé mal orthographiée ne
#  provoquerait aucune erreur (Xfconf ignore une clé qu'il ne connaît pas,
#  en silence) : c'est le genre de faute qu'aucun test ne peut voir sans
#  faire tourner le vrai xfce4-terminal, ce que tests/test_lexos_terminal.sh
#  fait précisément pour cette raison.
mkdir -p "$TARGET/.config/xfce4/xfconf/xfce-perchannel-xml"
cat > "$TARGET/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-terminal.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-terminal" version="1.0">
  <property name="background-mode" type="string" value="TERMINAL_BACKGROUND_TRANSPARENT"/>
  <property name="background-darkness" type="double" value="${TERM_TRANSPARENCE}"/>
  <property name="color-foreground" type="string" value="${TERM_FG}"/>
  <property name="color-background" type="string" value="${TERM_BG}"/>
  <property name="color-cursor-foreground" type="string" value="${TERM_BG}"/>
  <property name="color-cursor" type="string" value="${TERM_CURSEUR}"/>
  <property name="color-selection" type="string" value="${TERM_SEL_FG}"/>
  <property name="color-selection-background" type="string" value="${TERM_SEL_BG}"/>
  <property name="color-bold" type="string" value="${TERM_FG_HI}"/>
  <property name="color-bold-use-default" type="bool" value="false"/>
  <property name="color-palette" type="string" value="${TERM_PALETTE}"/>
  <property name="font-allow-bold" type="bool" value="true"/>
  <property name="font-name" type="string" value="${TERM_POLICE}"/>
  <property name="misc-always-show-tabs" type="bool" value="false"/>
  <property name="misc-bell" type="bool" value="false"/>
  <property name="misc-borders-default" type="bool" value="true"/>
  <property name="misc-cursor-blinks" type="bool" value="true"/>
  <property name="misc-cursor-shape" type="string" value="TERMINAL_CURSOR_SHAPE_BLOCK"/>
  <property name="misc-default-geometry" type="string" value="100x28"/>
  <property name="misc-menubar-default" type="bool" value="false"/>
  <property name="misc-toolbar-default" type="bool" value="false"/>
  <property name="misc-confirm-close" type="bool" value="false"/>
  <property name="misc-show-unsafe-paste-dialog" type="bool" value="false"/>
  <property name="scrolling-unlimited" type="bool" value="true"/>
  <property name="tab-activity-color" type="string" value="${TERM_SAISIE}"/>
</channel>
EOF

# =============================================================================
#  3b. flameshot (capture d'écran) — la barre d'outils suit l'accent
# =============================================================================
#  ALEX, PHOTO DU SÉLECTEUR DE ZONE : « changer la couleur pour orange au
#  lieu de rose ». flameshot arrive par défaut en violet — sa couleur à lui,
#  sans lien avec LexOS.
#
#  DEUX CLÉS, VÉRIFIÉES EN LES FAISANT ÉCRIRE PAR flameshot LUI-MÊME
#  (« flameshot config -m/-k », HOME de test, -platform offscreen), PAS
#  DEVINÉES : la doc (« man flameshot ») nomme les DRAPEAUX de la commande
#  « config », jamais les clés du fichier — celles-ci ne sont écrites nulle
#  part en clair. On a donc fait tourner la vraie commande et relu le
#  fichier qu'elle produit :
#    [General]
#    uiColor=<couleur principale des boutons>
#    contrastUiColor=<couleur de ce qui est DESSUS — l'icône>
#
#  contrastUiColor REPREND texte_lisible(), la même fonction WCAG qui choisit
#  déjà le noir ou le blanc pour tous les autres boutons de LexOS (BTN_FG,
#  quelques lignes plus haut) : une icône blanche sur l'orange de LexOS tombe
#  sous le seuil lisible (3,4:1), le noir passe (6,1:1). Pas une deuxième
#  règle de contraste à tenir à jour à côté de la première.
#  ═══ POURQUOI L'ACCENT « HAUT » ET PAS L'ACCENT PRINCIPAL ═══
#  ALEX, PHOTO DU PANNEAU D'AIDE : « quand on prend une capture d'écran,
#  faire en sorte que ce soit écriture noire s'il vous plaît. » Le rappel des
#  raccourcis (Souris · Entrée · Molette · Clic droit · Espace · Échap)
#  s'affichait en BLANC sur l'orange : 3,58:1, sous le seuil lisible.
#
#  ET CE TEXTE-LÀ NE SUIT PAS « contrastUiColor ». On l'a éprouvé pour de
#  vrai — flameshot lancé sous un serveur X virtuel (Xvfb), le panneau
#  photographié, les pixels relus — et non deviné : avec contrastUiColor déjà
#  à #000000, l'écriture restait blanche. flameshot la choisit LUI-MÊME
#  d'après la clarté de « uiColor », et aucune clé ne le contredit
#  (« flameshot config » n'en écrit que deux, on le lui a fait faire).
#
#  MESURÉ, COULEUR PAR COULEUR, DANS LE VRAI RENDU :
#      #E8590C (accent) ......... écriture BLANCHE
#      #FF7A33 (accent haut) .... écriture SOMBRE
#  La bascule est entre les deux. On prend donc l'accent HAUT — qui n'est pas
#  une couleur inventée pour l'occasion : c'est ACCENT_HI, le ton de survol
#  que LexOS emploie déjà partout. La barre d'outils reste orange, d'un
#  orange un peu plus vif, et flameshot bascule son texte tout seul.
#
#  contrastUiColor SUIT LA MÊME COULEUR. Il peint l'icône POSÉE SUR le
#  bouton : la calculer sur l'accent principal alors que le fond est
#  l'accent haut serait mesurer le contraste sur la mauvaise couleur.
mkdir -p "$TARGET/.config/flameshot"
cat > "$TARGET/.config/flameshot/flameshot.ini" <<EOF
[General]
uiColor=${ACCENT_HI}
contrastUiColor=$(texte_lisible "$ACCENT_HI")
#  DEUX BULLES POUR UNE SEULE CAPTURE. Photo d'Alex : « Capture d'écran »
#  (la nôtre, avec ses boutons) ET « Flameshot Info — Capture saved as … »
#  empilées dans le coin. La seconde ne dit rien de plus, en anglais, et
#  sans rien à cliquer. On la coupe : lexos-capture annonce déjà la
#  capture, avec le nom du fichier et ce qu'on peut en faire.
#  Clé relevée dans le binaire (« showDesktopNotificationChanged »), pas
#  devinée — « flameshot config --help » ne la documente pas.
showDesktopNotification=false
EOF

# =============================================================================
#  3c. Les couleurs de l'INVITE, dans un fichier que le shell relit
# =============================================================================
#  POURQUOI UN FICHIER, ET PAS DES COULEURS DANS interactive.sh.
#  L'invite avait ses couleurs écrites EN DUR (« 38;5;35 », « 38;5;208 »)
#  dans interactive.sh, sans aucun lien avec le terminalrc. Deux écritures
#  de la même couleur, libres de diverger — la faute exacte qui a donné
#  trois palettes de panneaux différentes dans ce dépôt.
#
#  Maintenant, une seule source : ce fichier. Et comme l'invite le relit à
#  CHAQUE affichage, les fenêtres DÉJÀ OUVERTES changent à la ligne
#  suivante, sans « source ~/.bashrc » et sans rien rouvrir.
#
#  DEUX ÉCRITURES DE CHAQUE COULEUR, ET CE N'EST PAS UN DOUBLON : la console
#  texte et les vieux ssh ne comprennent pas « 38;2;r;g;b » (couleur vraie)
#  et afficheraient la séquence en clair au milieu de l'invite. Ils reçoivent
#  la version palette 256, choisie pour être la plus proche.
ansi_vrai() { printf '38;2;%d;%d;%d' "$((16#${1:1:2}))" "$((16#${1:3:2}))" "$((16#${1:5:2}))"; }

if [[ "$TERM_EFFECTIF" == "jour" ]]; then
	PS_MACHINE_256="38;5;22"    # vert foncé
	PS_TEXTE_256="38;5;234"     # #1C1C1C, le plus proche de #1B1A17
	PS_ERREUR_256="1;38;5;88"   # rouge foncé
else
	PS_MACHINE_256="38;5;40"    # exactement #00D700, voir la section terminal plus haut
	PS_TEXTE_256="38;5;15"      # le blanc brillant de la palette
	PS_ERREUR_256="1;38;5;196"
fi

cat > "$CONF_DIR/terminal.env" <<EOF
# LexOS — couleurs de l'invite, générées par lexos-theme-gen.
# Ne pas éditer : sera écrasé. Pour changer de palette :
#     lexos terminal jour      ·  lexos terminal nuit
#     lexos terminal auto      ·  lexos terminal suivre
LEXOS_TERM_MODE=${TERM_MODE}
LEXOS_TERM_EFFECTIF=${TERM_EFFECTIF}
LEXOS_TERM_BG=${TERM_BG}
LEXOS_TERM_FG=${TERM_FG}
LEXOS_TERM_CURSEUR=${TERM_CURSEUR}
LEXOS_PS_MACHINE='$(ansi_vrai "$TERM_FG")'
LEXOS_PS_TEXTE='$(ansi_vrai "$TERM_TEXTE")'
LEXOS_PS_ERREUR='1;$(ansi_vrai "$TERM_ERREUR")'
LEXOS_PS_DIM='$(ansi_vrai "$TERM_DIM")'
LEXOS_PS_MACHINE_256='${PS_MACHINE_256}'
LEXOS_PS_TEXTE_256='${PS_TEXTE_256}'
LEXOS_PS_ERREUR_256='${PS_ERREUR_256}'
LEXOS_PS_DIM_256='2'
EOF

# =============================================================================
#  4. Icônes teintées à l'accent (outils fichiers, archives ZIP…)
# =============================================================================
#  Chaque SVG source contient l'orange par défaut comme jeton ; on le
#  remplace par l'accent courant puis on rend les tailles usuelles dans le
#  thème d'icônes de l'utilisateur, qui a priorité sur celui du système.
if command -v rsvg-convert >/dev/null 2>&1; then
	ICON_DIR="$TARGET/.local/share/icons/hicolor"
	for ICON_NAME in files zip wifi bluetooth camera capture-zone capture-video; do
		ICON_SRC="/usr/share/lexos/branding/icon-${ICON_NAME}.svg"
		[[ -r "$ICON_SRC" ]] || continue
		TMP_SVG="$(mktemp -t lexos-icon-XXXXXX.svg)"
		sed "s/#E8590C/${ACCENT}/gI" "$ICON_SRC" > "$TMP_SVG"
		#  16 et 22 étaient absents : le thème SYSTÈME, lui, les fournit.
		#  Résultat, aux tailles de la barre système l'icône retombait sur la
		#  version orange d'origine pendant qu'elle était bleue (ou verte…)
		#  partout ailleurs. On rend exactement les mêmes tailles que le
		#  thème système, sinon le remplacement est incomplet par construction.
		for S in 16 22 24 32 48 64 128 256; do
			mkdir -p "$ICON_DIR/${S}x${S}/apps"
			rsvg-convert -w "$S" -h "$S" \
				-o "$ICON_DIR/${S}x${S}/apps/lexos-${ICON_NAME}.png" "$TMP_SVG" 2>/dev/null || true
		done
		mkdir -p "$ICON_DIR/scalable/apps"
		rm -f "$ICON_DIR/scalable/apps/lexos-${ICON_NAME}.svg"
		rm -f "$TMP_SVG"
	done
	command -v gtk-update-icon-cache >/dev/null 2>&1 && \
		gtk-update-icon-cache -f "$ICON_DIR" >/dev/null 2>&1 || true
fi

# =============================================================================
#  4b. Les DOSSIERS suivent l'accent, eux aussi
# =============================================================================
#  DANS LA DÉMO, folderColor() rend l'accent courant : changer d'accent
#  repeint les six poches du dossier personnel. Sans ce bloc, l'ISO
#  garderait des dossiers orange sous un thème vert — et c'est la première
#  chose qu'on voit en ouvrant Fichiers.
#
#  On recopie le thème système dans celui de l'utilisateur en substituant
#  les DEUX jetons : #E8590C pour la poche, #A84007 pour le dos (le même
#  orange assombri, comme shade(c, 0.62) dans la démo). Le thème de
#  l'utilisateur passe avant celui du système dans XDG_DATA_DIRS, donc il
#  suffit d'écrire — rien à défaire.
#
#  Ce sont des SVG recopiés tels quels, pas des PNG rendus : un dossier se
#  voit à toutes les tailles, du panneau latéral à la grande vignette, et
#  figer huit tailles rendrait floue la seule qui manque.
#  La racine est surchargeable pour que ce bloc soit ÉPROUVABLE : sur une
#  machine de développement, /usr/share/icons/LexOS n'existe pas — il vit
#  dans config/includes.chroot. Sans cette variable, le seul moyen de
#  vérifier que changer d'accent repeint bien les dossiers serait de
#  construire une ISO et de la démarrer. En service normal elle n'est pas
#  définie et on lit le vrai chemin.
#  ═══ LE DÉFAUT QUI A COÛTÉ QUATRE ISO, ET CE QU'ALEX A VU ═══
#  Builds 71 à 74 : les dossiers du gestionnaire de fichiers restaient
#  BLEUS (71) puis des FEUILLES BLANCHES (72, 73, 74), alors que le thème
#  système était parfait. Le journal du build 75 le prouve, hook 0605 :
#  19 SVG lisibles, 0 cassée, tous les noms que GTK réclame présents,
#  152 PNG rendus sur huit tailles, index.theme réécrit, cache construit.
#  La construction était irréprochable — donc la faute était ICI, au
#  démarrage.
#
#  C'est Alex qui a donné l'indice décisif, sur le dock : « le fichier
#  change comme tu peux voir quand je mets la souris dessus ». Plank
#  AGRANDIT l'icône au survol. Une icône qui change quand la TAILLE change,
#  ce n'est pas une icône absente — c'est GTK qui choisit ailleurs.
#
#  Et voici pourquoi. Ce bloc écrivait un thème nommé « LexOS » dans le
#  dossier personnel. Le dossier personnel PASSE AVANT /usr/share dans
#  XDG_DATA_DIRS, et deux thèmes de même nom ne se complètent pas : le
#  premier trouvé GAGNE, l'autre n'existe plus. Or cette copie ne contenait
#  QUE « places/scalable ». Le thème complet du système — ses huit tailles
#  fixes, ses icônes d'application — était masqué par une copie qui en
#  portait un neuvième.
#
#  Résultat : aux tailles où Papirus (hérité) offre un PNG exact, il pouvait
#  l'emporter — dossiers BLEUS du build 71. Et le jour où Papirus n'était
#  pas installé, il ne restait plus rien : GTK descendait jusqu'à l'icône
#  générique d'un type inconnu, la FEUILLE BLANCHE des builds 72 à 74.
#
#  ═══ DEUX CORRECTIONS, ET LA PREMIÈRE EST LA PLUS IMPORTANTE ═══
#
#    1. SOUS L'ACCENT PAR DÉFAUT, ON NE COPIE PLUS RIEN. Les SVG du système
#       SONT déjà orange : la copie n'apportait pas une couleur, elle
#       n'apportait qu'un masque. On efface même une copie laissée par un
#       accent précédent — sans quoi revenir à l'orange laisserait le
#       masque en place, et on croirait le correctif inopérant.
#       C'est le cas d'Alex, et donc le cas de presque tout le monde.
#
#    2. SOUS UN AUTRE ACCENT, LA COPIE DEVIENT COMPLÈTE. Mêmes tailles,
#       mêmes icônes d'application, et un index.theme ÉCRIT d'après ce
#       qu'on vient de poser — jamais recopié d'ailleurs. Masquer un thème
#       n'est acceptable que si on le remplace À ÉGALITÉ.
DOSSIERS_RACINE="${LEXOS_ICONES:-/usr/share/icons/LexOS}"
DOSSIERS_SRC="$DOSSIERS_RACINE/places/scalable"
DOSSIERS_DST="$TARGET/.local/share/icons/LexOS"
TAILLES_ICONES="16 22 24 32 48 64 128 256"

if [[ "${ACCENT^^}" == "#E8590C" ]]; then
	#  Rien à teinter : le thème système est déjà de cette couleur. On
	#  retire toute copie antérieure pour cesser de le masquer.
	rm -rf "$DOSSIERS_DST"
elif [[ -d "$DOSSIERS_SRC" ]]; then
	rm -rf "$DOSSIERS_DST"
	mkdir -p "$DOSSIERS_DST/places/scalable"

	teindre() {   # <source> <destination>
		sed -e "s/#E8590C/${ACCENT}/gI" -e "s/#A84007/${ACCENT_LO}/gI" "$1" > "$2"
	}

	for F in "$DOSSIERS_SRC"/*.svg; do
		[[ -r "$F" ]] || continue
		teindre "$F" "$DOSSIERS_DST/places/scalable/$(basename "$F")"
	done

	#  Les icônes d'application (le lanceur « Fichiers ») sont des liens
	#  vers places/ : « sed » les suit et écrit de vrais fichiers.
	if [[ -d "$DOSSIERS_RACINE/apps/scalable" ]]; then
		mkdir -p "$DOSSIERS_DST/apps/scalable"
		for F in "$DOSSIERS_RACINE/apps/scalable"/*.svg; do
			[[ -r "$F" ]] || continue
			teindre "$F" "$DOSSIERS_DST/apps/scalable/$(basename "$F")"
		done
	fi

	#  LES TAILLES FIXES, sans quoi on retombe dans le défaut qu'on corrige.
	if command -v rsvg-convert >/dev/null 2>&1; then
		for CAT in places apps; do
			[[ -d "$DOSSIERS_DST/$CAT/scalable" ]] || continue
			for S in $TAILLES_ICONES; do
				mkdir -p "$DOSSIERS_DST/$CAT/${S}x${S}"
				for F in "$DOSSIERS_DST/$CAT/scalable"/*.svg; do
					[[ -r "$F" ]] || continue
					rsvg-convert -w "$S" -h "$S" \
						-o "$DOSSIERS_DST/$CAT/${S}x${S}/$(basename "$F" .svg).png" \
						"$F" 2>/dev/null || true
				done
			done
		done
	fi

	#  ═══ SI ON N'A PAS PU FAIRE AUSSI BIEN, ON NE MASQUE PAS ═══
	#  Sans les tailles fixes, on n'aurait que du scalable — exactement le
	#  défaut qui a coûté quatre ISO. Mieux vaut des dossiers de la MAUVAISE
	#  couleur mais VISIBLES que des dossiers de la bonne couleur qui ne
	#  s'affichent pas. On efface donc la copie et on laisse le thème système
	#  complet reprendre la main, en le disant.
	#
	#  ═══ CE CONTRÔLE REGARDAIT LES DOSSIERS, PAS LEUR CONTENU ═══
	#  Il cherchait « un dossier nommé 16x16, 22x22… ». Or ces dossiers sont
	#  créés par « mkdir -p » AVANT la conversion, et chaque rsvg-convert se
	#  termine par « || true ». Un rsvg-convert présent mais EN ÉCHEC — une
	#  installation cassée, une bibliothèque manquante, un disque plein —
	#  laissait donc seize dossiers vides, le contrôle les voyait, et on
	#  masquait le thème système avec du scalable seul. Le garde-fou écrit
	#  contre ce défaut précis ne le voyait pas.
	#
	#  Ce n'est pas une hypothèse : l'intégration continue vient de le faire.
	#  Le banc y fabrique un faux rsvg-convert qui s'appuyait sur Pillow, et
	#  Pillow n'est pas installé à cette étape-là. Résultat exact :
	#  « index.theme déclare 2 dossiers pour 18 sur le disque ».
	#
	#  On compte donc les tailles qui contiennent VRAIMENT des fichiers, et
	#  on les veut TOUTES. « À égalité » ne se négocie pas à sept huitièmes :
	#  la taille manquante serait précisément celle que le dock demande.
	#  Un dossier vide est aussi RETIRÉ — par « rm -rf », sûr puisqu'on vient
	#  de vérifier qu'il est vide, et pas par rmdir : ce programme tourne
	#  aussi sur des systèmes réduits, et l'index plus bas ne doit jamais
	#  avoir à se poser la question d'un dossier creux.
	ATTENDUES=0
	for S in $TAILLES_ICONES; do ATTENDUES=$((ATTENDUES + 1)); done
	PLEINES=0
	for D in "$DOSSIERS_DST"/places/[0-9]*; do
		[[ -d "$D" ]] || continue
		if compgen -G "$D/*" >/dev/null; then
			PLEINES=$((PLEINES + 1))
		else
			rm -rf "$D"
		fi
	done
	for D in "$DOSSIERS_DST"/apps/[0-9]*; do
		[[ -d "$D" ]] || continue
		compgen -G "$D/*" >/dev/null || rm -rf "$D"
	done
	if [[ "$PLEINES" -lt "$ATTENDUES" ]]; then
		rm -rf "$DOSSIERS_DST"
		printf 'Icônes : %s tailles fixes sur %s (rsvg-convert absent ou en échec) — les dossiers restent orange (thème système) plutôt que masqués à moitié.\n' \
			"$PLEINES" "$ATTENDUES" >&2
	else

	#  L'INDEX ÉCRIT D'APRÈS LE DISQUE, jamais recopié. Un thème qui déclare
	#  un dossier absent, ou qui en oublie un présent, est ignoré en partie
	#  — sans rien dire. Même règle que le hook 0605 côté système.
	DIRS=""
	for D in "$DOSSIERS_DST"/places/* "$DOSSIERS_DST"/apps/*; do
		[[ -d "$D" ]] || continue
		compgen -G "$D/*" >/dev/null || continue      # dossier vide : on ne le déclare pas
		DIRS="${DIRS:+$DIRS,}${D#"$DOSSIERS_DST"/}"
	done
	{
		echo "[Icon Theme]"
		echo "Name=LexOS"
		echo "Comment=Dossiers de LexOS teintés à l'accent ${ACCENT_NAME}"
		echo "Inherits=Papirus-Dark,Papirus,Adwaita,hicolor"
		echo "Directories=${DIRS}"
		for D in "$DOSSIERS_DST"/places/* "$DOSSIERS_DST"/apps/*; do
			[[ -d "$D" ]] || continue
			compgen -G "$D/*" >/dev/null || continue
			REL="${D#"$DOSSIERS_DST"/}"
			CTX="Places"; [[ "$REL" == apps/* ]] && CTX="Applications"
			T="${REL##*/}"
			echo
			echo "[${REL}]"
			echo "Context=${CTX}"
			if [[ "$T" == "scalable" ]]; then
				echo "Size=512"; echo "MinSize=8"; echo "MaxSize=512"; echo "Type=Scalable"
			else
				echo "Size=${T%%x*}"; echo "Type=Fixed"
			fi
		done
	} > "$DOSSIERS_DST/index.theme"

	command -v gtk-update-icon-cache >/dev/null 2>&1 && \
		gtk-update-icon-cache -f "$DOSSIERS_DST" >/dev/null 2>&1 || true
	fi
fi

# =============================================================================
#  4 bis. Les logos de la fenêtre de session, à l'encre du mode
# =============================================================================
#  lexos-session désigne ses six logos par un CHEMIN, pas par un nom d'icône :
#  c'est le seul moyen sûr après trois ISO passées à espérer qu'un nom se
#  trouve dans un thème (voir l'engrenage du gestionnaire de fichiers).
#
#  ═══ POURQUOI CE N'EST PAS L'ACCENT QU'ON SUBSTITUE ICI ═══
#  Premier jet : teindre ces logos à l'accent, comme les autres. Une maquette
#  de la fenêtre l'a réfuté avant qu'elle ne parte — la ligne SÉLECTIONNÉE est
#  peinte en accent (règle « treeview.view:selected », quelques centaines de
#  lignes plus haut dans ce même fichier), et yad sélectionne la première
#  ligne d'office. Un logo de la couleur du fond n'est plus un logo : on
#  aurait livré une fenêtre dont l'icône regardée est la seule invisible.
#
#  Les six sont donc dessinés en BLANC — la seule valeur qui tienne à la fois
#  sur le panneau noir (18,4:1) et sur l'accent (3,4:1) — sauf « arret » et
#  « redemarrer », rouges parce que le rouge y est un avertissement.
#
#  Reste le thème de JOUR, qui renverse le fond : du blanc sur du crème ne se
#  voit pas. C'est CE cas-là qu'on répare ici, et lui seul.
SESSION_DST="$CONF_DIR/session-icons"
#  On efface TOUJOURS d'abord : sans ça, repasser en sombre laisserait les
#  copies à l'encre noire du mode clair, et les logos disparaîtraient dans le
#  noir. Même piège, et même remède, que la copie du thème d'icônes.
rm -rf "$SESSION_DST"
if [[ "$MODE" == "clair" ]]; then
	mkdir -p "$SESSION_DST"
	for N in utilisateur deconnexion veille verrouiller; do
		SESSION_SRC="${LEXOS_BRANDING:-/usr/share/lexos/branding}/icon-${N}.svg"
		[[ -r "$SESSION_SRC" ]] || continue
		#  Seuls les attributs de dessin sont touchés : un « #FFFFFF » cité
		#  dans le commentaire d'en-tête n'a aucun effet, et le remplacer non
		#  plus — mais on ne réécrit que les lignes qui peignent, pour que le
		#  fichier livré continue d'expliquer POURQUOI il est blanc.
		sed '/^\s*<!--/,/-->/!s/#FFFFFF/'"${FG}"'/gI' "$SESSION_SRC" \
			> "$SESSION_DST/icon-${N}.svg"
	done
fi

# =============================================================================
#  5. Mémoriser l'accent pour les autres outils
# =============================================================================
cat > "$CONF_DIR/theme.conf" <<EOF
LEXOS_MODE=${MODE}
LEXOS_TERM_MODE=${TERM_MODE}
LEXOS_TERM_EFFECTIF=${TERM_EFFECTIF}
LEXOS_ACCENT_NAME=${ACCENT_NAME}
LEXOS_ACCENT=${ACCENT}
LEXOS_ACCENT_HI=${ACCENT_HI}
LEXOS_ACCENT_LO=${ACCENT_LO}
LEXOS_BG=${BG}
LEXOS_FG=${FG}
LEXOS_BTN_FG=${BTN_FG}
LEXOS_TERM_FG=${TERM_FG}
EOF

# =============================================================================
#  6. Dire le mode à libadwaita, qui n'écoute PAS GTK 3
# =============================================================================
#  ALEX, PHOTOS DE LA LOGITHÈQUE : « on voit pas les écritures ». Cartes
#  blanches, nom écrit en blanc dessus. La cause, relevée mot pour mot dans le
#  binaire de libadwaita :
#
#      « Using GtkSettings:gtk-application-prefer-dark-theme with libadwaita
#        is unsupported. Please use AdwStyleManager:color-scheme instead. »
#
#  Tout le mode sombre de LexOS passe par ce réglage GTK 3. Les applications
#  GTK 4 + libadwaita — la Logithèque en tête — l'ignorent explicitement et
#  rendent en CLAIR. Ce qu'elles lisent, c'est « org.gnome.desktop.interface
#  color-scheme » (relevé dans le même binaire, valeurs confirmées dans le
#  schéma de gsettings-desktop-schemas : default | prefer-dark | prefer-light).
#
#  Le DÉFAUT de la clé est posé pour tout le monde par
#  90-lexos-sombre.gschema.override, compilé par le crochet 0600. Ce bloc-ci
#  fait l'autre moitié, celle que la surcharge ne peut pas faire : suivre le
#  mode COURANT. Sans lui, « lexos theme clair » donnerait un bureau de jour
#  avec une Logithèque restée sombre — le même désaccord, dans l'autre sens.
#
#  ═══ POURQUOI TANT DE GARDES ═══
#  Ce générateur tourne aussi dans le chroot de construction (HOME=/etc/skel),
#  où il n'y a ni session ni bus D-Bus : gsettings n'y écrirait rien et
#  crierait sur la sortie d'erreur. On n'essaie donc QUE si l'on écrit dans
#  son propre foyer ET qu'un bus de session existe. Un échec ne coûte rien :
#  le défaut de la surcharge reste le bon point de départ.
if [[ "$TARGET" == "$HOME" && -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] \
   && command -v gsettings >/dev/null 2>&1; then
	if [[ "$MODE" == "clair" ]]; then COLOR_SCHEME="prefer-light"; else COLOR_SCHEME="prefer-dark"; fi
	gsettings set org.gnome.desktop.interface color-scheme "$COLOR_SCHEME" 2>/dev/null || true
fi

if [[ "$MODE" == "clair" ]]; then
	printf 'Thème LexOS — jour (clair) généré — accent : %s (%s)\n' "$ACCENT_NAME" "$ACCENT"
else
	printf 'Thème LexOS Noir généré — accent : %s (%s)\n' "$ACCENT_NAME" "$ACCENT"
fi

#!/usr/bin/env bash
# =============================================================================
#  lexos-brightness — luminosité de l'écran
# =============================================================================
#  Trois moyens, essayés dans cet ordre, parce qu'aucun ne marche partout :
#
#    1. brightnessctl        — propre, sans droits root, mais pas toujours là
#    2. /sys/class/backlight — le rétroéclairage réel ; demande les droits
#    3. xrandr --brightness  — assombrissement LOGICIEL : ça n'économise pas
#                              de batterie, mais c'est le seul recours sur un
#                              écran de bureau ou dans une machine virtuelle,
#                              qui n'ont pas de rétroéclairage pilotable.
#
#  Le troisième est annoncé comme tel : promettre une économie d'énergie qui
#  n'existe pas serait mentir à l'utilisateur.
# =============================================================================
set -uo pipefail

PROG="${0##*/}"

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; G=$'\033[32m'; Y=$'\033[33m'; E=$'\033[31m'; B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'
else
	O=''; G=''; Y=''; E=''; B=''; D=''; R=''
fi
say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

usage() {
	cat <<EOF
${B}$PROG${R} — luminosité de l'écran

Usage :
  $PROG                Luminosité actuelle et moyen utilisé
  $PROG <0-100>        Régler la luminosité, en pourcentage
  $PROG +10 / -10      Monter ou baisser de 10 points
  $PROG eco            Passer à 40% — confort en intérieur, moins de batterie

Exemples :
  $PROG 60
  $PROG -15
EOF
}

# --- Repérage du matériel ----------------------------------------------------
#  ALEX : « la luminosité de l'écran ne marche pas dans les Paramètres ».
#  Sur beaucoup de portables (les ThinkPad d'Alex compris), le noyau expose
#  DEUX interfaces à la fois sous /sys/class/backlight/ : « acpi_videoN »,
#  fournie par le firmware ACPI, et une interface native du pilote
#  graphique — « intel_backlight », « amdgpu_blN », « nvidia_wmi_ec_backlight ».
#  La première venait à gagner ici : le glob liste par ordre alphabétique, et
#  « acpi_video0 » précède « intel_backlight ». Or c'est justement celle qui,
#  sur beaucoup de machines, ne pilote RIEN de visible — le firmware
#  accepte l'écriture (donc pas d'erreur, pas de message), le fichier
#  « brightness » change de valeur, et l'écran ne bouge pas d'un cran. Un
#  réglage qui « marche » sans rien faire est exactement le genre de panne
#  qu'on ne voit pas dans le code, seulement sur la photo.
#  On préfère donc toute interface qui N'EST PAS acpi_video — c'est ce que
#  font déjà les environnements de bureau (GNOME, KDE) pour cette même
#  raison — et on ne retombe sur acpi_video que si rien d'autre n'existe.
#
#  LEXOS_BL : /sys/class/backlight n'existe pas dans un banc d'essai — ce
#  n'est pas un vrai noyau. Le détourner ici permet à
#  tests/test_lexos_brightness.sh de fabriquer un faux dossier avec les deux
#  interfaces et de prouver, en exécutant ce fichier pour de vrai, laquelle
#  gagne — pas seulement de relire l'intention. MÊME NOM DE VARIABLE que
#  settings.py (BL_DIR = os.environ.get("LEXOS_BL", …)) : un seul réglage
#  fait bouger les deux à la fois dans le banc, comme sur la vraie machine
#  où « le rétroéclairage » est UNE seule chose, pas deux réglages à tenir
#  synchronisés à la main.
BL_ROOT="${LEXOS_BL:-/sys/class/backlight}"
BL=""
for d in "$BL_ROOT"/*; do
	[[ -r "$d/max_brightness" ]] || continue
	[[ "$(basename "$d")" == acpi_video* ]] && continue
	BL="$d"; break
done
if [[ -z "$BL" ]]; then
	for d in "$BL_ROOT"/*; do
		[[ -r "$d/max_brightness" ]] && { BL="$d"; break; }
	done
fi

moyen() {
	if command -v brightnessctl >/dev/null 2>&1 && [[ -n "$BL" ]]; then echo "brightnessctl"
	elif [[ -n "$BL" ]]; then echo "sysfs"
	elif command -v xrandr >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then echo "xrandr"
	else echo "aucun"; fi
}

lire() {
	case "$(moyen)" in
		brightnessctl) brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%' ;;
		sysfs)
			local cur max
			cur="$(cat "$BL/brightness" 2>/dev/null)"; max="$(cat "$BL/max_brightness" 2>/dev/null)"
			[[ -n "$cur" && -n "$max" && "$max" -gt 0 ]] && echo $(( cur * 100 / max )) ;;
		xrandr)
			local v
			v="$(xrandr --verbose 2>/dev/null | awk '/Brightness/{print $2; exit}')"
			[[ -n "$v" ]] && awk -v v="$v" 'BEGIN{printf "%d", v*100}' ;;
	esac
}

#  ═══ ÉCRIRE DANS /sys, EN DEMANDANT LES DROITS S'IL LE FAUT ═══
#  ALEX : « ça fonctionne mais pas dans les Paramètres. » C'EST TOUT LE
#  BOGUE, ET IL TIENT EN UN MOT : « sudo » NE PEUT PAS DEMANDER DE MOT DE
#  PASSE SANS TERMINAL. Au terminal, sudo pose sa question, Alex répond, et
#  la luminosité change. Lancé depuis les Paramètres — un service sans
#  terminal — sudo n'a personne à qui demander : il refuse, tout de suite et
#  en silence. Même commande, même machine, deux résultats : exactement ce
#  qu'Alex décrit.
#
#  L'ORDRE CI-DESSOUS EST CELUI DU MOINS DE DÉRANGEMENT :
#    1. le fichier est déjà accessible en écriture — rien à demander ;
#    2. « sudo -n » : autorisé sans mot de passe. « -n » est la clé — sans
#       lui, sudo BLOQUE en attendant une saisie qui ne viendra jamais ;
#    3. pkexec : il passe par l'agent graphique de la session, qui SAIT
#       afficher une fenêtre de mot de passe. C'est la voie des Paramètres ;
#    4. un vrai terminal ([[ -t 0 ]]) : sudo peut poser sa question ;
#    5. sinon on le DIT, avec le pourquoi — un échec muet renvoie chercher
#       du côté du bouton, et c'est là qu'on a perdu du temps.
ecrire_sysfs() { # ecrire_sysfs <pourcentage>
	local p="$1" max val
	max="$(cat "$BL/max_brightness" 2>/dev/null)"
	[[ -n "$max" && "$max" -gt 0 ]] || die "Rétroéclairage illisible : $BL/max_brightness"
	val=$(( max * p / 100 ))

	if [[ -w "$BL/brightness" ]]; then
		printf '%s\n' "$val" > "$BL/brightness" \
			|| die "Écriture refusée sur $BL/brightness"
	elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
		printf '%s\n' "$val" | sudo -n tee "$BL/brightness" >/dev/null \
			|| die "Écriture refusée sur $BL/brightness"
	elif command -v pkexec >/dev/null 2>&1; then
		#  pkexec veut un PROGRAMME, pas une redirection : « tee » en est un.
		printf '%s\n' "$val" | pkexec tee "$BL/brightness" >/dev/null \
			|| die "Réglage refusé (mot de passe administrateur non fourni)."
	elif [[ -t 0 ]] && command -v sudo >/dev/null 2>&1; then
		printf '%s\n' "$val" | sudo tee "$BL/brightness" >/dev/null \
			|| die "Écriture refusée sur $BL/brightness"
	else
		die "Droits insuffisants sur le rétroéclairage, et aucun moyen de les demander (ni sudo sans mot de passe, ni pkexec)."
	fi
}

ecrire() { # ecrire <pourcentage>
	local p="$1"
	(( p < 5 ))   && p=5            # jamais un écran totalement noir
	(( p > 100 )) && p=100
	case "$(moyen)" in
		brightnessctl)
			#  ALEX : « les outils pour la luminosité fonctionnent, mais pas
			#  dans les Paramètres. » brightnessctl écrit dans
			#  /sys/class/backlight ; la règle udev de son paquet n'ouvre ce
			#  fichier qu'au groupe « video ». Un compte hors de ce groupe le
			#  voit ÉCHOUER — et on abandonnait là, par un « die », alors que
			#  la voie sysfs juste en dessous sait, elle, demander les droits.
			#  On ne meurt donc plus sur cet échec : on RETOMBE dessus.
			if brightnessctl -q set "${p}%" 2>/dev/null; then
				ok "Luminosité : ${p}%"; return 0
			fi
			warn "brightnessctl a refusé (droits ?) — on passe par le fichier système."
			ecrire_sysfs "$p" ;;
		sysfs)
			ecrire_sysfs "$p" ;;
		xrandr)
			local sorties
			sorties="$(xrandr --query 2>/dev/null | awk '/ connected/{print $1}')"
			[[ -n "$sorties" ]] || die "Aucun écran détecté par xrandr."
			local s
			for s in $sorties; do
				xrandr --output "$s" --brightness "$(awk -v p="$p" 'BEGIN{printf "%.2f", p/100}')" \
					2>/dev/null || warn "Échec sur la sortie $s"
			done
			warn "Assombrissement logiciel : l'image est plus sombre, mais la"
			warn "consommation ne baisse pas — cet écran n'a pas de rétroéclairage pilotable." ;;
		*)
			die "Aucun moyen de régler la luminosité sur cette machine." ;;
	esac
	ok "Luminosité : ${p}%"
}

# --- Répartiteur -------------------------------------------------------------
ARG="${1:-}"
case "$ARG" in
	""|status|etat)
		M="$(moyen)"
		[[ "$M" == "aucun" ]] && die "Aucun moyen de régler la luminosité sur cette machine."
		CUR="$(lire)"
		printf 'Luminosité : %s%s%%%s\n' "$O" "${CUR:-?}" "$R"
		printf 'Moyen      : %s\n' "$M"
		[[ "$M" == "xrandr" ]] && printf '  %sAssombrissement logiciel — aucune économie de batterie.%s\n' "$D" "$R"
		printf '\nRégler : %s <0-100>   ·   %s +10   ·   %s eco\n' "$PROG" "$PROG" "$PROG"
		;;
	-h|--help|help) usage ;;
	eco|economie)   ecrire 40 ;;
	+*|-*)
		DELTA="${ARG#+}"
		[[ "$DELTA" =~ ^-?[0-9]+$ ]] || { usage; exit 1; }
		CUR="$(lire)"; [[ -n "$CUR" ]] || die "Luminosité actuelle illisible."
		ecrire $(( CUR + DELTA ))
		;;
	*)
		[[ "$ARG" =~ ^[0-9]+$ ]] || { usage; exit 1; }
		ecrire "$ARG"
		;;
esac

#!/usr/bin/env bash
# =============================================================================
#  lexos-session — la fenêtre qui s'ouvre quand on clique sur le bouton rouge
# =============================================================================
#  CE QU'ALEX A DEMANDÉ, ET POURQUOI LE GREFFON DE XFCE NE SUFFISAIT PAS.
#
#  Photo de l'ISO 74, barre du haut : six petits boutons de session collés
#  les uns aux autres — verrouiller, changer d'utilisateur, veille,
#  redémarrer, éteindre, déconnexion. Le rouge n'était PAS au bout : la
#  déconnexion (verte) le dépassait à droite.
#
#  Sa demande, mot pour mot :
#    « mettre le bouton rouge totalement à droite de l'écran »
#    « ensuite le bouton pour le redémarrer à côté du bouton arrêt »
#    « bouton pour le mettre en mise en veille à côté du bouton redémarrer »
#    « mettre les 2 boutons — changer utilisateur, déconnexion — dans une
#      autre fenêtre quand on clique sur le bouton arrêt »
#
#  Les trois premiers points se règlent dans xfce4-panel.xml : on retire de
#  la rangée ce qui doit partir, et l'ordre du tableau EST l'ordre à
#  l'écran. Le quatrième, non. Le greffon « actions » de XFCE sait afficher
#  des boutons et exécuter des actions ; il ne sait pas ouvrir NOTRE fenêtre
#  au clic sur l'un d'eux. Il n'a aucun réglage pour ça — c'est le même mur
#  que pour la taille des boutons de fenêtre au build 70, où xfwm4 n'avait
#  aucun réglage de taille et où il a fallu fabriquer les images.
#
#  Donc : le bouton rouge de la barre n'est plus une action du greffon, mais
#  un LANCEUR ordinaire qui appelle ce programme.
#
#  ═══ CE QUI A CHANGÉ DEPUIS : TOUT DANS LE BOUTON ROUGE ═══
#  Veille et redémarrage avaient d'abord rejoint la barre, à côté du bouton
#  rouge — c'était la demande d'origine, ci-dessus. Deux photos plus tard,
#  Alex est revenu dessus : « trop d'outils visibles en haut […] j'aimerais
#  que tout soit dans le bouton rouge, pour tout retrouver à la même place ».
#  Ils rejoignent donc CETTE fenêtre à leur tour — plus de « lequel des deux
#  redémarrages » à se demander, puisqu'il n'y en a plus qu'un.
#
#  VERROUILLER — RETIRÉ, PUIS RAMENÉ ICI. Il vivait dans la même rangée que
#  veille et redémarrer (greffon « actions » de xfce4-panel) ; une photo de
#  l'écran de verrouillage montrait un damier gris, sans fond, rien
#  d'exploitable — « cet outil ne sert vraiment à rien » — et il a disparu
#  du panneau plutôt que de changer d'adresse. Le damier gris était l'icône
#  CASSÉE du greffon (image introuvable), pas le verrouillage lui-même :
#  xflock4 / light-locker fonctionnent très bien une fois appelés
#  directement, sans passer par ce greffon. Alex l'a redemandé dans CETTE
#  fenêtre — « verrouiller écran » dans la liste avec arrêter, redémarrer,
#  mise en veille, changer d'utilisateur — donc il rejoint le groupe, mais
#  par la vraie commande système, jamais par le greffon cassé.
#
#  ═══ CE QUI EST ÉPROUVABLE, ET COMMENT ═══
#  Un programme qui éteint la machine ne se teste pas en le lançant. Toutes
#  les commandes passent donc par « lancer() », et LEXOS_SESSION_SIMULE=1
#  les fait ÉCRIRE au lieu de s'exécuter. Ce n'est pas un chemin mort ajouté
#  pour faire joli : c'est le seul moyen que tests/test_lexos_session.sh
#  puisse vérifier que « Éteindre » éteint et que « Déconnexion » déconnecte,
#  au lieu de relire le code en hochant la tête.
# =============================================================================
set -uo pipefail

PROG="lexos-session"
BRAND="/usr/share/lexos/branding"

#  ─── EXÉCUTER, OU DIRE CE QU'ON AURAIT EXÉCUTÉ ──────────────────────────────
#  En simulation on écrit la commande sur la sortie standard et on rend 0.
#  En vrai on l'exécute. Une seule porte pour tout ce qui touche la machine :
#  s'il en existait une deuxième, le banc ne la verrait pas et c'est
#  exactement par là que passerait le jour où ça casse.
lancer() {
	if [[ -n "${LEXOS_SESSION_SIMULE:-}" ]]; then
		printf '%s\n' "$*"
		return 0
	fi
	"$@" >/dev/null 2>&1
}

#  Y a-t-il cette commande ? En simulation, on répond OUI à tout : sinon le
#  banc n'éprouverait que le repli du conteneur, jamais le chemin normal.
dispo() {
	[[ -n "${LEXOS_SESSION_SIMULE:-}" ]] && return 0
	command -v "$1" >/dev/null 2>&1
}

# =============================================================================
#  Les cinq gestes. Chacun essaie ses outils DANS L'ORDRE et s'arrête au
#  premier qui répond — et si aucun ne répond, il le DIT au lieu de rendre 0.
# =============================================================================
#  L'ordre n'est pas décoratif :
#    · xfce4-session-logout d'abord quand il s'agit de la SESSION (fermer les
#      applications proprement, écrire les fichiers en cours). systemctl
#      couperait par-dessous et on perdrait le travail non enregistré.
#    · systemctl / loginctl pour ce qui relève de la MACHINE, ou en repli
#      quand le gestionnaire de session XFCE n'est pas là (session minimale,
#      autre bureau, dépannage).

eteindre() {
	dispo xfce4-session-logout && { lancer xfce4-session-logout --halt --fast; return; }
	dispo systemctl            && { lancer systemctl poweroff;                 return; }
	dispo loginctl             && { lancer loginctl poweroff;                  return; }
	echo "$PROG : rien pour éteindre (ni xfce4-session-logout, ni systemctl, ni loginctl)" >&2
	return 1
}

redemarrer() {
	dispo xfce4-session-logout && { lancer xfce4-session-logout --reboot --fast; return; }
	dispo systemctl            && { lancer systemctl reboot;                     return; }
	dispo loginctl             && { lancer loginctl reboot;                      return; }
	echo "$PROG : rien pour redémarrer" >&2
	return 1
}

veille() {
	dispo xfce4-session-logout && { lancer xfce4-session-logout --suspend; return; }
	dispo systemctl            && { lancer systemctl suspend;              return; }
	dispo loginctl             && { lancer loginctl suspend;               return; }
	echo "$PROG : rien pour mettre en veille" >&2
	return 1
}

deconnexion() {
	dispo xfce4-session-logout && { lancer xfce4-session-logout --logout --fast; return; }
	#  Sans le gestionnaire XFCE, on termine la session de l'utilisateur
	#  courant. « $XDG_SESSION_ID » est posé par systemd-logind ; sans lui,
	#  loginctl ne saurait pas laquelle terminer et couperait peut-être une
	#  autre session — on s'abstient plutôt que de deviner.
	if dispo loginctl && [[ -n "${XDG_SESSION_ID:-}" ]]; then
		lancer loginctl terminate-session "$XDG_SESSION_ID"; return
	fi
	echo "$PROG : rien pour se déconnecter" >&2
	return 1
}

#  CHANGER D'UTILISATEUR — le seul geste qui dépend du gestionnaire de
#  CONNEXION, pas du bureau. LexOS emploie lightdm, dont l'outil est
#  « dm-tool ». Les deux autres sont là pour qui aurait changé de
#  gestionnaire ; aucun n'est deviné, chacun est nommé.
changer_utilisateur() {
	dispo dm-tool        && { lancer dm-tool switch-to-greeter; return; }
	dispo gdmflexiserver && { lancer gdmflexiserver;            return; }
	dispo kdmctl         && { lancer kdmctl reserve;            return; }
	echo "$PROG : impossible de changer d'utilisateur — aucun gestionnaire de connexion reconnu" >&2
	return 1
}

#  VERROUILLER L'ÉCRAN — xflock4 d'abord : c'est le script standard de XFCE,
#  il détecte tout seul ce qui est installé (light-locker, xfce4-screensaver,
#  etc.) et c'est le même choix que ferait n'importe quel raccourci clavier
#  XFCE. light-locker et xfce4-screensaver sont nommés ensuite en repli
#  direct, au cas où xflock4 manquerait (session minimale). L'un des deux
#  est toujours installé : « light-locker|xfce4-screensaver » dans la liste
#  de paquets impose l'un ou l'autre.
verrouiller() {
	dispo xflock4                   && { lancer xflock4;                    return; }
	dispo light-locker-command      && { lancer light-locker-command -l;    return; }
	dispo xfce4-screensaver-command && { lancer xfce4-screensaver-command -l; return; }
	dispo loginctl                  && { lancer loginctl lock-session;      return; }
	echo "$PROG : rien pour verrouiller l'écran" >&2
	return 1
}

# =============================================================================
#  La ligne de commande — « lexos session eteindre », etc.
# =============================================================================
#  Elle existe pour trois raisons : le banc s'en sert, elle marche en
#  console quand il n'y a pas d'écran, et elle rend le programme utilisable
#  au clavier comme tout le reste de LexOS.
case "${1:-}" in
	eteindre|éteindre|arret|arrêt|halt|poweroff)  eteindre;            exit $? ;;
	redemarrer|redémarrer|reboot|restart)         redemarrer;          exit $? ;;
	veille|suspend|sommeil)                       veille;              exit $? ;;
	deconnexion|déconnexion|logout)               deconnexion;         exit $? ;;
	utilisateur|changer-utilisateur|switch-user)  changer_utilisateur; exit $? ;;
	verrouiller|verrouillage|verrouiller-ecran|lock)  verrouiller;    exit $? ;;
	aide|--help|-h|help)
		cat <<'AIDE'
lexos session — arrêter, redémarrer, changer d'utilisateur

  lexos session                    ouvre la fenêtre
  lexos session eteindre           éteint la machine
  lexos session redemarrer         redémarre
  lexos session veille             met en veille
  lexos session deconnexion        ferme la session
  lexos session utilisateur        retourne à l'écran de connexion
  lexos session verrouiller        verrouille l'écran

Le bouton rouge, tout à droite de la barre du haut, ouvre la fenêtre.
AIDE
		exit 0
		;;
	"") : ;;   # pas d'argument : on ouvre la fenêtre, plus bas
	*)
		echo "$PROG : « $1 » n'est pas un geste connu — « lexos session aide »" >&2
		exit 1
		;;
esac

# =============================================================================
#  La fenêtre
# =============================================================================
#  Sans écran, on ne bloque pas sur un dialogue que personne ne verra : on
#  dit quoi taper. Le cas arrive pour de vrai — console de dépannage, ssh.
if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
	cat <<'TTY'

  Session LexOS — pas d'écran graphique ici.

    lexos session eteindre           éteindre
    lexos session veille             mettre en veille
    lexos session redemarrer         redémarrer
    lexos session deconnexion        fermer la session
    lexos session utilisateur        changer d'utilisateur
    lexos session verrouiller        verrouiller l'écran

TTY
	exit 0
fi

ICON="$BRAND/icon-arret.svg"
[[ -r "$ICON" ]] || ICON="system-shutdown"

QUI="${USER:-$(id -un 2>/dev/null)}"
TEXTE="<span size='x-large' weight='bold'>Que veux-tu faire ?</span>

Tu es connecté en tant que <b>${QUI}</b>."

#  yad d'abord (il est dans lexos-core.list.chroot, donc strict), zenity en
#  repli. Les codes de retour sont ceux qu'on déclare après le « ! » dans
#  chaque bouton : yad les rend tels quels.
# =============================================================================
#  UNE PETITE FENÊTRE SUR LE CÔTÉ, PAS UNE BARRE EN TRAVERS DE L'ÉCRAN
# =============================================================================
#  ALEX, photo à l'appui : « j'aimerais que ce soit une petite fenêtre qui
#  ouvre dans le côté, au lieu de le voir comme sur la 2e image » — pour
#  arrêter, redémarrer ou changer d'utilisateur.
#
#  CE QU'IL VOYAIT, ET POURQUOI. Les sept gestes étaient sept BOUTONS DE
#  DIALOGUE (--button). yad range ces boutons-là sur UNE SEULE RANGÉE
#  horizontale, en bas de la fenêtre, et élargit la fenêtre jusqu'à ce
#  qu'ils tiennent tous. Avec sept libellés français — « Changer
#  d'utilisateur », « Verrouiller l'écran »… — la fenêtre finissait par
#  traverser l'écran de bout en bout. Le « --width=560 » n'y pouvait rien :
#  c'est un plancher, pas un plafond. Boutons horizontaux et fenêtre étroite
#  sont incompatibles par construction ; il fallait changer de forme.
#
#  LA LISTE VERTICALE RÈGLE LES DEUX À LA FOIS : les gestes s'empilent, donc
#  la largeur ne dépend plus de leur nombre ni de la longueur des mots. Il ne
#  reste que deux boutons en bas (Annuler / le choix), et la fenêtre peut
#  enfin être petite. C'est EXACTEMENT la forme que le repli zenity, juste
#  en dessous, emploie depuis toujours — les deux chemins disent maintenant
#  la même chose, au lieu de deux dialogues différents selon l'outil présent.
#
#  ET SUR LE CÔTÉ. yad accepte « --posx » (vérifié dans son manuel). On la
#  pose contre le bord droit, sous la barre du haut, en calculant la place
#  d'après la largeur réelle de l'écran (xrandr, déjà employé ailleurs ici).
#  Sans xrandr, on ne devine pas une position au hasard : on retombe sur
#  « --center », le comportement d'avant.
# =============================================================================
#  UN LOGO PAR GESTE
# =============================================================================
#  ALEX, photo de la fenêtre à l'appui : « on aimerait ajouter des logos où
#  la fenêtre pour fermer ou redémarrer l'ordinateur. » Six lignes de texte
#  nu, toutes de la même couleur : rien ne distingue « Déconnexion » de
#  « Éteindre » avant de les avoir lues — et ce sont les deux gestes qu'on ne
#  veut surtout pas confondre.
#
#  ═══ NOS PROPRES DESSINS, PAS DES NOMS DU THÈME ═══
#  On aurait pu passer des noms d'icônes (« system-shutdown »,
#  « system-reboot »…) et laisser le thème les trouver. C'est exactement le
#  pari qui a coûté trois ISO à l'icône du gestionnaire de fichiers : un nom
#  qu'on suppose présent, dans un thème dont on suppose qu'il est parcouru.
#  Les six icônes sont donc dessinées dans branding/ et désignées par leur
#  CHEMIN — aucune recherche, aucune supposition.
#
#  Le nom du thème reste en repli pour la seule situation où le chemin ne
#  vaut rien : un LexOS incomplet, ou cet outil lancé sur une autre machine.
#
#  ═══ ROUGE POUR CE QUI COUPE, ACCENT POUR LE RESTE ═══
#  « Éteindre » et « Redémarrer » portent le rouge d'avertissement ; les
#  quatre autres portent le jeton d'accent et suivent donc la couleur choisie
#  par l'utilisateur. Voir l'en-tête de branding/icon-arret.svg : sous un
#  accent vert, un bouton d'arrêt vert dirait « vas-y » là où il faut dire
#  « attention ».
#  ═══ POURQUOI ELLES SONT BLANCHES ET NON À L'ACCENT ═══
#  Parce que la ligne SÉLECTIONNÉE est peinte en accent (voir la règle
#  « treeview.view:selected » de lexos-theme-gen) et que yad sélectionne la
#  première d'office : un logo à l'accent y serait invisible — justement
#  celui qu'on regarde. Contrastes calculés plutôt qu'estimés : l'accent
#  donne 4,9:1 sur le panneau noir mais 1,0:1 sur lui-même ; le blanc donne
#  18,4:1 et 3,4:1. Le blanc est la seule valeur qui tienne des deux côtés,
#  et c'est aussi la couleur du libellé sélectionné.
#
#  Le thème de JOUR renverse le fond : lexos-theme-gen écrit alors une copie
#  à l'encre sombre dans ~/.config/lexos/session-icons, qu'on préfère quand
#  elle existe. En sombre elle n'existe pas — la source dit déjà juste.
SESSION_ICONES="${XDG_CONFIG_HOME:-$HOME/.config}/lexos/session-icons"

img() {   # img <nom du fichier branding> <nom de repli dans le thème>
	if [[ -r "$SESSION_ICONES/icon-$1.svg" ]]; then
		printf '%s' "$SESSION_ICONES/icon-$1.svg"
	elif [[ -r "$BRAND/icon-$1.svg" ]]; then
		printf '%s' "$BRAND/icon-$1.svg"
	else
		printf '%s' "$2"
	fi
}

#  Résolus UNE FOIS, pour que yad et son repli zenity montrent exactement la
#  même chose. Deux listes écrites séparément, c'est deux fenêtres qui
#  finissent par diverger sans que personne ne s'en aperçoive.
IMG_UTILISATEUR="$(img utilisateur system-users)"
IMG_DECONNEXION="$(img deconnexion system-log-out)"
IMG_ARRET="$(img arret system-shutdown)"
IMG_REDEMARRER="$(img redemarrer system-reboot)"
IMG_VEILLE="$(img veille system-suspend)"
IMG_VERROUILLER="$(img verrouiller system-lock-screen)"

#  La colonne d'images élargit la fenêtre d'une quarantaine de points : sans
#  ce rattrapage, les libellés les plus longs (« Changer d'utilisateur »)
#  seraient coupés par des points de suspension.
LARGEUR_F=344
POSITION=(--center)
if command -v xrandr >/dev/null 2>&1; then
	ECRAN_L="$(xrandr 2>/dev/null | sed -n 's/^.*current \([0-9]\+\) x [0-9]\+.*$/\1/p' | head -1)"
	if [[ "$ECRAN_L" =~ ^[0-9]+$ ]] && (( ECRAN_L > LARGEUR_F + 80 )); then
		POSITION=(--posx="$(( ECRAN_L - LARGEUR_F - 40 ))" --posy=60)
	fi
fi

if command -v yad >/dev/null 2>&1; then
	CHOIX="$(yad --list --title="Session — LexOS" \
		--window-icon=lexos-arret \
		--width="$LARGEUR_F" --height=330 --borders=12 --on-top \
		"${POSITION[@]}" \
		--text="$TEXTE" \
		--no-headers \
		--column=" ":IMG --column="Que faire ?" --print-column=2 \
		--button="Annuler:1" --button="Choisir:0" \
		"$IMG_UTILISATEUR" "Changer d'utilisateur" \
		"$IMG_DECONNEXION" "Déconnexion" \
		"$IMG_ARRET"       "Éteindre" \
		"$IMG_REDEMARRER"  "Redémarrer" \
		"$IMG_VEILLE"      "Mise en veille" \
		"$IMG_VERROUILLER" "Verrouiller l'écran" \
		2>/dev/null)"
	#  yad termine les lignes de « --print-column » par le séparateur « | » :
	#  sans ce nettoyage, aucune correspondance ne tomberait juste et la
	#  fenêtre se fermerait sans rien faire — une panne muette.
	CHOIX="${CHOIX%|}"
	CHOIX="${CHOIX%$'\n'}"
	case "$CHOIX" in
		"Changer d'utilisateur") changer_utilisateur ;;
		"Déconnexion")           deconnexion ;;
		"Éteindre")              eteindre ;;
		"Redémarrer")            redemarrer ;;
		"Mise en veille")        veille ;;
		"Verrouiller l'écran")   verrouiller ;;
		*) : ;;   # Annuler, ou la fenêtre fermée : on ne fait RIEN
	esac
	exit 0
fi

if command -v zenity >/dev/null 2>&1; then
	#  zenity ne sait pas poser six boutons : on passe par une liste, qui
	#  dit la même chose et se lit aussi bien. Rien n'est retiré au passage.
	#  LES MÊMES LOGOS ICI, MAIS SEULEMENT S'ILS SONT TOUS LÀ. zenity ne
	#  connaît que des CHEMINS dans une colonne d'images : un nom de thème y
	#  laisserait une case vide. Plutôt que six lignes dont deux illustrées,
	#  on garde alors la liste nue — la même information, sans le bancal.
	ZEN_IMAGES=1
	for I in "$IMG_UTILISATEUR" "$IMG_DECONNEXION" "$IMG_ARRET" \
	         "$IMG_REDEMARRER" "$IMG_VEILLE" "$IMG_VERROUILLER"; do
		#  img() rend un NOM de thème quand le fichier manque : zenity, lui,
		#  ne sait lire qu'un chemin. Un seul nom dans le lot et on renonce.
		[[ "$I" == /* && -r "$I" ]] || ZEN_IMAGES=0
	done
	if [[ "$ZEN_IMAGES" == "1" ]]; then
		CHOIX="$(zenity --list --title="Session — LexOS" \
			--text="Tu es connecté en tant que ${QUI}." \
			--imagelist --hide-header --print-column=2 \
			--column=" " --column="Que faire ?" \
			"$IMG_UTILISATEUR" "Changer d'utilisateur" \
			"$IMG_DECONNEXION" "Déconnexion" \
			"$IMG_VEILLE"      "Mise en veille" \
			"$IMG_REDEMARRER"  "Redémarrer" \
			"$IMG_ARRET"       "Éteindre" \
			"$IMG_VERROUILLER" "Verrouiller l'écran" 2>/dev/null)"
	else
		CHOIX="$(zenity --list --title="Session — LexOS" \
			--text="Tu es connecté en tant que ${QUI}." \
			--column="Que faire ?" \
			"Changer d'utilisateur" "Déconnexion" "Mise en veille" "Redémarrer" "Éteindre" "Verrouiller l'écran" 2>/dev/null)"
	fi
	case "$CHOIX" in
		"Changer d'utilisateur") changer_utilisateur ;;
		"Déconnexion")           deconnexion ;;
		"Mise en veille")        veille ;;
		"Redémarrer")            redemarrer ;;
		"Éteindre")              eteindre ;;
		"Verrouiller l'écran")   verrouiller ;;
		*) : ;;
	esac
	exit 0
fi

#  Ni yad ni zenity : on ne fait RIEN en silence — on le dit. Éteindre la
#  machine parce qu'aucune boîte de dialogue n'a pu s'afficher serait la
#  pire réponse possible à un outil manquant.
notify-send "LexOS" "Ni yad ni zenity : tape « lexos session aide »." 2>/dev/null \
	|| echo "$PROG : ni yad ni zenity — tape « lexos session aide »" >&2
exit 1

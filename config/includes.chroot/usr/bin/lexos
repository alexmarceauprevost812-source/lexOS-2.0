#!/usr/bin/env bash
# =============================================================================
#  lexos — couteau suisse en ligne de commande de LexOS
# =============================================================================
set -uo pipefail

PROG="${0##*/}"

# --- Couleurs ----------------------------------------------------------------
if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; A=$'\033[38;5;215m'; D=$'\033[2m'
	G=$'\033[32m'; Y=$'\033[33m'; E=$'\033[31m'; B=$'\033[1m'; R=$'\033[0m'
else
	O=''; A=''; D=''; G=''; Y=''; E=''; B=''; R=''
fi

say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
err()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; }
die()  { err "$*"; exit 1; }

need_root() {
	if [[ $EUID -ne 0 ]]; then
		if command -v sudo >/dev/null 2>&1; then
			exec sudo -E "$0" "$@"
		fi
		die "Cette commande demande les droits administrateur (root)."
	fi
}

load_release() {
	LEXOS_NAME="LexOS"; LEXOS_VERSION="?"; LEXOS_CODENAME="?"
	LEXOS_FLAVOUR="?"; LEXOS_BUILD_DATE="?"; LEXOS_BUILD_ID="?"
	LEXOS_HOME_URL=""; DEBIAN_BASE="?"
	if [[ -r /etc/os-release ]]; then
		# shellcheck disable=SC1091
		. /etc/os-release
		LEXOS_NAME="${NAME:-LexOS}"
		LEXOS_VERSION="${VERSION_ID:-?}"
		LEXOS_CODENAME="${VERSION_CODENAME:-?}"
		LEXOS_HOME_URL="${HOME_URL:-}"
		DEBIAN_BASE="${DEBIAN_BASE:-?}"
		LEXOS_FLAVOUR="${LEXOS_FLAVOUR:-?}"
		LEXOS_BUILD_DATE="${LEXOS_BUILD_DATE:-?}"
		LEXOS_BUILD_ID="${LEXOS_BUILD_ID:-?}"
	fi
}

# =============================================================================
#  Commandes
# =============================================================================

cmd_help() {
	load_release
	cat <<EOF

${B}${O}${LEXOS_NAME}${R} ${D}${LEXOS_VERSION} « ${LEXOS_CODENAME} »${R}

${B}USAGE${R}
  ${PROG} <commande> [arguments]

${B}RIEN À RETENIR${R}
  Tape ${A}${PROG}${R} puis la touche ${B}Tab${R} : la liste des commandes s'affiche.
  Tape ${A}${PROG} accent${R} puis ${B}Tab${R} : les couleurs possibles s'affichent.
  ${D}Deux lettres et Tab suffisent — ${PROG} acc${R}${D}+Tab complète tout seul.${R}
  ${D}Perdu ? Le mot « aide » seul, dans le terminal, ramène ici.${R}

${B}SYSTÈME${R}
  ${A}info${R}                Résumé du système (alias : ${D}lexfetch${R})
  ${A}version${R}             Version de LexOS
  ${A}doctor${R}              Diagnostic : disque, réseau, services, mises à jour
  ${A}logs${R} [n]            ${D}n${R} dernières erreurs du journal (défaut : 40)

${B}PAQUETS${R}
  ${A}update${R}              Rafraîchir la liste des paquets
  ${A}upgrade${R}             Mettre à jour tout le système
  ${A}install${R} <paquets…>  Installer des paquets
  ${A}remove${R}  <paquets…>  Désinstaller des paquets
  ${A}search${R}  <terme>     Chercher un paquet
  ${A}clean${R}               Libérer de l'espace (caches, orphelins, journaux)
                      ${D}Les mises à jour de sécurité s'installent seules chaque jour
                      (unattended-upgrades) ; une notification prévient pour le reste.${R}

${B}APPARENCE${R}
  ${A}theme${R} <sombre|clair> LexOS Noir (défaut) ou thème de jour ${D}(crème, pas blanc pur)${R}
  ${A}accent${R} <couleur>    Couleur des boutons et des sélections
                      ${D}orange (défaut) · orange-rouge · bleu · rouge · vert · gris
                      violet · neon${R}
  ${A}police${R} <nom>        Police d'écriture de l'interface
                      ${D}defaut · classique · mono · manuscrite (écriture à la main)${R}
  ${A}dock${R} <position>     Barre d'outils : ${D}droite (défaut) · gauche · bas · haut${R}
  ${A}ecran${R}               Plusieurs écrans : étendre, dupliquer, principal
  ${A}wallpaper${R} [chemin]  Changer le fond d'écran (sans argument : celui par défaut)
  ${A}wallpaper${R} <image> <cadrage>  remplir · ajuster · etirer · centrer · mosaique
  ${A}wallpaper video${R} <fichier> Une vidéo en fond ${D}(en pause sur batterie, sans son)${R}
  ${A}wallpaper anime${R}     Fonds animés ${D}(défaut : « code », le fond qui s'écrit)${R}
  ${A}wallpaper anime liste${R}      Ceux qui existent : code · pluie · braises · etoiles · atelier
  ${A}wallpaper anime nouveau${R} <nom>  Fabriquer le sien ${D}(modèle commenté, JSON)${R}
  ${A}wallpaper anime apercu${R} <nom>   Une image, sans rien poser
  ${A}wallpaper anime off${R}     Revenir au fond fixe
                      ${D}Tout se fige sur batterie, sans exception.${R}
  ${A}crt${R} <on|off|status> Effets d'ouverture/fermeture façon TV 1980

${B}LANGUE${R}
  ${A}lang${R}                 Langue actuelle et langues courantes ${D}(français, québécois, anglais…)${R}
  ${A}lang${R} <code>          Change la langue ${D}(ex. : fr_CA.UTF-8, en_US.UTF-8, anglais)${R}
  ${A}lang toutes${R}          Liste TOUTES les langues installées ${D}(locales-all)${R}

${B}ÉNERGIE${R}
  ${A}perf${R} <profil>       ${D}petit · medium · performant · max${R}
  ${A}lumiere${R} <0-100>     Luminosité de l'écran ${D}(aussi : lumiere eco, lumiere +10)${R}
  ${A}perf status${R}         Ce que fait vraiment la machine
  ${A}perf auto${R}           Choisir d'après le matériel détecté
  ${A}temperature${R}         ${B}Chaleur et ventilateurs, en direct${R}
                      ${D}processeur · carte graphique · mémoire vidéo · disques${R}
  ${A}temperature surveille${R} Garde les maximums — à lancer AVANT une partie
  ${A}firmware${R}            BIOS et micrologiciels : ce qui est à jour
  ${A}firmware maj${R}        Met à jour le BIOS système, les SSD…
                      ${D}Dell et Alienware sont soutenus. Le BIOS de la CARTE
                      GRAPHIQUE (VBIOS), lui, ne se met à jour que sous Windows.${R}

${B}JEUX${R} ${D}(saveur gaming)${R}
  ${A}jeux${R}                 ${B}Ta bibliothèque${R} : tous tes jeux au même endroit
                      ${D}Steam · Lutris · RetroArch · Flatpak · Debian, réunis${R}
  ${A}jeux lancer${R} <n°>     Lance le jeu n° <n°> de la bibliothèque
  ${A}jeux chercher${R} <mot>  Cherche un jeu par son nom
  ${A}game info${R}            Matériel détecté : GPU, Vulkan, GameMode, MangoHud
  ${A}game${R} <commande>      Lance un jeu avec les réglages adaptés à la machine
  ${A}game extras${R}          Compléments de jeu absents de Debian ${D}(Flathub)${R}

${B}RÉSEAU${R}
  ${A}avion${R} <on|off>      Mode avion : coupe toutes les radios
  ${A}wifi${R}                Chercher et rejoindre un réseau Wi-Fi
  ${A}bt${R}                  Bluetooth : appairer, connecter
  ${A}net${R}                 Toutes les commandes réseau ${D}(réseau caché, appareils du LAN…)${R}
  ${A}vpn${R} import <fichier> Importe un VPN ${D}(.ovpn ou WireGuard .conf)${R}
  ${A}vpn connect${R} "<nom>"  Se connecte au VPN

${B}SÉCURITÉ${R}
  ${A}secure${R}               État : pare-feu, antivirus, anti-intrusion, anti-rootkit
  ${A}secure enable${R}        Active pare-feu (ufw) + fail2ban, réglages sûrs
  ${A}secure scan${R} [dossier] Analyse antivirus (ClamAV) + anti-rootkit

${B}PARTAGE${R}
  ${A}share${R} <fichiers…>   Envoyer vers un téléphone ${D}(QR code, KDE Connect, Bluetooth)${R}
  ${A}receive${R}             Recevoir des fichiers depuis un téléphone
  ${A}ecran-telephone${R}     Afficher et contrôler l'écran du téléphone ${D}(scrcpy, USB ou Wi-Fi)${R}

${B}NAVIGATEURS${R}
  ${D}Firefox et Chromium sont préinstallés. Chrome, lui, n'est pas libre :${R}
  ${D}Google interdit de le redistribuer, l'ISO ne peut donc pas le contenir.${R}
  ${A}chrome${R}              Ouvre Google Chrome ${D}(propose de l'installer au 1er lancement)${R}
  ${A}install chrome${R}      Installe Chrome tout de suite ${D}(dépôt officiel Google, ~110 Mio)${R}

${B}LOGITHÈQUE${R}
  ${A}logitheque${R}          Boutique d'applications ${D}(GNOME Logiciels, dépôts Debian + Flathub)${R}
  ${A}logitheque liste${R}    Catalogue des applications courantes
  ${A}logitheque install${R} <nom…>  Installe en une commande ${D}(ex. : vlc, photo, bureautique)${R}

${B}USB${R}
  ${A}usb${R}                 Appareils branchés
  ${A}usb watch${R}           Suivre les branchements en direct
  ${A}usb import${R}          Tout copier depuis un téléphone ou une clé USB ${D}(1 clic)${R}
  ${A}vide-memoire${R}        « Vide mémoire + » — tout extraire d'un appareil ${D}(idem)${R}
  ${A}usb terminal${R}        Terminal SUR le téléphone ${D}(adb shell, débogage USB requis)${R}
  ${A}format${R} [cible]      Formater une clé USB ou un téléphone ${D}(confirmation exigée)${R}

${B}CAPTURE${R}
  ${A}capture${R}             Capture tout l'écran ${D}(Impr écr)${R}
  ${A}capture fenetre${R}     Capture la fenêtre active ${D}(Alt+Impr écr)${R}
  ${A}capture zone${R}        Capture une zone à la souris ${D}(Maj+Impr écr)${R}
  ${A}capture video${R}       Enregistre l'écran en vidéo ${D}(Ctrl+Maj+R, Ctrl+C pour arrêter)${R}

${B}STUDIO+${R}
  ${A}musique${R}             lexOS_musique : lecteur audio local ${D}(crate, playlists)${R}
  ${A}studio${R}              Studio+ LexOS : ateliers image, vidéo et son
  ${A}studio ouvrir${R} <atelier>  photo · peinture · vectoriel · video · capture · son
                      ${D}propose d'installer l'atelier s'il manque${R}

${B}ARCHIVES${R}
  ${A}run-ins${R} <archive.zip> Installe une application livrée en .zip
                      ${D}montre ce qu'elle contient et demande avant d'exécuter${R}

${B}CARTES${R}
  ${A}cartes${R}              Carte du monde : position, fuseau, météo
                      ${D}données OpenStreetMap · aucun compte, aucune clé${R}
  ${A}gps${R}                 GPS d'Alex : itinéraires, adresses, points d'intérêt
                      ${D}Map IA · données OpenStreetMap · itinéraires OSRM${R}

${B}CLAVIER${R}
  ${A}clavier${R}             Dispositions actives et bascule
  ${A}clavier liste${R}       Les 20 dispositions reconnues
  ${A}clavier ajouter${R} <c> En ajouter une ${D}(4 au maximum : limite de X)${R}
  ${A}clavier bascule${R} <t> Quelles touches font passer à la suivante

${B}COMPTES EN LIGNE${R}
  ${A}comptes${R}             Ce qui est relié, ce qui est monté
  ${A}comptes services${R}    Drive · OneDrive · Dropbox · Nextcloud · Proton · S3…
  ${A}comptes ajouter${R} <s> Relier un compte ${D}(autorisation par le navigateur)${R}
  ${A}comptes monter${R} <n>  L'ouvrir comme un disque dans ~/Nuage
                      ${D}aucun mot de passe conservé — un jeton révocable, c'est tout${R}

${B}BIEN-ÊTRE NUMÉRIQUE${R}
  ${A}bienetre${R}            Temps d'écran du jour, limite, confort
  ${A}bienetre semaine${R}    Les sept derniers jours en un coup d'oeil
  ${A}bienetre demarrer${R}   Commencer à compter ${D}(arrêté par défaut, exprès)${R}
  ${A}bienetre limite${R} <m> Prévenir au-delà de N minutes
  ${A}bienetre pauses on${R}  Rappels de pause ${D}(workrave)${R}
  ${A}bienetre nuit on${R}    Réchauffer l'écran le soir ${D}(redshift)${R}

${B}MATÉRIEL APPLE${R}
  ${A}mac${R}                 Bilan : ce Mac peut-il faire tourner LexOS ?
  ${A}mac demarrage${R}       Comment démarrer LexOS sur ce Mac précisément
  ${A}mac wifi${R}            Quel pilote Broadcom il faut ${D}(déduit de l'identifiant PCI)${R}
  ${A}mac clavier${R} <mode>  F1..F12 : ${B}fonction${R} ou ${B}multimedia${R}
  ${A}mac ventilateur${R}     Pour qu'ils accélèrent quand ça chauffe
                      ${D}Mac Intel : oui. Mac M1/M2/M3/M4 : non, autre processeur.${R}

${B}IMAGES${R}
  ${A}sticker${R} <image…>     Découpe le sujet en autocollant (PNG transparent)
                      ${D}IA (rembg) si installée, sinon fond uni (ImageMagick)${R}

${B}IA${R}
  ${A}ia setup${R}             Installe l'IA locale (Ollama) + un petit modèle
  ${A}ia${R}                   Conversation libre avec l'IA locale
  ${A}ia${R} "<tâche>"          Agent AUTONOME : exécute des commandes tout seul
                      ${D}rien n'est envoyé sur internet, jamais sudo par défaut${R}
  ${A}claude${R}               Claude Code : l'assistant de programmation d'Anthropic
  ${A}claude app${R}           L'application Claude (claude.ai) en fenêtre dédiée
                      ${D}Claude tourne dans le nuage : connexion et compte requis${R}

${B}DÉVELOPPEMENT${R}
  ${A}dev${R}                 État des outils : Claude Code, GitHub CLI, Vercel CLI
  ${A}dev install${R}         Installe les trois ${D}(depuis leur source officielle)${R}
  ${A}dev install${R} <outil> ${D}claude · gh · vercel${R}
  ${A}dev update${R}          Met à jour ceux qui sont installés
                      ${D}Ces outils sortent une version par semaine : les figer
                      dans l'ISO les livrerait périmés. Le nécessaire (nodejs,
                      npm, git, curl) est, lui, déjà installé.${R}

${B}DÉMO & INSTALLATION${R}
  ${A}demo${R}                Où en est-on : clé USB (démo) ou disque dur ?
  ${A}install-disk${R}        Installer sur le disque ${D}(confirmation exigée)${R}

${B}EXEMPLES${R}
  ${D}${PROG} install neovim tmux${R}
  ${D}${PROG} chrome${R}             ${D}(ouvre Google Chrome, l'installe au besoin)${R}
  ${D}${PROG} install chrome${R}      ${D}(ajoute Google Chrome — dépôt officiel Google)${R}
  ${D}${PROG} accent violet${R}
  ${D}${PROG} dock gauche${R}
  ${D}${PROG} perf max${R}
  ${D}${PROG} share photo.jpg${R}
  ${D}${PROG} usb import${R}
  ${D}${PROG} lang quebecois${R}
  ${D}${PROG} sticker photo.jpg${R}
  ${D}${PROG} mac demarrage${R}
  ${D}${PROG} clavier ajouter us${R}
  ${D}${PROG} comptes ajouter google${R}
  ${D}${PROG} bienetre semaine${R}
  ${D}${PROG} ia "libère 2 Gio d'espace disque"${R}

EOF
	[[ -n "$LEXOS_HOME_URL" ]] && printf '%s%s%s\n\n' "$D" "$LEXOS_HOME_URL" "$R"
}

cmd_version() {
	load_release
	printf '%s%s%s %s (%s)\n' "$B$O" "$LEXOS_NAME" "$R" "$LEXOS_VERSION" "$LEXOS_CODENAME"
	printf '  saveur   : %s\n' "$LEXOS_FLAVOUR"
	printf '  build    : %s (%s)\n' "$LEXOS_BUILD_DATE" "$LEXOS_BUILD_ID"
	printf '  base     : Debian %s\n' "$DEBIAN_BASE"
	printf '  noyau    : %s\n' "$(uname -r)"
}

cmd_info() {
	if command -v lexfetch >/dev/null 2>&1; then
		exec lexfetch
	fi
	cmd_version
}

cmd_update() {
	need_root update
	say "Rafraîchissement des dépôts…"
	apt-get update && ok "Listes à jour" || die "Échec de la mise à jour des listes"
	local n
	n="$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst ')"
	if [[ "$n" -gt 0 ]]; then
		say "${n} paquet(s) peuvent être mis à jour — lance : ${D}${PROG} upgrade${R}"
	else
		ok "Système déjà à jour"
	fi
}

cmd_upgrade() {
	need_root upgrade
	say "Mise à jour du système…"
	apt-get update || die "Échec de la mise à jour des listes"
	DEBIAN_FRONTEND=noninteractive apt-get -y full-upgrade || die "Échec de la mise à jour"
	apt-get -y autoremove --purge
	ok "Système à jour"
}

cmd_install() {
	[[ $# -gt 0 ]] || die "Usage : ${PROG} install <paquet> [paquet…]"
	case "${1,,}" in
		chrome|google-chrome|chrome-navigateur)
			need_root install chrome
			exec /usr/bin/lexos-install-chrome
			;;
	esac
	need_root install "$@"
	say "Installation : $*"
	apt-get update -qq
	apt-get install -y "$@" || die "Installation échouée"
	ok "Installé : $*"
}

cmd_remove() {
	[[ $# -gt 0 ]] || die "Usage : ${PROG} remove <paquet> [paquet…]"
	need_root remove "$@"
	say "Désinstallation : $*"
	apt-get remove --purge -y "$@" || die "Désinstallation échouée"
	apt-get -y autoremove --purge
	ok "Désinstallé : $*"
}

cmd_search() {
	[[ $# -gt 0 ]] || die "Usage : ${PROG} search <terme>"
	apt-cache search --names-only "$1" | head -n 40
}

cmd_clean() {
	need_root clean
	local before after
	before="$(df -Pk / | awk 'NR==2{print $4}')"

	say "Nettoyage du cache APT…"
	apt-get clean
	apt-get -y autoremove --purge >/dev/null

	say "Rotation des journaux systemd…"
	journalctl --vacuum-time=7d >/dev/null 2>&1 || true

	say "Vidage des caches miniatures…"
	rm -rf /home/*/.cache/thumbnails/* /root/.cache/thumbnails/* 2>/dev/null || true

	after="$(df -Pk / | awk 'NR==2{print $4}')"
	local freed=$(( (after - before) / 1024 ))
	(( freed < 0 )) && freed=0
	ok "Terminé — ${freed} Mio libérés"
}

cmd_doctor() {
	load_release
	printf '\n%s%s — diagnostic%s\n\n' "$B$O" "$LEXOS_NAME" "$R"

	# Disque
	local use
	use="$(df -Ph / | awk 'NR==2{gsub(/%/,"",$5); print $5}')"
	if (( use >= 90 )); then
		err "Disque / rempli à ${use}% — fais du ménage (${PROG} clean)"
	elif (( use >= 75 )); then
		warn "Disque / rempli à ${use}%"
	else
		ok "Disque / : ${use}% utilisé"
	fi

	# Mémoire
	if [[ -r /proc/meminfo ]]; then
		local t a p
		t="$(awk '/MemTotal/{print $2}' /proc/meminfo)"
		a="$(awk '/MemAvailable/{print $2}' /proc/meminfo)"
		p=$(( 100 - (a * 100 / t) ))
		if (( p >= 90 )); then warn "Mémoire utilisée à ${p}%"
		else ok "Mémoire : ${p}% utilisée"; fi
	fi

	# Réseau
	if ping -c1 -W3 deb.debian.org >/dev/null 2>&1; then
		ok "Réseau : dépôts Debian joignables"
	else
		warn "Réseau : impossible de joindre deb.debian.org"
	fi

	# Services en échec
	if command -v systemctl >/dev/null 2>&1; then
		local failed
		failed="$(systemctl --failed --no-legend --plain 2>/dev/null | wc -l)"
		if (( failed > 0 )); then
			warn "${failed} service(s) en échec :"
			systemctl --failed --no-legend --plain 2>/dev/null | awk '{print "    - "$1}'
		else
			ok "Aucun service en échec"
		fi
	fi

	# Mises à jour
	if command -v apt-get >/dev/null 2>&1; then
		local n
		n="$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst ')"
		if (( n > 0 )); then
			warn "${n} mise(s) à jour disponible(s) — ${PROG} upgrade"
		else
			ok "Aucune mise à jour en attente"
		fi
	fi

	# Python : ce dont les applications de LexOS ont besoin
	#  Plusieurs applications de LexOS SONT des programmes Python. Quand un
	#  module manque, elles s'arrêtent sur un « ModuleNotFoundError » qui ne
	#  dit pas quel PAQUET installer — c'est ce que cette section répond, un
	#  module par ligne, avec le nom Debian à taper.
	if command -v python3 >/dev/null 2>&1; then
		local manquants=() ligne module paquet quoi
		for ligne in \
			"gi|python3-gi gir1.2-gtk-3.0|fonds d'écran animés" \
			"cairo|python3-cairo|fonds d'écran animés" \
			"Xlib|python3-xlib|fond d'écran vidéo" \
			"PySide6.QtWebEngineWidgets|python3-pyside6.qtwebenginewidgets|Paramètres et Cartes" \
			"tkinter|python3-tk|programmes Python à interface Tk" \
			"requests|python3-requests|programmes Python qui vont sur le web" \
			"PIL|python3-pil|programmes Python qui touchent aux images" \
			"numpy|python3-numpy|calcul, science, images"
		do
			module="${ligne%%|*}"; quoi="${ligne##*|}"
			paquet="${ligne#*|}"; paquet="${paquet%|*}"
			python3 -c "import ${module}" >/dev/null 2>&1 || \
				manquants+=("${paquet}|${quoi}")
		done
		if (( ${#manquants[@]} == 0 )); then
			ok "Python : tous les modules attendus sont là"
		else
			warn "Python : ${#manquants[@]} module(s) manquant(s)"
			for ligne in "${manquants[@]}"; do
				printf '    - %s%s%s  %s(%s)%s\n' \
					"$O" "${ligne%%|*}" "$R" "$D" "${ligne##*|}" "$R"
			done
			printf '    %ssudo apt install %s%s\n' "$D" \
				"$(printf '%s ' "${manquants[@]%%|*}")" "$R"
		fi
		#  pipx, et non pip : depuis Debian 12, « pip install » à l'échelle
		#  du système est refusé (externally-managed-environment). pipx pose
		#  chaque application Python dans son propre environnement.
		if command -v pipx >/dev/null 2>&1; then
			ok "pipx : les applications Python s'installent avec « pipx install <nom> »"
		else
			warn "pipx absent — c'est lui qui installe une application Python sur Debian 13"
			printf '    %ssudo apt install pipx%s\n' "$D" "$R"
		fi
	fi

	# Redémarrage requis
	if [[ -f /var/run/reboot-required ]]; then
		warn "Un redémarrage est requis"
	fi

	printf '\n'
}

cmd_logs() {
	local n="${1:-40}"
	if command -v journalctl >/dev/null 2>&1; then
		journalctl -p err -n "$n" --no-pager
	else
		tail -n "$n" /var/log/syslog 2>/dev/null || die "Aucun journal disponible"
	fi
}

#  Les cinq cadrages de XFCE, avec leur numéro dans xfconf. Les nommer
#  évite d'avoir à retenir que « 5 » veut dire « recadrer pour remplir » —
#  et c'est ce chiffre-là qu'on veut presque toujours.
wallpaper_style() {
	case "${1,,}" in
		remplir|zoom|cover|"")  printf '5' ;;   # recadre, ne déforme pas
		ajuster|contain|fit)    printf '4' ;;   # image entière, bandes possibles
		etirer|étirer|stretch)  printf '3' ;;   # déforme
		centrer|center)         printf '1' ;;
		mosaique|mosaïque|tile) printf '2' ;;
		*) return 1 ;;
	esac
}

cmd_wallpaper() {
	#  « wallpaper video … » part vers l'outil dédié : une vidéo de fond
	#  n'est pas une propriété xfconf mais un processus qui tourne, avec sa
	#  surveillance de batterie et son arrêt propre.
	if [[ "${1:-}" == "video" || "${1:-}" == "vidéo" ]]; then
		shift; exec lexos-fond-video "$@"
	fi

	#  « wallpaper anime … » : les fonds dessinés en direct. Même raison que
	#  la vidéo — ce n'est pas une propriété xfconf mais un programme qui
	#  tourne, avec sa surveillance de batterie.
	if [[ "${1:-}" == "anime" || "${1:-}" == "animé" || "${1:-}" == "anim" ]]; then
		shift; exec lexos-fond-anime "$@"
	fi
	#  « wallpaper code » : le raccourci vers la scène du même nom, celle qui
	#  écrit du code. C'est le fond animé par défaut de LexOS.
	if [[ "${1:-}" == "code" || "${1:-}" == "ecriture" || "${1:-}" == "écriture" ]]; then
		shift
		[[ "${1:-}" == "off" ]] && exec lexos-fond-anime off
		exec lexos-fond-anime code
	fi

	local img="${1:-/usr/share/backgrounds/lexos/wallpaper.png}"
	local cadrage="${2:-remplir}"

	[[ -r "$img" ]] || die "Image introuvable ou illisible : $img"
	[[ -f "$img" ]] || die "Ce n'est pas un fichier : $img"

	#  Vérifier que c'est bien une image AVANT de la poser : xfconf accepte
	#  n'importe quelle chaîne sans broncher, et un chemin qui ne pointe pas
	#  sur une image donne un bureau noir sans le moindre message. Mieux vaut
	#  refuser ici, en disant pourquoi.
	if command -v file >/dev/null 2>&1; then
		local genre; genre="$(file -b --mime-type "$img" 2>/dev/null)"
		case "$genre" in
			image/*) ;;
			*) die "Ce fichier n'est pas une image (${genre:-type inconnu}) : $(basename "$img")" ;;
		esac
	fi

	local style; style="$(wallpaper_style "$cadrage")" \
		|| die "Cadrage inconnu : $cadrage  (remplir | ajuster | etirer | centrer | mosaique)"

	command -v xfconf-query >/dev/null 2>&1 \
		|| die "xfconf-query absent — cette commande demande le bureau XFCE."
	[[ -n "${DISPLAY:-}" ]] || die "Aucune session graphique détectée."

	#  Chemin absolu : xfconf garde la chaîne telle quelle, et un chemin
	#  relatif ne voudrait plus rien dire à la prochaine ouverture de session.
	img="$(readlink -f "$img")"

	#  Un fond animé recouvre le fond fixe : on l'arrête AVANT de poser
	#  l'image. Dans l'autre ordre, l'arrêt remettrait le fond d'avant
	#  par-dessus celui qu'on vient de choisir.
	if command -v lexos-fond-anime >/dev/null 2>&1; then
		lexos-fond-anime off >/dev/null 2>&1 || true
	fi

	local prop count=0
	while read -r prop; do
		[[ "$prop" == *last-image ]] || continue
		xfconf-query -c xfce4-desktop -p "$prop" -s "$img" && count=$((count + 1))
		#  Le style vit sur une propriété voisine, au même emplacement.
		xfconf-query -c xfce4-desktop -p "${prop%last-image}image-style" \
			-n -t int -s "$style" 2>/dev/null || true
	done < <(xfconf-query -c xfce4-desktop -l 2>/dev/null)

	if (( count > 0 )); then
		ok "Fond d'écran appliqué sur ${count} écran(s) : $(basename "$img")"
	else
		die "Aucune propriété de fond d'écran trouvée."
	fi
}

cmd_accent() {
	local name="${1:-}"
	if [[ -z "$name" ]]; then
		local cur="orange"
		[[ -r "$HOME/.config/lexos/accent" ]] && cur="$(cat "$HOME/.config/lexos/accent")"
		printf 'Accent courant : %s%s%s\n' "$O" "$cur" "$R"
		printf 'Disponibles    : orange orange-rouge bleu rouge vert gris violet neon\n'
		return 0
	fi
	command -v lexos-theme-gen >/dev/null 2>&1 \
		|| die "lexos-theme-gen introuvable."
	lexos-theme-gen "$name" || exit 1

	# Recharge à chaud ce qui peut l'être.
	if command -v xfconf-query >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
		local t
		t="$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null || echo Arc-Dark)"
		xfconf-query -c xsettings -p /Net/ThemeName -s "Adwaita"  2>/dev/null || true
		xfconf-query -c xsettings -p /Net/ThemeName -s "$t"       2>/dev/null || true
	fi
	ok "Ferme et rouvre tes fenêtres pour que tout prenne la nouvelle couleur."
}

# --- La police d'écriture de l'interface -------------------------------------
#  Quatre familles nommées, pas une liste de fontes : « manuscrite » est celle
#  qu'on embarque nous-mêmes (Patrick Hand, licence OFL, dans
#  /usr/share/fonts/truetype/lexos) — les trois autres s'appuient sur des alias
#  génériques de fontconfig, qui existent sur toute installation. Une police
#  absente ne casse donc rien : fontconfig retombe sur la plus proche.
#
#  Deux endroits à écrire, et c'est voulu : xsettings applique le changement
#  À CHAUD sur les fenêtres ouvertes, gtk-3.0/settings.ini le fait SURVIVRE à
#  la déconnexion. N'écrire que le premier et tout revient au défaut au
#  redémarrage — ça a été le cas pendant un temps.
cmd_police() {
	local nom="${1:-}"
	local conf="$HOME/.config/lexos"
	local police

	case "${nom,,}" in
		defaut|default|systeme|système|'') police="" ;;
		classique|serif)                   police="Noto Serif 10" ;;
		mono|machine|monospace)            police="Monospace 10" ;;
		manuscrite|ecriture|écriture|main) police="Patrick Hand 12" ;;
		liste|list)
			local cur="défaut"
			[[ -r "$conf/police" ]] && cur="$(cat "$conf/police")"
			printf 'Police courante : %s%s%s\n' "$O" "$cur" "$R"
			printf 'Disponibles     : defaut · classique · mono · manuscrite\n'
			return 0
			;;
		*)
			die "Police inconnue : ${nom}
Disponibles : defaut · classique · mono · manuscrite"
			;;
	esac

	#  Sans argument on affiche l'état plutôt que de tout remettre à zéro :
	#  « lexos police » tout court doit renseigner, pas modifier.
	[[ -z "$nom" ]] && { cmd_police liste; return 0; }

	mkdir -p "$conf"
	printf '%s\n' "${nom,,}" > "$conf/police"

	# 1) À chaud, sur la session en cours.
	if command -v xfconf-query >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
		if [[ -z "$police" ]]; then
			xfconf-query -c xsettings -p /Gtk/FontName -r 2>/dev/null || true
		else
			xfconf-query -c xsettings -p /Gtk/FontName -s "$police" \
				--create -t string 2>/dev/null || true
		fi
	fi

	# 2) Pour les prochaines sessions, et pour les applications GTK qui
	#    lisent le fichier plutôt que xsettings.
	local ini="$HOME/.config/gtk-3.0/settings.ini"
	mkdir -p "$(dirname "$ini")"
	[[ -f "$ini" ]] || printf '[Settings]\n' > "$ini"
	grep -q '^\[Settings\]' "$ini" || sed -i '1i [Settings]' "$ini"
	sed -i '/^gtk-font-name[[:space:]]*=/d' "$ini"
	[[ -n "$police" ]] && sed -i "/^\[Settings\]/a gtk-font-name=${police}" "$ini"

	if [[ -z "$police" ]]; then
		ok "Police remise au défaut du système."
	else
		ok "Police : ${police}."
	fi
	say "Les fenêtres déjà ouvertes gardent l'ancienne — rouvre-les."
}

cmd_crt() {
	local mode="${1:-status}"
	local state_dir="$HOME/.config/lexos"
	mkdir -p "$state_dir"
	case "$mode" in
		on|off)
			printf '%s\n' "$mode" > "$state_dir/crt"
			ok "Effets CRT : ${mode} — déconnecte-toi et reconnecte-toi pour appliquer."
			;;
		status)
			local cur="on"
			[[ -r "$state_dir/crt" ]] && cur="$(cat "$state_dir/crt")"
			printf 'Effets CRT demandés : %s%s%s\n' "$O" "$cur" "$R"
			if pgrep -x compiz >/dev/null 2>&1; then
				ok "Compiz tourne — les effets sont actifs."
			else
				warn "Compiz ne tourne pas (repli xfwm4, sûrement pas d'accélération 3D)."
				[[ -r "$state_dir/wm.log" ]] && tail -n 5 "$state_dir/wm.log"
			fi
			;;
		*) die "Usage : ${PROG} crt <on|off|status>" ;;
	esac
}

cmd_demo() {
	load_release
	local live=0
	grep -qa 'boot=live' /proc/cmdline 2>/dev/null && live=1
	printf '\n'
	if (( live )); then
		printf '  %sSession DÉMO%s — tu tournes depuis la clé USB.\n' "$G" "$R"
		printf '  Ton disque dur n'\''est %spas%s touché : essaie tout ce que tu veux.\n' "$B" "$R"
		local medium
		medium="$(findmnt -no SOURCE /run/live/medium 2>/dev/null || echo 'inconnu')"
		printf '  Support     : %s\n' "$medium"
		printf '\n  Quand tu es convaincu : %s%s install%s\n' "$O" "$PROG" "$R"
	else
		printf '  %s%s est installé sur ce disque%s (pas une session démo).\n' "$B" "$LEXOS_NAME" "$R"
		printf '  Disque racine : %s\n' "$(findmnt -no SOURCE / 2>/dev/null || echo '?')"
	fi
	printf '\n'
}

cmd_install_disk() {
	command -v lexos-install >/dev/null 2>&1 \
		|| die "lexos-install introuvable sur cette image."
	exec lexos-install "$@"
}

cmd_dock() {
	local pos="${1:-}"
	local schema="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"

	command -v gsettings >/dev/null 2>&1 \
		|| die "gsettings absent — le dock Plank n'est pas installé."

	if [[ -z "$pos" ]]; then
		local cur; cur="$(gsettings get "$schema" position 2>/dev/null | tr -d "'")"
		case "$cur" in
			right)  cur="droite (défaut)" ;;
			left)   cur="gauche" ;;
			bottom) cur="bas" ;;
			top)    cur="haut" ;;
		esac
		printf 'Position du dock : %s%s%s\n' "$O" "$cur" "$R"
		printf 'Disponibles      : droite · gauche · bas · haut\n'
		return 0
	fi

	local target
	case "$(printf '%s' "$pos" | tr '[:upper:]' '[:lower:]')" in
		droite|right|d)         target="right" ;;
		gauche|left|g)          target="left" ;;
		bas|bottom|b)           target="bottom" ;;
		haut|top|h)             target="top" ;;
		*) die "Position inconnue : '$pos' (droite | gauche | bas | haut)" ;;
	esac

	gsettings set "$schema" position "$target" 2>/dev/null \
		|| die "Impossible de déplacer le dock."
	ok "Dock déplacé : ${pos}"

	# Plank applique la position à chaud, mais un redémarrage lève tout doute.
	if pgrep -x plank >/dev/null 2>&1; then
		pkill -x plank 2>/dev/null
		( sleep 1; setsid plank >/dev/null 2>&1 & ) 2>/dev/null
	fi
}

cmd_theme() {
	local mode="${1:-}"
	local gtk icons lexos_mode
	case "$mode" in
		dark|sombre|nuit)   gtk="Arc-Dark"; icons="Papirus-Dark"; lexos_mode="sombre" ;;
		light|clair|jour)   gtk="Arc";      icons="Papirus";      lexos_mode="clair"  ;;
		accent) shift; cmd_accent "$@"; return ;;
		*) die "Usage : ${PROG} theme <sombre|clair>  ·  ${PROG} accent <couleur>" ;;
	esac

	command -v lexos-theme-gen >/dev/null 2>&1 \
		&& lexos-theme-gen --mode "$lexos_mode" >/dev/null

	if command -v xfconf-query >/dev/null 2>&1; then
		xfconf-query -c xsettings -p /Net/ThemeName        -s "$gtk"
		xfconf-query -c xsettings -p /Net/IconThemeName    -s "$icons"
		xfconf-query -c xfwm4     -p /general/theme        -s "$gtk"
	fi
	ok "Thème : ${lexos_mode} (${gtk} / ${icons})"
}

# =============================================================================
#  Langue système — locales-all fournit déjà toutes les langues de glibc
# =============================================================================
LANG_COMMON=(
	"fr_CA.UTF-8:Français (Québec)"     "fr_FR.UTF-8:Français (France)"
	"en_US.UTF-8:English (US)"          "en_CA.UTF-8:English (Canada)"
	"en_GB.UTF-8:English (UK)"          "es_ES.UTF-8:Español (España)"
	"es_MX.UTF-8:Español (México)"      "de_DE.UTF-8:Deutsch"
	"it_IT.UTF-8:Italiano"              "pt_BR.UTF-8:Português (Brasil)"
	"pt_PT.UTF-8:Português (Portugal)"  "nl_NL.UTF-8:Nederlands"
	"ru_RU.UTF-8:Русский"               "zh_CN.UTF-8:中文（简体）"
	"zh_TW.UTF-8:中文（繁體）"           "ja_JP.UTF-8:日本語"
	"ko_KR.UTF-8:한국어"                 "ar_SA.UTF-8:العربية"
	"hi_IN.UTF-8:हिन्दी"                "pl_PL.UTF-8:Polski"
)

cmd_lang() {
	local sub="${1:-}"
	case "${sub,,}" in
	list|liste|ls|'')
		local cur; cur="$(awk -F= '/^LANG=/{print $2}' /etc/default/locale 2>/dev/null)"
		printf '\n%s%s — langues%s\n' "$B$O" "$PROG" "$R"
		printf 'Langue actuelle : %s%s%s\n\n' "$O" "${cur:-${LANG:-inconnue}}" "$R"
		local entry code label
		for entry in "${LANG_COMMON[@]}"; do
			code="${entry%%:*}"; label="${entry#*:}"
			printf '  %-16s %s\n' "$code" "$label"
		done
		printf '\n  %s%s toutes les langues installées (locales-all) : %s lang toutes%s\n' "$D" "$R" "$PROG" "$R"
		printf '  %sChanger : %s lang <code>%s  (ex. : %s lang fr_CA.UTF-8, %s lang anglais)\n\n' \
			"$D" "$PROG" "$R" "$PROG" "$PROG"
		;;
	toutes|all|complete)
		command -v locale >/dev/null 2>&1 || die "commande 'locale' introuvable."
		locale -a
		;;
	*)
		local code="$sub"
		case "${sub,,}" in
			francais|français|french|fr)         code="fr_FR.UTF-8" ;;
			quebecois|québécois|fr-ca|fr_ca)      code="fr_CA.UTF-8" ;;
			anglais|english|en)                  code="en_US.UTF-8" ;;
			espagnol|spanish|es)                  code="es_ES.UTF-8" ;;
			allemand|german|de)                   code="de_DE.UTF-8" ;;
			italien|italian|it)                   code="it_IT.UTF-8" ;;
		esac
		# « locale -a » liste les locales sous une forme normalisée (ex. fr_ca.utf8)
		# qui diffère de la forme conventionnelle utilisée dans LANG (fr_CA.UTF-8) :
		# on compare les deux en ignorant casse et tirets.
		if command -v locale >/dev/null 2>&1; then
			local norm_code norm_have
			norm_code="$(printf '%s' "$code" | tr '[:upper:]' '[:lower:]' | tr -d '-')"
			norm_have="$(locale -a 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d '-')"
			grep -qxF "$norm_code" <<< "$norm_have" \
				|| die "Langue inconnue ou non installée : '${sub}'  (voir : ${PROG} lang list)"
		fi

		need_root lang "$sub"
		if grep -q '^LANG=' /etc/default/locale 2>/dev/null; then
			sed -i "s/^LANG=.*/LANG=${code}/" /etc/default/locale
		else
			printf 'LANG=%s\n' "$code" >> /etc/default/locale
		fi
		local k
		for k in LC_ADDRESS LC_MEASUREMENT LC_MONETARY LC_NAME LC_NUMERIC LC_PAPER LC_TELEPHONE LC_TIME; do
			grep -q "^${k}=" /etc/default/locale 2>/dev/null && sed -i "s/^${k}=.*/${k}=${code}/" /etc/default/locale
		done
		ok "Langue système : ${code} — reconnecte-toi (ou redémarre) pour l'appliquer partout."
		;;
	esac
}

# =============================================================================
#  Répartiteur
# =============================================================================
CMD="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
	help|--help|-h|aide|?) cmd_help ;;
	version|--version|-V) cmd_version ;;
	info|status)          cmd_info ;;
	update)               cmd_update ;;
	upgrade|up)           cmd_upgrade ;;
	install|add)          cmd_install "$@" ;;
	remove|rm|uninstall)  cmd_remove "$@" ;;
	search|find)          cmd_search "$@" ;;
	clean|cleanup)        cmd_clean ;;
	doctor|check)         cmd_doctor ;;
	logs|log)             cmd_logs "$@" ;;
	wallpaper|bg)         cmd_wallpaper "$@" ;;
	theme)                cmd_theme "$@" ;;
	accent)               cmd_accent "$@" ;;
	police|font|ecriture|écriture) cmd_police "$@" ;;
	lang|langue)          cmd_lang "$@" ;;
	dock|barre)           cmd_dock "$@" ;;
	ecran|écran|display|screen) exec lexos-display "$@" ;;
	perf|performance)     exec lexos-perf "$@" ;;
	temperature|température|temp|chaleur|ventilateurs) exec lexos-temp "$@" ;;
	lumiere|luminosite|brightness) exec lexos-brightness "$@" ;;
	net|reseau)           exec lexos-net "$@" ;;
	avion|airplane)       exec lexos-net avion "$@" ;;
	wifi)                 exec lexos-net "${1:-scan}" "${@:2}" ;;
	bt|bluetooth)         exec lexos-net bt "$@" ;;
	share|partage)        exec lexos-share "$@" ;;
	receive|recevoir)     exec lexos-share receive ;;
	ecran-telephone)      exec lexos-ecran-telephone "$@" ;;
	logitheque|boutique|store) exec lexos-logitheque "$@" ;;
	usb)                  exec lexos-usb "$@" ;;
	vide-memoire|vider)   exec lexos-usb import "$@" ;;
	terminal-appareil)    exec lexos-usb terminal ;;
	format)               exec lexos-format "$@" ;;
	capture|capture-ecran) exec lexos-capture "$@" ;;
	run-ins|runins)       exec lexos-run-ins "$@" ;;
	studio)               exec lexos-studio "$@" ;;
	sticker|autocollant)  exec lexos-sticker "$@" ;;
	ia|agent)             exec lexos-ia "$@" ;;
	claude|cc)            exec lexos-claude "$@" ;;
	dev|devs|developpement|développement) exec lexos-dev "$@" ;;
	firmware|bios|micrologiciel) exec lexos-firmware "$@" ;;
	musique|music)        exec lexos-musique "$@" ;;
	chrome|google-chrome) exec lexos-chrome "$@" ;;
	#  « jeux » ouvre la BIBLIOTHÈQUE (la liste de ce qu'on possède) : c'est
	#  ce que quelqu'un veut dire en tapant « mes jeux ». « game » reste la
	#  commande qui LANCE quelque chose avec les réglages de jeu.
	jeux|jeu|bibliotheque|bibliothèque|biblio) exec lexos-jeux "$@" ;;
	game)                 exec lexos-game "$@" ;;
	secure|securite)      exec lexos-secure "$@" ;;
	vpn)                  exec lexos-vpn "$@" ;;
	cartes|carte|maps)    exec lexos-cartes "$@" ;;
	gps|navigation)       exec lexos-gps "$@" ;;
	clavier|keyboard)     exec lexos-clavier "$@" ;;
	comptes|compte)       exec lexos-comptes "$@" ;;
	bienetre|bien-etre|bien-être) exec lexos-bienetre "$@" ;;
	mac|apple)            exec lexos-mac "$@" ;;
	crt)                  cmd_crt "$@" ;;
	demo|live)            cmd_demo ;;
	install-disk|setup)   cmd_install_disk "$@" ;;
	*)
		err "Commande inconnue : ${CMD}"
		printf '  Le sommaire des commandes : %s aide\n' "$PROG" >&2
		printf '  Ou tape « %s » puis la touche Tab pour les voir toutes.\n' "$PROG" >&2
		exit 1
		;;
esac
